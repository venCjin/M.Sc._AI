CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;


UNWIND [{_id:3, properties:{id:"Two imprisoned men bond over a number of years, finding solace and eventual redemption through acts of common decency."}}, {_id:16, properties:{id:"An organized crime dynasty's aging patriarch transfers control of his clandestine empire to his reluctant son."}}, {_id:35, properties:{id:"When the menace known as the Joker wreaks havoc and chaos on the people of Gotham, Batman must accept one of the greatest psychological and physical tests of his ability to fight injustice."}}, {_id:44, properties:{id:"The early life and career of Vito Corleone in 1920s New York City is portrayed, while his son, Michael, expands and tightens his grip on the family crime syndicate."}}, {_id:56, properties:{id:"A jury holdout attempts to prevent a miscarriage of justice by forcing his colleagues to reconsider the evidence."}}, {_id:61, properties:{id:"Gandalf and Aragorn lead the World of Men against Sauron's army to draw his gaze from Frodo and Sam as they approach Mount Doom with the One Ring."}}, {_id:79, properties:{id:"The lives of two mob hitmen, a boxer, a gangster and his wife, and a pair of diner bandits intertwine in four tales of violence and redemption."}}, {_id:85, properties:{id:"In German-occupied Poland during World War II, industrialist Oskar Schindler gradually becomes concerned for his Jewish workforce after witnessing their persecution by the Nazis."}}, {_id:96, properties:{id:"A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O."}}, {_id:112, properties:{id:"An insomniac office worker and a devil-may-care soapmaker form an underground fight club that evolves into something much, much more."}}, {_id:121, properties:{id:"A meek Hobbit from the Shire and eight companions set out on a journey to destroy the powerful One Ring and save Middle-earth from the Dark Lord Sauron."}}, {_id:125, properties:{id:"The presidencies of Kennedy and Johnson, the events of Vietnam, Watergate and other historical events unfold through the perspective of an Alabama man with an IQ of 75, whose only desire is to be reunited with his childhood sweetheart."}}, {_id:138, properties:{id:"A bounty hunting scam joins two men in an uneasy alliance against a third in a race to find a fortune in gold buried in a remote cemetery."}}, {_id:147, properties:{id:"While Frodo and Sam edge closer to Mordor with the help of the shifty Gollum, the divided fellowship makes a stand against Sauron's new ally, Saruman, and his hordes of Isengard."}}, {_id:162, properties:{id:"When a beautiful stranger leads computer hacker Neo to a forbidding underworld, he discovers the shocking truth--the life he knows is the elaborate deception of an evil cyber-intelligence."}}, {_id:163, properties:{id:"The story of Henry Hill and his life in the mob, covering his relationship with his wife Karen Hill and his mob partners Jimmy Conway and Tommy DeVito in the Italian-American crime syndicate."}}, {_id:177, properties:{id:"After the Rebels are brutally overpowered by the Empire on the ice planet Hoth, Luke Skywalker begins Jedi training with Yoda, while his friends are pursued by Darth Vader and a bounty hunter named Boba Fett all over the galaxy."}}, {_id:191, properties:{id:"A criminal pleads insanity and is admitted to a mental institution, where he rebels against the oppressive nurse and rallies up the scared patients."}}, {_id:200, properties:{id:"The real life of one of America's foremost founding fathers and first Secretary of the Treasury, Alexander Hamilton. Captured live on Broadway from the Richard Rodgers Theater with the original Broadway cast."}}, {_id:209, properties:{id:"Greed and class discrimination threaten the newly formed symbiotic relationship between the wealthy Park family and the destitute Kim clan."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:222, properties:{id:"Nedumaaran Rajangam \"Maara\" sets out to make the common man fly and in the process takes on the world's most capital intensive industry and several enemies who stand in his way."}}, {_id:229, properties:{id:"A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival."}}, {_id:248, properties:{id:"In the slums of Rio, two kids' paths diverge as one struggles to become a photographer and the other a kingpin."}}, {_id:255, properties:{id:"During her family's move to the suburbs, a sullen 10-year-old girl wanders into a world ruled by gods, witches, and spirits, and where humans are changed into beasts."}}, {_id:269, properties:{id:"Following the Normandy Landings, a group of U.S. soldiers go behind enemy lines to retrieve a paratrooper whose brothers have been killed in action."}}, {_id:277, properties:{id:"The lives of guards on Death Row are affected by one of their charges: a black man accused of child murder and rape, yet who has a mysterious gift."}}, {_id:281, properties:{id:"When an open-minded Jewish librarian and his son become victims of the Holocaust, he uses a perfect mixture of will, humor, and imagination to protect his son from the dangers around their camp."}}, {_id:296, properties:{id:"Two detectives, a rookie and a veteran, hunt a serial killer who uses the seven deadly sins as his motives."}}, {_id:307, properties:{id:"A young F.B.I. cadet must receive the help of an incarcerated and manipulative cannibal killer to help catch another serial killer, a madman who skins his victims."}}, {_id:314, properties:{id:"Luke Skywalker joins forces with a Jedi Knight, a cocky pilot, a Wookiee and two droids to save the galaxy from the Empire's world-destroying battle station, while also attempting to rescue Princess Leia from the mysterious Darth Vader."}}, {_id:323, properties:{id:"When a ronin requesting seppuku at a feudal lord's palace is told of the brutal suicide of another ronin who previously visited, he reveals how their pasts are intertwined - and in doing so challenges the clan's integrity."}}, {_id:330, properties:{id:"A poor village under attack by bandits recruits seven unemployed samurai to help them defend themselves."}}, {_id:337, properties:{id:"An angel is sent from Heaven to help a desperately frustrated businessman by showing him what life would have been like if he had never existed."}}, {_id:346, properties:{id:"In Gotham City, mentally troubled comedian Arthur Fleck is disregarded and mistreated by society. He then embarks on a downward spiral of revolution and bloody crime. This path brings him face-to-face with his alter-ego: the Joker."}}, {_id:357, properties:{id:"A promising young drummer enrolls at a cut-throat music conservatory where his dreams of greatness are mentored by an instructor who will stop at nothing to realize a student's potential."}}, {_id:376, properties:{id:"After he becomes a quadriplegic from a paragliding accident, an aristocrat hires a young man from the projects to be his caregiver."}}, {_id:381, properties:{id:"After a tragic accident, two stage magicians engage in a battle to create the ultimate illusion while sacrificing everything they have to outwit each other."}}, {_id:386, properties:{id:"An undercover cop and a mole in the police attempt to identify each other while infiltrating an Irish gang in South Boston."}}, {_id:393, properties:{id:"A Polish Jewish musician struggles to survive the destruction of the Warsaw ghetto of World War II."}}, {_id:402, properties:{id:"A former Roman General sets out to exact vengeance against the corrupt emperor who murdered his family and sent him into slavery."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:412, properties:{id:"A former neo-nazi skinhead tries to prevent his younger brother from going down the same wrong path that he did."}}, {_id:426, properties:{id:"A sole survivor tells of the twisty events leading up to a horrific gun battle on a boat, which began when five criminals met at a seemingly random police lineup."}}, {_id:435, properties:{id:"Mathilda, a 12-year-old girl, is reluctantly taken in by Léon, a professional assassin, after her family is murdered. An unusual relationship forms as she becomes his protégée and learns the assassin's trade."}}, {_id:445, properties:{id:"Lion prince Simba and his father are targeted by his bitter uncle, who wants to ascend the throne himself."}}, {_id:453, properties:{id:"A cyborg, identical to the one who failed to kill Sarah Connor, must now protect her teenage son, John Connor, from a more advanced and powerful cyborg."}}, {_id:460, properties:{id:"A filmmaker recalls his childhood when falling in love with the pictures at the cinema of his home village and forms a deep friendship with the cinema's projectionist."}}, {_id:467, properties:{id:"A young boy and his little sister struggle to survive in Japan during World War II."}}, {_id:483, properties:{id:"Marty McFly, a 17-year-old high school student, is accidentally sent thirty years into the past in a time-traveling DeLorean invented by his close friend, the eccentric scientist Doc Brown."}}, {_id:487, properties:{id:"A mysterious stranger with a harmonica joins forces with a notorious desperado to protect a beautiful widow from a ruthless assassin working for the railroad."}}, {_id:505, properties:{id:"A Phoenix secretary embezzles $40,000 from her employer's client, goes on the run, and checks into a remote motel run by a young man under the domination of his mother."}}, {_id:508, properties:{id:"A cynical expatriate American cafe owner struggles to decide whether or not to help his former lover and her fugitive husband escape the Nazis in French Morocco."}}, {_id:519, properties:{id:"The Tramp struggles to live in modern industrial society with the help of a young homeless woman."}}, {_id:534, properties:{id:"With the aid of a wealthy erratic tippler, a dewy-eyed tramp who has fallen in love with a sightless flower girl accumulates money to be able to help her medically."}}, {_id:544, properties:{id:"While serving a five-year sentence for a violent crime, a 12-year-old boy sues his parents for neglect."}}, {_id:556, properties:{id:"In 1950, amid-st the ravages of the Korean War, Sergeant Süleyman stumbles upon a half-frozen little girl, with no parents and no help in sight. Frantic, scared and on the verge of death, ...                See full summary »"}}, {_id:561, properties:{id:"Vikram, a no-nonsense police officer, accompanied by Simon, his partner, is on the hunt to capture Vedha, a smuggler and a murderer. Vedha tries to change Vikram's life, which leads to a conflict."}}, {_id:571, properties:{id:"Two strangers find themselves linked in a bizarre way. When a connection forms, will distance be the only thing to keep them apart?"}}, {_id:576, properties:{id:"Former wrestler Mahavir Singh Phogat and his two wrestler daughters struggle towards glory at the Commonwealth Games in the face of societal oppression."}}, {_id:587, properties:{id:"Teen Miles Morales becomes the Spider-Man of his universe, and must join with five spider-powered individuals from other dimensions to stop a threat for all realities."}}, {_id:597, properties:{id:"After the devastating events of Avengers: Infinity War (2018), the universe is in ruins. With the help of remaining allies, the Avengers assemble once more in order to reverse Thanos' actions and restore balance to the universe."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:605, properties:{id:"The Avengers and their allies must be willing to sacrifice all in an attempt to defeat the powerful Thanos before his blitz of devastation and ruin puts an end to the universe."}}, {_id:610, properties:{id:"Aspiring musician Miguel, confronted with his family's ancestral ban on music, enters the Land of the Dead to find his great-great-grandfather, a legendary singer."}}, {_id:622, properties:{id:"With the help of a German bounty hunter, a freed slave sets out to rescue his wife from a brutal Mississippi plantation owner."}}, {_id:632, properties:{id:"Eight years after the Joker's reign of anarchy, Batman, with the help of the enigmatic Catwoman, is forced from his exile to save Gotham City from the brutal guerrilla terrorist Bane."}}, {_id:634, properties:{id:"Two friends are searching for their long lost companion. They revisit their college days and recall the memories of their friend who inspired them to think differently, even as the rest of the world called them \"idiots\"."}}, {_id:643, properties:{id:"An eight-year-old boy is thought to be a lazy trouble-maker, until the new art teacher has the patience and compassion to discover the real problem behind his struggles in school."}}, {_id:661, properties:{id:"In the distant future, a small waste-collecting robot inadvertently embarks on a space journey that will ultimately decide the fate of mankind."}}, {_id:666, properties:{id:"In 1984 East Berlin, an agent of the secret police, conducting surveillance on a writer and his lover, finds himself becoming increasingly absorbed by their lives."}}, {_id:675, properties:{id:"After being kidnapped and imprisoned for fifteen years, Oh Dae-Su is released, only to find that he must find his captor in five days."}}, {_id:687, properties:{id:"A man with short-term memory loss attempts to track down his wife's murderer."}}, {_id:695, properties:{id:"On a journey to find the cure for a Tatarigami's curse, Ashitaka finds himself in the middle of a war between the forest gods and Tatara, a mining colony. In this quest he also meets San, the Mononoke Hime."}}, {_id:698, properties:{id:"A former Prohibition-era Jewish gangster returns to the Lower East Side of Manhattan over thirty years later, where he once again must confront the ghosts and regrets of his old life."}}, {_id:707, properties:{id:"In 1936, archaeologist and adventurer Indiana Jones is hired by the U.S. government to find the Ark of the Covenant before Adolf Hitler's Nazis can obtain its awesome powers."}}, {_id:721, properties:{id:"A family heads to an isolated hotel for the winter where a sinister presence influences the father into violence, while his psychic son sees horrific forebodings from both past and future."}}, {_id:725, properties:{id:"A U.S. Army officer serving in Vietnam is tasked with assassinating a renegade Special Forces Colonel who sees himself as a god."}}, {_id:736, properties:{id:"After a space merchant vessel receives an unknown transmission as a distress call, one of the crew is attacked by a mysterious life form and they soon realize that its life cycle has merely begun."}}, {_id:744, properties:{id:"The story of a terminally ill man who wishes to live life to the fullest before the inevitable occurs, as told by his best friend."}}, {_id:751, properties:{id:"An executive of a shoe company becomes a victim of extortion when his chauffeur's son is kidnapped and held for ransom."}}, {_id:762, properties:{id:"An insane general triggers a path to nuclear holocaust that a War Room full of politicians and generals frantically tries to stop."}}, {_id:768, properties:{id:"A veteran British barrister must defend his client in a murder trial that has surprise after surprise."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:779, properties:{id:"After refusing to attack an enemy position, a general accuses the soldiers of cowardice and their commanding officer must defend them."}}, {_id:785, properties:{id:"A wheelchair-bound photographer spies on his neighbors from his apartment window and becomes convinced one of them has committed murder."}}, {_id:790, properties:{id:"A screenwriter develops a dangerous relationship with a faded film star determined to make a triumphant return."}}, {_id:801, properties:{id:"Dictator Adenoid Hynkel tries to expand his empire while a poor Jewish barber tries to avoid persecution from Hynkel's regime."}}, {_id:805, properties:{id:"April 6th, 1917. As a regiment assembles to wage war deep in enemy territory, two soldiers are assigned to race against time and deliver a message that will stop 1,600 men from walking straight into a deadly trap."}}, {_id:814, properties:{id:"A mythological story about a goddess who created the entire universe. The plot revolves around the consequences when humans build a temple for her first-born."}}, {_id:830, properties:{id:"A series of mysterious events change the life of a blind pianist, who must now report a crime that he should technically know nothing of."}}, {_id:835, properties:{id:"A man goes to extreme lengths to save his family from punishment after the family commits an accidental crime."}}, {_id:841, properties:{id:"A teacher lives a lonely life, all the while struggling over his son's custody. His life slowly gets better as he finds love and receives good news from his son, but his new luck is about to be brutally shattered by an innocent little lie."}}, {_id:858, properties:{id:"A married couple are faced with a difficult decision - to improve the life of their child by moving to another country or to stay in Iran and look after a deteriorating parent who has Alzheimer's disease."}}, {_id:862, properties:{id:"Twins journey to the Middle East to discover their family history and fulfill their mother's last wishes."}}, {_id:872, properties:{id:"A story of love between a mentally-ill father who was wrongly accused of murder and his lovely six years old daughter. The prison would be their home. Based on the 2013 Korean movie 7-beon-bang-ui seon-mul (2013)."}}, {_id:878, properties:{id:"The family of a left-wing journalist is torn apart after the military coup of Turkey in 1980."}}, {_id:890, properties:{id:"In Nazi-occupied France during World War II, a plan to assassinate Nazi leaders by a group of Jewish U.S. soldiers coincides with a theatre owner's vengeful plans for the same."}}, {_id:893, properties:{id:"When their relationship turns sour, a couple undergoes a medical procedure to have each other erased from their memories."}}, {_id:912, properties:{id:"Amélie is an innocent and naive girl in Paris with her own sense of justice. She decides to help those around her and, along the way, discovers love."}}, {_id:920, properties:{id:"Unscrupulous boxing promoters, violent bookmakers, a Russian gangster, incompetent amateur robbers and supposedly Jewish jewelers fight to track down a priceless stolen diamond."}}, {_id:921, properties:{id:"The drug-induced utopias of four Coney Island people are shattered when their addictions run deep."}}, {_id:930, properties:{id:"A sexually frustrated suburban father has a mid-life crisis after becoming infatuated with his daughter's best friend."}}, {_id:938, properties:{id:"Will Hunting, a janitor at M.I.T., has a gift for mathematics, but needs help from a psychologist to find direction in his life."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:952, properties:{id:"After a boy loses his sister's pair of shoes, he goes on a series of adventures in order to find them. When he can't, he tries a new way to \"win\" a new pair."}}, {_id:955, properties:{id:"A cowboy doll is profoundly threatened and jealous when a new spaceman figure supplants him as top toy in a boy's room."}}, {_id:965, properties:{id:"Scottish warrior William Wallace leads his countrymen in a rebellion to free his homeland from the tyranny of King Edward I of England."}}, {_id:975, properties:{id:"When a simple jewelry heist goes horribly wrong, the surviving criminals begin to suspect that one of them is a police informant."}}, {_id:983, properties:{id:"A pragmatic U.S. Marine observes the dehumanizing effects the Vietnam War has on his fellow recruits from their brutal boot camp training to the bloody street fighting in Hue."}}, {_id:992, properties:{id:"After finding an old rifle, a young boy joins the Soviet resistance movement against ruthless German forces and experiences the horrors of World War II."}}, {_id:1000, properties:{id:"Fifty-seven years after surviving an apocalyptic attack aboard her space vessel by merciless space creatures, Officer Ripley awakens from hyper-sleep and tries to warn anyone who will listen about the predators."}}, {_id:1012, properties:{id:"The life, success and troubles of Wolfgang Amadeus Mozart, as told by Antonio Salieri, the contemporaneous composer who was insanely jealous of Mozart's talent and claimed to have murdered him."}}, {_id:1016, properties:{id:"In 1980 Miami, a determined Cuban immigrant takes over a drug cartel and succumbs to greed."}}, {_id:1028, properties:{id:"After a daring mission to rescue Han Solo from Jabba the Hutt, the Rebels dispatch to Endor to destroy the second Death Star. Meanwhile, Luke struggles to help Darth Vader back from the dark side without falling into the Emperor's trap."}}, {_id:1037, properties:{id:"The claustrophobic world of a WWII German U-boat; boredom, filth and sheer terror."}}, {_id:1044, properties:{id:"A mentally unstable veteran works as a nighttime taxi driver in New York City, where the perceived decadence and sleaze fuels his urge for violent action by attempting to liberate a presidential campaign worker and an underage prostitute."}}, {_id:1055, properties:{id:"Two grifters team up to pull off the ultimate con."}}, {_id:1058, properties:{id:"In the future, a sadistic gang leader is imprisoned and volunteers for a conduct-aversion experiment, but it doesn't go as planned."}}, {_id:1068, properties:{id:"After discovering a mysterious artifact buried beneath the Lunar surface, mankind sets off on a quest to find its origins with help from intelligent supercomputer H.A.L. 9000."}}, {_id:1075, properties:{id:"Two bounty hunters with the same intentions team up to track down a Western outlaw."}}, {_id:1084, properties:{id:"The story of T.E. Lawrence, the English officer who successfully united and led the diverse, often warring, Arab tribes during World War I in order to fight the Turks."}}, {_id:1090, properties:{id:"A man tries to rise in his company by letting its executives use his apartment for trysts, but complications and a romance of his own ensue."}}, {_id:1097, properties:{id:"A New York City advertising executive goes on the run after being mistaken for a government agent by a group of foreign spies."}}, {_id:1109, properties:{id:"A former police detective juggles wrestling with his personal demons and becoming obsessed with a hauntingly beautiful woman."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1123, properties:{id:"A silent film production company and cast make a difficult transition to sound."}}, {_id:1126, properties:{id:"A bureaucrat tries to find a meaning in his life after he discovers he has terminal cancer."}}, {_id:1134, properties:{id:"In post-war Italy, a working-class man's bicycle is stolen. He and his son set out to find it."}}, {_id:1149, properties:{id:"An insurance representative lets himself be talked by a seductive housewife into a murder/insurance fraud scheme that arouses the suspicion of an insurance investigator."}}, {_id:1152, properties:{id:"Following the death of publishing tycoon Charles Foster Kane, reporters scramble to uncover the meaning of his final utterance; 'Rosebud'."}}, {_id:1164, properties:{id:"When the police in a German city are unable to catch a child-murderer, other criminals join in the manhunt."}}, {_id:1177, properties:{id:"In a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a savior to mediate their differences."}}, {_id:1185, properties:{id:"The Tramp cares for an abandoned child, but events put that relationship in jeopardy."}}, {_id:1193, properties:{id:"A tragic incident forces Anirudh, a middle-aged man, to take a trip down memory lane and reminisce his college days along with his friends, who were labelled as losers."}}, {_id:1198, properties:{id:"Indian army special forces execute a covert operation, avenging the killing of fellow army men at their base by a terrorist group."}}, {_id:1211, properties:{id:"In the 1970s, a fierce rebel rises against brutal oppression and becomes the symbol of hope to legions of downtrodden people."}}, {_id:1222, properties:{id:"A working-class Italian-American bouncer becomes the driver of an African-American classical pianist on a tour of venues through the 1960s American South."}}, {_id:1226, properties:{id:"A mother personally challenges the local authorities to solve her daughter's murder when they fail to catch the culprit."}}, {_id:1233, properties:{id:"An experienced investigator confronts several conflicting theories about the perpetrators of a violent double homicide."}}, {_id:1250, properties:{id:"When Shiva, the son of Bahubali, learns about his heritage, he begins to look for answers. His story is juxtaposed with past events that unfolded in the Mahishmati Kingdom."}}, {_id:1254, properties:{id:"A simple act of kindness always sparks another, even in a frozen, faraway place. When Smeerensburg's new postman, Jesper, befriends toymaker Klaus, their gifts melt an age-old feud and deliver a sleigh full of holiday traditions."}}, {_id:1263, properties:{id:"Desperate measures are taken by a man who tries to save his family from the dark side of the law, after they commit an unexpected crime."}}, {_id:1274, properties:{id:"A Delhi girl from a traditional family sets out on a solo honeymoon after her marriage gets cancelled."}}, {_id:1277, properties:{id:"In 1992, war rages in Abkhazia, a breakaway region of Georgia. An Estonian man Ivo has decided to stay behind and harvest his crops of tangerines. In a bloody conflict at his door, a wounded man is left behind, and Ivo takes him in."}}, {_id:1289, properties:{id:"The truth behind the ascension of Milkha Singh who was scarred because of the India-Pakistan partition."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1295, properties:{id:"A clash between Sultan and Shahid Khan leads to the expulsion of Khan from Wasseypur, and ignites a deadly blood feud spanning three generations."}}, {_id:1307, properties:{id:"Expelled from his school, a 16-year old boy returns home to his abusive and oppressive father."}}, {_id:1318, properties:{id:"The story of Paan Singh Tomar, an Indian athlete and seven-time national steeplechase champion who becomes one of the most feared dacoits in Chambal Valley after his retirement."}}, {_id:1324, properties:{id:"A retired legal counselor writes a novel hoping to find closure for one of his past unresolved homicide cases and for his unreciprocated love with his superior - both of which still haunt him decades later."}}, {_id:1332, properties:{id:"The youngest son of an alcoholic former boxer returns home, where he's trained by his father for competition in a mixed martial arts tournament - a path that puts the fighter on a collision course with his estranged, older brother."}}, {_id:1339, properties:{id:"In 1954, a U.S. Marshal investigates the disappearance of a murderer who escaped from a hospital for the criminally insane."}}, {_id:1345, properties:{id:"78-year-old Carl Fredricksen travels to Paradise Falls in his house equipped with balloons, inadvertently taking a young stowaway."}}, {_id:1355, properties:{id:"Based on the true story of Jordan Belfort, from his rise to a wealthy stock-broker living the high life to his fall involving crime, corruption and the federal government."}}, {_id:1366, properties:{id:"Kabir Khan is the coach of the Indian Women's National Hockey Team and his dream is to make his all girls team emerge victorious against all odds."}}, {_id:1375, properties:{id:"A story of family, religion, hatred, oil and madness, focusing on a turn-of-the-century prospector in the early days of the business."}}, {_id:1379, properties:{id:"In the Falangist Spain of 1944, the bookish young stepdaughter of a sadistic army officer escapes into an eerie but captivating fantasy world."}}, {_id:1389, properties:{id:"The toys are mistakenly delivered to a day-care center instead of the attic right before Andy leaves for college, and it's up to Woody to convince the other toys that they weren't abandoned and to return home."}}, {_id:1401, properties:{id:"In a future British tyranny, a shadowy freedom fighter, known only by the alias of \"V\", plots to overthrow it with the help of a young woman."}}, {_id:1406, properties:{id:"The story of six young Indians who assist an English woman to film a documentary on the freedom fighters from their past, and the events that lead them to relive the long-forgotten saga of freedom."}}, {_id:1412, properties:{id:"The cathartic tale of a young woman who can't see, hear or talk and the teacher who brings a ray of light into her dark world."}}, {_id:1416, properties:{id:"After training with his mentor, Batman begins his fight to free crime-ridden Gotham City from corruption."}}, {_id:1420, properties:{id:"A successful Indian scientist returns to an Indian village to take his nanny to America with him and in the process rediscovers his roots."}}, {_id:1429, properties:{id:"Traudl Junge, the final secretary for Adolf Hitler, tells of the Nazi dictator's final days in his Berlin bunker at the end of WWII."}}, {_id:1440, properties:{id:"When an unconfident young woman is cursed with an old body by a spiteful witch, her only chance of breaking the spell lies with a self-indulgent yet insecure young wizard and his companions in his legged, walking castle."}}, {_id:1450, properties:{id:"After John Nash, a brilliant but asocial mathematician, accepts secret work in cryptography, his life takes a turn for the nightmarish."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1456, properties:{id:"Three unemployed men look for answers to all their money problems - but when their opportunity arrives, will they know what to do with it?"}}, {_id:1460, properties:{id:"A botched card game in London triggers four friends, thugs, weed-growers, hard gangsters, loan sharks and debt collectors to collide with each other in a series of unexpected events, all for the sake of weed, cash and two antique shotguns."}}, {_id:1468, properties:{id:"As corruption grows in 1950s Los Angeles, three policemen - one strait-laced, one brutal, and one sleazy - investigate a series of murders with their own brand of justice."}}, {_id:1477, properties:{id:"Baran the Bandit, released from prison after 35 years, searches for vengeance and his lover."}}, {_id:1482, properties:{id:"A group of professional bank robbers start to feel the heat from police when they unknowingly leave a clue at their latest heist."}}, {_id:1492, properties:{id:"A tale of greed, deception, money, power, and murder occur between two best friends: a mafia enforcer and a casino executive compete against each other over a gambling empire, and over a fast-living and fast-loving socialite."}}, {_id:1496, properties:{id:"Two slackers competing for the affections of an heiress inadvertently become her protectors from an evil criminal."}}, {_id:1504, properties:{id:"Retired Old West gunslinger William Munny reluctantly takes on one last job, with the help of his old partner Ned Logan and a young man, The \"Schofield Kid.\""}}, {_id:1507, properties:{id:"In 1938, after his father Professor Henry Jones, Sr. goes missing while pursuing the Holy Grail, Professor Henry \"Indiana\" Jones, Jr. finds himself up against Adolf Hitler's Nazis again to stop them from obtaining its powers."}}, {_id:1515, properties:{id:"In this luminous tale set in the area around Sarajevo and in Italy, Perhan, an engaging young Romany (gypsy) with telekinetic powers, is seduced by the quick-cash world of petty crime, which threatens to destroy him and those he loves."}}, {_id:1528, properties:{id:"When two girls move to the country to be near their ailing mother, they have adventures with the wondrous forest spirits who live nearby."}}, {_id:1538, properties:{id:"An NYPD officer tries to save his wife and several others taken hostage by German terrorists during a Christmas party at the Nakatomi Plaza in Los Angeles."}}, {_id:1545, properties:{id:"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them and cause them to turn on each other...and him."}}, {_id:1550, properties:{id:"The life of boxer Jake LaMotta, whose violence and temper that led him to the top in the ring destroyed his life outside of it."}}, {_id:1557, properties:{id:"A guide leads two men through an area known as the Zone to find a room that grants wishes."}}, {_id:1564, properties:{id:"A married daughter who longs for her mother's love is visited by the latter, a successful concert pianist."}}, {_id:1575, properties:{id:"This epic historical drama chronicles the life and times of Prophet Muhammad and serves as an introduction to early Islamic history."}}, {_id:1582, properties:{id:"After his family is murdered by a notorious and ruthless bandit, a former police officer enlists the services of two outlaws to capture the bandit."}}, {_id:1588, properties:{id:"King Arthur and his Knights of the Round Table embark on a surreal, low-budget search for the Holy Grail, encountering many, very silly obstacles."}}, {_id:1602, properties:{id:"Allied prisoners of war plan for several hundred of their number to escape from a German camp during World War II."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1611, properties:{id:"Atticus Finch, a lawyer in the Depression-era South, defends a black man against an undeserved rape charge, and his children against prejudice."}}, {_id:1617, properties:{id:"A crafty ronin comes to a town divided by two criminal gangs and decides to play them against each other to free the town."}}, {_id:1626, properties:{id:"In 1948, an American court in occupied Germany tries four Nazis judged for war crimes."}}, {_id:1628, properties:{id:"After two male musicians witness a mob hit, they flee the state in an all-female band disguised as women, but further complications set in."}}, {_id:1641, properties:{id:"After living a life marked by coldness, an aging professor is forced to confront the emptiness of his existence."}}, {_id:1645, properties:{id:"A man seeks answers about life, death, and the existence of God as he plays chess against the Grim Reaper during the Black Plague."}}, {_id:1657, properties:{id:"Four men plan a technically perfect crime, but the human element intervenes..."}}, {_id:1659, properties:{id:"A former tennis player tries to arrange his wife's murder after learning of her affair."}}, {_id:1669, properties:{id:"An old couple visit their children and grandchildren in the city, but receive little attention."}}, {_id:1675, properties:{id:"The rape of a bride and the murder of her samurai husband are recalled from the perspectives of a bandit, the bride, the samurai's ghost and a woodcutter."}}, {_id:1682, properties:{id:"A seemingly timid but secretly ruthless ingénue insinuates herself into the lives of an aging Broadway star and her circle of theater friends."}}, {_id:1693, properties:{id:"Two Americans searching for work in Mexico convince an old prospector to help them mine for gold in the Sierra Madre Mountains."}}, {_id:1701, properties:{id:"During the Nazi occupation of Poland, an acting troupe becomes embroiled in a Polish soldier's efforts to track down a German spy."}}, {_id:1706, properties:{id:"A prospector goes to the Klondike in search of gold and finds it and more."}}, {_id:1718, properties:{id:"A film projectionist longs to be a detective, and puts his meagre skills to work when he is framed by a rival for stealing his girlfriend's father's pocketwatch."}}, {_id:1727, properties:{id:"On an isolated island in Brittany at the end of the eighteenth century, a female painter is obliged to paint a wedding portrait of a young woman."}}, {_id:1739, properties:{id:"When three young women are implicated in a crime, a retired lawyer steps forward to help them clear their names."}}, {_id:1745, properties:{id:"A young man is ostracized by his classmates after he bullies a deaf girl to the point where she moves away. Years later, he sets off on a path for redemption."}}, {_id:1753, properties:{id:"A successful entrepreneur accused of murder and a witness preparation expert have less than three hours to come up with an impregnable defense."}}, {_id:1762, properties:{id:"A woman is hired as a handmaiden to a Japanese heiress, but secretly she is involved in a plot to defraud her."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1765, properties:{id:"A widowed single mother, raising her violent son alone, finds new hope when a mysterious neighbor inserts herself into their household."}}, {_id:1773, properties:{id:"A young man returns to Kashmir after his father's disappearance to confront his uncle, whom he suspects of playing a role in his father's fate."}}, {_id:1782, properties:{id:"In a future where mutants are nearly extinct, an elderly and weary Logan leads a quiet life. But when Laura, a mutant child pursued by scientists, comes to him for help, he must get her to safety."}}, {_id:1789, properties:{id:"Held captive for 7 years in an enclosed space, a woman and her young son finally gain their freedom, allowing the boy to experience the outside world for the first time."}}, {_id:1802, properties:{id:"Six short stories that explore the extremities of human behavior involving people in distress."}}, {_id:1808, properties:{id:"After landing the gig of a lifetime, a New York jazz pianist suddenly finds himself trapped in a strange land between Earth and the afterlife."}}, {_id:1818, properties:{id:"A hotel owner and landlord in a remote Turkish village deals with conflicts within his family and a tenant behind on his rent."}}, {_id:1825, properties:{id:"An alien on Earth loses the only device he can use to communicate with his spaceship. His innocent nature and child-like questions force the country to evaluate the impact of religion on its people."}}, {_id:1832, properties:{id:"A shopkeeper takes God to court when his shop is destroyed by an earthquake."}}, {_id:1841, properties:{id:"A writer encounters the owner of an aging high-class hotel, who tells him of his early years serving as a lobby boy in the hotel's glorious years under an exceptional concierge."}}, {_id:1842, properties:{id:"With his wife's disappearance having become the focus of an intense media circus, a man sees the spotlight turned on him when it's suspected that he may not be innocent."}}, {_id:1849, properties:{id:"After her werewolf lover unexpectedly dies in an accident while hunting for food for their children, a young woman must find ways to raise the werewolf son and daughter that she had with him while keeping their trait hidden from society."}}, {_id:1863, properties:{id:"World War II American Army Medic Desmond T. Doss, who served during the Battle of Okinawa, refuses to kill people, and becomes the first man in American history to receive the Medal of Honor without firing a shot."}}, {_id:1865, properties:{id:"After young Riley is uprooted from her Midwest life and moved to San Francisco, her emotions - Joy, Fear, Anger, Disgust and Sadness - conflict on how best to navigate a new city, house, and school."}}, {_id:1877, properties:{id:"Three young people learn that love can neither be defined nor contained by society's definition of normal and abnormal."}}, {_id:1886, properties:{id:"In the antebellum United States, Solomon Northup, a free black man from upstate New York, is abducted and sold into slavery."}}, {_id:1892, properties:{id:"The merciless 1970s rivalry between Formula One rivals James Hunt and Niki Lauda."}}, {_id:1901, properties:{id:"American car designer Carroll Shelby and driver Ken Miles battle corporate interference and the laws of physics to build a revolutionary race car for Ford in order to defeat Ferrari at the 24 Hours of Le Mans in 1966."}}, {_id:1902, properties:{id:"The true story of how the Boston Globe uncovered the massive scandal of child molestation and cover-up within the local Catholic Archdiocese, shaking the entire Catholic Church to its core."}}, {_id:1919, properties:{id:"Ben, a young Irish boy, and his little sister Saoirse, a girl who can turn into a seal, go on an adventure to free the fairies and save the spirit world."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:1924, properties:{id:"A pregnant woman's search for her missing husband takes her from London to Kolkata, but everyone she questions denies having ever met him."}}, {_id:1933, properties:{id:"Three friends decide to turn their fantasy vacation into reality after one of their friends gets engaged."}}, {_id:1939, properties:{id:"When Keller Dover's daughter and her friend go missing, he takes matters into his own hands as the police pursue multiple leads and the pressure mounts."}}, {_id:1948, properties:{id:"In a post-apocalyptic wasteland, a woman rebels against a tyrannical ruler in search for her homeland with the aid of a group of female prisoners, a psychotic worshiper, and a drifter named Max."}}, {_id:1952, properties:{id:"A retiring police officer reminisces about the most astounding day of his career. About a case that was never filed but continues to haunt him in his memories - the case of a man and a Wednesday."}}, {_id:1962, properties:{id:"Disgruntled Korean War veteran Walt Kowalski sets out to reform his neighbor, Thao Lor, a Hmong teenager who tried to steal Kowalski's prized possession: a 1972 Gran Torino."}}, {_id:1974, properties:{id:"Harry, Ron, and Hermione search for Voldemort's remaining Horcruxes in their effort to destroy the Dark Lord as the final battle rages on at Hogwarts."}}, {_id:1977, properties:{id:"A newly unemployed cellist takes a job preparing the dead for funerals."}}, {_id:1986, properties:{id:"A college professor bonds with an abandoned dog he takes into his home."}}, {_id:1998, properties:{id:"A tale of friendship between two unlikely pen pals: Mary, a lonely, eight-year-old girl living in the suburbs of Melbourne, and Max, a forty-four-year old, severely obese man living in New York."}}, {_id:2004, properties:{id:"A hapless young Viking who aspires to hunt dragons becomes the unlikely friend of a young dragon himself, and learns there may be more to the creatures than he assumed."}}, {_id:2013, properties:{id:"After graduating from Emory University, top student and athlete Christopher McCandless abandons his possessions, gives his entire $24,000 savings account to charity and hitchhikes to Alaska to live in the wilderness. Along the way, Christopher encounters a series of characters that shape his life."}}, {_id:2028, properties:{id:"Violence and mayhem ensue after a hunter stumbles upon a drug deal gone wrong and more than two million dollars in cash near the Rio Grande."}}, {_id:2032, properties:{id:"Munna Bhai embarks on a journey with Mahatma Gandhi in order to fight against a corrupt property dealer."}}, {_id:2039, properties:{id:"A determined woman works with a hardened boxing trainer to become a professional."}}, {_id:2041, properties:{id:"Paul Rusesabagina, a hotel manager, houses over a thousand Tutsi refugees during their struggle against the Hutu militia in Rwanda, Africa."}}, {_id:2051, properties:{id:"When two brothers are forced to fight in the Korean War, the elder decides to take the riskiest missions if it will help shield the younger from battle."}}, {_id:2065, properties:{id:"Nine years after Jesse and Celine first met, they encounter each other again on the French leg of Jesse's book tour."}}, {_id:2067, properties:{id:"A gangster sets out to fulfill his father's dream of becoming a doctor."}}, {_id:2074, properties:{id:"In a small Korean province in 1986, two detectives struggle with the case of multiple young women being found raped and murdered by an unknown culprit."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2081, properties:{id:"Three inseparable childhood friends are just out of college. Nothing comes between them - until they each fall in love, and their wildly different approaches to relationships creates tension."}}, {_id:2090, properties:{id:"After awakening from a four-year coma, a former assassin wreaks vengeance on the team of assassins who betrayed her."}}, {_id:2101, properties:{id:"After his son is captured in the Great Barrier Reef and taken to Sydney, a timid clownfish sets out on a journey to bring him home."}}, {_id:2106, properties:{id:"Barely 21 yet, Frank is a skilled forger who has passed as a doctor, lawyer and pilot. FBI agent Carl becomes obsessed with tracking down the con man, who only revels in the pursuit."}}, {_id:2108, properties:{id:"A horrific car accident connects three stories, each involving characters dealing with loss, regret, and life's harsh realities, all in the name of love."}}, {_id:2122, properties:{id:"In order to power the city, monsters have to scare children so that they scream. However, the children are toxic to the monsters, and after a child gets through, 2 monsters realize things may not be what they think."}}, {_id:2125, properties:{id:"Concurrent theatrical ending of the TV series Shin seiki evangerion (1995)."}}, {_id:2135, properties:{id:"The people of a small village in Victorian India stake their future on a game of cricket against their ruthless British rulers."}}, {_id:2139, properties:{id:"A boy who communicates with spirits seeks the help of a disheartened child psychologist."}}, {_id:2150, properties:{id:"A baby boy, discovered in 1900 on an ocean liner, grows into a musical prodigy, never setting foot on land."}}, {_id:2157, properties:{id:"An insurance salesman discovers his whole life is actually a reality TV show."}}, {_id:2159, properties:{id:"Matko and his son Zare live on the banks of the Danube river and get by through hustling and basically doing anything to make a living. In order to pay off a business debt Matko agrees to marry off Zare to the sister of a local gangster."}}, {_id:2174, properties:{id:"Jeff \"The Dude\" Lebowski, mistaken for a millionaire of the same name, seeks restitution for his ruined rug and enlists his bowling buddies to help get it."}}, {_id:2175, properties:{id:"Two neighbors, a woman and a man, form a strong bond after both suspect extramarital activities of their spouses. However, they agree to keep their bond platonic so as not to commit similar wrongs."}}, {_id:2189, properties:{id:"Renton, deeply immersed in the Edinburgh drug scene, tries to clean up and get out, despite the allure of the drugs and influence of friends."}}, {_id:2198, properties:{id:"Jerry Lundegaard's inept crime falls apart due to his and his henchmen's bungling and the persistent police work of the quite pregnant Marge Gunderson."}}, {_id:2199, properties:{id:"A group of Serbian socialists prepares for the war in a surreal underground filled by parties, tragedies, love and hate."}}, {_id:2211, properties:{id:"24 hours in the lives of three young men in the French suburbs the day after a violent riot."}}, {_id:2217, properties:{id:"When Raj meets Simran in Europe, it isn't love at first sight but when Simran moves to India for an arranged marriage, love makes its presence felt."}}, {_id:2224, properties:{id:"A young man and woman meet on a train in Europe, and wind up spending one evening together in Vienna. Unfortunately, both know that this will probably be their only night together."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2236, properties:{id:"A model discovers a retired judge is keen on invading people's privacy."}}, {_id:2239, properties:{id:"Two melancholy Hong Kong policemen fall in love: one with a mysterious female underworld figure, the other with a beautiful and ethereal server at a late-night restaurant he frequents."}}, {_id:2246, properties:{id:"A pragmatic paleontologist visiting an almost complete theme park is tasked with protecting a couple of kids after a power failure causes the park's cloned dinosaurs to run loose."}}, {_id:2256, properties:{id:"A man's coerced confession to an I.R.A. bombing he did not commit results in the imprisonment of his father as well. An English lawyer fights to free them."}}, {_id:2266, properties:{id:"Two boys meet at an opera training school in Peking in 1924. Their resulting friendship will span nearly 70 years and will endure some of the most troublesome times in China's history."}}, {_id:2270, properties:{id:"A young woman becomes the fourth wife of a wealthy lord, and must learn to live with the strict rules and tensions within the household."}}, {_id:2279, properties:{id:"Maverick teacher John Keating uses poetry to embolden his boarding school students to new heights of self-expression."}}, {_id:2286, properties:{id:"After the death of one of his friends, a writer recounts a childhood journey with his friends to find the body of a missing boy."}}, {_id:2293, properties:{id:"Chris Taylor, a neophyte recruit in Vietnam, finds himself caught in a battle of wills between two sergeants, one good and the other evil. A shrewd examination of the brutality of war and the duality of man in conflict."}}, {_id:2306, properties:{id:"Travis Henderson, an aimless drifter who has been missing for four years, wanders out of the desert and must reconnect with society, himself, his life, and his family."}}, {_id:2311, properties:{id:"Warrior and pacifist Princess Nausicaä desperately struggles to prevent two warring nations from destroying themselves and their dying planet."}}, {_id:2324, properties:{id:"A research team in Antarctica is hunted by a shape-shifting alien that assumes the appearance of its victims."}}, {_id:2335, properties:{id:"A confined but troubled rock star descends into madness in the midst of his physical and social isolation from everyone."}}, {_id:2343, properties:{id:"The story of Brian Sweeney Fitzgerald, an extremely determined man who intends to build an opera house in the middle of a jungle."}}, {_id:2347, properties:{id:"Two young Swedish children experience the many comedies and tragedies of their family, the Ekdahls."}}, {_id:2355, properties:{id:"A blade runner must pursue and terminate four replicants who stole a ship in space, and have returned to Earth to find their creator."}}, {_id:2361, properties:{id:"A Victorian surgeon rescues a heavily disfigured man who is mistreated while scraping a living as a side-show freak. Behind his monstrous façade, there is revealed a person of kindness, intelligence and sophistication."}}, {_id:2366, properties:{id:"Born on the original Christmas in the stable next door to Jesus Christ, Brian of Nazareth spends his life being mistaken for a messiah."}}, {_id:2376, properties:{id:"An in-depth examination of the ways in which the U.S. Vietnam War impacts and disrupts the lives of people in a small industrial town in Pennsylvania."}}, {_id:2385, properties:{id:"A small-time boxer gets a supremely rare chance to fight a heavy-weight champion in a bout in which he strives to go the distance for his self-respect."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2393, properties:{id:"A television network cynically exploits a deranged former anchor's ravings and revelations about the news media for its own profit."}}, {_id:2399, properties:{id:"An Irish rogue wins the heart of a rich widow and assumes her dead husband's aristocratic position in 18th-century England."}}, {_id:2404, properties:{id:"A dying man in his forties remembers his past. His childhood, his mother, the war, personal moments and things that tell of the recent history of all the Russian nation."}}, {_id:2410, properties:{id:"A private detective hired to expose an adulterer finds himself caught up in a web of deceit, corruption, and murder."}}, {_id:2417, properties:{id:"During the Great Depression, a con man finds himself saddled with a young girl who may or may not be his daughter, and the two forge an unlikely partnership."}}, {_id:2424, properties:{id:"When a woman dying of cancer in early twentieth-century Sweden is visited by her two sisters, long-repressed feelings between the siblings rise to the surface."}}, {_id:2436, properties:{id:"A psychologist is sent to a station orbiting a distant planet in order to discover what has caused the crew to go insane."}}, {_id:2445, properties:{id:"After professional hitman Jef Costello is seen by witnesses his efforts to provide himself an alibi drive him further into a corner."}}, {_id:2454, properties:{id:"A laid back Southern man is sentenced to two years in a rural prison, but refuses to conform."}}, {_id:2456, properties:{id:"A nurse is put in charge of a mute actress and finds that their personae are melding together."}}, {_id:2463, properties:{id:"The life, times and afflictions of the fifteenth-century Russian iconographer St. Andrei Rublev."}}, {_id:2470, properties:{id:"In the 1950s, fear and violence escalate as the people of Algiers fight for independence from the French government."}}, {_id:2477, properties:{id:"The guests at an upper-class dinner party find themselves unable to leave."}}, {_id:2489, properties:{id:"A former child star torments her paraplegic sister in their decaying Hollywood mansion."}}, {_id:2493, properties:{id:"A crafty samurai helps a young man and his fellow clansmen save his uncle, who has been framed and imprisoned by a corrupt superintendent."}}, {_id:2498, properties:{id:"A senator returns to a western town for the funeral of an old friend and tells the story of his origins."}}, {_id:2509, properties:{id:"In WW2, twelve year old Soviet orphan Ivan Bondarev works for the Soviet army as a scout behind the German lines and strikes a friendship with three sympathetic Soviet officers."}}, {_id:2514, properties:{id:"An innocent yet pampered young virgin and her family's pregnant and jealous servant set out to deliver candles to church, but only one returns from events that transpire in the woods along the way."}}, {_id:2518, properties:{id:"Based on a real-life case in 1925, two great lawyers argue the case for and against a science teacher accused of the crime of teaching evolution."}}, {_id:2523, properties:{id:"A young boy, left without attention, delves into a life of petty crime."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2534, properties:{id:"After a Jewish prince is betrayed and sent into slavery by a Roman friend, he regains his freedom and comes back for revenge."}}, {_id:2540, properties:{id:"Lured by gold, two greedy peasants unknowingly escort a princess and her general across enemy lines."}}, {_id:2551, properties:{id:"A waifish prostitute wanders the streets of Rome looking for true love but finds only heartbreak."}}, {_id:2554, properties:{id:"A war-hardened general, egged on by his ambitious wife, works to fulfill a prophecy that he would become lord of Spider's Web Castle."}}, {_id:2558, properties:{id:"British POWs are forced to build a railway bridge across the river Kwai for their Japanese captors, not knowing that the allied forces are planning to destroy it."}}, {_id:2568, properties:{id:"An ex-prize fighter turned longshoreman struggles to stand up to his corrupt union bosses."}}, {_id:2571, properties:{id:"In a decrepit South American village, four men are hired to transport an urgent nitroglycerine shipment without the equipment that would make it safe."}}, {_id:2581, properties:{id:"A frustrated former big-city journalist now stuck working for an Albuquerque newspaper exploits a story about a man trapped in a cave to rekindle his career, but the situation quickly escalates into an out-of-control circus."}}, {_id:2585, properties:{id:"A psychopathic criminal with a mother complex makes a daring break from prison and leads his old gang in a chemical plant payroll heist."}}, {_id:2598, properties:{id:"Pulp novelist Holly Martins travels to shadowy, postwar Vienna, only to find himself investigating the mysterious death of an old friend, Harry Lime."}}, {_id:2602, properties:{id:"A young ballet dancer is torn between the man she loves and her pursuit to become a prima ballerina."}}, {_id:2610, properties:{id:"Two employees at a gift shop can barely stand each other, without realizing that they are falling in love through the post as each other's anonymous pen pal."}}, {_id:2617, properties:{id:"A self-conscious woman juggles adjusting to her new role as an aristocrat's wife and avoiding being intimidated by his first wife's spectral presence."}}, {_id:2624, properties:{id:"A naive man is appointed to fill a vacancy in the United States Senate. His plans promptly collide with political corruption, but he doesn't back down."}}, {_id:2629, properties:{id:"A manipulative woman and a roguish man conduct a turbulent romance during the American Civil War and Reconstruction periods."}}, {_id:2643, properties:{id:"During WWI, two French soldiers are captured and imprisoned in a German P.O.W. camp. Several escape attempts follow until they are eventually sent to a seemingly inescapable fortress."}}, {_id:2653, properties:{id:"A renegade reporter and a crazy young heiress meet on a bus heading for New York, and end up stuck with each other when the bus leaves them behind at one of the stops."}}, {_id:2664, properties:{id:"In 1431, Jeanne d'Arc is placed on trial on charges of heresy. The ecclesiastical jurists attempt to force Jeanne to recant her claims of holy visions."}}, {_id:2668, properties:{id:"The Tramp finds work and the girl of his dreams at a circus."}}, {_id:2675, properties:{id:"An allegorical tale about a man fighting the good and evil within him. Both sides are made flesh - one a sophisticated woman he is attracted to and the other his wife."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2683, properties:{id:"When Union spies steal an engineer's beloved locomotive, he pursues it single-handedly and straight through enemy lines."}}, {_id:2699, properties:{id:"Hypnotist Dr. Caligari uses a somnambulist, Cesare, to commit murders."}}, {_id:2706, properties:{id:"A man is embarrassed when he finds out his mother is pregnant."}}, {_id:2708, properties:{id:"The story of Togo, the sled dog who led the 1925 serum run yet was considered by most to be too small and weak to lead such an intense race."}}, {_id:2716, properties:{id:"When Iraq invades Kuwait in August 1990, a callous Indian businessman becomes the spokesperson for more than 170,000 stranded countrymen."}}, {_id:2722, properties:{id:"An Indian man with a magnanimous heart takes a young mute Pakistani girl back to her homeland to reunite her with her family."}}, {_id:2731, properties:{id:"An elite counter-intelligence unit learns of a plot, masterminded by a maniacal madman. With the clock ticking, it's up to them to track the terrorists' international tentacles and prevent them from striking at the heart of India."}}, {_id:2738, properties:{id:"While navigating their careers in Los Angeles, a pianist and an actress fall in love while attempting to reconcile their aspirations for the future."}}, {_id:2744, properties:{id:"A five-year-old Indian boy is adopted by an Australian couple after getting lost hundreds of kilometers from home. 25 years later, he sets out to find his lost family."}}, {_id:2750, properties:{id:"An astronaut becomes stranded on Mars after his team assume him dead, and must rely on his ingenuity to find a way to signal to Earth that he is alive."}}, {_id:2761, properties:{id:"In a city of anthropomorphic animals, a rookie bunny cop and a cynical con artist fox must work together to uncover a conspiracy."}}, {_id:2765, properties:{id:"In ancient India, an adventurous and daring man becomes involved in a decades-old feud between two warring peoples."}}, {_id:2771, properties:{id:"Found inside a shining stalk of bamboo by an old bamboo cutter and his wife, a tiny girl grows rapidly into an exquisite young lady. The mysterious young princess enthralls all who encounter her, but ultimately she must confront her fate, the punishment for her crime."}}, {_id:2784, properties:{id:"Based on the New York Times bestseller, this movie tells the incredibly inspiring and heartwarming story of August Pullman, a boy with facial differences who enters the fifth grade, attending a mainstream elementary school for the first time."}}, {_id:2791, properties:{id:"A coming-of-age story based on the lives of street rappers in Mumbai."}}, {_id:2795, properties:{id:"A gang of con-men rob prominent rich businessmen and politicians by posing as C.B.I and income tax officers."}}, {_id:2804, properties:{id:"A 20-something supervising staff member of a residential treatment facility navigates the troubled waters of that world alongside her co-worker and longtime boyfriend."}}, {_id:2813, properties:{id:"Only a short time after the first raid, Rama goes undercover with the thugs of Jakarta and plans to bring down the syndicate and uncover the corruption within his police force."}}, {_id:2817, properties:{id:"During World War II, the English mathematical genius Alan Turing tries to crack the German Enigma code with help from fellow mathematicians."}}, {_id:2826, properties:{id:"A group of intergalactic criminals must pull together to stop a fanatical warrior with plans to purge the universe."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2837, properties:{id:"Young Blade Runner K's discovery of a long-buried secret leads him to track down former Blade Runner Rick Deckard, who's been missing for thirty years."}}, {_id:2841, properties:{id:"In a near future, a lonely writer develops an unlikely relationship with an operating system designed to meet his every need."}}, {_id:2847, properties:{id:"The story of the legendary British rock band Queen and lead singer Freddie Mercury, leading up to their famous performance at Live Aid (1985)."}}, {_id:2855, properties:{id:"A frontiersman on a fur trading expedition in the 1820s fights for survival after being mauled by a bear and left for dead by members of his own hunting team."}}, {_id:2864, properties:{id:"An introvert freshman is taken under the wings of two seniors who welcome him to the real world"}}, {_id:2867, properties:{id:"After a prison riot, former-Captain Nascimento, now a high ranking security officer in Rio de Janeiro, is swept into a bloody political dispute that involves government officials and paramilitary groups."}}, {_id:2876, properties:{id:"The story of King George VI, his impromptu ascension to the throne of the British Empire in 1936, and the speech therapist who helped the unsure monarch overcome his stammer."}}, {_id:2883, properties:{id:"An aspiring author during the civil rights movement of the 1960s decides to write a book detailing the African American maids' point of view on the white families for which they work, and the hardships they go through on a daily basis."}}, {_id:2896, properties:{id:"A wisecracking mercenary gets experimented on and becomes immortal but ugly, and sets out to track down the man who ruined his looks."}}, {_id:2898, properties:{id:"The mysterious disappearance of a kindergarten teacher during a picnic in the north of Iran is followed by a series of misadventures for her fellow travelers."}}, {_id:2906, properties:{id:"After breaking up with his childhood sweetheart, a young man finds solace in drugs. Meanwhile, a teenage girl is caught in the world of prostitution. Will they be destroyed, or will they find redemption?"}}, {_id:2916, properties:{id:"During the Japanese invasion of China, a wealthy martial artist is forced to leave his home when his city is occupied. With little means of providing for themselves, Ip Man and the remaining members of the city must find a way to survive."}}, {_id:2922, properties:{id:"An Indian Muslim man with Asperger's syndrome takes a challenge to speak to the President of the United States seriously and embarks on a cross-country journey."}}, {_id:2928, properties:{id:"Story of 40-man Turkish task force who must defend a relay station."}}, {_id:2933, properties:{id:"A Mumbai teenager reflects on his life after being accused of cheating on the Indian version of \"Who Wants to be a Millionaire?\"."}}, {_id:2939, properties:{id:"A committed dancer struggles to maintain her sanity after winning the lead role in a production of Tchaikovsky's \"Swan Lake\"."}}, {_id:2946, properties:{id:"In 1997 Rio de Janeiro, Captain Nascimento has to find a substitute for his position while trying to take down drug dealers and criminals before the Pope visits."}}, {_id:2952, properties:{id:"Earth's mightiest heroes must come together and learn to fight as a team if they are going to stop the mischievous Loki and his alien army from enslaving humanity."}}, {_id:2960, properties:{id:"A precocious and outspoken Iranian girl grows up during the Islamic Revolution."}}, {_id:2965, properties:{id:"In 1985 Dallas, electrician and hustler Ron Woodroof works around the system to help AIDS patients get the medication they need after he is diagnosed with the disease."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:2972, properties:{id:"A struggling salesman takes custody of his son as he's poised to begin a life-changing professional career."}}, {_id:2984, properties:{id:"A fisherman, a smuggler, and a syndicate of businessmen match wits over the possession of a priceless diamond."}}, {_id:2994, properties:{id:"Jason Bourne dodges a ruthless C.I.A. official and his Agents from a new assassination program while searching for the origins of his life as a trained killer."}}, {_id:2995, properties:{id:"A transient young man breaks into empty homes to partake of the vacationing residents' lives for a few days."}}, {_id:3009, properties:{id:"A movie that explores the dark and miserable town, Basin City, tells the story of three different people, all caught up in violent corruption."}}, {_id:3014, properties:{id:"The true story of Elle editor Jean-Dominique Bauby who suffers a stroke and has to live with an almost totally paralyzed body; only his left eye isn't paralyzed."}}, {_id:3023, properties:{id:"A slick young Turk kidnapped by extraterrestrials shows his great « humanitarian spirit » by outwitting the evil commander-in-chief of the planet of G.O.R.A."}}, {_id:3037, properties:{id:"A rat who can cook makes an unusual alliance with a young kitchen worker at a famous restaurant."}}, {_id:3041, properties:{id:"After earning 00 status and a licence to kill, Secret Agent James Bond sets out on his first mission as 007. Bond must defeat a private banker funding terrorists in a high-stakes game of poker at Casino Royale, Montenegro."}}, {_id:3047, properties:{id:"The Bride continues her quest of vengeance against her former boss and lover Bill, the reclusive bouncer Budd, and the treacherous, one-eyed Elle."}}, {_id:3057, properties:{id:"In the Russian wilderness, two brothers face a range of new, conflicting emotions when their father - a man they know only through a single photograph - resurfaces."}}, {_id:3060, properties:{id:"A boy is raised by a Buddhist monk in an isolated floating temple where the years pass like the seasons."}}, {_id:3073, properties:{id:"The factual story of Spaniard Ramon Sampedro, who fought a thirty-year campaign in favor of euthanasia and his own right to die."}}, {_id:3076, properties:{id:"The story of James J. Braddock, a supposedly washed-up boxer who came back to become a champion and an inspiration in the 1930s."}}, {_id:3086, properties:{id:"Naina, an introverted, perpetually depressed girl's life changes when she meets Aman. But Aman has a secret of his own which changes their lives forever. Embroiled in all this is Rohit, Naina's best friend who conceals his love for her."}}, {_id:3092, properties:{id:"A story between a mole in the police department and an undercover cop. Their objectives are the same: to find out who is the mole, and who is the cop."}}, {_id:3099, properties:{id:"Blacksmith Will Turner teams up with eccentric pirate \"Captain\" Jack Sparrow to save his love, the governor's daughter, from Jack's former pirate allies, who are now undead."}}, {_id:3103, properties:{id:"A frustrated son tries to determine the fact from fiction in his dying father's life."}}, {_id:3110, properties:{id:"A family of undercover superheroes, while trying to live the quiet suburban life, are forced into action to save the world."}}, {_id:3121, properties:{id:"A young man sees a drunk, cute woman standing too close to the tracks at a metro station in Seoul and pulls her back. She ends up getting him into trouble repeatedly after that, starting on the train."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3130, properties:{id:"A woman on the run from the mob is reluctantly accepted in a small Colorado community in exchange for labor, but when a search visits the town she finds out that their support has a price."}}, {_id:3137, properties:{id:"Lives of residents in a small Anatolian village change when television is introduced to them"}}, {_id:3139, properties:{id:"After narrowly escaping a bizarre accident, a troubled teenager is plagued by visions of a man in a large rabbit suit who manipulates him to commit a series of crimes."}}, {_id:3147, properties:{id:"An epic mosaic of interrelated characters in search of love, forgiveness, and meaning in the San Fernando Valley."}}, {_id:3156, properties:{id:"An East European girl travels to the United States with her young son, expecting it to be like a Hollywood film."}}, {_id:3161, properties:{id:"An old man makes a long journey by lawnmower to mend his relationship with an ill brother."}}, {_id:3169, properties:{id:"A pop singer gives up her career to become an actress, but she slowly goes insane when she starts being stalked by an obsessed fan and what seems to be a ghost of her past."}}, {_id:3179, properties:{id:"At Helge's 60th birthday party, some unpleasant family truths are revealed."}}, {_id:3190, properties:{id:"An emotive journey of a former school teacher, who writes letters for illiterate people, and a young boy, whose mother has just died, as they search for the father he never knew."}}, {_id:3191, properties:{id:"A young boy befriends a giant robot from outer space that a paranoid government agent wants to destroy."}}, {_id:3204, properties:{id:"Two terminally ill patients escape from a hospital, steal a car and rush towards the sea."}}, {_id:3213, properties:{id:"Karl Childers, a simple man hospitalized since his childhood murder of his mother and her lover, is released to start a new life in a small town."}}, {_id:3221, properties:{id:"Following the death of her adoptive parents, a successful young black optometrist establishes contact with her biological mother -- a lonely white factory worker living in poverty in East London."}}, {_id:3229, properties:{id:"In a future world devastated by disease, a convict is sent back in time to gather information about the man-made virus that wiped out most of the human population on the planet."}}, {_id:3240, properties:{id:"A cyborg policewoman and her partner hunt a mysterious and powerful hacker called the Puppet Master."}}, {_id:3246, properties:{id:"Jack Skellington, king of Halloween Town, discovers Christmas Town, but his attempts to bring Christmas to his home causes confusion."}}, {_id:3254, properties:{id:"A weatherman finds himself inexplicably living the same day over and over again."}}, {_id:3259, properties:{id:"Based on the true life experiences of poet Jimmy Santiago Baca, the film focuses on step-brothers Paco and Cruz, and their bi-racial cousin Miklo."}}, {_id:3271, properties:{id:"A prep school student needing money agrees to \"babysit\" a blind man, but the job is not at all what he anticipated."}}, {_id:3282, properties:{id:"A kindhearted street urchin and a power-hungry Grand Vizier vie for a magic lamp that has the power to make their deepest wishes come true."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3289, properties:{id:"New Orleans District Attorney Jim Garrison discovers there's more to the Kennedy assassination than the official story."}}, {_id:3294, properties:{id:"A prince cursed to spend his days as a hideous monster sets out to regain his humanity by earning a young woman's love."}}, {_id:3302, properties:{id:"Lieutenant John Dunbar, assigned to a remote western Civil War outpost, befriends wolves and Indians, making him an intolerable aberration in the military."}}, {_id:3307, properties:{id:"On the hottest day of the year on a street in the Bedford-Stuyvesant section of Brooklyn, everyone's hate and bigotry smolders and builds until it explodes into violence."}}, {_id:3316, properties:{id:"Selfish yuppie Charlie Babbitt's father left a fortune to his savant brother Raymond and a pittance to Charlie; they travel cross-country."}}, {_id:3329, properties:{id:"A secret military project endangers Neo-Tokyo when it turns a biker gang member into a rampaging psychic psychopath who can only be stopped by two teenagers and a group of psychics."}}, {_id:3336, properties:{id:"While home sick in bed, a young boy's grandfather reads him the story of a farmboy-turned-pirate who encounters numerous obstacles, enemies and allies in his quest to be reunited with his true love."}}, {_id:3337, properties:{id:"An angel tires of overseeing human activity and wishes to become human when he falls in love with a mortal."}}, {_id:3344, properties:{id:"A French boarding school run by priests seems to be a haven from World War II until a new student arrives. He becomes the roommate of the top student in his class. Rivals at first, the roommates form a bond and share a secret."}}, {_id:3356, properties:{id:"A young boy and a girl with a magic crystal must race against pirates and foreign agents in a search for a legendary floating castle."}}, {_id:3360, properties:{id:"A human soldier is sent from 2029 to 1984 to stop an almost indestructible cyborg killing machine, sent from the same year, which has been programmed to execute a young woman whose unborn son is the key to humanity's future salvation."}}, {_id:3371, properties:{id:"The life of the lawyer who became the famed leader of the Indian revolts against the British rule through his philosophy of nonviolent protest."}}, {_id:3374, properties:{id:"A petty thief with an utter resemblance to a samurai warlord is hired as the lord's double. When the warlord later dies the thief is forced to take up arms in his place."}}, {_id:3378, properties:{id:"A simpleminded, sheltered gardener becomes an unlikely trusted advisor to a powerful businessman and an insider in Washington politics."}}, {_id:3387, properties:{id:"Neurotic New York comedian Alvy Singer falls in love with the ditzy Annie Hall."}}, {_id:3394, properties:{id:"When a killer shark unleashes chaos on a beach community, it's up to a local sheriff, a marine biologist, and an old seafarer to hunt the beast down."}}, {_id:3400, properties:{id:"Three amateur bank robbers plan to hold up a bank. A nice simple robbery: Walk in, take the money, and run. Unfortunately, the supposedly uncomplicated heist suddenly becomes a bizarre nightmare as everything that could go wrong does."}}, {_id:3411, properties:{id:"An American grandson of the infamous scientist, struggling to prove that his grandfather was not as insane as people believe, is invited to Transylvania, where he discovers the process that reanimates a dead body."}}, {_id:3418, properties:{id:"A man befriends a fellow criminal as the two of them begin serving their sentence on a dreadful prison island, which inspires the man to plot his escape."}}, {_id:3424, properties:{id:"When a 12-year-old girl is possessed by a mysterious entity, her mother seeks the help of two priests to save her."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3429, properties:{id:"A man who loves games and theater invites his wife's lover to meet him, setting up a battle of wits with potentially deadly results."}}, {_id:3432, properties:{id:"In 1951, a group of high schoolers come of age in a bleak, isolated, atrophied North Texas town that is slowly dying, both culturally and economically."}}, {_id:3443, properties:{id:"In prerevolutionary Russia, a Jewish peasant contends with marrying off three of his daughters while growing anti-Semitic sentiment threatens his village."}}, {_id:3449, properties:{id:"A weak-willed Italian man becomes a fascist flunky who goes abroad to arrange the assassination of his old teacher, now a political dissident."}}, {_id:3460, properties:{id:"Wyoming, early 1900s. Butch Cassidy and The Sundance Kid are the leaders of a band of outlaws. After a train robbery goes wrong they find themselves on the run with a posse hard on their heels. Their solution - escape to Bolivia."}}, {_id:3464, properties:{id:"A young couple trying for a baby move into a fancy apartment surrounded by peculiar neighbors."}}, {_id:3472, properties:{id:"An astronaut crew crash-lands on a planet in the distant future where intelligent talking apes are the dominant species, and humans are the oppressed and enslaved."}}, {_id:3480, properties:{id:"A disillusioned college graduate finds himself torn between his older lover and her daughter."}}, {_id:3486, properties:{id:"A bitter, aging couple, with the help of alcohol, use their young houseguests to fuel anguish and emotional pain towards each other over the course of a distressing night."}}, {_id:3496, properties:{id:"A woman leaves an Austrian convent to become a governess to the children of a Naval officer widower."}}, {_id:3502, properties:{id:"The life of a Russian physician and poet who, although married to another, falls in love with a political activist's wife and experiences hardship during World War I and then the October Revolution."}}, {_id:3507, properties:{id:"A wandering gunfighter plays two rival families against each other in a town torn apart by greed, pride, and revenge."}}, {_id:3512, properties:{id:"A harried movie director retreats into his memories and fantasies."}}, {_id:3521, properties:{id:"Twelve episodic tales in the life of a Parisian woman and her slow descent into prostitution."}}, {_id:3532, properties:{id:"An up-and-coming pool player plays a long-time champion in a single high-stakes match."}}, {_id:3539, properties:{id:"A series of stories following a week in the life of a philandering paparazzo journalist living in Rome."}}, {_id:3547, properties:{id:"A small-town sheriff in the American West enlists the help of a cripple, a drunk, and a young gunfighter in his efforts to hold in jail the brother of the local bad guy."}}, {_id:3549, properties:{id:"In a murder trial, the defendant says he suffered temporary insanity after the victim raped his wife. What is the truth, and will he win his case?"}}, {_id:3558, properties:{id:"A stark, perverse story of murder, kidnapping, and police corruption in a Mexican border town."}}, {_id:3564, properties:{id:"Brick is an alcoholic ex-football player who drinks his days away and resists the affections of his wife. A reunion with his terminal father jogs a host of memories and revelations for both father and son."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3573, properties:{id:"Powerful but unethical Broadway columnist J.J. Hunsecker coerces unscrupulous press agent Sidney Falco into breaking up his sister's romance with a jazz musician."}}, {_id:3580, properties:{id:"Crook Johnny Clay assembles a five man team to plan and execute a daring race-track robbery."}}, {_id:3584, properties:{id:"A religious fanatic marries a gullible widow whose young children are reluctant to tell him where their real daddy hid the $10,000 he'd stolen in a robbery."}}, {_id:3592, properties:{id:"A care-free girl is sold to a traveling entertainer, consequently enduring physical and emotional pain along the way."}}, {_id:3595, properties:{id:"The wife and mistress of a loathed school principal plan to murder him with what they believe is the perfect alibi."}}, {_id:3601, properties:{id:"When two escaping American World War II prisoners are killed, the German P.O.W. camp barracks black marketeer, J.J. Sefton, is suspected of being an informer."}}, {_id:3612, properties:{id:"A bored and sheltered princess escapes her guardians and falls in love with an American newsman in Rome."}}, {_id:3615, properties:{id:"Disturbed Blanche DuBois moves in with her sister in New Orleans and is tormented by her brutish brother-in-law while her reality crumbles around her."}}, {_id:3620, properties:{id:"A potentially violent screenwriter is a murder suspect until his lovely neighbor clears him. However, she soon starts to have her doubts."}}, {_id:3626, properties:{id:"A distant poor relative of the Duke D'Ascoyne plots to inherit the title by murdering the eight other heirs who stand ahead of him in the line of succession."}}, {_id:3634, properties:{id:"Two men attempt to prove they committed the perfect crime by hosting a dinner party after strangling their former classmate to death."}}, {_id:3640, properties:{id:"A private eye escapes his past to run a gas station in a small town, but his past catches up with him. Now he must return to the big city world of danger, corruption, double crosses and duplicitous dames."}}, {_id:3646, properties:{id:"Meeting a stranger in a railway station, a woman is tempted to cheat on her husband."}}, {_id:3656, properties:{id:"A police detective falls in love with the woman whose murder he is investigating."}}, {_id:3659, properties:{id:"Three World War II veterans return home to small-town America to discover that they and their families have been irreparably changed."}}, {_id:3669, properties:{id:"A writer of books on the futility of marriage risks his reputation when he decides to get married. Things get even more complicated when he learns on his wedding day that his beloved maiden aunts are habitual murderers."}}, {_id:3673, properties:{id:"A private detective takes on a case that involves him with three eccentric criminals, a gorgeous liar, and their quest for a priceless statuette."}}, {_id:3678, properties:{id:"A poor Midwest family is forced off their land. They travel to California, suffering the misfortunes of the homeless in the Great Depression."}}, {_id:3688, properties:{id:"Dorothy Gale is swept away from a farm in Kansas to a magical land of Oz in a tornado and embarks on a quest with her new friends to see the Wizard who can help her return home to Kansas and help her friends as well."}}, {_id:3694, properties:{id:"A bourgeois life in France at the onset of World War II, as the rich and their poor servants meet up at a French chateau."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3699, properties:{id:"Former detective Nick Charles and his wealthy wife Nora investigate a murder case, mostly for the fun of it."}}, {_id:3713, properties:{id:"A German youth eagerly enters World War I, but his enthusiasm wanes as he gets a firsthand view of the horror."}}, {_id:3721, properties:{id:"In the midst of the Russian Revolution of 1905, the crew of the battleship Potemkin mutiny against the brutal, tyrannical regime of the vessel's officers. The resulting street demonstration in Odessa brings on a police massacre."}}, {_id:3725, properties:{id:"A detective investigates the death of a patriarch of an eccentric, combative family."}}, {_id:3732, properties:{id:"The emotional journey of two hopelessly in love youngsters, a young girl, Kizie, suffering from cancer, and a boy, Manny, whom she meets at a support group."}}, {_id:3740, properties:{id:"A family of small-time crooks take in a child they find outside in the cold."}}, {_id:3752, properties:{id:"Noah Baumbach's incisive and compassionate look at a marriage breaking up and a family staying together."}}, {_id:3763, properties:{id:"In 1980s Italy, romance blossoms between a seventeen-year-old student and the older man hired as his father's research assistant."}}, {_id:3767, properties:{id:"After having suffered a heart-attack, a 59-year-old carpenter must fight the bureaucratic forces of the system in order to receive Employment and Support Allowance."}}, {_id:3777, properties:{id:"Set in Japan, Isle of Dogs follows a boy's odyssey in search of his lost dog."}}, {_id:3780, properties:{id:"A national manhunt is ordered for a rebellious kid and his foster uncle who go missing in the wild New Zealand bush."}}, {_id:3792, properties:{id:"In the forests of the Pacific Northwest, a father devoted to raising his six kids with a rigorous physical and intellectual education is forced to leave his paradise and enter the world, challenging his idea of what it means to be a parent."}}, {_id:3794, properties:{id:"A boy growing up in Dublin during the 1980s escapes his strained family life by starting a band to impress the mysterious girl he likes."}}, {_id:3804, properties:{id:"Imprisoned on the planet Sakaar, Thor must race against time to return to Asgard and stop Ragnarök, the destruction of his world, at the hands of the powerful and ruthless villain Hela."}}, {_id:3816, properties:{id:"When Louis Bloom, a con man desperate for work, muscles into the world of L.A. crime journalism, he blurs the line between observer and participant to become the star of his own story."}}, {_id:3823, properties:{id:"A young boy in Hitler's army finds out his mother is hiding a Jewish girl in their home."}}, {_id:3825, properties:{id:"A linguist works with the military to communicate with alien lifeforms after twelve mysterious spacecrafts appear around the world."}}, {_id:3829, properties:{id:"As a new threat to the galaxy rises, Rey, a desert scavenger, and Finn, an ex-stormtrooper, must join Han Solo and Chewbacca to search for the one hope of restoring peace."}}, {_id:3837, properties:{id:"We meet Jesse and Celine nine years on in Greece. Almost two decades have passed since their first meeting on that train bound for Vienna."}}, {_id:3843, properties:{id:"The X-Men send Wolverine to the past in a desperate effort to change history and prevent an event that results in doom for both humans and mutants."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:3849, properties:{id:"A group of men set out in search of a dead body in the Anatolian steppes."}}, {_id:3860, properties:{id:"An egomaniacal film star develops a relationship with a young dancer against the backdrop of Hollywood's silent era."}}, {_id:3866, properties:{id:"A soldier fighting aliens gets to relive the same day over and over again, the day restarting every time he dies."}}, {_id:3876, properties:{id:"Georges and Anne are an octogenarian couple. They are cultivated, retired music teachers. Their daughter, also a musician, lives in Britain with her family. One day, Anne has a stroke, and the couple's bond of love is severely tested."}}, {_id:3881, properties:{id:"An old man recalls his time painting houses for his friend, Jimmy Hoffa, through the 1950-70s."}}, {_id:3885, properties:{id:"A young Arab man is sent to a French prison."}}, {_id:3894, properties:{id:"Astronaut Sam Bell has a quintessentially personal encounter toward the end of his three-year stint on the Moon, where he, working alongside his computer, GERTY, sends back to Earth parcels of a resource that has helped diminish our planet's power problems."}}, {_id:3900, properties:{id:"Oskar, an overlooked and bullied boy, finds love and revenge through Eli, a beautiful but peculiar girl."}}, {_id:3911, properties:{id:"Violence ensues after an extraterrestrial race forced to live in slum-like conditions on Earth finds a kindred spirit in a government agent exposed to their biotechnology."}}, {_id:3921, properties:{id:"A faded professional wrestler must retire, but finds his quest for a new life outside the ring a dispiriting struggle."}}, {_id:3929, properties:{id:"A depressed wealthy businessman finds his life changing after he meets a spunky and care-free young woman."}}, {_id:3936, properties:{id:"The life of Mason, from early childhood to his arrival at college."}}, {_id:3945, properties:{id:"A woman assists her friend in arranging an illegal abortion in 1980s Romania."}}, {_id:3950, properties:{id:"The brash James T. Kirk tries to live up to his father's legacy with Mr. Spock keeping him in check as a vengeful Romulan from the future creates black holes to destroy the Federation one planet at a time."}}, {_id:3955, properties:{id:"Guilt-stricken after a job gone wrong, hitman Ray and his partner await orders from their ruthless boss in Bruges, Belgium, the last place in the world Ray wants to be."}}, {_id:3964, properties:{id:"An impromptu goodbye party for Professor John Oldman becomes a mysterious interrogation after the retiring scholar reveals to his colleagues he has a longer and stranger past than they can imagine."}}, {_id:3975, properties:{id:"The story of the battle of Iwo Jima between the United States and Imperial Japan during World War II, as told from the perspective of the Japanese who fought it."}}, {_id:3978, properties:{id:"In a hospital on the outskirts of 1920s Los Angeles, an injured stuntman begins to tell a fellow patient, a little girl with a broken arm, a fantastic story of five mythical heroes. Thanks to his fractured state of mind and her vivid imagination, the line between fiction and reality blurs as the tale advances."}}, {_id:3989, properties:{id:"A young man who survives a disaster at sea is hurtled into an epic journey of adventure and discovery. While cast away, he forms an unexpected connection with another survivor: a fearsome Bengal tiger."}}, {_id:3992, properties:{id:"An urbane fox cannot resist returning to his farm raiding ways and then must help his community survive the farmers' retaliation."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4002, properties:{id:"A young French-Canadian, growing up in the 1960s and 1970s, struggles to reconcile his emerging homosexuality with his father's conservative values and his own Catholic beliefs."}}, {_id:4013, properties:{id:"The new teacher at a severely administered boys' boarding school works to positively affect the students' lives through music."}}, {_id:4017, properties:{id:"After being held captive in an Afghan cave, billionaire engineer Tony Stark creates a unique weaponized suit of armor to fight evil."}}, {_id:4027, properties:{id:"A man's uneventful life is disrupted by the zombie apocalypse."}}, {_id:4036, properties:{id:"With the intention to break free from the strict familial restrictions, a suicidal young woman sets up a marriage of convenience with a forty-year-old addict, an act that will lead to an outburst of envious love."}}, {_id:4040, properties:{id:"The lives of three men who were childhood friends are shattered when one of them has a family tragedy."}}, {_id:4048, properties:{id:"Harry Potter, Ron and Hermione return to Hogwarts School of Witchcraft and Wizardry for their third year of study, where they delve into the mystery surrounding an escaped prisoner who poses a dangerous threat to the young wizard."}}, {_id:4052, properties:{id:"A defense officer, Nameless, was summoned by the King of Qin regarding his success of terminating three warriors."}}, {_id:4062, properties:{id:"Two men share an odd friendship while they care for two women who are both in deep comas."}}, {_id:4066, properties:{id:"Bosnia and Herzegovina during 1993 at the time of the heaviest fighting between the two warring sides. Two soldiers from opposing sides in the conflict, Nino and Ciki, become trapped in no man's land, whilst a third soldier becomes a living booby trap."}}, {_id:4078, properties:{id:"A terrorist explosion releases a deadly virus on the masses, and it's up the bounty-hunting Bebop crew to catch the cold-blooded culprit."}}, {_id:4086, properties:{id:"A man is picked up by a fishing boat, bullet-riddled and suffering from amnesia, before racing to elude assassins and attempting to regain his memory."}}, {_id:4090, properties:{id:"Two con artists try to swindle a stamp collector by selling him a sheet of counterfeit rare stamps (the \"nine queens\")."}}, {_id:4099, properties:{id:"In 2027, in a chaotic world in which women have become somehow infertile, a former activist agrees to help transport a miraculously pregnant woman to a sanctuary at sea."}}, {_id:4101, properties:{id:"A high-school boy is given the chance to write a story for Rolling Stone Magazine about an up-and-coming rock band as he accompanies them on their concert tour."}}, {_id:4111, properties:{id:"After a car wreck on the winding Mulholland Drive renders a woman amnesiac, she and a perky Hollywood-hopeful search for clues and answers across Los Angeles in a twisting venture beyond dreams and reality."}}, {_id:4117, properties:{id:"When Woody is stolen by a toy collector, Buzz and his friends set out on a rescue mission to save Woody before he becomes a museum toy property with his roundup gang Jessie, Prospector, and Bullseye."}}, {_id:4122, properties:{id:"Back when sex was safe, pleasure was a business and business was booming, an idealistic porn producer aspires to elevate his craft to an art when he discovers a hot young talent."}}, {_id:4126, properties:{id:"A love story between a girl who loves reading books, and a boy who has previously checked out all of the library books she chooses."}}, {_id:4141, properties:{id:"A family descended from Maori warriors is bedeviled by a violent father and the societal problems of being treated as outcasts."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4147, properties:{id:"In Detroit, a lonely pop culture geek marries a call girl, steals cocaine from her pimp, and tries to sell it in Hollywood. Meanwhile, the owners of the cocaine, the Mob, track them down in an attempt to reclaim it."}}, {_id:4153, properties:{id:"A woman struggles to find a way to live her life after the death of her husband and child."}}, {_id:4158, properties:{id:"A vagabond swordsman is aided by a beautiful ninja girl and a crafty spy in confronting a demonic clan of killers - with a ghost from his past as their leader - who are bent on overthrowing the Tokugawa Shogunate."}}, {_id:4167, properties:{id:"A Puerto Rican former convict, just released from prison, pledges to stay away from drugs and violence despite the pressure around him and lead on to a better life outside of N.Y.C."}}, {_id:4170, properties:{id:"An artificial man, who was incompletely constructed and has scissors for hands, leads a solitary life. Then one day, a suburban lady meets him and introduces him to her world."}}, {_id:4179, properties:{id:"Christy Brown, born with cerebral palsy, learns to paint and write with his only controllable limb - his left foot."}}, {_id:4185, properties:{id:"An ophthalmologist's mistress threatens to reveal their affair to his wife while a married documentary filmmaker is infatuated with another woman."}}, {_id:4193, properties:{id:"During the era of Prohibition in the United States, Federal Agent Eliot Ness sets out to stop ruthless Chicago gangster Al Capone and, because of rampant corruption, assembles a small, hand-picked team to help him."}}, {_id:4199, properties:{id:"Between two Thanksgivings two years apart, Hannah's husband falls in love with her sister Lee, while her hypochondriac ex-husband rekindles his relationship with her sister Holly."}}, {_id:4201, properties:{id:"A bureaucrat in a dystopic society becomes an enemy of the state as he pursues the woman of his dreams."}}, {_id:4215, properties:{id:"Spinal Tap, one of England's loudest bands, is chronicled by film director Marty DiBergi on what proves to be a fateful tour."}}, {_id:4218, properties:{id:"In the 1940s, a young boy named Ralphie attempts to convince his parents, his teacher and Santa that a Red Ryder BB gun really is the perfect Christmas gift."}}, {_id:4230, properties:{id:"Jake Blues, just released from prison, puts together his old band to save the Catholic home where he and his brother Elwood were raised."}}, {_id:4239, properties:{id:"The life of a divorced television writer dating a teenage girl is further complicated when he falls in love with his best friend's mistress."}}, {_id:4241, properties:{id:"Director/choreographer Bob Fosse tells his own life story as he details the sordid career of Joe Gideon, a womanizing, drug-using dancer."}}, {_id:4248, properties:{id:"Following an ever-growing epidemic of zombies that have risen from the dead, two Philadelphia S.W.A.T. team members, a traffic reporter, and his television executive girlfriend seek refuge in a secluded shopping mall."}}, {_id:4256, properties:{id:"\"The Washington Post\" reporters Bob Woodward and Carl Bernstein uncover the details of the Watergate scandal that leads to President Richard Nixon's resignation."}}, {_id:4269, properties:{id:"In a corrupt, greed-fueled world, a powerful alchemist leads a messianic character and seven materialistic figures to the Holy Mountain, where they hope to achieve enlightenment."}}, {_id:4271, properties:{id:"A series of comedic and nostalgic vignettes set in a 1930s Italian coastal town."}}, {_id:4279, properties:{id:"A surreal, virtually plotless series of dreams centered around six middle-class people and their consistently interrupted attempts to have a meal together."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4287, properties:{id:"In the 16th century, the ruthless and insane Don Lope de Aguirre leads a Spanish expedition in search of El Dorado."}}, {_id:4293, properties:{id:"Young, rich, and obsessed with death, Harold finds himself changed forever when he meets lively septuagenarian Maude at a funeral."}}, {_id:4301, properties:{id:"The World War II phase of the career of controversial American general George S. Patton."}}, {_id:4305, properties:{id:"An aging group of outlaws look for one last big score as the \"traditional\" American West is disappearing around them."}}, {_id:4311, properties:{id:"A ragtag group of Pennsylvanians barricade themselves in an old farmhouse to remain safe from a horde of flesh-eating ghouls that are ravaging the East Coast of the United States."}}, {_id:4322, properties:{id:"1183 A.D.: King Henry II's three sons all want to inherit the throne, but he won't commit to a choice. They and his wife variously plot to force him."}}, {_id:4326, properties:{id:"A black police detective is asked to investigate a murder in a racially hostile southern town."}}, {_id:4336, properties:{id:"Romance and suspense ensue in Paris as a woman is pursued by several men who want a fortune her murdered husband had stolen. Whom can she trust?"}}, {_id:4339, properties:{id:"A former prisoner of war is brainwashed as an unwitting assassin for an international Communist conspiracy."}}, {_id:4344, properties:{id:"The slave Spartacus leads a violent revolt against the decadent Roman Republic."}}, {_id:4352, properties:{id:"A woman disappears during a Mediterranean boating trip. During the search, her lover and her best friend become attracted to each other."}}, {_id:4361, properties:{id:"A French actress filming an anti-war film in Hiroshima has an affair with a married Japanese architect as they share their differing perspectives on war."}}, {_id:4365, properties:{id:"Moses, an Egyptian Prince, learns of his true heritage as a Hebrew and his divine mission as the deliverer of his people."}}, {_id:4374, properties:{id:"An American Civil War veteran embarks on a journey to rescue his niece from the Comanches."}}, {_id:4380, properties:{id:"Two brothers struggle to maintain their strict, Bible-toting father's favor."}}, {_id:4383, properties:{id:"A town Marshal, despite the disagreements of his newlywed bride and the townspeople around him, must face a gang of deadly killers alone at high noon when the gang leader, an outlaw he sent up years ago, arrives on the noon train."}}, {_id:4395, properties:{id:"A psychopath forces a tennis star to comply with his theory that two strangers can get away with murder."}}, {_id:4397, properties:{id:"Due to his insistence that he has an invisible six foot-tall rabbit for a best friend, a whimsical middle-aged man is thought by his family to be insane - but he may be wiser than anyone knows."}}, {_id:4406, properties:{id:"When a nice old man who claims to be Santa Claus is institutionalized as insane, a young lawyer decides to defend him by arguing in court that he is the real thing."}}, {_id:4414, properties:{id:"A woman is asked to spy on a group of Nazi friends in South America. How far will she have to go to ingratiate herself with them?"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4418, properties:{id:"Private detective Philip Marlowe is hired by a wealthy family. Before the complex case is over, he's seen murder, blackmail, and what might be love."}}, {_id:4429, properties:{id:"The desperate life of a chronic alcoholic is followed through a four-day drinking bout."}}, {_id:4434, properties:{id:"When a rich woman's ex-husband and a tabloid-type reporter turn up just before her planned remarriage, she begins to learn the truth about herself."}}, {_id:4439, properties:{id:"A newspaper editor uses every trick in the book to keep his ace reporter ex-wife from remarrying."}}, {_id:4449, properties:{id:"When Prince John and the Norman Lords begin oppressing the Saxon masses in King Richard's absence, a Saxon lord fights back as the outlaw leader of a rebel guerrilla army."}}, {_id:4455, properties:{id:"A sly business manager and two wacky friends of two opera singers help them achieve success while humiliating their stuffy and snobbish enemies."}}, {_id:4463, properties:{id:"A film crew goes to a tropical island for an exotic location shoot and discovers a colossal ape who takes a shine to their female blonde star. He is then captured and brought back to New York City for public exhibition."}}, {_id:4472, properties:{id:"A circus' beautiful trapeze artist agrees to marry the leader of side-show performers, but his deformed friends discover she is only marrying him for his inheritance."}}, {_id:4485, properties:{id:"Vampire Count Orlok expresses interest in a new residence and real estate agent Hutter's wife."}}, {_id:4491, properties:{id:"An American expat tries to sell off his highly profitable marijuana empire in London, triggering plots, schemes, bribery and blackmail in an attempt to steal his domain out from under him."}}, {_id:4494, properties:{id:"A Kashmiri woman agrees to marry a Pakistani army officer in order to spy on Pakistan during the Indo-Pakistan War of 1971."}}, {_id:4503, properties:{id:"A heavy-metal drummer's life is thrown into freefall when he begins to lose his hearing."}}, {_id:4508, properties:{id:"While both participating in a production of \"Death of a Salesman,\" a teacher's wife is assaulted in her new home, which leaves him determined to find the perpetrator over his wife's traumatized objections."}}, {_id:4514, properties:{id:"Allied soldiers from Belgium, the British Empire, and France are surrounded by the German Army and evacuated during a fierce battle in World War II."}}, {_id:4523, properties:{id:"Seven long-time friends get together for a dinner. When they decide to share with each other the content of every text message, email and phone call they receive, many secrets start to unveil and the equilibrium trembles."}}, {_id:4528, properties:{id:"The story of a team of female African-American mathematicians who served a vital role in NASA during the early years of the U.S. space program."}}, {_id:4540, properties:{id:"Paddington (Ben Whishaw), now happily settled with the Brown family and a popular member of the local community, picks up a series of odd jobs to buy the perfect present for his Aunt Lucy's (Imelda Staunton's) 100th birthday, only for the gift to be stolen."}}, {_id:4545, properties:{id:"A story that revolves around drug abuse in the affluent north Indian State of Punjab and how the youth there have succumbed to it en-masse resulting in a socio-economic decline."}}, {_id:4553, properties:{id:"A young boy named Kubo must locate a magical suit of armour worn by his late father in order to defeat a vengeful spirit from the past."}}, {_id:4555, properties:{id:"The untold story of Mahendra Singh Dhoni's journey from ticket collector to trophy collector - the world-cup-winning captain of the Indian Cricket Team."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4566, properties:{id:"A depressed uncle is asked to take care of his teenage nephew after the boy's father dies."}}, {_id:4574, properties:{id:"In post-World War II Denmark, a group of young German POWs are forced to clear a beach of thousands of land mines under the watch of a Danish Sergeant who slowly learns to appreciate their plight."}}, {_id:4583, properties:{id:"The daughter of an Imperial scientist joins the Rebel Alliance in a risky move to steal the plans for the Death Star."}}, {_id:4591, properties:{id:"Political involvement in the Avengers' affairs causes a rift between Captain America and Iron Man."}}, {_id:4598, properties:{id:"In the dead of a Wyoming winter, a bounty hunter and his prisoner find shelter in a cabin currently inhabited by a collection of nefarious characters."}}, {_id:4603, properties:{id:"Jo March reflects back and forth on her life, telling the beloved story of the March sisters - four young women, each determined to live life on her own terms."}}, {_id:4609, properties:{id:"In a story depicted in oil painted animation, a young man comes to the last hometown of painter Vincent van Gogh (Robert Gulaczyk) to deliver the troubled artist's final letter and ends up investigating his final days there."}}, {_id:4616, properties:{id:"U.K. gay activists work to help miners during their lengthy strike of the National Union of Mineworkers in the summer of 1984."}}, {_id:4627, properties:{id:"An Iranian man deserts his French wife and her two children to return to his homeland. Meanwhile, his wife starts up a new relationship, a reality her husband confronts upon his wife's request for a divorce."}}, {_id:4633, properties:{id:"Jep Gambardella has seduced his way through the lavish nightlife of Rome for decades, but after his 65th birthday and a shock from the past, Jep looks past the nightclubs and parties to find a timeless landscape of absurd, exquisite beauty."}}, {_id:4641, properties:{id:"A mistaken delivery in Mumbai's famously efficient lunchbox delivery system connects a young housewife to an older man in the dusk of his life as they build a fantasy world together through notes in the lunchbox."}}, {_id:4650, properties:{id:"A man is brought in by an infertility doctor to supply him with his sperm, where he becomes the biggest sperm donor for his clinic."}}, {_id:4653, properties:{id:"A special bond develops between plus-sized inflatable robot Baymax and prodigy Hiro Hamada, who together team up with a group of friends to form a band of high-tech heroes."}}, {_id:4661, properties:{id:"At the age of 21, Tim discovers he can travel in time and change what happens and has happened in his own life. His decision to make his world a better place by getting a girlfriend turns out not to be as easy as you might think."}}, {_id:4669, properties:{id:"A quiet, sweet tempered housewife endures small slights from her well-educated husband and daughter every day because of her inability to speak and understand English."}}, {_id:4680, properties:{id:"A look at the life of Jiro Horikoshi, the man who designed Japanese fighter planes during World War II."}}, {_id:4684, properties:{id:"When a new toy called \"Forky\" joins Woody and the gang, a road trip alongside old and new friends reveals how big the world can be for a toy."}}, {_id:4694, properties:{id:"A lonely art expert working for a mysterious and reclusive heiress finds not only her art worth examining."}}, {_id:4701, properties:{id:"A pair of young lovers flee their New England town, which causes a local search party to fan out to find them."}}, {_id:4705, properties:{id:"When Hiccup and Toothless discover an ice cave that is home to hundreds of new wild dragons and the mysterious Dragon Rider, the two friends find themselves at the center of a battle to protect the peace."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4708, properties:{id:"In 2006-2007 a group of investors bet against the US mortgage market. In their research they discover how flawed and corrupt the market is."}}, {_id:4718, properties:{id:"A psychological thriller of a grieving mother turned cold-blooded avenger with a twisty master plan to pay back those who were responsible for her daughter's death."}}, {_id:4723, properties:{id:"A secret agent exacts revenge on a serial killer through a series of captures and releases."}}, {_id:4732, properties:{id:"Journalist Mikael Blomkvist is aided in his search for a woman who has been missing for forty years by Lisbeth Salander, a young computer hacker."}}, {_id:4733, properties:{id:"The true story of Captain Richard Phillips and the 2009 hijacking by Somali pirates of the U.S.-flagged MV Maersk Alabama, the first American cargo ship to be hijacked in two hundred years."}}, {_id:4741, properties:{id:"A quiet pawnshop keeper with a violent past takes on a drug-and-organ trafficking ring in hope of saving the child who is his only friend."}}, {_id:4752, properties:{id:"The rap group NWA emerges from the mean streets of Compton in Los Angeles, California, in the mid-1980s and revolutionizes Hip Hop culture with their music and tales about life in the hood."}}, {_id:4761, properties:{id:"A mother desperately searches for the killer who framed her son for a girl's horrific murder."}}, {_id:4767, properties:{id:"A disgraced ex-policeman who runs a small ring of prostitutes finds himself in a race against time when one of his women goes missing."}}, {_id:4773, properties:{id:"The dwarves, along with Bilbo Baggins and Gandalf the Grey, continue their quest to reclaim Erebor, their homeland, from Smaug. Bilbo Baggins is in possession of a mysterious and magical ring."}}, {_id:4781, properties:{id:"Strange events happen in a small village in the north of Germany during the years before World War I, which seem to be ritual punishment. Who is responsible?"}}, {_id:4785, properties:{id:"A journalist is aided by a young female hacker in his search for the killer of a woman who has been dead for forty years."}}, {_id:4794, properties:{id:"The story of 7 people on trial stemming from various charges surrounding the uprising at the 1968 Democratic National Convention in Chicago, Illinois."}}, {_id:4801, properties:{id:"Four friends, all high school teachers, test a theory that they will improve their lives by maintaining a constant level of alcohol in their blood."}}, {_id:4805, properties:{id:"Based on the story of Micky Ward, a fledgling boxer who tries to escape the shadow of his more famous but troubled older boxing brother and get his own shot at greatness."}}, {_id:4817, properties:{id:"A retired CIA agent travels across Europe and relies on his old skills to save his estranged daughter, who has been kidnapped while on a trip to Paris."}}, {_id:4820, properties:{id:"Through the innocent eyes of Bruno, the eight-year-old son of the commandant at a German concentration camp, a forbidden friendship with a Jewish boy on the other side of the camp fence has startling and unexpected consequences."}}, {_id:4830, properties:{id:"A modern-day musical about a busker and an immigrant and their eventful week in Dublin, as they write, rehearse and record songs that tell their love story."}}, {_id:4836, properties:{id:"A reluctant Hobbit, Bilbo Baggins, sets out to the Lonely Mountain with a spirited group of dwarves to reclaim their mountain home, and the gold within it from the dragon Smaug."}}, {_id:4843, properties:{id:"A Turkish man travels to Istanbul to find the daughter of his father's former girlfriend."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4849, properties:{id:"Thirteen-year-old fledgling writer Briony Tallis irrevocably changes the course of several lives when she accuses her older sister's lover of a crime he did not commit."}}, {_id:4855, properties:{id:"A mysterious Hollywood stuntman and mechanic moonlights as a getaway driver and finds himself in trouble when he helps out his neighbor."}}, {_id:4862, properties:{id:"An outcast New York City cop is charged with bringing down Harlem drug lord Frank Lucas, whose real life inspired this partly biographical film."}}, {_id:4868, properties:{id:"A paraplegic Marine dispatched to the moon Pandora on a unique mission becomes torn between following his orders and protecting the world he feels is his home."}}, {_id:4869, properties:{id:"A boy stands on a station platform as a train is about to leave. Should he go with his mother or stay with his father? Infinite possibilities arise from this decision. As long as he doesn't choose, anything is possible."}}, {_id:4881, properties:{id:"As the Mayan kingdom faces its decline, a young man is taken on a perilous journey to a world ruled by fear and oppression."}}, {_id:4887, properties:{id:"A family determined to get their young daughter into the finals of a beauty pageant take a cross-country trip in their VW bus."}}, {_id:4891, properties:{id:"A skilled London police officer is transferred to a small town with a dark secret."}}, {_id:4898, properties:{id:"Tells the story of Benjamin Button, a man who starts aging backwards with consequences."}}, {_id:4903, properties:{id:"Veer-Zaara is a saga of love, separation, courage and sacrifice. A love story that is an inspiration and will remain a legend forever."}}, {_id:4910, properties:{id:"A neo-nazi sentenced to community service at a church clashes with the blindly devotional priest."}}, {_id:4917, properties:{id:"Sparks fly when spirited Elizabeth Bennet meets single, rich, and proud Mr. Darcy. But Mr. Darcy reluctantly finds himself falling in love with a woman beneath his class. Can each overcome their own pride and prejudice?"}}, {_id:4920, properties:{id:"The story of New Zealander Burt Munro, who spent years rebuilding a 1920 Indian motorcycle, which helped him set the land speed world record at Utah's Bonneville Salt Flats in 1967."}}, {_id:4934, properties:{id:"On Christmas Eve, three homeless people living on the streets of Tokyo discover a newborn baby among the trash and set out to find its parents."}}, {_id:4936, properties:{id:"The crew of the ship Serenity try to evade an assassin sent to recapture one of their members who is telepathic."}}, {_id:4943, properties:{id:"A chronicle of country music legend Johnny Cash's life, from his early days on an Arkansas cotton farm to his rise to fame with Sun Records in Memphis, where he recorded alongside Elvis Presley, Jerry Lee Lewis, and Carl Perkins."}}, {_id:4949, properties:{id:"A teenage boy expelled from school for fighting arrives at a boarding school where the systematic bullying of younger students is encouraged as a means to maintain discipline, and decides to fight back."}}, {_id:4956, properties:{id:"A poor yet passionate young man falls in love with a rich young woman, giving her a sense of freedom, but they are soon separated because of their social differences."}}, {_id:4967, properties:{id:"The dramatization of a motorcycle road trip Che Guevara went on in his youth that showed him his life's calling."}}, {_id:4971, properties:{id:"Sixteen-year-old Lilja and her only friend, the young boy Volodja, live in Russia, fantasizing about a better life. One day, Lilja falls in love with Andrej, who is going to Sweden, and invites Lilja to come along and start a new life."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:4980, properties:{id:"When her grandson is kidnapped during the Tour de France, Madame Souza and her beloved pooch Bruno team up with the Belleville Sisters--an aged song-and-dance team from the days of Fred Astaire--to rescue him."}}, {_id:4989, properties:{id:"After a shooting incident at the North/South Korean border/DMZ leaves 2 North Korean soldiers dead, a neutral Swiss/Swedish team investigates, what actually happened."}}, {_id:4997, properties:{id:"A young man, falsely imprisoned by his jealous \"friend\", escapes and uses a hidden treasure to exact his revenge."}}, {_id:5005, properties:{id:"A man shuffles through a dream meeting various people and discussing the meanings and purposes of the universe."}}, {_id:5006, properties:{id:"The true story of a newly appointed African-American coach and his high school team on their first season as a racially integrated unit."}}, {_id:5017, properties:{id:"A young Chinese warrior steals a sword from a famed swordsman and then escapes into a world of romantic adventure with a mysterious man in the frontier of the nation."}}, {_id:5026, properties:{id:"Young Esteban wants to become a writer and also to discover the identity of his second mother, a trans woman, carefully concealed by his mother Manuela."}}, {_id:5029, properties:{id:"A FedEx executive undergoes a physical and emotional transformation after crash landing on a deserted island."}}, {_id:5043, properties:{id:"Two Irish Catholic brothers become vigilantes and wipe out Boston's criminal underworld in the name of God."}}, {_id:5045, properties:{id:"A research chemist comes under personal and professional attack when he decides to appear in a 60 Minutes exposé on Big Tobacco."}}, {_id:5052, properties:{id:"The true story of Homer Hickam, a coal miner's son who was inspired by the first Sputnik launch to take up rocketry against his father's wishes."}}, {_id:5058, properties:{id:"A mean lord exiles fairytale creatures to the swamp of a grumpy ogre, who must go on a quest and rescue a princess for the lord in order to get his land back."}}, {_id:5066, properties:{id:"A seventeen-year-old aristocrat falls in love with a kind but poor artist aboard the luxurious, ill-fated R.M.S. Titanic."}}, {_id:5079, properties:{id:"Nishi leaves the police in the face of harrowing personal and professional difficulties. Spiraling into depression, he makes questionable decisions."}}, {_id:5084, properties:{id:"A genetically inferior man assumes the identity of a superior one in order to pursue his lifelong dream of space travel."}}, {_id:5087, properties:{id:"After a wealthy banker is given an opportunity to participate in a mysterious game, his life is turned upside down when he becomes unable to distinguish between the game and reality."}}, {_id:5099, properties:{id:"Oilman Jan is paralyzed in an accident. His wife, who prayed for his return, feels guilty; even more, when Jan urges her to have sex with another."}}, {_id:5102, properties:{id:"Ambitious but troubled movie director Edward D. Wood Jr. tries his best to fulfill his dreams, despite his lack of talent."}}, {_id:5107, properties:{id:"A young man in a small Midwestern town struggles to care for his mentally-disabled younger brother and morbidly obese mother while attempting to pursue his own happiness."}}, {_id:5115, properties:{id:"A successful lawman's plans to retire anonymously in Tombstone, Arizona are disrupted by the kind of outlaws he was famous for eliminating."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5117, properties:{id:"In the summer of 1962, a new kid in town is taken under the wing of a young baseball prodigy and his rowdy team, resulting in many adventures."}}, {_id:5126, properties:{id:"A butler who sacrificed body and soul to service in the years leading up to World War II realizes too late how misguided his loyalty was to his lordly employer."}}, {_id:5138, properties:{id:"Parallel tales of two sexually obsessed men, one hurting and annoying women physically and mentally, one wandering around the city talking to strangers and experiencing dimensions of life."}}, {_id:5141, properties:{id:"Dr. Richard Kimble, unjustly accused of murdering his wife, must find the real killer while being the target of a nationwide manhunt led by a seasoned U.S. Marshal."}}, {_id:5150, properties:{id:"A father becomes worried when a local gangster befriends his son in the Bronx in the 1960s."}}, {_id:5158, properties:{id:"Batman is wrongly implicated in a series of murders of mob bosses actually done by a new vigilante assassin."}}, {_id:5164, properties:{id:"A tough-as-nails cop teams up with an undercover agent to shut down a sinister mobster and his crew."}}, {_id:5172, properties:{id:"An anthology of 5 different cab drivers in 5 American and European cities and their remarkable fares on the same eventful night."}}, {_id:5179, properties:{id:"Two parallel stories about two identical women; one living in Poland, the other in France. They don't know each other, but their lives are nevertheless profoundly connected."}}, {_id:5187, properties:{id:"Follows the lives of three young males living in the Crenshaw ghetto of Los Angeles, dissecting questions of race, relationships, violence, and future prospects."}}, {_id:5191, properties:{id:"After a famous author is rescued from a car crash by a fan of his novels, he comes to realize that the care he is receiving is only the beginning of a nightmare of captivity and abuse."}}, {_id:5199, properties:{id:"The victims of an encephalitis epidemic many years ago have been catatonic ever since, but now a new drug offers the prospect of reviving them."}}, {_id:5206, properties:{id:"A young witch, on her mandatory year of independent life, finds fitting into a new community difficult while she supports herself by running an air courier service."}}, {_id:5209, properties:{id:"Robert Gould Shaw leads the U.S. Civil War's first all-black volunteer company, fighting prejudices from both his own Union Army, and the Confederates."}}, {_id:5216, properties:{id:"A disillusioned assassin accepts one last hit in hopes of using his earnings to restore vision to a singer he accidentally blinded."}}, {_id:5223, properties:{id:"After visiting 2015, Marty McFly must repeat his visit to 1955 to prevent disastrous changes to 1985...without interfering with his first trip."}}, {_id:5224, properties:{id:"Two F.B.I. Agents with wildly different styles arrive in Mississippi to investigate the disappearance of some civil rights activists."}}, {_id:5230, properties:{id:"A team of commandos on a mission in a Central American jungle find themselves hunted by an extraterrestrial warrior."}}, {_id:5238, properties:{id:"The lone survivor of an onslaught of flesh-possessing spirits holes up in a cabin with a group of strangers while the demons continue their attack."}}, {_id:5245, properties:{id:"A high school wise guy is determined to have a day off from school, despite what the Principal thinks of that."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5255, properties:{id:"Two men are framed and sent to jail, where they meet a murderer who helps them escape and leave the state."}}, {_id:5258, properties:{id:"A group of young misfits called The Goonies discover an ancient map and set out on an adventure to find a legendary pirate's long-lost treasure."}}, {_id:5272, properties:{id:"A black Southern woman struggles to find her identity after suffering abuse from her father and others over four decades."}}, {_id:5273, properties:{id:"Five high school students meet in Saturday detention and discover how they have a lot more in common than they thought."}}, {_id:5286, properties:{id:"A journalist is trapped in Cambodia during tyrant Pol Pot's bloody 'Year Zero' cleansing campaign, which claimed the lives of two million 'undesirable' civilians."}}, {_id:5295, properties:{id:"Three former parapsychology professors set up shop as a unique ghost removal service."}}, {_id:5301, properties:{id:"The story of the original Mercury 7 astronauts and their macho, seat-of-the-pants approach to the space program."}}, {_id:5308, properties:{id:"Rupert Pupkin is a passionate yet unsuccessful comic who craves nothing more than to be in the spotlight and to achieve this, he stalks and kidnaps his idol to take the spotlight for himself."}}, {_id:5312, properties:{id:"A troubled child summons the courage to help a friendly alien escape Earth and return to his home world."}}, {_id:5324, properties:{id:"Ted Kramer's wife leaves him, allowing for a lost bond to be rediscovered between Ted and his son, Billy. But a heated custody battle ensues over the divorced couple's son, deepening the wounds left by the separation."}}, {_id:5329, properties:{id:"A hot-tempered farm laborer convinces the woman he loves to marry their rich but dying boss so that they can have a claim to his fortune."}}, {_id:5335, properties:{id:"Missouri farmer Josey Wales joins a Confederate guerrilla unit and winds up on the run from the Union soldiers who murdered his family."}}, {_id:5341, properties:{id:"Two British former soldiers decide to set themselves up as Kings in Kafiristan, a land where no white man has set foot since Alexander the Great."}}, {_id:5344, properties:{id:"A paranoid, secretive surveillance expert has a crisis of conscience when he suspects that the couple he is spying on will be murdered."}}, {_id:5349, properties:{id:"On a faraway planet where blue giants rule, oppressed humanoids rebel against their machine-like leaders."}}, {_id:5358, properties:{id:"A professional assassin codenamed \"Jackal\" plots to kill Charles de Gaulle, the President of France."}}, {_id:5368, properties:{id:"An impressionable teenage girl from a dead-end town and her older greaser boyfriend embark on a killing spree in the South Dakota badlands."}}, {_id:5370, properties:{id:"A female girlie club entertainer in Weimar Republic era Berlin romances two men while the Nazi Party rises to power around them."}}, {_id:5379, properties:{id:"A poor but hopeful boy seeks one of the five coveted golden tickets that will send him on a tour of Willy Wonka's mysterious chocolate factory."}}, {_id:5391, properties:{id:"A naive hustler travels from Texas to New York City to seek personal fortune, finding a new friend in the process."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5400, properties:{id:"A recently blinded woman is terrorized by a trio of thugs while they search for a heroin-stuffed doll they believe is in her apartment."}}, {_id:5404, properties:{id:"A couple's attitudes are challenged when their daughter introduces them to her African-American fiancé."}}, {_id:5407, properties:{id:"Bored waitress Bonnie Parker falls in love with an ex-con named Clyde Barrow and together they start a violent crime spree through the country, stealing cars and robbing banks."}}, {_id:5414, properties:{id:"Snobbish phonetics Professor Henry Higgins agrees to a wager that he can make flower girl Eliza Doolittle presentable in high society."}}, {_id:5423, properties:{id:"In turn of the century London, a magical nanny employs music and adventure to help two neglected children become closer to their father."}}, {_id:5428, properties:{id:"The events of D-Day, told on a grand scale from both the Allied and German points of view."}}, {_id:5436, properties:{id:"Decades of a love triangle concerning two friends and an impulsive woman."}}, {_id:5442, properties:{id:"A young governess for two children becomes convinced that the house and grounds are haunted."}}, {_id:5455, properties:{id:"A small-time thief steals a car and impulsively murders a motorcycle policeman. Wanted by the authorities, he reunites with a hip American journalism student and attempts to persuade her to run away with him to Italy."}}, {_id:5463, properties:{id:"Dunson leads a cattle drive, the culmination of over 14 years of work, to its destination in Missouri. But his tyrannical behavior along the way causes a mutiny, led by his adopted son."}}, {_id:5465, properties:{id:"A man visits his war buddy's family hotel and finds a gangster running things. As a hurricane approaches, the two end up confronting each other."}}, {_id:5468, properties:{id:"During World War II, American expatriate Harry Morgan helps transport a French Resistance leader and his beautiful wife to Martinique while romancing a sensuous lounge singer."}}, {_id:5478, properties:{id:"A young girl, overjoyed when her favorite uncle comes to visit the family, slowly begins to suspect that he is in fact the \"Merry Widow\" killer sought by the authorities."}}, {_id:5481, properties:{id:"A group of people traveling on a stagecoach find their journey complicated by the threat of Geronimo and learn something about each other in the process."}}, {_id:5485, properties:{id:"While travelling in continental Europe, a rich young playgirl realizes that an elderly lady seems to have disappeared from the train."}}, {_id:5494, properties:{id:"While trying to secure a $1 million donation for his museum, a befuddled paleontologist is pursued by a flighty and often irritating heiress and her pet leopard, Baby."}}, {_id:5499, properties:{id:"Mary Shelley reveals the main characters of her novel survived: Dr. Frankenstein, goaded by an even madder scientist, builds his monster a mate."}}, {_id:5502, properties:{id:"Rufus T. Firefly is named president/dictator of bankrupt Freedonia and declares war on neighboring Sylvania over the love of wealthy Mrs. Teasdale."}}, {_id:5512, properties:{id:"An ambitious and nearly insane violent gangster climbs the ladder of success in the mob, but his weaknesses prove to be his downfall."}}, {_id:5517, properties:{id:"Dr. Frankenstein dares to tamper with life and death by creating a human monster out of lifeless body parts."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5522, properties:{id:"A year in the life of a middle-class family's maid in Mexico City in the early 1970s."}}, {_id:5532, properties:{id:"Spring. Yorkshire. Young farmer Johnny Saxby numbs his daily frustrations with binge drinking and casual sex, until the arrival of a Romanian migrant worker for lambing season ignites an intense relationship that sets Johnny on a new path."}}, {_id:5539, properties:{id:"Foul-mouthed mutant mercenary Wade Wilson (a.k.a. Deadpool), brings together a team of fellow mutant rogues to protect a young boy with supernatural abilities from the brutal, time-traveling cyborg Cable."}}, {_id:5545, properties:{id:"A veteran hunter helps an FBI agent investigate the murder of a young woman on a Wyoming Native American reservation."}}, {_id:5551, properties:{id:"A young African-American visits his white girlfriend's parents for the weekend, where his simmering uneasiness about their reception of him eventually reaches a boiling point."}}, {_id:5557, properties:{id:"Ethan Hunt and his IMF team, along with some familiar allies, race against time after a mission gone wrong."}}, {_id:5569, properties:{id:"Ove, an ill-tempered, isolated retiree who spends his days enforcing block association rules and visiting his wife's grave, has finally given up on life just as an unlikely friendship develops with his boisterous new neighbors."}}, {_id:5576, properties:{id:"Viago, Deacon and Vladislav are vampires who are finding that modern life has them struggling with the mundane - like paying rent, keeping up with the chore wheel, trying to get into nightclubs and overcoming flatmate conflicts."}}, {_id:5586, properties:{id:"Due to 12 y.o. Anna's asthma, she's sent to stay with relatives of her guardian in the Japanese countryside. She likes to be alone, sketching. She befriends Marnie. Who is the mysterious, blonde Marnie."}}, {_id:5591, properties:{id:"A look at the relationship between the famous physicist Stephen Hawking and his wife."}}, {_id:5600, properties:{id:"A spy organisation recruits a promising street kid into the agency's training program, while a global threat emerges from a twisted tech genius."}}, {_id:5607, properties:{id:"Two teenage cancer patients begin a life-affirming journey to visit a reclusive author in Amsterdam."}}, {_id:5617, properties:{id:"High schooler Greg, who spends most of his time making parodies of classic movies with his co-worker Earl, finds his outlook forever altered after befriending a classmate who has just been diagnosed with cancer."}}, {_id:5623, properties:{id:"A washed-up superhero actor attempts to revive his fading career by writing, directing, and starring in a Broadway production."}}, {_id:5626, properties:{id:"Adèle's life is changed when she meets Emma, a young woman with blue hair, who will allow her to discover desire and to assert herself as a woman and as an adult. In front of others, Adèle grows, seeks herself, loses herself, and ultimately finds herself through love and loss."}}, {_id:5634, properties:{id:"Three friends growing up in India at the turn of the millennium set out to open a training academy to produce the country's next cricket stars."}}, {_id:5642, properties:{id:"Elise and Didier fall in love at first sight, in spite of their differences. He talks, she listens. He's a romantic atheist, she's a religious realist. When their daughter becomes seriously ill, their love is put on trial."}}, {_id:5652, properties:{id:"As Steve Rogers struggles to embrace his role in the modern world, he teams up with a fellow Avenger and S.H.I.E.L.D agent, Black Widow, to battle a new threat from history: an assassin known as the Winter Soldier."}}, {_id:5658, properties:{id:"Janardhan Jakhar chases his dreams of becoming a big Rock star, during which he falls in love with Heer."}}, {_id:5666, properties:{id:"An aging, booze-addled father makes the trip from Montana to Nebraska with his estranged son in order to claim a million-dollar Mega Sweepstakes Marketing prize."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5670, properties:{id:"A video game villain wants to be a hero and sets out to fulfill his dream, but his quest brings havoc to the whole arcade where he lives."}}, {_id:5679, properties:{id:"A little girl lives in a very grown-up world with her mother, who tries to prepare her for it. Her neighbor, the Aviator, introduces the girl to an extraordinary world where anything is possible, the world of the Little Prince."}}, {_id:5687, properties:{id:"A substitute teacher who drifts from classroom to classroom finds a connection to the students and teachers during his latest assignment."}}, {_id:5691, properties:{id:"While on a trip to Paris with his fiancée's family, a nostalgic screenwriter finds himself mysteriously going back to the 1920s every day at midnight."}}, {_id:5701, properties:{id:"An ordinary LEGO construction worker, thought to be the prophesied as \"special\", is recruited to join a quest to stop an evil tyrant from gluing the LEGO universe into eternal stasis."}}, {_id:5705, properties:{id:"Two astronauts work together to survive after an accident leaves them stranded in space."}}, {_id:5711, properties:{id:"After the crew of the Enterprise find an unstoppable force of terror from within their own organization, Captain Kirk leads a manhunt to a war-zone world to capture a one-man weapon of mass destruction."}}, {_id:5716, properties:{id:"A drama based on the experiences of Agu, a child soldier fighting in the civil war of an unnamed African country."}}, {_id:5722, properties:{id:"As Harvard student Mark Zuckerberg creates the social networking site that would become known as Facebook, he is sued by the twins who claimed he stole their idea, and by the co-founder who was later squeezed out of the business."}}, {_id:5728, properties:{id:"In the 1960s, superpowered humans Charles Xavier and Erik Lensherr work together to find others like them, but Erik's vengeful pursuit of an ambitious mutant who ruined his life causes a schism to divide them."}}, {_id:5734, properties:{id:"Three buddies wake up from a bachelor party in Las Vegas, with no memory of the previous night and the bachelor missing. They make their way around the city in order to find their friend before his wedding."}}, {_id:5739, properties:{id:"James Bond's loyalty to M is tested when her past comes back to haunt her. When MI6 comes under attack, 007 must track down and destroy the threat, no matter how personal the cost."}}, {_id:5744, properties:{id:"After a stint in a mental institution, former teacher Pat Solitano moves back in with his parents and tries to reconcile with his ex-wife. Things get more challenging when Pat meets Tiffany, a mysterious girl with problems of her own."}}, {_id:5752, properties:{id:"Acting under the cover of a Hollywood producer scouting a location for a science fiction film, a CIA agent launches a dangerous operation to rescue six Americans in Tehran during the U.S. hostage crisis in Iran in 1979."}}, {_id:5757, properties:{id:"An offbeat romantic comedy about a woman who doesn't believe true love exists, and the young man who falls for her."}}, {_id:5763, properties:{id:"As Harry, Ron, and Hermione race against time and evil to destroy the Horcruxes, they uncover the existence of the three most powerful objects in the wizarding world: the Deathly Hallows."}}, {_id:5764, properties:{id:"A five-year-old boy develops a relationship with Ponyo, a young goldfish princess who longs to become a human after falling in love with him."}}, {_id:5774, properties:{id:"A dramatic retelling of the post-Watergate television interviews between British talk-show host David Frost and former president Richard Nixon."}}, {_id:5778, properties:{id:"When a machine that allows therapists to enter their patients' dreams is stolen, all Hell breaks loose. Only a young female therapist, Paprika, can stop it."}}, {_id:5787, properties:{id:"Grief-stricken mother Christine Collins (Angelina Jolie) takes on the L.A.P.D. to her own detriment when it tries to pass off an obvious impostor as her missing child."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5794, properties:{id:"Two eighth-graders start to have feelings for each other despite being total opposites."}}, {_id:5802, properties:{id:"A high-school girl named Makoto acquires the power to travel back in time, and decides to use it for her own personal benefits. Little does she know that she is affecting the lives of others just as much as she is her own."}}, {_id:5808, properties:{id:"A battle between the world's two greatest minds begins when Light Yagami finds the Death Note, a notebook with the power to kill, and decides to rid the world of criminals."}}, {_id:5812, properties:{id:"A young boy becomes friends with a gang of skinheads. Friends soon become like family, and relationships will be pushed to the very limit."}}, {_id:5824, properties:{id:"A young programmer is selected to participate in a ground-breaking experiment in synthetic intelligence by evaluating the human qualities of a highly advanced humanoid A.I."}}, {_id:5831, properties:{id:"A manager of an orphanage in India is sent to Copenhagen, Denmark, where he discovers a life-altering family secret."}}, {_id:5836, properties:{id:"Based on the events of the brutal Ugandan dictator Idi Amin's regime as seen by his personal physician during the 1970s."}}, {_id:5841, properties:{id:"In the late 1960s/early 1970s, a San Francisco cartoonist becomes an amateur detective obsessed with tracking down the Zodiac Killer, an unidentified individual who terrorizes Northern California with a killing spree."}}, {_id:5850, properties:{id:"A case of mistaken identity lands Slevin into the middle of a war being plotted by two of the city's most rival crime bosses. Under constant surveillance by Detective Brikowski and assassin Goodkat, he must get them before they get him."}}, {_id:5855, properties:{id:"In December 1914, an unofficial Christmas truce on the Western Front allows soldiers from opposing sides of the First World War to gain insight into each other's way of life."}}, {_id:5863, properties:{id:"A profile of Ian Curtis, the enigmatic singer of Joy Division whose personal, professional, and romantic troubles led him to commit suicide at the age of 23."}}, {_id:5872, properties:{id:"The magically long-haired Rapunzel has spent her entire life in a tower, but now that a runaway thief has stumbled upon her, she is about to discover the world for the first time, and who she really is."}}, {_id:5879, properties:{id:"In the Nazi-occupied Netherlands during World War II, a Jewish singer infiltrates the regional Gestapo headquarters for the Dutch resistance."}}, {_id:5888, properties:{id:"The story of a forbidden and secretive relationship between two cowboys, and their lives over the years."}}, {_id:5889, properties:{id:"A small-time rancher agrees to hold a captured outlaw who's awaiting a train to go to court in Yuma. A battle of wills ensues as the outlaw tries to psych out the rancher."}}, {_id:5898, properties:{id:"Los Angeles citizens with vastly separate lives collide in interweaving stories of race, loss and redemption."}}, {_id:5901, properties:{id:"In Shanghai, China in the 1940s, a wannabe gangster aspires to join the notorious \"Axe Gang\" while residents of a housing complex exhibit extraordinary powers in defending their turf."}}, {_id:5911, properties:{id:"When Jason Bourne is framed for a CIA operation gone awry, he is forced to resume his former life as a trained assassin to survive."}}, {_id:5916, properties:{id:"An industrial worker who hasn't slept in a year begins to doubt his own sanity."}}, {_id:5924, properties:{id:"The story of the life and career of the legendary rhythm and blues musician Ray Charles, from his humble beginnings in the South, where he went blind at age seven, to his meteoric rise to stardom during the 1950s and 1960s."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:5928, properties:{id:"A faded movie star and a neglected young woman form an unlikely bond after crossing paths in Tokyo."}}, {_id:5939, properties:{id:"Harry Potter finds himself competing in a hazardous tournament between rival schools of magic, but he is distracted by recurring nightmares."}}, {_id:5940, properties:{id:"In Mexico City, a former CIA operative swears vengeance on those who committed an unspeakable act against the family he was hired to protect."}}, {_id:5951, properties:{id:"An adventurous 11-year-old girl finds another world that is a strangely idealized version of her frustrating home, but it has sinister secrets."}}, {_id:5953, properties:{id:"An American military advisor embraces the Samurai culture he was hired to destroy after he is captured in battle."}}, {_id:5960, properties:{id:"Three young Irish women struggle to maintain their spirits while they endure dehumanizing abuse as inmates of a Magdalene Sisters Asylum."}}, {_id:5972, properties:{id:"In 1990, to protect his fragile mother from a fatal shock after a long coma, a young man must keep her from learning that her beloved nation of East Germany as she knew it has disappeared."}}, {_id:5976, properties:{id:"A family of Irish immigrants adjust to life on the mean streets of Hell's Kitchen while also grieving the death of a child."}}, {_id:5982, properties:{id:"A mentally handicapped man fights for custody of his 7-year-old daughter and in the process teaches his cold-hearted lawyer the value of love and family."}}, {_id:5986, properties:{id:"A lovelorn screenwriter becomes desperate as he tries and fails to adapt 'The Orchid Thief' by Susan Orlean for the screen."}}, {_id:5994, properties:{id:"160 elite U.S. soldiers drop into Somalia to capture two top lieutenants of a renegade warlord and find themselves in a desperate battle with a large force of heavily-armed Somalis."}}, {_id:5995, properties:{id:"A mob enforcer's son witnesses a murder, forcing him and his father to take to the road, and his father down a path of redemption and revenge."}}, {_id:6003, properties:{id:"For two weeks, 20 male participants are hired to play prisoners and guards in a prison. The \"prisoners\" have to follow seemingly mild rules, and the \"guards\" are told to retain order without using physical violence."}}, {_id:6012, properties:{id:"A talented young boy becomes torn between his unexpected love of dance and the disintegration of his family."}}, {_id:6019, properties:{id:"A gender-queer punk-rock singer from East Berlin tours the U.S. with her band as she tells her life story and follows the former lover/band-mate who stole her songs."}}, {_id:6031, properties:{id:"Danny Ocean and his ten accomplices plan to rob three Las Vegas casinos simultaneously."}}, {_id:6037, properties:{id:"When a girl is abducted by a vampire, a legendary bounty hunter is hired to bring her back."}}, {_id:6044, properties:{id:"In the deep south during the 1930s, three escaped convicts search for hidden treasure while a relentless lawman pursues them."}}, {_id:6050, properties:{id:"Neal Oliver, a very confused young man and an artist, takes a journey of a lifetime on a highway I60 that doesn't exist on any of the maps, going to the places he never even heard of, searching for an answer and his dreamgirl."}}, {_id:6052, properties:{id:"When Stan Marsh and his friends go see an R-rated movie, they start cursing and their parents think that Canada is to blame."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6063, properties:{id:"Three company workers who hate their jobs decide to rebel against their greedy boss."}}, {_id:6069, properties:{id:"The lives of several individuals intertwine as they go about their lives in their own unique ways, engaging in acts society as a whole might find disturbing in a desperate search for human connection."}}, {_id:6076, properties:{id:"A rookie cop spends his first day as a Los Angeles narcotics officer with a rogue detective who isn't what he appears to be."}}, {_id:6082, properties:{id:"The extracurricular king of Rushmore Preparatory School is put on academic probation."}}, {_id:6091, properties:{id:"A very handsome man finds the love of his life, but he suffers an accident and needs to have his face rebuilt by surgery after it is severely disfigured."}}, {_id:6096, properties:{id:"A puppeteer discovers a portal that leads literally into the head of movie star John Malkovich."}}, {_id:6100, properties:{id:"A single mother and waitress, a misanthropic author, and a gay artist form an unlikely friendship after the artist is assaulted in a robbery."}}, {_id:6106, properties:{id:"In the colorful future, a cab driver unwittingly becomes the central figure in the search for a legendary cosmic weapon to keep Evil and Mr. Zorg at bay."}}, {_id:6115, properties:{id:"A few friends have a weekly fools' dinner, where each brings a fool along. Pierre finds a champion fool for next dinner. Surprise."}}, {_id:6123, properties:{id:"An FBI undercover agent infiltrates the mob and finds himself identifying more with the mafia life, at the expense of his regular one."}}, {_id:6129, properties:{id:"Pianist David Helfgott, driven by his father and teachers, has a breakdown. Years later he returns to the piano, to popular if not critical acclaim."}}, {_id:6137, properties:{id:"An altar boy is accused of murdering a priest, and the truth is buried several layers deep."}}, {_id:6140, properties:{id:"Hamlet, Prince of Denmark, returns home to find his father murdered and his mother remarrying the murderer, his uncle. Meanwhile, war is brewing."}}, {_id:6145, properties:{id:"A young girl is relegated to servitude at a boarding school when her father goes missing and is presumed dead."}}, {_id:6156, properties:{id:"This Hong Kong-set crime drama follows the lives of a hitman, hoping to get out of the business, and his elusive female partner."}}, {_id:6160, properties:{id:"A simple Italian postman learns to love poetry while delivering mail to a famous poet, and then uses this to woo local beauty Beatrice."}}, {_id:6166, properties:{id:"A day in the lives of two convenience clerks named Dante and Randal as they annoy customers, discuss movies, and play hockey on the store roof."}}, {_id:6176, properties:{id:"The day-to-day lives of several suburban Los Angeles residents."}}, {_id:6182, properties:{id:"When a man with HIV is fired by his law firm because of his condition, he hires a homophobic small time lawyer as the only willing advocate for a wrongful dismissal suit."}}, {_id:6187, properties:{id:"The Muppet characters tell their version of the classic tale of an old and bitter miser's redemption on Christmas Eve."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6197, properties:{id:"Biographical epic of the controversial and influential Black Nationalist leader, from his early life and career as a small-time gangster, to his ministry as a member of the Nation of Islam."}}, {_id:6205, properties:{id:"Three trappers protect the daughters of a British Colonel in the midst of the French and Indian War."}}, {_id:6208, properties:{id:"In 1930s Italy, a veteran World War I pilot is cursed to look like an anthropomorphic pig."}}, {_id:6215, properties:{id:"An examination of the machinations behind the scenes at a real estate office."}}, {_id:6222, properties:{id:"Military lawyer Lieutenant Daniel Kaffee defends Marines accused of murder. They contend they were acting under orders."}}, {_id:6231, properties:{id:"A housewife who is unhappy with her life befriends an old lady in a nursing home and is enthralled by the tales she tells of people she used to know."}}, {_id:6238, properties:{id:"A renowned New York playwright is enticed to California to write for the movies and discovers the hellish truth of Hollywood."}}, {_id:6242, properties:{id:"Tom Reagan, an advisor to a Prohibition-era crime boss, tries to keep the peace between warring mobs but gets caught in divided loyalties."}}, {_id:6244, properties:{id:"A toon-hating detective is a cartoon rabbit's only hope to prove his innocence when he is accused of murder."}}, {_id:6257, properties:{id:"Rex and Saskia, a young couple in love, are on vacation. They stop at a busy service station and Saskia is abducted. After three years and no sign of Saskia, Rex begins receiving letters from the abductor."}}, {_id:6265, properties:{id:"In 1969, two substance-abusing, unemployed actors retreat to the countryside for a holiday that proves disastrous."}}, {_id:6271, properties:{id:"The story of the final Emperor of China."}}, {_id:6276, properties:{id:"A young English boy struggles to survive under Japanese occupation during World War II."}}, {_id:6281, properties:{id:"An intellectually nonconformist friar investigates a series of mysterious deaths in an isolated abbey."}}, {_id:6289, properties:{id:"The discovery of a severed human ear found in a field leads a young man on an investigation related to a beautiful, mysterious nightclub singer and a group of psychopathic criminals who have kidnapped her child."}}, {_id:6292, properties:{id:"In New Jersey in 1935, a movie character walks off the screen and into the real world."}}, {_id:6305, properties:{id:"An ordinary word processor has the worst night of his life after he agrees to visit a girl in Soho who he met that evening at a coffee shop."}}, {_id:6307, properties:{id:"\"Documentary\" about a man who can look and act like whoever he's around, and meets various famous people."}}, {_id:6314, properties:{id:"A lawyer sees the chance to salvage his career and self-respect by taking a medical malpractice case to trial rather than settling."}}, {_id:6324, properties:{id:"With the assistance of the Enterprise crew, Admiral Kirk must stop an old nemesis, Khan Noonien Singh, from using the life-generating Genesis Device as the ultimate weapon."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6329, properties:{id:"A veteran Green Beret is forced by a cruel Sheriff and his deputies to flee into the mountains and wage an escalating one-man war against his pursuers."}}, {_id:6332, properties:{id:"The accidental death of the older son of an affluent family deeply strains the relationships among the bitter mother, the good-natured father, and the guilt-ridden younger son."}}, {_id:6346, properties:{id:"A man afraid to fly must ensure that a plane lands safely after the pilots become sick."}}, {_id:6349, properties:{id:"A dashing thief, his gang of desperadoes and an intrepid policeman struggle to free a princess from an evil count's clutches, and learn the hidden secret to a fabulous treasure that she holds part of a key to."}}, {_id:6356, properties:{id:"Fifteen years after murdering his sister on Halloween night 1963, Michael Myers escapes from a mental hospital and returns to the small town of Haddonfield, Illinois to kill again."}}, {_id:6364, properties:{id:"A bureaucrat rents a Paris apartment where he finds himself drawn into a rabbit hole of dangerous paranoia."}}, {_id:6372, properties:{id:"In czarist Russia, a neurotic soldier and his distant cousin formulate a plot to assassinate Napoleon."}}, {_id:6376, properties:{id:"In New York, armed men hijack a subway car and demand a ransom for the passengers. Even if it's paid, how could they get away?"}}, {_id:6382, properties:{id:"In order to ruin a western town, a corrupt politician appoints a black Sheriff, who promptly becomes his most formidable adversary."}}, {_id:6393, properties:{id:"An honest New York cop named Frank Serpico blows the whistle on rampant corruption in the force only to have his comrades turn against him."}}, {_id:6396, properties:{id:"A secret agent comes to an opium lord's island fortress with other fighters for a martial-arts tournament."}}, {_id:6406, properties:{id:"Intent on seeing the Cahulawassee River before it's dammed and turned into a lake, outdoor fanatic Lewis Medlock takes his friends on a canoeing trip they'll never forget into the dangerous American back-country."}}, {_id:6408, properties:{id:"A pair of NYC cops in the Narcotics Bureau stumble onto a drug smuggling job with a French connection."}}, {_id:6415, properties:{id:"When a madman calling himself \"the Scorpio Killer\" menaces the city, tough-as-nails San Francisco Police Inspector \"Dirty\" Harry Callahan is assigned to track down and ferret out the crazed psychopath."}}, {_id:6425, properties:{id:"Allied agents stage a daring raid on a castle where the Nazis are holding American brigadier general George Carnaby prisoner, but that's not all that's really going on."}}, {_id:6430, properties:{id:"Two friends try sharing an apartment, but their ideas of housekeeping and lifestyles are as different as night and day."}}, {_id:6434, properties:{id:"During World War II, a rebellious U.S. Army Major is assigned a dozen convicted murderers to train and lead them into a mass assassination mission of German officers."}}, {_id:6437, properties:{id:"A frigid young housewife decides to spend her midweek afternoons as a prostitute."}}, {_id:6446, properties:{id:"The story of Sir Thomas More, who stood up to King Henry VIII when the King rejected the Roman Catholic Church to obtain a divorce and remarry."}}, {_id:6451, properties:{id:"A sex-repulsed woman who disapproves of her sister's boyfriend sinks into depression and has horrific visions of rape and violence."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6456, properties:{id:"Outnumbered British soldiers do battle with Zulu warriors at Rorke's Drift."}}, {_id:6470, properties:{id:"While investigating a gold magnate's smuggling, James Bond uncovers a plot to contaminate the Fort Knox gold reserve."}}, {_id:6474, properties:{id:"A wealthy San Francisco socialite pursues a potential boyfriend to a small Northern California town that slowly takes a turn for the bizarre when birds of all kinds suddenly begin to attack people."}}, {_id:6482, properties:{id:"A lawyer's family is stalked by a man he once helped put in jail."}}, {_id:6487, properties:{id:"A young man murders women, using a movie camera to film their dying expressions of terror."}}, {_id:6490, properties:{id:"Seven gunfighters are hired by Mexican peasants to liberate their village from oppressive bandits."}}, {_id:6496, properties:{id:"A surgeon causes an accident which leaves his daughter disfigured, and goes to extremes to give her a new face."}}, {_id:6502, properties:{id:"A small-town doctor learns that the population of his community is being replaced by emotionless alien duplicates."}}, {_id:6510, properties:{id:"A rebellious young man with a troubled past comes to a new town, finding friends and enemies."}}, {_id:6519, properties:{id:"Five oddball criminals planning a bank robbery rent rooms on a cul-de-sac from an octogenarian widow under the pretext that they are classical musicians."}}, {_id:6521, properties:{id:"A playboy becomes interested in the daughter of his family's chauffeur, but it's his more serious brother who would be the better man for her."}}, {_id:6528, properties:{id:"A retired American boxer returns to the village of his birth in Ireland, where he falls for a spirited redhead whose brother is contemptuous of their union."}}, {_id:6532, properties:{id:"An alien lands and tells the people of Earth that they must live peacefully or be destroyed as a danger to other planets."}}, {_id:6539, properties:{id:"In WWI Africa, a gin-swilling riverboat captain is persuaded by a strait-laced missionary to use his boat to attack an enemy warship."}}, {_id:6547, properties:{id:"A small-time gambler hired to work in a Buenos Aires casino discovers his employer's new wife is his former lover."}}, {_id:6554, properties:{id:"A collection of animated interpretations of great works of Western classical music."}}, {_id:6560, properties:{id:"A scientist finds a way of becoming invisible, but in doing so, he becomes murderously insane."}}, {_id:6563, properties:{id:"A corporate defense attorney takes on an environmental lawsuit against a chemical company that exposes a lengthy history of pollution."}}, {_id:6573, properties:{id:"After his teenage daughter goes missing, a desperate father tries to find clues on her laptop."}}, {_id:6579, properties:{id:"A faded television actor and his stunt double strive to achieve fame and success in the final years of Hollywood's Golden Age in 1969 Los Angeles."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6588, properties:{id:"A couple going through a divorce must team up to find their son who has disappeared during one of their bitter arguments."}}, {_id:6594, properties:{id:"Set over one summer, the film follows precocious six-year-old Moonee as she courts mischief and adventure with her ragtag playmates and bonds with her rebellious but caring mother, all while living in the shadows of Walt Disney World."}}, {_id:6602, properties:{id:"World-renowned civil rights defense attorney Bryan Stevenson works to free a wrongly condemned death row prisoner."}}, {_id:6603, properties:{id:"Frank, a single man raising his child prodigy niece Mary, is drawn into a custody battle with his mother."}}, {_id:6609, properties:{id:"Zak runs away from his care home to make his dream of becoming a wrestler come true."}}, {_id:6618, properties:{id:"A young Spanish woman who has recently moved to Berlin finds her flirtation with a local guy turn potentially deadly as their night out with his friends reveals a dangerous secret."}}, {_id:6632, properties:{id:"When five orphan girls are seen innocently playing with boys on a beach, their scandalized conservative guardians confine them while forced marriages are arranged."}}, {_id:6635, properties:{id:"The Guardians struggle to keep together as a team while dealing with their personal family issues, notably Star-Lord's encounter with his father the ambitious celestial being Ego."}}, {_id:6640, properties:{id:"After being coerced into working for a crime boss, a young getaway driver finds himself taking part in a heist doomed to fail."}}, {_id:6646, properties:{id:"Based on the true story of the Granite Mountain Hotshots, a group of elite firefighters who risk everything to protect a town from a historic wildfire."}}, {_id:6652, properties:{id:"During the Cold War, an American lawyer is recruited to defend an arrested Soviet spy in court, and then help the CIA facilitate an exchange of the spy for the Soviet captured American U2 spy plane pilot, Francis Gary Powers."}}, {_id:6656, properties:{id:"The Incredibles family takes on a new mission which involves a change in family roles: Bob Parr (Mr. Incredible) must manage the house while his wife Helen (Elastigirl) goes out to save the world."}}, {_id:6663, properties:{id:"In Ancient Polynesia, when a terrible curse incurred by the Demigod Maui reaches Moana's island, she answers the Ocean's call to seek out the Demigod to set things right."}}, {_id:6668, properties:{id:"An idealistic FBI agent is enlisted by a government task force to aid in the escalating war against drugs at the border area between the U.S. and Mexico."}}, {_id:6673, properties:{id:"The former World Heavyweight Champion Rocky Balboa serves as a trainer and mentor to Adonis Johnson, the son of his late friend and former rival Apollo Creed."}}, {_id:6685, properties:{id:"In a Russian coastal town, Kolya is forced to fight the corrupt mayor when he is told that his house will be demolished. He recruits a lawyer friend to help, but the man's arrival brings further misfortune for Kolya and his family."}}, {_id:6690, properties:{id:"A divorced father and his ex-con older brother resort to a desperate scheme in order to save their family's ranch in West Texas."}}, {_id:6692, properties:{id:"A world-weary political journalist picks up the story of a woman's search for her son, who was taken away from her decades ago after she became pregnant and was forced to live in a convent."}}, {_id:6702, properties:{id:"A growing nation of genetically evolved apes led by Caesar is threatened by a band of human survivors of the devastating virus unleashed a decade earlier."}}, {_id:6710, properties:{id:"A detective searches for the body of a femme fatale which has gone missing from a morgue."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6718, properties:{id:"A S.W.A.T. team becomes trapped in a tenement run by a ruthless mobster and his army of killers and thugs."}}, {_id:6722, properties:{id:"Shot documentary-style, this film follows the daily grind of two young police officers in LA who are partners and friends, and what happens when they meet criminal forces greater than themselves."}}, {_id:6727, properties:{id:"The Clock family are four-inch-tall people who live anonymously in another family's residence, borrowing simple items to make their home. Life changes for the Clocks when their teenage daughter, Arrietty, is discovered."}}, {_id:6739, properties:{id:"A musician helps a young singer find fame as age and alcoholism send his own career into a downward spiral."}}, {_id:6743, properties:{id:"A stubborn teenager enlists the help of a tough U.S. Marshal to track down her father's murderer."}}, {_id:6752, properties:{id:"The lives of two Danish families cross each other, and an extraordinary but risky friendship comes into bud. But loneliness, frailty and sorrow lie in wait."}}, {_id:6756, properties:{id:"When a criminal mastermind uses a trio of orphan girls as pawns for a grand scheme, he finds their love is profoundly changing him for the better."}}, {_id:6761, properties:{id:"Inspired by a true story, a comedy centered on a 27-year-old guy who learns of his cancer diagnosis and his subsequent struggle to beat the disease."}}, {_id:6769, properties:{id:"Dave Lizewski is an unnoticed high school student and comic book fan who one day decides to become a superhero, even though he has no powers, training or meaningful reason to do so."}}, {_id:6779, properties:{id:"The story of two men on different sides of a prison riot -- the inmate leading the rebellion and the young guard trapped in the revolt, who poses as a prisoner in a desperate attempt to survive the ordeal."}}, {_id:6782, properties:{id:"Oakland A's general manager Billy Beane's successful attempt to assemble a baseball team on a lean budget by employing computer-generated analysis to acquire new players."}}, {_id:6786, properties:{id:"A brilliant plastic surgeon, haunted by past tragedies, creates a type of synthetic skin that withstands any kind of damage. His guinea pig: a mysterious and volatile woman who holds the key to his obsession."}}, {_id:6797, properties:{id:"A shy student trying to reach his family in Ohio, a gun-toting tough guy trying to find the last Twinkie, and a pair of sisters trying to get to an amusement park join forces to travel across a zombie-filled America."}}, {_id:6803, properties:{id:"A high school teacher's experiment to demonstrate to his students what life is like under a dictatorship spins horribly out of control when he forms a social unit with a life of its own."}}, {_id:6809, properties:{id:"Detective Sherlock Holmes and his stalwart partner Watson engage in a battle of wits and brawn with a nemesis whose plot is a threat to all of England."}}, {_id:6815, properties:{id:"The story of Michael Oher, a homeless and traumatized boy who became an All-American football player and first-round NFL draft pick with the help of a caring woman and her family."}}, {_id:6823, properties:{id:"A college professor travels to New York City to attend a conference and finds a young couple living in his apartment."}}, {_id:6832, properties:{id:"A man with a fateful secret embarks on an extraordinary journey of redemption by forever changing the lives of seven strangers."}}, {_id:6833, properties:{id:"A teenager who dies during childbirth leaves clues in her journal that could tie her child to a rape involving a violent Russian mob family."}}, {_id:6839, properties:{id:"In a countryside town bordering on a magical land, a young man makes a promise to his beloved that he'll retrieve a fallen star by venturing into the magical realm."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6847, properties:{id:"A young boy in a remote medieval outpost under siege from barbarian raids is beckoned to adventure when a celebrated master illuminator arrives with an ancient book, brimming with secret wisdom and powers."}}, {_id:6855, properties:{id:"A police detective, a bank robber, and a high-power broker enter high-stakes negotiations after the criminal's brilliant heist spirals into a hostage situation."}}, {_id:6859, properties:{id:"Two Boston area detectives investigate a little girl's kidnapping, which ultimately turns into a crisis both professionally and personally."}}, {_id:6865, properties:{id:"Biopic of the iconic French singer Édith Piaf. Raised by her grandmother in a brothel, she was discovered while singing on a street corner at the age of 19. Despite her success, Piaf's life was filled with tragedy."}}, {_id:6874, properties:{id:"A biography of Chinese Martial Arts Master Huo Yuanjia, who is the founder and spiritual guru of the Jin Wu Sports Federation."}}, {_id:6882, properties:{id:"In turn-of-the-century Vienna, a magician uses his abilities to secure the love of a woman far above his social standing."}}, {_id:6886, properties:{id:"A disaffected soldier returns to his hometown to get even with the thugs who brutalized his mentally-challenged brother years ago."}}, {_id:6893, properties:{id:"As Harry Potter begins his sixth year at Hogwarts, he discovers an old book marked as \"the property of the Half-Blood Prince\" and begins to learn more about Lord Voldemort's dark past."}}, {_id:6898, properties:{id:"King Leonidas of Sparta and a force of 300 men fight the Persians at Thermopylae in 480 B.C."}}, {_id:6903, properties:{id:"At a turning point in his life, a former tennis pro falls for an actress who happens to be dating his friend and soon-to-be brother-in-law."}}, {_id:6913, properties:{id:"In 1985 where former superheroes exist, the murder of a colleague sends active vigilante Rorschach into his own sprawling investigation, uncovering something that could completely change the course of history as we know it."}}, {_id:6915, properties:{id:"An arms dealer confronts the morality of his work as he is being chased by an INTERPOL Agent."}}, {_id:6923, properties:{id:"Two strangers awaken in a room with no recollection of how they got there, and soon discover they're pawns in a deadly game perpetrated by a notorious serial killer."}}, {_id:6931, properties:{id:"A theatre director struggles with his work, and the women in his life, as he creates a life-size replica of New York City inside a warehouse as part of his new play."}}, {_id:6933, properties:{id:"A teenage hustler and a young man obsessed with alien abductions cross paths, together discovering a horrible, liberating truth."}}, {_id:6940, properties:{id:"As adults, best friends Julien and Sophie continue the odd game they started as children -- a fearless competition to outdo one another with daring and outrageous stunts. While they often act out to relieve one another's pain, their game might be a way to avoid the fact that they are truly meant for one another."}}, {_id:6950, properties:{id:"Tells the story of a young woman's relentless search for her fiancé, who has disappeared from the trenches of the Somme during World War One."}}, {_id:6954, properties:{id:"When his only friend dies, a man born with dwarfism moves to rural New Jersey to live a life of solitude, only to meet a chatty hot dog vendor and a woman dealing with her own personal loss."}}, {_id:6965, properties:{id:"A freak accident brings together a critically ill mathematician, a grieving mother, and a born-again ex-con."}}, {_id:6972, properties:{id:"A recently laid off factory worker kidnaps his former boss' friend's daughter, hoping to use the ransom money to pay for his sister's kidney transplant."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:6976, properties:{id:"The story of Sir J.M. Barrie's friendship with a family who inspired him to create Peter Pan."}}, {_id:6978, properties:{id:"Cornered by the DEA, convicted New York drug dealer Montgomery Brogan reevaluates his life in the 24 remaining hours before facing a seven-year jail term."}}, {_id:6991, properties:{id:"Evan Treborn suffers blackouts during significant events of his life. As he grows up, he finds a way to remember these lost memories and a supernatural way to alter his life by reading his journal."}}, {_id:6998, properties:{id:"Four weeks after a mysterious, incurable virus spreads throughout the UK, a handful of survivors try to find sanctuary."}}, {_id:6999, properties:{id:"In the future, the Japanese government captures a class of ninth-grade students and forces them to kill each other under the revolutionary \"Battle Royale\" act."}}, {_id:7008, properties:{id:"The eccentric members of a dysfunctional family reluctantly gather under the same roof for various reasons."}}, {_id:7016, properties:{id:"In Mexico, two teenage boys and an attractive older woman embark on a road trip and learn a thing or two about life, friendship, sex, and each other."}}, {_id:7017, properties:{id:"An orphaned boy enrolls in a school of wizardry, where he learns the truth about himself, his family and the terrible evil that haunts the magical world."}}, {_id:7027, properties:{id:"A woman who lives in her darkened old family house with her two photosensitive children becomes convinced that the home is haunted."}}, {_id:7031, properties:{id:"The story of how George Jung, along with the Medellín Cartel headed by Pablo Escobar, established the American cocaine market in the 1970s in the United States."}}, {_id:7035, properties:{id:"A Russian and a German sniper play a game of cat-and-mouse during the Battle of Stalingrad."}}, {_id:7042, properties:{id:"In a future where a special police unit is able to arrest murderers before they commit their crimes, an officer from that unit is himself accused of a future murder."}}, {_id:7048, properties:{id:"The story of Rubin 'Hurricane' Carter, a boxer wrongly imprisoned for murder, and the people who aided in his fight to prove his innocence."}}, {_id:7055, properties:{id:"A wealthy New York City investment banking executive, Patrick Bateman, hides his alternate psychopathic ego from his co-workers and friends as he delves deeper into his violent, hedonistic fantasies."}}, {_id:7060, properties:{id:"After a botched money delivery, Lola has 20 minutes to come up with 100,000 Deutschmarks."}}, {_id:7064, properties:{id:"Adaptation of James Jones' autobiographical 1962 novel, focusing on the conflict at Guadalcanal during the second World War."}}, {_id:7068, properties:{id:"To save her father from death in the army, a young maiden secretly goes in his place and becomes one of China's greatest heroines in the process."}}, {_id:7078, properties:{id:"An oddball journalist and his psychopathic lawyer travel to Las Vegas for a series of psychedelic escapades."}}, {_id:7085, properties:{id:"Two violent young men take a mother, father, and son hostage in their vacation cabin and force them to play sadistic \"games\" with one another for their own amusement."}}, {_id:7091, properties:{id:"A man struggles with memories of his past, which include a wife he cannot remember and a nightmarish world no one else ever seems to wake up from."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:7096, properties:{id:"After a prank goes disastrously wrong, a group of boys are sent to a detention center where they are brutalized. Thirteen years later, an unexpected random encounter with a former guard gives them a chance for revenge."}}, {_id:7105, properties:{id:"Anonymous videotapes presage a musician's murder conviction, and a gangster's girlfriend leads a mechanic astray."}}, {_id:7108, properties:{id:"Rich Mr. Dashwood dies, leaving his second wife and her three daughters poor by the rules of inheritance. The two eldest daughters are the title opposites."}}, {_id:7111, properties:{id:"John McClane and a Harlem store owner are targeted by German terrorist Simon in New York City, where he plans to rob the Federal Reserve Building."}}, {_id:7117, properties:{id:"On the run after murdering a man, accountant William Blake encounters a strange aboriginal American man named Nobody who prepares him for his journey into the spiritual world."}}, {_id:7126, properties:{id:"Photographer Robert Kincaid wanders into the life of housewife Francesca Johnson for four days in the 1960s."}}, {_id:7127, properties:{id:"NASA must devise a strategy to return Apollo 13 to Earth safely after the spacecraft undergoes massive internal damage putting the lives of the three astronauts on board in jeopardy."}}, {_id:7134, properties:{id:"After his wife divorces him, a Polish immigrant plots to get even with her."}}, {_id:7140, properties:{id:"An ordinary man frustrated with the various flaws he sees in society begins to psychotically and violently lash out against them."}}, {_id:7143, properties:{id:"The adventures of high school and junior high students on the last day of school in May 1976."}}, {_id:7149, properties:{id:"Two New Yorkers accused of murder in rural Alabama while on their way back to college call in the help of one of their cousins, a loudmouth lawyer with no trial experience."}}, {_id:7162, properties:{id:"A twenty-seven-year-old office worker travels to the countryside while reminiscing about her childhood in Tokyo."}}, {_id:7166, properties:{id:"Post-apocalyptic surrealist black comedy about the landlord of an apartment building who occasionally prepares a delicacy for his odd tenants."}}, {_id:7175, properties:{id:"An eight-year-old troublemaker must protect his house from a pair of burglars when he is accidentally left home alone by his family during Christmas vacation."}}, {_id:7179, properties:{id:"Follows Michael Corleone, now in his 60s, as he seeks to free his family from crime and find a suitable successor to his empire."}}, {_id:7187, properties:{id:"Harry and Sally have known each other for years, and are very good friends, but they fear sex would ruin the friendship."}}, {_id:7192, properties:{id:"A mermaid princess makes a Faustian bargain in an attempt to become human and win a prince's love."}}, {_id:7202, properties:{id:"Incompetent police Detective Frank Drebin must foil an attempt to assassinate Queen Elizabeth II."}}, {_id:7204, properties:{id:"A man must struggle to travel home for Thanksgiving with a lovable oaf of a shower curtain ring salesman as his only companion."}}, {_id:7212, properties:{id:"Two newly paired cops who are complete opposites must put aside their differences in order to catch a gang of drug smugglers."}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Description;
UNWIND [{_id:7217, properties:{id:"The owner of a seedy small-town Texas bar discovers that one of his employees is having an affair with his wife. A chaotic chain of misunderstandings, lies and mischief ensues after he devises a plot to have them murdered."}}, {_id:7228, properties:{id:"Norman is a curmudgeon with an estranged relationship with his daughter Chelsea. At Golden Pond, he and his wife nevertheless agree to care for Billy, the son of Chelsea's new boyfriend, and a most unexpected relationship blooms."}}, {_id:7230, properties:{id:"In the post-apocalyptic Australian wasteland, a cynical drifter agrees to help a small, gasoline-rich community escape a horde of bandits."}}, {_id:7238, properties:{id:"In the near future, a charismatic leader summons the street gangs of New York City in a bid to take it over. When he is killed, The Warriors are falsely blamed and now must fight their way home while every other gang is hunting them down."}}, {_id:7245, properties:{id:"Kermit and his newfound friends trek across America to find success in Hollywood, but a frog legs merchant is after Kermit."}}, {_id:7258, properties:{id:"Alcatraz is the most secure prison of its time. It is believed that no one can ever escape from it, until three daring men make a possible successful attempt at escaping from one of the most infamous prisons in the world."}}, {_id:7265, properties:{id:"Hoping to escape destruction by human developers and save their community, a colony of rabbits, led by Hazel and Fiver, seek out a safe place to set up a new warren."}}, {_id:7274, properties:{id:"Billy Hayes, an American college student, is caught smuggling drugs out of Turkey and thrown into prison."}}, {_id:7279, properties:{id:"Roy Neary, an electric lineman, watches how his quiet and ordinary daily life turns upside down after a close encounter with a UFO."}}, {_id:7286, properties:{id:"Private investigator Philip Marlowe helps a friend out of a jam, but in doing so gets implicated in his wife's murder."}}, {_id:7293, properties:{id:"A low-life bandit and an I.R.A. explosives expert rebel against the government and become heroes of the Mexican Revolution."}}, {_id:7296, properties:{id:"A group of U.S. soldiers sneaks across enemy lines to get their hands on a secret stash of Nazi treasure."}}, {_id:7308, properties:{id:"Bagheera the Panther and Baloo the Bear have a difficult time trying to convince a boy to leave the jungle for human civilization."}}, {_id:7312, properties:{id:"A fashion photographer unknowingly captures a death on film after following two lovers in a park."}}, {_id:7317, properties:{id:"Over two \"typical\" days in the life of The Beatles, the boys struggle to keep themselves and Sir Paul McCartney's mischievous grandfather in check while preparing for a live television performance."}}, {_id:7329, properties:{id:"A young New York socialite becomes interested in a young man who has moved into her apartment building, but her past threatens to get in the way."}}, {_id:7332, properties:{id:"Sprawling epic covering the life of a Texas cattle rancher and his family and associates."}}, {_id:7339, properties:{id:"In Hawaii in 1941, a private is cruelly punished for not boxing on his unit's team, while his captain's wife and second-in-command are falling in love."}}, {_id:7346, properties:{id:"Several survivors of a torpedoed merchant ship in World War II find themselves in the same lifeboat with one of the crew members of the U-boat that sank their ship."}}, {_id:7353, properties:{id:"A man in London tries to help a counter-espionage Agent. But when the Agent is killed, and the man stands accused, he must go on the run to save himself and stop a spy ring which is trying to steal top secret information."}}] AS row

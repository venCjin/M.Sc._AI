UNWIND [{_id:6598, properties:{runtimeInMinutes:98, numberOfRatingVotes:999790, name:"WALL·E", rating:8.4, description:"In the distant future, a small waste-collecting robot inadvertently embarks on a space journey that will ultimately decide the fate of mankind.", id:"WALL·E", grossRevenue:223808164}}, {_id:6599, properties:{runtimeInMinutes:137, numberOfRatingVotes:358685, name:"The Lives of Others", rating:8.4, description:"In 1984 East Berlin, an agent of the secret police, conducting surveillance on a writer and his lover, finds himself becoming increasingly absorbed by their lives.", id:"The Lives of Others", grossRevenue:11286112}}, {_id:6600, properties:{runtimeInMinutes:101, numberOfRatingVotes:515451, name:"Oldeuboi", rating:8.4, description:"After being kidnapped and imprisoned for fifteen years, Oh Dae-Su is released, only to find that he must find his captor in five days.", id:"Oldeuboi", grossRevenue:707481}}, {_id:6601, properties:{runtimeInMinutes:113, numberOfRatingVotes:1125712, name:"Memento", rating:8.4, description:"A man with short-term memory loss attempts to track down his wife's murderer.", id:"Memento", grossRevenue:25544867}}, {_id:6602, properties:{runtimeInMinutes:134, numberOfRatingVotes:343171, name:"Mononoke-hime", rating:8.4, description:"On a journey to find the cure for a Tatarigami's curse, Ashitaka finds himself in the middle of a war between the forest gods and Tatara, a mining colony. In this quest he also meets San, the Mononoke Hime.", id:"Mononoke-hime", grossRevenue:2375308}}, {_id:6603, properties:{runtimeInMinutes:229, numberOfRatingVotes:311365, name:"Once Upon a Time in America", rating:8.4, description:"A former Prohibition-era Jewish gangster returns to the Lower East Side of Manhattan over thirty years later, where he once again must confront the ghosts and regrets of his old life.", id:"Once Upon a Time in America", grossRevenue:5321508}}, {_id:6604, properties:{runtimeInMinutes:115, numberOfRatingVotes:884112, name:"Raiders of the Lost Ark", rating:8.4, description:"In 1936, archaeologist and adventurer Indiana Jones is hired by the U.S. government to find the Ark of the Covenant before Adolf Hitler's Nazis can obtain its awesome powers.", id:"Raiders of the Lost Ark", grossRevenue:248159971}}, {_id:6605, properties:{runtimeInMinutes:146, numberOfRatingVotes:898237, name:"The Shining", rating:8.4, description:"A family heads to an isolated hotel for the winter where a sinister presence influences the father into violence, while his psychic son sees horrific forebodings from both past and future.", id:"The Shining", grossRevenue:44017374}}, {_id:6606, properties:{runtimeInMinutes:147, numberOfRatingVotes:606398, name:"Apocalypse Now", rating:8.4, description:"A U.S. Army officer serving in Vietnam is tasked with assassinating a renegade Special Forces Colonel who sees himself as a god.", id:"Apocalypse Now", grossRevenue:83471511}}, {_id:6607, properties:{runtimeInMinutes:117, numberOfRatingVotes:787806, name:"Alien", rating:8.4, description:"After a space merchant vessel receives an unknown transmission as a distress call, one of the crew is attacked by a mysterious life form and they soon realize that its life cycle has merely begun.", id:"Alien", grossRevenue:78900000}}, {_id:6608, properties:{runtimeInMinutes:122, numberOfRatingVotes:30273, name:"Anand", rating:8.4, description:"The story of a terminally ill man who wishes to live life to the fullest before the inevitable occurs, as told by his best friend.", id:"Anand"}}, {_id:6609, properties:{runtimeInMinutes:143, numberOfRatingVotes:34357, name:"Tengoku to jigoku", rating:8.4, description:"An executive of a shoe company becomes a victim of extortion when his chauffeur's son is kidnapped and held for ransom.", id:"Tengoku to jigoku"}}, {_id:6610, properties:{runtimeInMinutes:95, numberOfRatingVotes:450474, name:"Dr. Strangelove or: How I Learned to Stop Worrying and Love the Bomb", rating:8.4, description:"An insane general triggers a path to nuclear holocaust that a War Room full of politicians and generals frantically tries to stop.", id:"Dr. Strangelove or: How I Learned to Stop Worrying and Love the Bomb", grossRevenue:275902}}, {_id:6611, properties:{runtimeInMinutes:116, numberOfRatingVotes:108862, name:"Witness for the Prosecution", rating:8.4, description:"A veteran British barrister must defend his client in a murder trial that has surprise after surprise.", id:"Witness for the Prosecution", grossRevenue:8175000}}, {_id:6612, properties:{runtimeInMinutes:88, numberOfRatingVotes:178092, name:"Paths of Glory", rating:8.4, description:"After refusing to attack an enemy position, a general accuses the soldiers of cowardice and their commanding officer must defend them.", id:"Paths of Glory"}}, {_id:6613, properties:{runtimeInMinutes:112, numberOfRatingVotes:444074, name:"Rear Window", rating:8.4, description:"A wheelchair-bound photographer spies on his neighbors from his apartment window and becomes convinced one of them has committed murder.", id:"Rear Window", grossRevenue:36764313}}, {_id:6614, properties:{runtimeInMinutes:110, numberOfRatingVotes:201632, name:"Sunset Blvd.", rating:8.4, description:"A screenwriter develops a dangerous relationship with a faded film star determined to make a triumphant return.", id:"Sunset Blvd."}}, {_id:6615, properties:{runtimeInMinutes:125, numberOfRatingVotes:203150, rating:8.4, name:"The Great Dictator", description:"Dictator Adenoid Hynkel tries to expand his empire while a poor Jewish barber tries to avoid persecution from Hynkel's regime.", id:"The Great Dictator", grossRevenue:288475}}, {_id:6616, properties:{runtimeInMinutes:119, numberOfRatingVotes:425844, name:"1917", rating:8.3, description:"April 6th, 1917. As a regiment assembles to wage war deep in enemy territory, two soldiers are assigned to race against time and deliver a message that will stop 1,600 men from walking straight into a deadly trap.", id:"1917", grossRevenue:159227644}}, {_id:6617, properties:{runtimeInMinutes:104, numberOfRatingVotes:27793, name:"Tumbbad", rating:8.3, description:"A mythological story about a goddess who created the entire universe. The plot revolves around the consequences when humans build a temple for her first-born.", id:"Tumbbad"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6618, properties:{runtimeInMinutes:139, numberOfRatingVotes:71875, name:"Andhadhun", rating:8.3, description:"A series of mysterious events change the life of a blind pianist, who must now report a crime that he should technically know nothing of.", id:"Andhadhun", grossRevenue:1373943}}, {_id:6619, properties:{runtimeInMinutes:163, numberOfRatingVotes:70367, name:"Drishyam", rating:8.2, description:"Desperate measures are taken by a man who tries to save his family from the dark side of the law, after they commit an unexpected crime.", id:"Drishyam", grossRevenue:739478}}, {_id:6620, properties:{runtimeInMinutes:115, numberOfRatingVotes:281623, name:"Jagten", rating:8.3, description:"A teacher lives a lonely life, all the while struggling over his son's custody. His life slowly gets better as he finds love and receives good news from his son, but his new luck is about to be brutally shattered by an innocent little lie.", id:"Jagten", grossRevenue:687185}}, {_id:6621, properties:{runtimeInMinutes:123, numberOfRatingVotes:220002, name:"Jodaeiye Nader az Simin", rating:8.3, description:"A married couple are faced with a difficult decision - to improve the life of their child by moving to another country or to stay in Iran and look after a deteriorating parent who has Alzheimer's disease.", id:"Jodaeiye Nader az Simin", grossRevenue:7098492}}, {_id:6622, properties:{runtimeInMinutes:131, numberOfRatingVotes:150023, name:"Incendies", rating:8.3, description:"Twins journey to the Middle East to discover their family history and fulfill their mother's last wishes.", id:"Incendies", grossRevenue:6857096}}, {_id:6623, properties:{runtimeInMinutes:132, numberOfRatingVotes:33935, name:"Miracle in cell NO.7", rating:8.3, description:"A story of love between a mentally-ill father who was wrongly accused of murder and his lovely six years old daughter. The prison would be their home. Based on the 2013 Korean movie 7-beon-bang-ui seon-mul (2013).", id:"Miracle in cell NO.7"}}, {_id:6624, properties:{runtimeInMinutes:112, numberOfRatingVotes:78925, name:"Babam ve Oglum", rating:8.3, description:"The family of a left-wing journalist is torn apart after the military coup of Turkey in 1980.", id:"Babam ve Oglum"}}, {_id:6625, properties:{runtimeInMinutes:153, numberOfRatingVotes:1267869, name:"Inglourious Basterds", rating:8.3, description:"In Nazi-occupied France during World War II, a plan to assassinate Nazi leaders by a group of Jewish U.S. soldiers coincides with a theatre owner's vengeful plans for the same.", id:"Inglourious Basterds", grossRevenue:120540719}}, {_id:6626, properties:{runtimeInMinutes:108, numberOfRatingVotes:911664, name:"Eternal Sunshine of the Spotless Mind", rating:8.3, description:"When their relationship turns sour, a couple undergoes a medical procedure to have each other erased from their memories.", id:"Eternal Sunshine of the Spotless Mind", grossRevenue:34400301}}, {_id:6627, properties:{runtimeInMinutes:122, numberOfRatingVotes:703810, name:"Amélie", rating:8.3, description:"Amélie is an innocent and naive girl in Paris with her own sense of justice. She decides to help those around her and, along the way, discovers love.", id:"Amélie", grossRevenue:33225499}}, {_id:6628, properties:{runtimeInMinutes:104, numberOfRatingVotes:782001, name:"Snatch", rating:8.3, description:"Unscrupulous boxing promoters, violent bookmakers, a Russian gangster, incompetent amateur robbers and supposedly Jewish jewelers fight to track down a priceless stolen diamond.", id:"Snatch", grossRevenue:30328156}}, {_id:6629, properties:{runtimeInMinutes:102, numberOfRatingVotes:766870, name:"Requiem for a Dream", rating:8.3, description:"The drug-induced utopias of four Coney Island people are shattered when their addictions run deep.", id:"Requiem for a Dream", grossRevenue:3635482}}, {_id:6630, properties:{runtimeInMinutes:122, numberOfRatingVotes:1069738, name:"American Beauty", rating:8.3, description:"A sexually frustrated suburban father has a mid-life crisis after becoming infatuated with his daughter's best friend.", id:"American Beauty", grossRevenue:130096601}}, {_id:6631, properties:{runtimeInMinutes:126, numberOfRatingVotes:861606, name:"Good Will Hunting", rating:8.3, description:"Will Hunting, a janitor at M.I.T., has a gift for mathematics, but needs help from a psychologist to find direction in his life.", id:"Good Will Hunting", grossRevenue:138433435}}, {_id:6632, properties:{runtimeInMinutes:89, numberOfRatingVotes:65341, rating:8.3, name:"Bacheha-Ye aseman", description:"After a boy loses his sister's pair of shoes, he goes on a series of adventures in order to find them. When he can't, he tries a new way to \"win\" a new pair.", id:"Bacheha-Ye aseman", grossRevenue:933933}}, {_id:6633, properties:{runtimeInMinutes:81, numberOfRatingVotes:887429, name:"Toy Story", rating:8.3, description:"A cowboy doll is profoundly threatened and jealous when a new spaceman figure supplants him as top toy in a boy's room.", id:"Toy Story", grossRevenue:191796233}}, {_id:6634, properties:{runtimeInMinutes:178, numberOfRatingVotes:959181, name:"Braveheart", rating:8.3, description:"Scottish warrior William Wallace leads his countrymen in a rebellion to free his homeland from the tyranny of King Edward I of England.", id:"Braveheart", grossRevenue:75600000}}, {_id:6635, properties:{runtimeInMinutes:99, numberOfRatingVotes:918562, name:"Reservoir Dogs", rating:8.3, description:"When a simple jewelry heist goes horribly wrong, the surviving criminals begin to suspect that one of them is a police informant.", id:"Reservoir Dogs", grossRevenue:2832029}}, {_id:6636, properties:{runtimeInMinutes:116, numberOfRatingVotes:675146, name:"Full Metal Jacket", rating:8.3, description:"A pragmatic U.S. Marine observes the dehumanizing effects the Vietnam War has on his fellow recruits from their brutal boot camp training to the bloody street fighting in Hue.", id:"Full Metal Jacket", grossRevenue:46357676}}, {_id:6637, properties:{runtimeInMinutes:142, numberOfRatingVotes:59056, name:"Idi i smotri", rating:8.3, description:"After finding an old rifle, a young boy joins the Soviet resistance movement against ruthless German forces and experiences the horrors of World War II.", id:"Idi i smotri"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6638, properties:{runtimeInMinutes:137, numberOfRatingVotes:652719, name:"Aliens", rating:8.3, description:"Fifty-seven years after surviving an apocalyptic attack aboard her space vessel by merciless space creatures, Officer Ripley awakens from hyper-sleep and tries to warn anyone who will listen about the predators.", id:"Aliens", grossRevenue:85160248}}, {_id:6639, properties:{runtimeInMinutes:160, numberOfRatingVotes:369007, name:"Amadeus", rating:8.3, description:"The life, success and troubles of Wolfgang Amadeus Mozart, as told by Antonio Salieri, the contemporaneous composer who was insanely jealous of Mozart's talent and claimed to have murdered him.", id:"Amadeus", grossRevenue:51973029}}, {_id:6640, properties:{runtimeInMinutes:170, numberOfRatingVotes:740911, name:"Scarface", rating:8.3, description:"In 1980 Miami, a determined Cuban immigrant takes over a drug cartel and succumbs to greed.", id:"Scarface", grossRevenue:45598982}}, {_id:6641, properties:{runtimeInMinutes:131, numberOfRatingVotes:950470, name:"Star Wars: Episode VI - Return of the Jedi", rating:8.3, description:"After a daring mission to rescue Han Solo from Jabba the Hutt, the Rebels dispatch to Endor to destroy the second Death Star. Meanwhile, Luke struggles to help Darth Vader back from the dark side without falling into the Emperor's trap.", id:"Star Wars: Episode VI - Return of the Jedi", grossRevenue:309125409}}, {_id:6642, properties:{runtimeInMinutes:149, numberOfRatingVotes:231855, name:"Das Boot", rating:8.3, description:"The claustrophobic world of a WWII German U-boat; boredom, filth and sheer terror.", id:"Das Boot", grossRevenue:11487676}}, {_id:6643, properties:{runtimeInMinutes:114, numberOfRatingVotes:724636, name:"Taxi Driver", rating:8.3, description:"A mentally unstable veteran works as a nighttime taxi driver in New York City, where the perceived decadence and sleaze fuels his urge for violent action by attempting to liberate a presidential campaign worker and an underage prostitute.", id:"Taxi Driver", grossRevenue:28262574}}, {_id:6644, properties:{runtimeInMinutes:129, numberOfRatingVotes:241513, name:"The Sting", rating:8.3, description:"Two grifters team up to pull off the ultimate con.", id:"The Sting", grossRevenue:159600000}}, {_id:6645, properties:{runtimeInMinutes:136, numberOfRatingVotes:757904, name:"A Clockwork Orange", rating:8.3, description:"In the future, a sadistic gang leader is imprisoned and volunteers for a conduct-aversion experiment, but it doesn't go as planned.", id:"A Clockwork Orange", grossRevenue:6207725}}, {_id:6646, properties:{runtimeInMinutes:149, numberOfRatingVotes:603517, name:"2001: A Space Odyssey", rating:8.3, description:"After discovering a mysterious artifact buried beneath the Lunar surface, mankind sets off on a quest to find its origins with help from intelligent supercomputer H.A.L. 9000.", id:"2001: A Space Odyssey", grossRevenue:56954992}}, {_id:6647, properties:{runtimeInMinutes:132, numberOfRatingVotes:232772, name:"Per qualche dollaro in più", rating:8.3, description:"Two bounty hunters with the same intentions team up to track down a Western outlaw.", id:"Per qualche dollaro in più", grossRevenue:15000000}}, {_id:6648, properties:{runtimeInMinutes:228, numberOfRatingVotes:268085, name:"Lawrence of Arabia", rating:8.3, description:"The story of T.E. Lawrence, the English officer who successfully united and led the diverse, often warring, Arab tribes during World War I in order to fight the Turks.", id:"Lawrence of Arabia", grossRevenue:44824144}}, {_id:6649, properties:{runtimeInMinutes:125, numberOfRatingVotes:164363, name:"The Apartment", rating:8.3, description:"A man tries to rise in his company by letting its executives use his apartment for trysts, but complications and a romance of his own ensue.", id:"The Apartment", grossRevenue:18600000}}, {_id:6650, properties:{runtimeInMinutes:136, numberOfRatingVotes:299198, name:"North by Northwest", rating:8.3, description:"A New York City advertising executive goes on the run after being mistaken for a government agent by a group of foreign spies.", id:"North by Northwest", grossRevenue:13275000}}, {_id:6651, properties:{runtimeInMinutes:128, numberOfRatingVotes:364368, name:"Vertigo", rating:8.3, description:"A former police detective juggles wrestling with his personal demons and becoming obsessed with a hauntingly beautiful woman.", id:"Vertigo", grossRevenue:3200000}}, {_id:6652, properties:{runtimeInMinutes:103, numberOfRatingVotes:218957, name:"Singin' in the Rain", rating:8.3, description:"A silent film production company and cast make a difficult transition to sound.", id:"Singin' in the Rain", grossRevenue:8819028}}, {_id:6653, properties:{runtimeInMinutes:143, numberOfRatingVotes:68463, name:"Ikiru", rating:8.3, description:"A bureaucrat tries to find a meaning in his life after he discovers he has terminal cancer.", id:"Ikiru", grossRevenue:55240}}, {_id:6654, properties:{runtimeInMinutes:89, numberOfRatingVotes:146427, rating:8.3, name:"Ladri di biciclette", description:"In post-war Italy, a working-class man's bicycle is stolen. He and his son set out to find it.", id:"Ladri di biciclette", grossRevenue:332930}}, {_id:6655, properties:{runtimeInMinutes:107, numberOfRatingVotes:143525, name:"Double Indemnity", rating:8.3, description:"An insurance representative lets himself be talked by a seductive housewife into a murder/insurance fraud scheme that arouses the suspicion of an insurance investigator.", id:"Double Indemnity", grossRevenue:5720000}}, {_id:6656, properties:{runtimeInMinutes:119, numberOfRatingVotes:403351, name:"Citizen Kane", rating:8.3, description:"Following the death of publishing tycoon Charles Foster Kane, reporters scramble to uncover the meaning of his final utterance; 'Rosebud'.", id:"Citizen Kane", grossRevenue:1585634}}, {_id:6657, properties:{runtimeInMinutes:117, numberOfRatingVotes:143434, name:"M - Eine Stadt sucht einen Mörder", rating:8.3, description:"When the police in a German city are unable to catch a child-murderer, other criminals join in the manhunt.", id:"M - Eine Stadt sucht einen Mörder", grossRevenue:28877}}] AS row

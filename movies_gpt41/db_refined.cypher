UNWIND [{_id:7178, properties:{runtimeInMinutes:143, numberOfRatingVotes:524235, name:"Cast Away", rating:7.8, description:"A FedEx executive undergoes a physical and emotional transformation after crash landing on a deserted island.", id:"Cast Away", grossRevenue:233632142}}, {_id:7179, properties:{runtimeInMinutes:108, numberOfRatingVotes:227143, rating:7.8, name:"The Boondock Saints", description:"Two Irish Catholic brothers become vigilantes and wipe out Boston's criminal underworld in the name of God.", id:"The Boondock Saints", grossRevenue:25812}}, {_id:7180, properties:{runtimeInMinutes:157, numberOfRatingVotes:159886, name:"The Insider", rating:7.8, description:"A research chemist comes under personal and professional attack when he decides to appear in a 60 Minutes exposé on Big Tobacco.", id:"The Insider", grossRevenue:28965197}}, {_id:7181, properties:{runtimeInMinutes:108, numberOfRatingVotes:82855, name:"October Sky", rating:7.8, description:"The true story of Homer Hickam, a coal miner's son who was inspired by the first Sputnik launch to take up rocketry against his father's wishes.", id:"October Sky", grossRevenue:32481825}}, {_id:7182, properties:{runtimeInMinutes:90, numberOfRatingVotes:613941, name:"Shrek", rating:7.8, description:"A mean lord exiles fairytale creatures to the swamp of a grumpy ogre, who must go on a quest and rescue a princess for the lord in order to get his land back.", id:"Shrek", grossRevenue:267665011}}, {_id:7183, properties:{runtimeInMinutes:194, numberOfRatingVotes:1046089, name:"Titanic", rating:7.8, description:"A seventeen-year-old aristocrat falls in love with a kind but poor artist aboard the luxurious, ill-fated R.M.S. Titanic.", id:"Titanic", grossRevenue:659325379}}, {_id:7184, properties:{runtimeInMinutes:103, numberOfRatingVotes:27712, name:"Hana-bi", rating:7.8, description:"Nishi leaves the police in the face of harrowing personal and professional difficulties. Spiraling into depression, he makes questionable decisions.", id:"Hana-bi", grossRevenue:233986}}, {_id:7185, properties:{runtimeInMinutes:106, numberOfRatingVotes:280845, name:"Gattaca", rating:7.8, description:"A genetically inferior man assumes the identity of a superior one in order to pursue his lifelong dream of space travel.", id:"Gattaca", grossRevenue:12339633}}, {_id:7186, properties:{runtimeInMinutes:129, numberOfRatingVotes:345096, name:"The Game", rating:7.8, description:"After a wealthy banker is given an opportunity to participate in a mysterious game, his life is turned upside down when he becomes unable to distinguish between the game and reality.", id:"The Game", grossRevenue:48323648}}, {_id:7187, properties:{runtimeInMinutes:159, numberOfRatingVotes:62428, name:"Breaking the Waves", rating:7.8, description:"Oilman Jan is paralyzed in an accident. His wife, who prayed for his return, feels guilty; even more, when Jan urges her to have sex with another.", id:"Breaking the Waves", grossRevenue:4040691}}, {_id:7188, properties:{runtimeInMinutes:127, numberOfRatingVotes:164937, name:"Ed Wood", rating:7.8, description:"Ambitious but troubled movie director Edward D. Wood Jr. tries his best to fulfill his dreams, despite his lack of talent.", id:"Ed Wood", grossRevenue:5887457}}, {_id:7189, properties:{runtimeInMinutes:118, numberOfRatingVotes:215034, name:"What's Eating Gilbert Grape", rating:7.8, description:"A young man in a small Midwestern town struggles to care for his mentally-disabled younger brother and morbidly obese mother while attempting to pursue his own happiness.", id:"What's Eating Gilbert Grape", grossRevenue:9170214}}, {_id:7190, properties:{runtimeInMinutes:130, numberOfRatingVotes:126871, name:"Tombstone", rating:7.8, description:"A successful lawman's plans to retire anonymously in Tombstone, Arizona are disrupted by the kind of outlaws he was famous for eliminating.", id:"Tombstone", grossRevenue:56505065}}, {_id:7191, properties:{runtimeInMinutes:101, numberOfRatingVotes:78963, name:"The Sandlot", rating:7.8, description:"In the summer of 1962, a new kid in town is taken under the wing of a young baseball prodigy and his rowdy team, resulting in many adventures.", id:"The Sandlot", grossRevenue:32416586}}, {_id:7192, properties:{runtimeInMinutes:134, numberOfRatingVotes:66065, name:"The Remains of the Day", rating:7.8, description:"A butler who sacrificed body and soul to service in the years leading up to World War II realizes too late how misguided his loyalty was to his lordly employer.", id:"The Remains of the Day", grossRevenue:22954968}}, {_id:7193, properties:{runtimeInMinutes:132, numberOfRatingVotes:34635, name:"Naked", rating:7.8, description:"Parallel tales of two sexually obsessed men, one hurting and annoying women physically and mentally, one wandering around the city talking to strangers and experiencing dimensions of life.", id:"Naked", grossRevenue:1769305}}, {_id:7194, properties:{runtimeInMinutes:130, numberOfRatingVotes:267684, name:"The Fugitive", rating:7.8, description:"Dr. Richard Kimble, unjustly accused of murdering his wife, must find the real killer while being the target of a nationwide manhunt led by a seasoned U.S. Marshal.", id:"The Fugitive", grossRevenue:183875760}}, {_id:7195, properties:{runtimeInMinutes:121, numberOfRatingVotes:128171, name:"A Bronx Tale", rating:7.8, description:"A father becomes worried when a local gangster befriends his son in the Bronx in the 1960s.", id:"A Bronx Tale", grossRevenue:17266971}}, {_id:7196, properties:{runtimeInMinutes:76, numberOfRatingVotes:43690, name:"Batman: Mask of the Phantasm", rating:7.8, description:"Batman is wrongly implicated in a series of murders of mob bosses actually done by a new vigilante assassin.", id:"Batman: Mask of the Phantasm", grossRevenue:5617391}}, {_id:7197, properties:{runtimeInMinutes:128, numberOfRatingVotes:46700, name:"Lat sau san taam", rating:7.8, description:"A tough-as-nails cop teams up with an undercover agent to shut down a sinister mobster and his crew.", id:"Lat sau san taam"}}] AS row

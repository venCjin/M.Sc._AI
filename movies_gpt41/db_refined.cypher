UNWIND [{_id:7078, properties:{runtimeInMinutes:113, numberOfRatingVotes:68689, name:"Charade", rating:7.9, description:"Romance and suspense ensue in Paris as a woman is pursued by several men who want a fortune her murdered husband had stolen. Whom can she trust?", id:"Charade", grossRevenue:13474588}}, {_id:7079, properties:{runtimeInMinutes:126, numberOfRatingVotes:71122, name:"The Manchurian Candidate", rating:7.9, description:"A former prisoner of war is brainwashed as an unwitting assassin for an international Communist conspiracy.", id:"The Manchurian Candidate"}}, {_id:7080, properties:{runtimeInMinutes:197, numberOfRatingVotes:124339, name:"Spartacus", rating:7.9, description:"The slave Spartacus leads a violent revolt against the decadent Roman Republic.", id:"Spartacus", grossRevenue:30000000}}, {_id:7081, properties:{runtimeInMinutes:144, numberOfRatingVotes:26542, name:"L'avventura", rating:7.9, description:"A woman disappears during a Mediterranean boating trip. During the search, her lover and her best friend become attracted to each other.", id:"L'avventura"}}, {_id:7082, properties:{runtimeInMinutes:90, numberOfRatingVotes:28421, rating:7.9, name:"Hiroshima mon amour", description:"A French actress filming an anti-war film in Hiroshima has an affair with a married Japanese architect as they share their differing perspectives on war.", id:"Hiroshima mon amour", grossRevenue:88300}}, {_id:7083, properties:{runtimeInMinutes:220, numberOfRatingVotes:63560, name:"The Ten Commandments", rating:7.9, description:"Moses, an Egyptian Prince, learns of his true heritage as a Hebrew and his divine mission as the deliverer of his people.", id:"The Ten Commandments", grossRevenue:93740000}}, {_id:7084, properties:{runtimeInMinutes:119, numberOfRatingVotes:80316, name:"The Searchers", rating:7.9, description:"An American Civil War veteran embarks on a journey to rescue his niece from the Comanches.", id:"The Searchers"}}, {_id:7085, properties:{runtimeInMinutes:118, numberOfRatingVotes:40313, name:"East of Eden", rating:7.9, description:"Two brothers struggle to maintain their strict, Bible-toting father's favor.", id:"East of Eden"}}, {_id:7086, properties:{runtimeInMinutes:85, numberOfRatingVotes:97222, name:"High Noon", rating:7.9, description:"A town Marshal, despite the disagreements of his newlywed bride and the townspeople around him, must face a gang of deadly killers alone at high noon when the gang leader, an outlaw he sent up years ago, arrives on the noon train.", id:"High Noon", grossRevenue:9450000}}, {_id:7087, properties:{runtimeInMinutes:101, numberOfRatingVotes:123341, name:"Strangers on a Train", rating:7.9, description:"A psychopath forces a tennis star to comply with his theory that two strangers can get away with murder.", id:"Strangers on a Train", grossRevenue:7630000}}, {_id:7088, properties:{runtimeInMinutes:104, numberOfRatingVotes:52573, name:"Harvey", rating:7.9, description:"Due to his insistence that he has an invisible six foot-tall rabbit for a best friend, a whimsical middle-aged man is thought by his family to be insane - but he may be wiser than anyone knows.", id:"Harvey"}}, {_id:7089, properties:{runtimeInMinutes:96, numberOfRatingVotes:41625, name:"Miracle on 34th Street", rating:7.9, description:"When a nice old man who claims to be Santa Claus is institutionalized as insane, a young lawyer decides to defend him by arguing in court that he is the real thing.", id:"Miracle on 34th Street", grossRevenue:2650000}}, {_id:7090, properties:{runtimeInMinutes:102, numberOfRatingVotes:92306, name:"Notorious", rating:7.9, description:"A woman is asked to spy on a group of Nazi friends in South America. How far will she have to go to ingratiate herself with them?", id:"Notorious", grossRevenue:10464000}}, {_id:7091, properties:{runtimeInMinutes:114, numberOfRatingVotes:78796, name:"The Big Sleep", rating:7.9, description:"Private detective Philip Marlowe is hired by a wealthy family. Before the complex case is over, he's seen murder, blackmail, and what might be love.", id:"The Big Sleep", grossRevenue:6540000}}, {_id:7092, properties:{runtimeInMinutes:101, numberOfRatingVotes:33549, name:"The Lost Weekend", rating:7.9, description:"The desperate life of a chronic alcoholic is followed through a four-day drinking bout.", id:"The Lost Weekend", grossRevenue:9460000}}, {_id:7093, properties:{runtimeInMinutes:112, numberOfRatingVotes:63550, name:"The Philadelphia Story", rating:7.9, description:"When a rich woman's ex-husband and a tabloid-type reporter turn up just before her planned remarriage, she begins to learn the truth about herself.", id:"The Philadelphia Story"}}, {_id:7094, properties:{runtimeInMinutes:92, numberOfRatingVotes:53667, rating:7.9, name:"His Girl Friday", description:"A newspaper editor uses every trick in the book to keep his ace reporter ex-wife from remarrying.", id:"His Girl Friday", grossRevenue:296000}}, {_id:7095, properties:{runtimeInMinutes:102, numberOfRatingVotes:47175, name:"The Adventures of Robin Hood", rating:7.9, description:"When Prince John and the Norman Lords begin oppressing the Saxon masses in King Richard's absence, a Saxon lord fights back as the outlaw leader of a rebel guerrilla army.", id:"The Adventures of Robin Hood", grossRevenue:3981000}}, {_id:7096, properties:{runtimeInMinutes:96, numberOfRatingVotes:30580, name:"A Night at the Opera", rating:7.9, description:"A sly business manager and two wacky friends of two opera singers help them achieve success while humiliating their stuffy and snobbish enemies.", id:"A Night at the Opera", grossRevenue:2537520}}, {_id:7097, properties:{runtimeInMinutes:100, numberOfRatingVotes:78991, name:"King Kong", rating:7.9, description:"A film crew goes to a tropical island for an exotic location shoot and discovers a colossal ape who takes a shine to their female blonde star. He is then captured and brought back to New York City for public exhibition.", id:"King Kong", grossRevenue:10000000}}] AS row

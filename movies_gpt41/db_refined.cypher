UNWIND [{_id:7118, properties:{runtimeInMinutes:119, numberOfRatingVotes:51841, name:"Pride", rating:7.8, description:"U.K. gay activists work to help miners during their lengthy strike of the National Union of Mineworkers in the summer of 1984.", id:"Pride"}}, {_id:7119, properties:{runtimeInMinutes:130, numberOfRatingVotes:45002, name:"Le passé", rating:7.8, description:"An Iranian man deserts his French wife and her two children to return to his homeland. Meanwhile, his wife starts up a new relationship, a reality her husband confronts upon his wife's request for a divorce.", id:"Le passé", grossRevenue:1330596}}, {_id:7120, properties:{runtimeInMinutes:141, numberOfRatingVotes:81125, name:"La grande bellezza", rating:7.8, description:"Jep Gambardella has seduced his way through the lavish nightlife of Rome for decades, but after his 65th birthday and a shock from the past, Jep looks past the nightclubs and parties to find a timeless landscape of absurd, exquisite beauty.", id:"La grande bellezza", grossRevenue:2852400}}, {_id:7121, properties:{runtimeInMinutes:104, numberOfRatingVotes:50523, name:"The Lunchbox", rating:7.8, description:"A mistaken delivery in Mumbai's famously efficient lunchbox delivery system connects a young housewife to an older man in the dusk of his life as they build a fantasy world together through notes in the lunchbox.", id:"The Lunchbox", grossRevenue:4231500}}, {_id:7122, properties:{runtimeInMinutes:126, numberOfRatingVotes:39710, name:"Vicky Donor", rating:7.8, description:"A man is brought in by an infertility doctor to supply him with his sperm, where he becomes the biggest sperm donor for his clinic.", id:"Vicky Donor", grossRevenue:169209}}, {_id:7123, properties:{runtimeInMinutes:102, numberOfRatingVotes:410983, name:"Big Hero 6", rating:7.8, description:"A special bond develops between plus-sized inflatable robot Baymax and prodigy Hiro Hamada, who together team up with a group of friends to form a band of high-tech heroes.", id:"Big Hero 6", grossRevenue:222527828}}, {_id:7124, properties:{runtimeInMinutes:123, numberOfRatingVotes:303032, name:"About Time", rating:7.8, description:"At the age of 21, Tim discovers he can travel in time and change what happens and has happened in his own life. His decision to make his world a better place by getting a girlfriend turns out not to be as easy as you might think.", id:"About Time", grossRevenue:15322921}}, {_id:7125, properties:{runtimeInMinutes:134, numberOfRatingVotes:33618, name:"English Vinglish", rating:7.8, description:"A quiet, sweet tempered housewife endures small slights from her well-educated husband and daughter every day because of her inability to speak and understand English.", id:"English Vinglish", grossRevenue:1670773}}, {_id:7126, properties:{runtimeInMinutes:126, numberOfRatingVotes:73690, name:"Kaze tachinu", rating:7.8, description:"A look at the life of Jiro Horikoshi, the man who designed Japanese fighter planes during World War II.", id:"Kaze tachinu", grossRevenue:5209580}}, {_id:7127, properties:{runtimeInMinutes:100, numberOfRatingVotes:203177, name:"Toy Story 4", rating:7.8, description:"When a new toy called \"Forky\" joins Woody and the gang, a road trip alongside old and new friends reveals how big the world can be for a toy.", id:"Toy Story 4", grossRevenue:434038008}}, {_id:7128, properties:{runtimeInMinutes:131, numberOfRatingVotes:108399, rating:7.8, name:"La migliore offerta", description:"A lonely art expert working for a mysterious and reclusive heiress finds not only her art worth examining.", id:"La migliore offerta", grossRevenue:85433}}, {_id:7129, properties:{runtimeInMinutes:94, numberOfRatingVotes:318789, name:"Moonrise Kingdom", rating:7.8, description:"A pair of young lovers flee their New England town, which causes a local search party to fan out to find them.", id:"Moonrise Kingdom", grossRevenue:45512466}}, {_id:7130, properties:{runtimeInMinutes:102, numberOfRatingVotes:305611, name:"How to Train Your Dragon 2", rating:7.8, description:"When Hiccup and Toothless discover an ice cave that is home to hundreds of new wild dragons and the mysterious Dragon Rider, the two friends find themselves at the center of a battle to protect the peace.", id:"How to Train Your Dragon 2", grossRevenue:177002924}}, {_id:7131, properties:{runtimeInMinutes:130, numberOfRatingVotes:362942, name:"The Big Short", rating:7.8, description:"In 2006-2007 a group of investors bet against the US mortgage market. In their research they discover how flawed and corrupt the market is.", id:"The Big Short", grossRevenue:70259870}}, {_id:7132, properties:{runtimeInMinutes:106, numberOfRatingVotes:35713, name:"Kokuhaku", rating:7.8, description:"A psychological thriller of a grieving mother turned cold-blooded avenger with a twisty master plan to pay back those who were responsible for her daughter's death.", id:"Kokuhaku"}}, {_id:7133, properties:{runtimeInMinutes:144, numberOfRatingVotes:111252, rating:7.8, name:"Ang-ma-reul bo-at-da", description:"A secret agent exacts revenge on a serial killer through a series of captures and releases.", id:"Ang-ma-reul bo-at-da", grossRevenue:128392}}, {_id:7134, properties:{runtimeInMinutes:158, numberOfRatingVotes:423010, name:"The Girl with the Dragon Tattoo", rating:7.8, description:"Journalist Mikael Blomkvist is aided in his search for a woman who has been missing for forty years by Lisbeth Salander, a young computer hacker.", id:"The Girl with the Dragon Tattoo", grossRevenue:102515793}}, {_id:7135, properties:{runtimeInMinutes:134, numberOfRatingVotes:421244, name:"Captain Phillips", rating:7.8, description:"The true story of Captain Richard Phillips and the 2009 hijacking by Somali pirates of the U.S.-flagged MV Maersk Alabama, the first American cargo ship to be hijacked in two hundred years.", id:"Captain Phillips", grossRevenue:107100855}}, {_id:7136, properties:{runtimeInMinutes:119, numberOfRatingVotes:62848, name:"Ajeossi", rating:7.8, description:"A quiet pawnshop keeper with a violent past takes on a drug-and-organ trafficking ring in hope of saving the child who is his only friend.", id:"Ajeossi", grossRevenue:6460}}, {_id:7137, properties:{runtimeInMinutes:147, numberOfRatingVotes:179264, name:"Straight Outta Compton", rating:7.8, description:"The rap group NWA emerges from the mean streets of Compton in Los Angeles, California, in the mid-1980s and revolutionizes Hip Hop culture with their music and tales about life in the hood.", id:"Straight Outta Compton", grossRevenue:161197785}}] AS row

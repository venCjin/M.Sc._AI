UNWIND [{_id:7198, properties:{runtimeInMinutes:129, numberOfRatingVotes:55362, name:"Night on Earth", rating:7.8, description:"An anthology of 5 different cab drivers in 5 American and European cities and their remarkable fares on the same eventful night.", id:"Night on Earth", grossRevenue:2015810}}, {_id:7199, properties:{runtimeInMinutes:98, numberOfRatingVotes:42376, name:"La double vie de Véronique", rating:7.8, description:"Two parallel stories about two identical women; one living in Poland, the other in France. They don't know each other, but their lives are nevertheless profoundly connected.", id:"La double vie de Véronique", grossRevenue:1999955}}, {_id:7200, properties:{runtimeInMinutes:112, numberOfRatingVotes:126082, name:"Boyz n the Hood", rating:7.8, description:"Follows the lives of three young males living in the Crenshaw ghetto of Los Angeles, dissecting questions of race, relationships, violence, and future prospects.", id:"Boyz n the Hood", grossRevenue:57504069}}, {_id:7201, properties:{runtimeInMinutes:107, numberOfRatingVotes:184740, name:"Misery", rating:7.8, description:"After a famous author is rescued from a car crash by a fan of his novels, he comes to realize that the care he is receiving is only the beginning of a nightmare of captivity and abuse.", id:"Misery", grossRevenue:61276872}}, {_id:7202, properties:{runtimeInMinutes:121, numberOfRatingVotes:125276, name:"Awakenings", rating:7.8, description:"The victims of an encephalitis epidemic many years ago have been catatonic ever since, but now a new drug offers the prospect of reviving them.", id:"Awakenings", grossRevenue:52096475}}, {_id:7203, properties:{runtimeInMinutes:103, numberOfRatingVotes:124193, name:"Majo no takkyûbin", rating:7.8, description:"A young witch, on her mandatory year of independent life, finds fitting into a new community difficult while she supports herself by running an air courier service.", id:"Majo no takkyûbin"}}, {_id:7204, properties:{runtimeInMinutes:122, numberOfRatingVotes:122779, name:"Glory", rating:7.8, description:"Robert Gould Shaw leads the U.S. Civil War's first all-black volunteer company, fighting prejudices from both his own Union Army, and the Confederates.", id:"Glory", grossRevenue:26830000}}, {_id:7205, properties:{runtimeInMinutes:111, numberOfRatingVotes:45624, name:"Dip huet seung hung", rating:7.8, description:"A disillusioned assassin accepts one last hit in hopes of using his earnings to restore vision to a singer he accidentally blinded.", id:"Dip huet seung hung"}}, {_id:7206, properties:{runtimeInMinutes:108, numberOfRatingVotes:481918, name:"Back to the Future Part II", rating:7.8, description:"After visiting 2015, Marty McFly must repeat his visit to 1955 to prevent disastrous changes to 1985...without interfering with his first trip.", id:"Back to the Future Part II", grossRevenue:118500000}}, {_id:7207, properties:{runtimeInMinutes:128, numberOfRatingVotes:88214, name:"Mississippi Burning", rating:7.8, description:"Two F.B.I. Agents with wildly different styles arrive in Mississippi to investigate the disappearance of some civil rights activists.", id:"Mississippi Burning", grossRevenue:34603943}}, {_id:7208, properties:{runtimeInMinutes:107, numberOfRatingVotes:371387, name:"Predator", rating:7.8, description:"A team of commandos on a mission in a Central American jungle find themselves hunted by an extraterrestrial warrior.", id:"Predator", grossRevenue:59735548}}, {_id:7209, properties:{runtimeInMinutes:84, numberOfRatingVotes:148359, name:"Evil Dead II", rating:7.8, description:"The lone survivor of an onslaught of flesh-possessing spirits holes up in a cabin with a group of strangers while the demons continue their attack.", id:"Evil Dead II", grossRevenue:5923044}}, {_id:7210, properties:{runtimeInMinutes:103, numberOfRatingVotes:321382, name:"Ferris Bueller's Day Off", rating:7.8, description:"A high school wise guy is determined to have a day off from school, despite what the Principal thinks of that.", id:"Ferris Bueller's Day Off", grossRevenue:70136369}}, {_id:7211, properties:{runtimeInMinutes:107, numberOfRatingVotes:47834, name:"Down by Law", rating:7.8, description:"Two men are framed and sent to jail, where they meet a murderer who helps them escape and leave the state.", id:"Down by Law", grossRevenue:1436000}}, {_id:7212, properties:{runtimeInMinutes:114, numberOfRatingVotes:244430, name:"The Goonies", rating:7.8, description:"A group of young misfits called The Goonies discover an ancient map and set out on an adventure to find a legendary pirate's long-lost treasure.", id:"The Goonies", grossRevenue:61503218}}, {_id:7213, properties:{runtimeInMinutes:154, numberOfRatingVotes:78321, name:"The Color Purple", rating:7.8, description:"A black Southern woman struggles to find her identity after suffering abuse from her father and others over four decades.", id:"The Color Purple", grossRevenue:98467863}}, {_id:7214, properties:{runtimeInMinutes:97, numberOfRatingVotes:357026, name:"The Breakfast Club", rating:7.8, description:"Five high school students meet in Saturday detention and discover how they have a lot more in common than they thought.", id:"The Breakfast Club", grossRevenue:45875171}}, {_id:7215, properties:{runtimeInMinutes:141, numberOfRatingVotes:51585, name:"The Killing Fields", rating:7.8, description:"A journalist is trapped in Cambodia during tyrant Pol Pot's bloody 'Year Zero' cleansing campaign, which claimed the lives of two million 'undesirable' civilians.", id:"The Killing Fields", grossRevenue:34700291}}, {_id:7216, properties:{runtimeInMinutes:105, numberOfRatingVotes:355413, name:"Ghostbusters", rating:7.8, description:"Three former parapsychology professors set up shop as a unique ghost removal service.", id:"Ghostbusters", grossRevenue:238632124}}, {_id:7217, properties:{runtimeInMinutes:193, numberOfRatingVotes:56235, name:"The Right Stuff", rating:7.8, description:"The story of the original Mercury 7 astronauts and their macho, seat-of-the-pants approach to the space program.", id:"The Right Stuff", grossRevenue:21500000}}] AS row

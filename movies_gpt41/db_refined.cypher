UNWIND [{_id:7338, properties:{runtimeInMinutes:126, numberOfRatingVotes:434125, name:"The Fifth Element", rating:7.7, description:"In the colorful future, a cab driver unwittingly becomes the central figure in the search for a legendary cosmic weapon to keep Evil and Mr. Zorg at bay.", id:"The Fifth Element", grossRevenue:63540020}}, {_id:7339, properties:{runtimeInMinutes:80, numberOfRatingVotes:37424, name:"Le dîner de cons", rating:7.7, description:"A few friends have a weekly fools' dinner, where each brings a fool along. Pierre finds a champion fool for next dinner. Surprise.", id:"Le dîner de cons", grossRevenue:4065116}}, {_id:7340, properties:{runtimeInMinutes:127, numberOfRatingVotes:279318, name:"Donnie Brasco", rating:7.7, description:"An FBI undercover agent infiltrates the mob and finds himself identifying more with the mafia life, at the expense of his regular one.", id:"Donnie Brasco", grossRevenue:41909762}}, {_id:7341, properties:{runtimeInMinutes:105, numberOfRatingVotes:51350, name:"Shine", rating:7.7, description:"Pianist David Helfgott, driven by his father and teachers, has a breakdown. Years later he returns to the piano, to popular if not critical acclaim.", id:"Shine", grossRevenue:35811509}}, {_id:7342, properties:{runtimeInMinutes:129, numberOfRatingVotes:189716, name:"Primal Fear", rating:7.7, description:"An altar boy is accused of murdering a priest, and the truth is buried several layers deep.", id:"Primal Fear", grossRevenue:56116183}}, {_id:7343, properties:{runtimeInMinutes:242, numberOfRatingVotes:35991, name:"Hamlet", rating:7.7, description:"Hamlet, Prince of Denmark, returns home to find his father murdered and his mother remarrying the murderer, his uncle. Meanwhile, war is brewing.", id:"Hamlet", grossRevenue:4414535}}, {_id:7344, properties:{runtimeInMinutes:97, numberOfRatingVotes:32236, name:"A Little Princess", rating:7.7, description:"A young girl is relegated to servitude at a boarding school when her father goes missing and is presumed dead.", id:"A Little Princess", grossRevenue:10019307}}, {_id:7345, properties:{runtimeInMinutes:99, numberOfRatingVotes:26429, name:"Do lok tin si", rating:7.7, description:"This Hong Kong-set crime drama follows the lives of a hitman, hoping to get out of the business, and his elusive female partner.", id:"Do lok tin si"}}, {_id:7346, properties:{runtimeInMinutes:108, numberOfRatingVotes:33600, name:"Il postino", rating:7.7, description:"A simple Italian postman learns to love poetry while delivering mail to a famous poet, and then uses this to woo local beauty Beatrice.", id:"Il postino", grossRevenue:21848932}}, {_id:7347, properties:{runtimeInMinutes:92, numberOfRatingVotes:211450, name:"Clerks", rating:7.7, description:"A day in the lives of two convenience clerks named Dante and Randal as they annoy customers, discuss movies, and play hockey on the store roof.", id:"Clerks", grossRevenue:3151130}}, {_id:7348, properties:{runtimeInMinutes:188, numberOfRatingVotes:42275, name:"Short Cuts", rating:7.7, description:"The day-to-day lives of several suburban Los Angeles residents.", id:"Short Cuts", grossRevenue:6110979}}, {_id:7349, properties:{runtimeInMinutes:125, numberOfRatingVotes:224169, name:"Philadelphia", rating:7.7, description:"When a man with HIV is fired by his law firm because of his condition, he hires a homophobic small time lawyer as the only willing advocate for a wrongful dismissal suit.", id:"Philadelphia", grossRevenue:77324422}}, {_id:7350, properties:{runtimeInMinutes:85, numberOfRatingVotes:50298, name:"The Muppet Christmas Carol", rating:7.7, description:"The Muppet characters tell their version of the classic tale of an old and bitter miser's redemption on Christmas Eve.", id:"The Muppet Christmas Carol", grossRevenue:27281507}}, {_id:7351, properties:{runtimeInMinutes:202, numberOfRatingVotes:85819, name:"Malcolm X", rating:7.7, description:"Biographical epic of the controversial and influential Black Nationalist leader, from his early life and career as a small-time gangster, to his ministry as a member of the Nation of Islam.", id:"Malcolm X", grossRevenue:48169908}}, {_id:7352, properties:{runtimeInMinutes:112, numberOfRatingVotes:150409, name:"The Last of the Mohicans", rating:7.7, description:"Three trappers protect the daughters of a British Colonel in the midst of the French and Indian War.", id:"The Last of the Mohicans", grossRevenue:75505856}}, {_id:7353, properties:{runtimeInMinutes:94, numberOfRatingVotes:77798, name:"Kurenai no buta", rating:7.7, description:"In 1930s Italy, a veteran World War I pilot is cursed to look like an anthropomorphic pig.", id:"Kurenai no buta"}}, {_id:7354, properties:{runtimeInMinutes:100, numberOfRatingVotes:95826, name:"Glengarry Glen Ross", rating:7.7, description:"An examination of the machinations behind the scenes at a real estate office.", id:"Glengarry Glen Ross", grossRevenue:10725228}}, {_id:7355, properties:{runtimeInMinutes:138, numberOfRatingVotes:235388, name:"A Few Good Men", rating:7.7, description:"Military lawyer Lieutenant Daniel Kaffee defends Marines accused of murder. They contend they were acting under orders.", id:"A Few Good Men", grossRevenue:141340178}}, {_id:7356, properties:{runtimeInMinutes:130, numberOfRatingVotes:66941, name:"Fried Green Tomatoes", rating:7.7, description:"A housewife who is unhappy with her life befriends an old lady in a nursing home and is enthralled by the tales she tells of people she used to know.", id:"Fried Green Tomatoes", grossRevenue:82418501}}, {_id:7357, properties:{runtimeInMinutes:116, numberOfRatingVotes:113240, name:"Barton Fink", rating:7.7, description:"A renowned New York playwright is enticed to California to write for the movies and discovers the hellish truth of Hollywood.", id:"Barton Fink", grossRevenue:6153939}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:7358, properties:{runtimeInMinutes:115, numberOfRatingVotes:125822, name:"Miller's Crossing", rating:7.7, description:"Tom Reagan, an advisor to a Prohibition-era crime boss, tries to keep the peace between warring mobs but gets caught in divided loyalties.", id:"Miller's Crossing", grossRevenue:5080409}}, {_id:7359, properties:{runtimeInMinutes:104, numberOfRatingVotes:182009, name:"Who Framed Roger Rabbit", rating:7.7, description:"A toon-hating detective is a cartoon rabbit's only hope to prove his innocence when he is accused of murder.", id:"Who Framed Roger Rabbit", grossRevenue:156452370}}, {_id:7360, properties:{runtimeInMinutes:107, numberOfRatingVotes:33982, name:"Spoorloos", rating:7.7, description:"Rex and Saskia, a young couple in love, are on vacation. They stop at a busy service station and Saskia is abducted. After three years and no sign of Saskia, Rex begins receiving letters from the abductor.", id:"Spoorloos"}}, {_id:7361, properties:{runtimeInMinutes:107, numberOfRatingVotes:40396, name:"Withnail & I", rating:7.7, description:"In 1969, two substance-abusing, unemployed actors retreat to the countryside for a holiday that proves disastrous.", id:"Withnail & I", grossRevenue:1544889}}, {_id:7362, properties:{runtimeInMinutes:163, numberOfRatingVotes:94326, name:"The Last Emperor", rating:7.7, description:"The story of the final Emperor of China.", id:"The Last Emperor", grossRevenue:43984230}}, {_id:7363, properties:{runtimeInMinutes:153, numberOfRatingVotes:115677, name:"Empire of the Sun", rating:7.7, description:"A young English boy struggles to survive under Japanese occupation during World War II.", id:"Empire of the Sun", grossRevenue:22238696}}, {_id:7364, properties:{runtimeInMinutes:130, numberOfRatingVotes:102031, name:"Der Name der Rose", rating:7.7, description:"An intellectually nonconformist friar investigates a series of mysterious deaths in an isolated abbey.", id:"Der Name der Rose", grossRevenue:7153487}}, {_id:7365, properties:{runtimeInMinutes:120, numberOfRatingVotes:181285, name:"Blue Velvet", rating:7.7, description:"The discovery of a severed human ear found in a field leads a young man on an investigation related to a beautiful, mysterious nightclub singer and a group of psychopathic criminals who have kidnapped her child.", id:"Blue Velvet", grossRevenue:8551228}}, {_id:7366, properties:{runtimeInMinutes:82, numberOfRatingVotes:47102, name:"The Purple Rose of Cairo", rating:7.7, description:"In New Jersey in 1935, a movie character walks off the screen and into the real world.", id:"The Purple Rose of Cairo", grossRevenue:10631333}}, {_id:7367, properties:{runtimeInMinutes:97, numberOfRatingVotes:59635, name:"After Hours", rating:7.7, description:"An ordinary word processor has the worst night of his life after he agrees to visit a girl in Soho who he met that evening at a coffee shop.", id:"After Hours", grossRevenue:10600000}}, {_id:7368, properties:{runtimeInMinutes:79, numberOfRatingVotes:39881, name:"Zelig", rating:7.7, description:"\"Documentary\" about a man who can look and act like whoever he's around, and meets various famous people.", id:"Zelig", grossRevenue:11798616}}, {_id:7369, properties:{runtimeInMinutes:129, numberOfRatingVotes:36096, name:"The Verdict", rating:7.7, description:"A lawyer sees the chance to salvage his career and self-respect by taking a medical malpractice case to trial rather than settling.", id:"The Verdict", grossRevenue:54000000}}, {_id:7370, properties:{runtimeInMinutes:113, numberOfRatingVotes:112704, name:"Star Trek II: The Wrath of Khan", rating:7.7, description:"With the assistance of the Enterprise crew, Admiral Kirk must stop an old nemesis, Khan Noonien Singh, from using the life-generating Genesis Device as the ultimate weapon.", id:"Star Trek II: The Wrath of Khan", grossRevenue:78912963}}, {_id:7371, properties:{runtimeInMinutes:93, numberOfRatingVotes:226541, name:"First Blood", rating:7.7, description:"A veteran Green Beret is forced by a cruel Sheriff and his deputies to flee into the mountains and wage an escalating one-man war against his pursuers.", id:"First Blood", grossRevenue:47212904}}, {_id:7372, properties:{runtimeInMinutes:124, numberOfRatingVotes:47099, name:"Ordinary People", rating:7.7, description:"The accidental death of the older son of an affluent family deeply strains the relationships among the bitter mother, the good-natured father, and the guilt-ridden younger son.", id:"Ordinary People", grossRevenue:54800000}}, {_id:7373, properties:{runtimeInMinutes:88, numberOfRatingVotes:214882, name:"Airplane!", rating:7.7, description:"A man afraid to fly must ensure that a plane lands safely after the pilots become sick.", id:"Airplane!", grossRevenue:83400000}}, {_id:7374, properties:{runtimeInMinutes:100, numberOfRatingVotes:27014, rating:7.7, name:"Rupan sansei: Kariosutoro no shiro", description:"A dashing thief, his gang of desperadoes and an intrepid policeman struggle to free a princess from an evil count's clutches, and learn the hidden secret to a fabulous treasure that she holds part of a key to.", id:"Rupan sansei: Kariosutoro no shiro"}}, {_id:7375, properties:{runtimeInMinutes:91, numberOfRatingVotes:233106, name:"Halloween", rating:7.7, description:"Fifteen years after murdering his sister on Halloween night 1963, Michael Myers escapes from a mental hospital and returns to the small town of Haddonfield, Illinois to kill again.", id:"Halloween", grossRevenue:47000000}}, {_id:7376, properties:{runtimeInMinutes:126, numberOfRatingVotes:39889, name:"Le locataire", rating:7.7, description:"A bureaucrat rents a Paris apartment where he finds himself drawn into a rabbit hole of dangerous paranoia.", id:"Le locataire", grossRevenue:1924733}}] AS row

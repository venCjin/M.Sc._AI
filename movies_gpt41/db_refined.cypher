UNWIND [{_id:7158, properties:{runtimeInMinutes:121, numberOfRatingVotes:463466, name:"Hot Fuzz", rating:7.8, description:"A skilled London police officer is transferred to a small town with a dark secret.", id:"Hot Fuzz", grossRevenue:23637265}}, {_id:7159, properties:{runtimeInMinutes:166, numberOfRatingVotes:589160, name:"The Curious Case of Benjamin Button", rating:7.8, description:"Tells the story of Benjamin Button, a man who starts aging backwards with consequences.", id:"The Curious Case of Benjamin Button", grossRevenue:127509326}}, {_id:7160, properties:{runtimeInMinutes:192, numberOfRatingVotes:49050, name:"Veer-Zaara", rating:7.8, description:"Veer-Zaara is a saga of love, separation, courage and sacrifice. A love story that is an inspiration and will remain a legend forever.", id:"Veer-Zaara", grossRevenue:2921738}}, {_id:7161, properties:{runtimeInMinutes:94, numberOfRatingVotes:45717, name:"Adams æbler", rating:7.8, description:"A neo-nazi sentenced to community service at a church clashes with the blindly devotional priest.", id:"Adams æbler", grossRevenue:1305}}, {_id:7162, properties:{runtimeInMinutes:129, numberOfRatingVotes:258924, name:"Pride & Prejudice", rating:7.8, description:"Sparks fly when spirited Elizabeth Bennet meets single, rich, and proud Mr. Darcy. But Mr. Darcy reluctantly finds himself falling in love with a woman beneath his class. Can each overcome their own pride and prejudice?", id:"Pride & Prejudice", grossRevenue:38405088}}, {_id:7163, properties:{runtimeInMinutes:127, numberOfRatingVotes:51980, name:"The World's Fastest Indian", rating:7.8, description:"The story of New Zealander Burt Munro, who spent years rebuilding a 1920 Indian motorcycle, which helped him set the land speed world record at Utah's Bonneville Salt Flats in 1967.", id:"The World's Fastest Indian", grossRevenue:5128124}}, {_id:7164, properties:{runtimeInMinutes:90, numberOfRatingVotes:31658, rating:7.8, name:"Tôkyô goddofâzâzu", description:"On Christmas Eve, three homeless people living on the streets of Tokyo discover a newborn baby among the trash and set out to find its parents.", id:"Tôkyô goddofâzâzu", grossRevenue:128985}}, {_id:7165, properties:{runtimeInMinutes:119, numberOfRatingVotes:283310, name:"Serenity", rating:7.8, description:"The crew of the ship Serenity try to evade an assassin sent to recapture one of their members who is telepathic.", id:"Serenity", grossRevenue:25514517}}, {_id:7166, properties:{runtimeInMinutes:136, numberOfRatingVotes:234207, name:"Walk the Line", rating:7.8, description:"A chronicle of country music legend Johnny Cash's life, from his early days on an Arkansas cotton farm to his rise to fame with Sun Records in Memphis, where he recorded alongside Elvis Presley, Jerry Lee Lewis, and Carl Perkins.", id:"Walk the Line", grossRevenue:119519402}}, {_id:7167, properties:{runtimeInMinutes:113, numberOfRatingVotes:35682, name:"Ondskan", rating:7.8, description:"A teenage boy expelled from school for fighting arrives at a boarding school where the systematic bullying of younger students is encouraged as a means to maintain discipline, and decides to fight back.", id:"Ondskan", grossRevenue:15280}}, {_id:7168, properties:{runtimeInMinutes:123, numberOfRatingVotes:520284, name:"The Notebook", rating:7.8, description:"A poor yet passionate young man falls in love with a rich young woman, giving her a sense of freedom, but they are soon separated because of their social differences.", id:"The Notebook", grossRevenue:81001787}}, {_id:7169, properties:{runtimeInMinutes:126, numberOfRatingVotes:96703, name:"Diarios de motocicleta", rating:7.8, description:"The dramatization of a motorcycle road trip Che Guevara went on in his youth that showed him his life's calling.", id:"Diarios de motocicleta", grossRevenue:16756372}}, {_id:7170, properties:{runtimeInMinutes:109, numberOfRatingVotes:42673, name:"Lilja 4-ever", rating:7.8, description:"Sixteen-year-old Lilja and her only friend, the young boy Volodja, live in Russia, fantasizing about a better life. One day, Lilja falls in love with Andrej, who is going to Sweden, and invites Lilja to come along and start a new life.", id:"Lilja 4-ever", grossRevenue:181655}}, {_id:7171, properties:{runtimeInMinutes:80, numberOfRatingVotes:50622, name:"Les triplettes de Belleville", rating:7.8, description:"When her grandson is kidnapped during the Tour de France, Madame Souza and her beloved pooch Bruno team up with the Belleville Sisters--an aged song-and-dance team from the days of Fred Astaire--to rescue him.", id:"Les triplettes de Belleville", grossRevenue:7002255}}, {_id:7172, properties:{runtimeInMinutes:110, numberOfRatingVotes:26518, rating:7.8, name:"Gongdong gyeongbi guyeok JSA", description:"After a shooting incident at the North/South Korean border/DMZ leaves 2 North Korean soldiers dead, a neutral Swiss/Swedish team investigates, what actually happened.", id:"Gongdong gyeongbi guyeok JSA"}}, {_id:7173, properties:{runtimeInMinutes:131, numberOfRatingVotes:129022, name:"The Count of Monte Cristo", rating:7.8, description:"A young man, falsely imprisoned by his jealous \"friend\", escapes and uses a hidden treasure to exact his revenge.", id:"The Count of Monte Cristo", grossRevenue:54234062}}, {_id:7174, properties:{runtimeInMinutes:99, numberOfRatingVotes:60684, name:"Waking Life", rating:7.8, description:"A man shuffles through a dream meeting various people and discussing the meanings and purposes of the universe.", id:"Waking Life", grossRevenue:2892011}}, {_id:7175, properties:{runtimeInMinutes:113, numberOfRatingVotes:198089, name:"Remember the Titans", rating:7.8, description:"The true story of a newly appointed African-American coach and his high school team on their first season as a racially integrated unit.", id:"Remember the Titans", grossRevenue:115654751}}, {_id:7176, properties:{runtimeInMinutes:120, numberOfRatingVotes:253228, name:"Wo hu cang long", rating:7.8, description:"A young Chinese warrior steals a sword from a famed swordsman and then escapes into a world of romantic adventure with a mysterious man in the frontier of the nation.", id:"Wo hu cang long", grossRevenue:128078872}}, {_id:7177, properties:{runtimeInMinutes:101, numberOfRatingVotes:89058, name:"Todo sobre mi madre", rating:7.8, description:"Young Esteban wants to become a writer and also to discover the identity of his second mother, a trans woman, carefully concealed by his mother Manuela.", id:"Todo sobre mi madre", grossRevenue:8264530}}] AS row

UNWIND [{_id:6658, properties:{runtimeInMinutes:153, numberOfRatingVotes:159992, name:"Metropolis", rating:8.3, description:"In a futuristic city sharply divided between the working class and the city planners, the son of the city's mastermind falls in love with a working-class prophet who predicts the coming of a savior to mediate their differences.", id:"Metropolis", grossRevenue:1236166}}, {_id:6659, properties:{runtimeInMinutes:68, numberOfRatingVotes:113314, name:"The Kid", rating:8.3, description:"The Tramp cares for an abandoned child, but events put that relationship in jeopardy.", id:"The Kid", grossRevenue:5450000}}, {_id:6660, properties:{runtimeInMinutes:143, numberOfRatingVotes:33893, name:"Chhichhore", rating:8.2, description:"A tragic incident forces Anirudh, a middle-aged man, to take a trip down memory lane and reminisce his college days along with his friends, who were labelled as losers.", id:"Chhichhore", grossRevenue:898575}}, {_id:6661, properties:{runtimeInMinutes:138, numberOfRatingVotes:43444, name:"Uri: The Surgical Strike", rating:8.2, description:"Indian army special forces execute a covert operation, avenging the killing of fellow army men at their base by a terrorist group.", id:"Uri: The Surgical Strike", grossRevenue:4186168}}, {_id:6662, properties:{runtimeInMinutes:156, numberOfRatingVotes:36680, name:"K.G.F: Chapter 1", rating:8.2, description:"In the 1970s, a fierce rebel rises against brutal oppression and becomes the symbol of hope to legions of downtrodden people.", id:"K.G.F: Chapter 1"}}, {_id:6663, properties:{runtimeInMinutes:130, numberOfRatingVotes:377884, name:"Green Book", rating:8.2, description:"A working-class Italian-American bouncer becomes the driver of an African-American classical pianist on a tour of venues through the 1960s American South.", id:"Green Book", grossRevenue:85080171}}, {_id:6664, properties:{runtimeInMinutes:115, numberOfRatingVotes:432610, name:"Three Billboards Outside Ebbing, Missouri", rating:8.2, description:"A mother personally challenges the local authorities to solve her daughter's murder when they fail to catch the culprit.", id:"Three Billboards Outside Ebbing, Missouri", grossRevenue:54513740}}, {_id:6665, properties:{runtimeInMinutes:132, numberOfRatingVotes:31142, name:"Talvar", rating:8.2, description:"An experienced investigator confronts several conflicting theories about the perpetrators of a violent double homicide.", id:"Talvar", grossRevenue:342370}}, {_id:6666, properties:{runtimeInMinutes:167, numberOfRatingVotes:75348, name:"Baahubali 2: The Conclusion", rating:8.2, description:"When Shiva, the son of Bahubali, learns about his heritage, he begins to look for answers. His story is juxtaposed with past events that unfolded in the Mahishmati Kingdom.", id:"Baahubali 2: The Conclusion", grossRevenue:20186659}}, {_id:6667, properties:{runtimeInMinutes:96, numberOfRatingVotes:104761, name:"Klaus", rating:8.2, description:"A simple act of kindness always sparks another, even in a frozen, faraway place. When Smeerensburg's new postman, Jesper, befriends toymaker Klaus, their gifts melt an age-old feud and deliver a sleigh full of holiday traditions.", id:"Klaus"}}, {_id:6668, properties:{runtimeInMinutes:146, numberOfRatingVotes:60701, name:"Queen", rating:8.2, description:"A Delhi girl from a traditional family sets out on a solo honeymoon after her marriage gets cancelled.", id:"Queen", grossRevenue:1429534}}, {_id:6669, properties:{runtimeInMinutes:87, numberOfRatingVotes:40382, name:"Mandariinid", rating:8.2, description:"In 1992, war rages in Abkhazia, a breakaway region of Georgia. An Estonian man Ivo has decided to stay behind and harvest his crops of tangerines. In a bloody conflict at his door, a wounded man is left behind, and Ivo takes him in.", id:"Mandariinid", grossRevenue:144501}}, {_id:6670, properties:{runtimeInMinutes:186, numberOfRatingVotes:61137, name:"Bhaag Milkha Bhaag", rating:8.2, description:"The truth behind the ascension of Milkha Singh who was scarred because of the India-Pakistan partition.", id:"Bhaag Milkha Bhaag", grossRevenue:1626289}}, {_id:6671, properties:{runtimeInMinutes:321, numberOfRatingVotes:82365, name:"Gangs of Wasseypur", rating:8.2, description:"A clash between Sultan and Shahid Khan leads to the expulsion of Khan from Wasseypur, and ignites a deadly blood feud spanning three generations.", id:"Gangs of Wasseypur"}}, {_id:6672, properties:{runtimeInMinutes:134, numberOfRatingVotes:42341, name:"Udaan", rating:8.2, description:"Expelled from his school, a 16-year old boy returns home to his abusive and oppressive father.", id:"Udaan", grossRevenue:7461}}, {_id:6673, properties:{runtimeInMinutes:135, numberOfRatingVotes:33237, rating:8.2, name:"Paan Singh Tomar", description:"The story of Paan Singh Tomar, an Indian athlete and seven-time national steeplechase champion who becomes one of the most feared dacoits in Chambal Valley after his retirement.", id:"Paan Singh Tomar", grossRevenue:39567}}, {_id:6674, properties:{runtimeInMinutes:129, numberOfRatingVotes:193217, name:"El secreto de sus ojos", rating:8.2, description:"A retired legal counselor writes a novel hoping to find closure for one of his past unresolved homicide cases and for his unreciprocated love with his superior - both of which still haunt him decades later.", id:"El secreto de sus ojos", grossRevenue:6391436}}, {_id:6675, properties:{runtimeInMinutes:140, numberOfRatingVotes:435950, name:"Warrior", rating:8.2, description:"The youngest son of an alcoholic former boxer returns home, where he's trained by his father for competition in a mixed martial arts tournament - a path that puts the fighter on a collision course with his estranged, older brother.", id:"Warrior", grossRevenue:13657115}}, {_id:6676, properties:{runtimeInMinutes:138, numberOfRatingVotes:1129894, name:"Shutter Island", rating:8.2, description:"In 1954, a U.S. Marshal investigates the disappearance of a murderer who escaped from a hospital for the criminally insane.", id:"Shutter Island", grossRevenue:128012934}}, {_id:6677, properties:{runtimeInMinutes:96, numberOfRatingVotes:935507, name:"Up", rating:8.2, description:"78-year-old Carl Fredricksen travels to Paradise Falls in his house equipped with balloons, inadvertently taking a young stowaway.", id:"Up", grossRevenue:293004164}}] AS row

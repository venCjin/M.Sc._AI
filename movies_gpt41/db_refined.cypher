UNWIND [{_id:7218, properties:{runtimeInMinutes:109, numberOfRatingVotes:88511, name:"The King of Comedy", rating:7.8, description:"Rupert Pupkin is a passionate yet unsuccessful comic who craves nothing more than to be in the spotlight and to achieve this, he stalks and kidnaps his idol to take the spotlight for himself.", id:"The King of Comedy", grossRevenue:2500000}}, {_id:7219, properties:{runtimeInMinutes:115, numberOfRatingVotes:372490, name:"E.T. the Extra-Terrestrial", rating:7.8, description:"A troubled child summons the courage to help a friendly alien escape Earth and return to his home world.", id:"E.T. the Extra-Terrestrial", grossRevenue:435110554}}, {_id:7220, properties:{runtimeInMinutes:105, numberOfRatingVotes:133351, name:"Kramer vs. Kramer", rating:7.8, description:"Ted Kramer's wife leaves him, allowing for a lost bond to be rediscovered between Ted and his son, Billy. But a heated custody battle ensues over the divorced couple's son, deepening the wounds left by the separation.", id:"Kramer vs. Kramer", grossRevenue:106260000}}, {_id:7221, properties:{runtimeInMinutes:94, numberOfRatingVotes:52852, name:"Days of Heaven", rating:7.8, description:"A hot-tempered farm laborer convinces the woman he loves to marry their rich but dying boss so that they can have a claim to his fortune.", id:"Days of Heaven"}}, {_id:7222, properties:{runtimeInMinutes:135, numberOfRatingVotes:65659, name:"The Outlaw Josey Wales", rating:7.8, description:"Missouri farmer Josey Wales joins a Confederate guerrilla unit and winds up on the run from the Union soldiers who murdered his family.", id:"The Outlaw Josey Wales", grossRevenue:31800000}}, {_id:7223, properties:{runtimeInMinutes:129, numberOfRatingVotes:44917, name:"The Man Who Would Be King", rating:7.8, description:"Two British former soldiers decide to set themselves up as Kings in Kafiristan, a land where no white man has set foot since Alexander the Great.", id:"The Man Who Would Be King"}}, {_id:7224, properties:{runtimeInMinutes:113, numberOfRatingVotes:98611, name:"The Conversation", rating:7.8, description:"A paranoid, secretive surveillance expert has a crisis of conscience when he suspects that the couple he is spying on will be murdered.", id:"The Conversation", grossRevenue:4420000}}, {_id:7225, properties:{runtimeInMinutes:72, numberOfRatingVotes:25229, rating:7.8, name:"La planète sauvage", description:"On a faraway planet where blue giants rule, oppressed humanoids rebel against their machine-like leaders.", id:"La planète sauvage", grossRevenue:193817}}, {_id:7226, properties:{runtimeInMinutes:143, numberOfRatingVotes:37445, name:"The Day of the Jackal", rating:7.8, description:"A professional assassin codenamed \"Jackal\" plots to kill Charles de Gaulle, the President of France.", id:"The Day of the Jackal", grossRevenue:16056255}}, {_id:7227, properties:{runtimeInMinutes:94, numberOfRatingVotes:66009, name:"Badlands", rating:7.8, description:"An impressionable teenage girl from a dead-end town and her older greaser boyfriend embark on a killing spree in the South Dakota badlands.", id:"Badlands"}}, {_id:7228, properties:{runtimeInMinutes:124, numberOfRatingVotes:48334, name:"Cabaret", rating:7.8, description:"A female girlie club entertainer in Weimar Republic era Berlin romances two men while the Nazi Party rises to power around them.", id:"Cabaret", grossRevenue:42765000}}, {_id:7229, properties:{runtimeInMinutes:100, numberOfRatingVotes:178731, name:"Willy Wonka & the Chocolate Factory", rating:7.8, description:"A poor but hopeful boy seeks one of the five coveted golden tickets that will send him on a tour of Willy Wonka's mysterious chocolate factory.", id:"Willy Wonka & the Chocolate Factory", grossRevenue:4000000}}, {_id:7230, properties:{runtimeInMinutes:113, numberOfRatingVotes:101124, name:"Midnight Cowboy", rating:7.8, description:"A naive hustler travels from Texas to New York City to seek personal fortune, finding a new friend in the process.", id:"Midnight Cowboy", grossRevenue:44785053}}, {_id:7231, properties:{runtimeInMinutes:108, numberOfRatingVotes:27733, name:"Wait Until Dark", rating:7.8, description:"A recently blinded woman is terrorized by a trio of thugs while they search for a heroin-stuffed doll they believe is in her apartment.", id:"Wait Until Dark", grossRevenue:17550741}}, {_id:7232, properties:{runtimeInMinutes:108, numberOfRatingVotes:39642, name:"Guess Who's Coming to Dinner", rating:7.8, description:"A couple's attitudes are challenged when their daughter introduces them to her African-American fiancé.", id:"Guess Who's Coming to Dinner", grossRevenue:56700000}}, {_id:7233, properties:{runtimeInMinutes:111, numberOfRatingVotes:102415, name:"Bonnie and Clyde", rating:7.8, description:"Bored waitress Bonnie Parker falls in love with an ex-con named Clyde Barrow and together they start a violent crime spree through the country, stealing cars and robbing banks.", id:"Bonnie and Clyde"}}, {_id:7234, properties:{runtimeInMinutes:170, numberOfRatingVotes:86525, name:"My Fair Lady", rating:7.8, description:"Snobbish phonetics Professor Henry Higgins agrees to a wager that he can make flower girl Eliza Doolittle presentable in high society.", id:"My Fair Lady", grossRevenue:72000000}}, {_id:7235, properties:{runtimeInMinutes:139, numberOfRatingVotes:158029, name:"Mary Poppins", rating:7.8, description:"In turn of the century London, a magical nanny employs music and adventure to help two neglected children become closer to their father.", id:"Mary Poppins", grossRevenue:102272727}}, {_id:7236, properties:{runtimeInMinutes:178, numberOfRatingVotes:52141, name:"The Longest Day", rating:7.8, description:"The events of D-Day, told on a grand scale from both the Allied and German points of view.", id:"The Longest Day", grossRevenue:39100000}}, {_id:7237, properties:{runtimeInMinutes:105, numberOfRatingVotes:37605, name:"Jules et Jim", rating:7.8, description:"Decades of a love triangle concerning two friends and an impulsive woman.", id:"Jules et Jim"}}] AS row

// :begin
CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
// :commit
// CALL db.awaitIndexes(300);
// :begin
UNWIND [{_id:2139, properties:{runtimeInMinutes:142, numberOfRatingVotes:2343110, name:"The Shawshank Redemption", rating:9.3, description:"Two imprisoned men bond over a number of years, finding solace and eventual redemption through acts of common decency.", id:"The Shawshank Redemption", grossRevenue:28341469}}, {_id:2140, properties:{runtimeInMinutes:175, numberOfRatingVotes:1620367, name:"The Godfather", rating:9.2, description:"An organized crime dynasty's aging patriarch transfers control of his clandestine empire to his reluctant son.", id:"The Godfather", grossRevenue:134966411}}, {_id:2141, properties:{runtimeInMinutes:85, numberOfRatingVotes:36037, name:"Love and Death", rating:7.7, description:"In czarist Russia, a neurotic soldier and his distant cousin formulate a plot to assassinate Napoleon.", id:"Love and Death"}}, {_id:2142, properties:{runtimeInMinutes:104, numberOfRatingVotes:26729, rating:7.7, name:"The Taking of Pelham One Two Three", description:"In New York, armed men hijack a subway car and demand a ransom for the passengers. Even if it's paid, how could they get away?", id:"The Taking of Pelham One Two Three"}}, {_id:2143, properties:{runtimeInMinutes:93, numberOfRatingVotes:125993, name:"Blazing Saddles", rating:7.7, description:"In order to ruin a western town, a corrupt politician appoints a black Sheriff, who promptly becomes his most formidable adversary.", id:"Blazing Saddles", grossRevenue:119500000}}, {_id:2144, properties:{runtimeInMinutes:130, numberOfRatingVotes:109941, name:"Serpico", rating:7.7, description:"An honest New York cop named Frank Serpico blows the whistle on rampant corruption in the force only to have his comrades turn against him.", id:"Serpico", grossRevenue:29800000}}, {_id:2145, properties:{runtimeInMinutes:102, numberOfRatingVotes:96561, name:"Enter the Dragon", rating:7.7, description:"A secret agent comes to an opium lord's island fortress with other fighters for a martial-arts tournament.", id:"Enter the Dragon", grossRevenue:25000000}}, {_id:2146, properties:{runtimeInMinutes:109, numberOfRatingVotes:98740, name:"Deliverance", rating:7.7, description:"Intent on seeing the Cahulawassee River before it's dammed and turned into a lake, outdoor fanatic Lewis Medlock takes his friends on a canoeing trip they'll never forget into the dangerous American back-country.", id:"Deliverance", grossRevenue:7056013}}, {_id:2147, properties:{runtimeInMinutes:104, numberOfRatingVotes:110075, name:"The French Connection", rating:7.7, description:"A pair of NYC cops in the Narcotics Bureau stumble onto a drug smuggling job with a French connection.", id:"The French Connection", grossRevenue:15630710}}, {_id:2148, properties:{runtimeInMinutes:102, numberOfRatingVotes:143292, name:"Dirty Harry", rating:7.7, description:"When a madman calling himself \"the Scorpio Killer\" menaces the city, tough-as-nails San Francisco Police Inspector \"Dirty\" Harry Callahan is assigned to track down and ferret out the crazed psychopath.", id:"Dirty Harry", grossRevenue:35900000}}, {_id:2149, properties:{runtimeInMinutes:158, numberOfRatingVotes:51913, name:"Where Eagles Dare", rating:7.7, description:"Allied agents stage a daring raid on a castle where the Nazis are holding American brigadier general George Carnaby prisoner, but that's not all that's really going on.", id:"Where Eagles Dare"}}, {_id:2150, properties:{runtimeInMinutes:105, numberOfRatingVotes:31572, name:"The Odd Couple", rating:7.7, description:"Two friends try sharing an apartment, but their ideas of housekeeping and lifestyles are as different as night and day.", id:"The Odd Couple", grossRevenue:44527234}}, {_id:2151, properties:{runtimeInMinutes:150, numberOfRatingVotes:67183, name:"The Dirty Dozen", rating:7.7, description:"During World War II, a rebellious U.S. Army Major is assigned a dozen convicted murderers to train and lead them into a mass assassination mission of German officers.", id:"The Dirty Dozen", grossRevenue:45300000}}, {_id:2152, properties:{runtimeInMinutes:100, numberOfRatingVotes:40274, name:"Belle de jour", rating:7.7, description:"A frigid young housewife decides to spend her midweek afternoons as a prostitute.", id:"Belle de jour", grossRevenue:26331}}, {_id:2153, properties:{runtimeInMinutes:120, numberOfRatingVotes:31222, name:"A Man for All Seasons", rating:7.7, description:"The story of Sir Thomas More, who stood up to King Henry VIII when the King rejected the Roman Catholic Church to obtain a divorce and remarry.", id:"A Man for All Seasons", grossRevenue:28350000}}, {_id:2154, properties:{runtimeInMinutes:105, numberOfRatingVotes:48883, name:"Repulsion", rating:7.7, description:"A sex-repulsed woman who disapproves of her sister's boyfriend sinks into depression and has horrific visions of rape and violence.", id:"Repulsion"}}, {_id:2155, properties:{runtimeInMinutes:138, numberOfRatingVotes:35999, name:"Zulu", rating:7.7, description:"Outnumbered British soldiers do battle with Zulu warriors at Rorke's Drift.", id:"Zulu"}}, {_id:2156, properties:{runtimeInMinutes:110, numberOfRatingVotes:174119, name:"Goldfinger", rating:7.7, description:"While investigating a gold magnate's smuggling, James Bond uncovers a plot to contaminate the Fort Knox gold reserve.", id:"Goldfinger", grossRevenue:51081062}}, {_id:2157, properties:{runtimeInMinutes:119, numberOfRatingVotes:171739, name:"The Birds", rating:7.7, description:"A wealthy San Francisco socialite pursues a potential boyfriend to a small Northern California town that slowly takes a turn for the bizarre when birds of all kinds suddenly begin to attack people.", id:"The Birds", grossRevenue:11403529}}, {_id:2158, properties:{runtimeInMinutes:106, numberOfRatingVotes:26457, name:"Cape Fear", rating:7.7, description:"A lawyer's family is stalked by a man he once helped put in jail.", id:"Cape Fear"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2159, properties:{runtimeInMinutes:101, numberOfRatingVotes:31354, name:"Peeping Tom", rating:7.7, description:"A young man murders women, using a movie camera to film their dying expressions of terror.", id:"Peeping Tom", grossRevenue:83957}}, {_id:2160, properties:{runtimeInMinutes:128, numberOfRatingVotes:87719, name:"The Magnificent Seven", rating:7.7, description:"Seven gunfighters are hired by Mexican peasants to liberate their village from oppressive bandits.", id:"The Magnificent Seven", grossRevenue:4905000}}, {_id:2161, properties:{runtimeInMinutes:90, numberOfRatingVotes:27620, rating:7.7, name:"Les yeux sans visage", description:"A surgeon causes an accident which leaves his daughter disfigured, and goes to extremes to give her a new face.", id:"Les yeux sans visage", grossRevenue:52709}}, {_id:2162, properties:{runtimeInMinutes:80, numberOfRatingVotes:44839, rating:7.7, name:"Invasion of the Body Snatchers", description:"A small-town doctor learns that the population of his community is being replaced by emotionless alien duplicates.", id:"Invasion of the Body Snatchers"}}, {_id:2163, properties:{runtimeInMinutes:111, numberOfRatingVotes:83363, name:"Rebel Without a Cause", rating:7.7, description:"A rebellious young man with a troubled past comes to a new town, finding friends and enemies.", id:"Rebel Without a Cause"}}, {_id:2164, properties:{runtimeInMinutes:91, numberOfRatingVotes:26464, name:"The Ladykillers", rating:7.7, description:"Five oddball criminals planning a bank robbery rent rooms on a cul-de-sac from an octogenarian widow under the pretext that they are classical musicians.", id:"The Ladykillers"}}, {_id:2165, properties:{runtimeInMinutes:113, numberOfRatingVotes:59415, name:"Sabrina", rating:7.7, description:"A playboy becomes interested in the daughter of his family's chauffeur, but it's his more serious brother who would be the better man for her.", id:"Sabrina"}}, {_id:2166, properties:{runtimeInMinutes:129, numberOfRatingVotes:34677, name:"The Quiet Man", rating:7.7, description:"A retired American boxer returns to the village of his birth in Ireland, where he falls for a spirited redhead whose brother is contemptuous of their union.", id:"The Quiet Man", grossRevenue:10550000}}, {_id:2167, properties:{runtimeInMinutes:92, numberOfRatingVotes:76315, rating:7.7, name:"The Day the Earth Stood Still", description:"An alien lands and tells the people of Earth that they must live peacefully or be destroyed as a danger to other planets.", id:"The Day the Earth Stood Still"}}, {_id:2168, properties:{runtimeInMinutes:105, numberOfRatingVotes:71481, rating:7.7, name:"The African Queen", description:"In WWI Africa, a gin-swilling riverboat captain is persuaded by a strait-laced missionary to use his boat to attack an enemy warship.", id:"The African Queen", grossRevenue:536118}}, {_id:2169, properties:{runtimeInMinutes:110, numberOfRatingVotes:27991, name:"Gilda", rating:7.7, description:"A small-time gambler hired to work in a Buenos Aires casino discovers his employer's new wife is his former lover.", id:"Gilda"}}, {_id:2170, properties:{runtimeInMinutes:125, numberOfRatingVotes:88662, name:"Fantasia", rating:7.7, description:"A collection of animated interpretations of great works of Western classical music.", id:"Fantasia", grossRevenue:76408097}}, {_id:2171, properties:{runtimeInMinutes:71, numberOfRatingVotes:30683, name:"The Invisible Man", rating:7.7, description:"A scientist finds a way of becoming invisible, but in doing so, he becomes murderously insane.", id:"The Invisible Man"}}, {_id:2172, properties:{runtimeInMinutes:126, numberOfRatingVotes:60408, name:"Dark Waters", rating:7.6, description:"A corporate defense attorney takes on an environmental lawsuit against a chemical company that exposes a lengthy history of pollution.", id:"Dark Waters"}}, {_id:2173, properties:{runtimeInMinutes:102, numberOfRatingVotes:140840, name:"Searching", rating:7.6, description:"After his teenage daughter goes missing, a desperate father tries to find clues on her laptop.", id:"Searching", grossRevenue:26020957}}, {_id:2174, properties:{runtimeInMinutes:161, numberOfRatingVotes:551309, name:"Once Upon a Time... in Hollywood", rating:7.6, description:"A faded television actor and his stunt double strive to achieve fame and success in the final years of Hollywood's Golden Age in 1969 Los Angeles.", id:"Once Upon a Time... in Hollywood", grossRevenue:142502728}}, {_id:2175, properties:{runtimeInMinutes:127, numberOfRatingVotes:29765, name:"Nelyubov", rating:7.6, description:"A couple going through a divorce must team up to find their son who has disappeared during one of their bitter arguments.", id:"Nelyubov", grossRevenue:566356}}, {_id:2176, properties:{runtimeInMinutes:111, numberOfRatingVotes:95181, name:"The Florida Project", rating:7.6, description:"Set over one summer, the film follows precocious six-year-old Moonee as she courts mischief and adventure with her ragtag playmates and bonds with her rebellious but caring mother, all while living in the shadows of Walt Disney World.", id:"The Florida Project", grossRevenue:5904366}}, {_id:2177, properties:{runtimeInMinutes:137, numberOfRatingVotes:46739, name:"Just Mercy", rating:7.6, description:"World-renowned civil rights defense attorney Bryan Stevenson works to free a wrongly condemned death row prisoner.", id:"Just Mercy"}}, {_id:2178, properties:{runtimeInMinutes:101, numberOfRatingVotes:99643, name:"Gifted", rating:7.6, description:"Frank, a single man raising his child prodigy niece Mary, is drawn into a custody battle with his mother.", id:"Gifted", grossRevenue:24801212}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2179, properties:{runtimeInMinutes:97, numberOfRatingVotes:66346, name:"The Peanut Butter Falcon", rating:7.6, description:"Zak runs away from his care home to make his dream of becoming a wrestler come true.", id:"The Peanut Butter Falcon", grossRevenue:13122642}}, {_id:2180, properties:{runtimeInMinutes:138, numberOfRatingVotes:52903, name:"Victoria", rating:7.6, description:"A young Spanish woman who has recently moved to Berlin finds her flirtation with a local guy turn potentially deadly as their night out with his friends reveals a dangerous secret.", id:"Victoria"}}, {_id:2181, properties:{runtimeInMinutes:97, numberOfRatingVotes:35785, name:"Mustang", rating:7.6, description:"When five orphan girls are seen innocently playing with boys on a beach, their scandalized conservative guardians confine them while forced marriages are arranged.", id:"Mustang", grossRevenue:845464}}, {_id:2182, properties:{runtimeInMinutes:136, numberOfRatingVotes:569974, name:"Guardians of the Galaxy Vol. 2", rating:7.6, description:"The Guardians struggle to keep together as a team while dealing with their personal family issues, notably Star-Lord's encounter with his father the ambitious celestial being Ego.", id:"Guardians of the Galaxy Vol. 2", grossRevenue:389813101}}, {_id:2183, properties:{runtimeInMinutes:113, numberOfRatingVotes:439406, name:"Baby Driver", rating:7.6, description:"After being coerced into working for a crime boss, a young getaway driver finds himself taking part in a heist doomed to fail.", id:"Baby Driver", grossRevenue:107825862}}, {_id:2184, properties:{runtimeInMinutes:134, numberOfRatingVotes:58371, name:"Only the Brave", rating:7.6, description:"Based on the true story of the Granite Mountain Hotshots, a group of elite firefighters who risk everything to protect a town from a historic wildfire.", id:"Only the Brave", grossRevenue:18340051}}, {_id:2185, properties:{runtimeInMinutes:142, numberOfRatingVotes:287659, name:"Bridge of Spies", rating:7.6, description:"During the Cold War, an American lawyer is recruited to defend an arrested Soviet spy in court, and then help the CIA facilitate an exchange of the spy for the Soviet captured American U2 spy plane pilot, Francis Gary Powers.", id:"Bridge of Spies", grossRevenue:72313754}}, {_id:2186, properties:{runtimeInMinutes:118, numberOfRatingVotes:250057, name:"Incredibles 2", rating:7.6, description:"The Incredibles family takes on a new mission which involves a change in family roles: Bob Parr (Mr. Incredible) must manage the house while his wife Helen (Elastigirl) goes out to save the world.", id:"Incredibles 2", grossRevenue:608581744}}, {_id:2187, properties:{runtimeInMinutes:107, numberOfRatingVotes:272784, name:"Moana", rating:7.6, description:"In Ancient Polynesia, when a terrible curse incurred by the Demigod Maui reaches Moana's island, she answers the Ocean's call to seek out the Demigod to set things right.", id:"Moana", grossRevenue:248757044}}, {_id:2188, properties:{runtimeInMinutes:121, numberOfRatingVotes:371291, name:"Sicario", rating:7.6, description:"An idealistic FBI agent is enlisted by a government task force to aid in the escalating war against drugs at the border area between the U.S. and Mexico.", id:"Sicario", grossRevenue:46889293}}, {_id:2189, properties:{runtimeInMinutes:133, numberOfRatingVotes:247666, name:"Creed", rating:7.6, description:"The former World Heavyweight Champion Rocky Balboa serves as a trainer and mentor to Adonis Johnson, the son of his late friend and former rival Apollo Creed.", id:"Creed", grossRevenue:109767581}}, {_id:2190, properties:{runtimeInMinutes:140, numberOfRatingVotes:49397, name:"Leviafan", rating:7.6, description:"In a Russian coastal town, Kolya is forced to fight the corrupt mayor when he is told that his house will be demolished. He recruits a lawyer friend to help, but the man's arrival brings further misfortune for Kolya and his family.", id:"Leviafan", grossRevenue:1092800}}, {_id:2191, properties:{runtimeInMinutes:102, numberOfRatingVotes:204175, name:"Hell or High Water", rating:7.6, description:"A divorced father and his ex-con older brother resort to a desperate scheme in order to save their family's ranch in West Texas.", id:"Hell or High Water", grossRevenue:26862450}}, {_id:2192, properties:{runtimeInMinutes:98, numberOfRatingVotes:94212, name:"Philomena", rating:7.6, description:"A world-weary political journalist picks up the story of a woman's search for her son, who was taken away from her decades ago after she became pregnant and was forced to live in a convent.", id:"Philomena", grossRevenue:37707719}}, {_id:2193, properties:{runtimeInMinutes:130, numberOfRatingVotes:411599, name:"Dawn of the Planet of the Apes", rating:7.6, description:"A growing nation of genetically evolved apes led by Caesar is threatened by a band of human survivors of the devastating virus unleashed a decade earlier.", id:"Dawn of the Planet of the Apes", grossRevenue:208545589}}, {_id:2194, properties:{runtimeInMinutes:112, numberOfRatingVotes:57549, name:"El cuerpo", rating:7.6, description:"A detective searches for the body of a femme fatale which has gone missing from a morgue.", id:"El cuerpo"}}, {_id:2195, properties:{runtimeInMinutes:101, numberOfRatingVotes:190531, name:"Serbuan maut", rating:7.6, description:"A S.W.A.T. team becomes trapped in a tenement run by a ruthless mobster and his army of killers and thugs.", id:"Serbuan maut", grossRevenue:4105123}}, {_id:2196, properties:{runtimeInMinutes:109, numberOfRatingVotes:228132, name:"End of Watch", rating:7.6, description:"Shot documentary-style, this film follows the daily grind of two young police officers in LA who are partners and friends, and what happens when they meet criminal forces greater than themselves.", id:"End of Watch", grossRevenue:41003371}}, {_id:2197, properties:{runtimeInMinutes:94, numberOfRatingVotes:80939, name:"Kari-gurashi no Arietti", rating:7.6, description:"The Clock family are four-inch-tall people who live anonymously in another family's residence, borrowing simple items to make their home. Life changes for the Clocks when their teenage daughter, Arrietty, is discovered.", id:"Kari-gurashi no Arietti", grossRevenue:19202743}}, {_id:2198, properties:{runtimeInMinutes:136, numberOfRatingVotes:334312, name:"A Star Is Born", rating:7.6, description:"A musician helps a young singer find fame as age and alcoholism send his own career into a downward spiral.", id:"A Star Is Born", grossRevenue:215288866}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2199, properties:{runtimeInMinutes:110, numberOfRatingVotes:311822, name:"True Grit", rating:7.6, description:"A stubborn teenager enlists the help of a tough U.S. Marshal to track down her father's murderer.", id:"True Grit", grossRevenue:171243005}}, {_id:2200, properties:{runtimeInMinutes:118, numberOfRatingVotes:38491, name:"Hævnen", rating:7.6, description:"The lives of two Danish families cross each other, and an extraordinary but risky friendship comes into bud. But loneliness, frailty and sorrow lie in wait.", id:"Hævnen", grossRevenue:1008098}}, {_id:2201, properties:{runtimeInMinutes:95, numberOfRatingVotes:500851, name:"Despicable Me", rating:7.6, description:"When a criminal mastermind uses a trio of orphan girls as pawns for a grand scheme, he finds their love is profoundly changing him for the better.", id:"Despicable Me", grossRevenue:251513985}}, {_id:2202, properties:{runtimeInMinutes:100, numberOfRatingVotes:315426, name:"50/50", rating:7.6, description:"Inspired by a true story, a comedy centered on a 27-year-old guy who learns of his cancer diagnosis and his subsequent struggle to beat the disease.", id:"50/50", grossRevenue:35014192}}, {_id:2203, properties:{runtimeInMinutes:117, numberOfRatingVotes:524081, name:"Kick-Ass", rating:7.6, description:"Dave Lizewski is an unnoticed high school student and comic book fan who one day decides to become a superhero, even though he has no powers, training or meaningful reason to do so.", id:"Kick-Ass", grossRevenue:48071303}}, {_id:2204, properties:{runtimeInMinutes:113, numberOfRatingVotes:63882, name:"Celda 211", rating:7.6, description:"The story of two men on different sides of a prison riot -- the inmate leading the rebellion and the young guard trapped in the revolt, who poses as a prisoner in a desperate attempt to survive the ordeal.", id:"Celda 211"}}, {_id:2205, properties:{runtimeInMinutes:133, numberOfRatingVotes:369529, name:"Moneyball", rating:7.6, description:"Oakland A's general manager Billy Beane's successful attempt to assemble a baseball team on a lean budget by employing computer-generated analysis to acquire new players.", id:"Moneyball", grossRevenue:75605492}}, {_id:2206, properties:{runtimeInMinutes:120, numberOfRatingVotes:138959, name:"La piel que habito", rating:7.6, description:"A brilliant plastic surgeon, haunted by past tragedies, creates a type of synthetic skin that withstands any kind of damage. His guinea pig: a mysterious and volatile woman who holds the key to his obsession.", id:"La piel que habito", grossRevenue:3185812}}, {_id:2207, properties:{runtimeInMinutes:88, numberOfRatingVotes:520041, name:"Zombieland", rating:7.6, description:"A shy student trying to reach his family in Ohio, a gun-toting tough guy trying to find the last Twinkie, and a pair of sisters trying to get to an amusement park join forces to travel across a zombie-filled America.", id:"Zombieland", grossRevenue:75590286}}, {_id:2208, properties:{runtimeInMinutes:107, numberOfRatingVotes:102742, name:"Die Welle", rating:7.6, description:"A high school teacher's experiment to demonstrate to his students what life is like under a dictatorship spins horribly out of control when he forms a social unit with a life of its own.", id:"Die Welle"}}, {_id:2209, properties:{runtimeInMinutes:128, numberOfRatingVotes:583158, name:"Sherlock Holmes", rating:7.6, description:"Detective Sherlock Holmes and his stalwart partner Watson engage in a battle of wits and brawn with a nemesis whose plot is a threat to all of England.", id:"Sherlock Holmes", grossRevenue:209028679}}, {_id:2210, properties:{runtimeInMinutes:129, numberOfRatingVotes:293266, name:"The Blind Side", rating:7.6, description:"The story of Michael Oher, a homeless and traumatized boy who became an All-American football player and first-round NFL draft pick with the help of a caring woman and her family.", id:"The Blind Side", grossRevenue:255959475}}, {_id:2211, properties:{runtimeInMinutes:104, numberOfRatingVotes:41544, name:"The Visitor", rating:7.6, description:"A college professor travels to New York City to attend a conference and finds a young couple living in his apartment.", id:"The Visitor", grossRevenue:9422422}}, {_id:2212, properties:{runtimeInMinutes:123, numberOfRatingVotes:286770, name:"Seven Pounds", rating:7.6, description:"A man with a fateful secret embarks on an extraordinary journey of redemption by forever changing the lives of seven strangers.", id:"Seven Pounds", grossRevenue:69951824}}, {_id:2213, properties:{runtimeInMinutes:100, numberOfRatingVotes:227760, name:"Eastern Promises", rating:7.6, description:"A teenager who dies during childbirth leaves clues in her journal that could tie her child to a rape involving a violent Russian mob family.", id:"Eastern Promises", grossRevenue:17114882}}, {_id:2214, properties:{runtimeInMinutes:127, numberOfRatingVotes:255036, name:"Stardust", rating:7.6, description:"In a countryside town bordering on a magical land, a young man makes a promise to his beloved that he'll retrieve a fallen star by venturing into the magical realm.", id:"Stardust", grossRevenue:38634938}}, {_id:2215, properties:{runtimeInMinutes:71, numberOfRatingVotes:31779, rating:7.6, name:"The Secret of Kells", description:"A young boy in a remote medieval outpost under siege from barbarian raids is beckoned to adventure when a celebrated master illuminator arrives with an ancient book, brimming with secret wisdom and powers.", id:"The Secret of Kells", grossRevenue:686383}}, {_id:2216, properties:{runtimeInMinutes:129, numberOfRatingVotes:339757, name:"Inside Man", rating:7.6, description:"A police detective, a bank robber, and a high-power broker enter high-stakes negotiations after the criminal's brilliant heist spirals into a hostage situation.", id:"Inside Man", grossRevenue:88513495}}, {_id:2217, properties:{runtimeInMinutes:114, numberOfRatingVotes:250590, name:"Gone Baby Gone", rating:7.6, description:"Two Boston area detectives investigate a little girl's kidnapping, which ultimately turns into a crisis both professionally and personally.", id:"Gone Baby Gone", grossRevenue:20300218}}, {_id:2218, properties:{runtimeInMinutes:140, numberOfRatingVotes:82781, name:"La Vie En Rose", rating:7.6, description:"Biopic of the iconic French singer Édith Piaf. Raised by her grandmother in a brothel, she was discovered while singing on a street corner at the age of 19. Despite her success, Piaf's life was filled with tragedy.", id:"La Vie En Rose", grossRevenue:10301706}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2219, properties:{runtimeInMinutes:104, numberOfRatingVotes:72863, name:"Huo Yuan Jia", rating:7.6, description:"A biography of Chinese Martial Arts Master Huo Yuanjia, who is the founder and spiritual guru of the Jin Wu Sports Federation.", id:"Huo Yuan Jia", grossRevenue:24633730}}, {_id:2220, properties:{runtimeInMinutes:110, numberOfRatingVotes:354728, name:"The Illusionist", rating:7.6, description:"In turn-of-the-century Vienna, a magician uses his abilities to secure the love of a woman far above his social standing.", id:"The Illusionist", grossRevenue:39868642}}, {_id:2221, properties:{runtimeInMinutes:90, numberOfRatingVotes:49728, rating:7.6, name:"Dead Man's Shoes", description:"A disaffected soldier returns to his hometown to get even with the thugs who brutalized his mentally-challenged brother years ago.", id:"Dead Man's Shoes", grossRevenue:6013}}, {_id:2222, properties:{runtimeInMinutes:153, numberOfRatingVotes:474827, name:"Harry Potter and the Half-Blood Prince", rating:7.6, description:"As Harry Potter begins his sixth year at Hogwarts, he discovers an old book marked as \"the property of the Half-Blood Prince\" and begins to learn more about Lord Voldemort's dark past.", id:"Harry Potter and the Half-Blood Prince", grossRevenue:301959197}}, {_id:2223, properties:{runtimeInMinutes:117, numberOfRatingVotes:732876, name:"300", rating:7.6, description:"King Leonidas of Sparta and a force of 300 men fight the Persians at Thermopylae in 480 B.C.", id:"300", grossRevenue:210614939}}, {_id:2224, properties:{runtimeInMinutes:124, numberOfRatingVotes:206294, name:"Match Point", rating:7.6, description:"At a turning point in his life, a former tennis pro falls for an actress who happens to be dating his friend and soon-to-be brother-in-law.", id:"Match Point", grossRevenue:23089926}}, {_id:2225, properties:{runtimeInMinutes:162, numberOfRatingVotes:500799, name:"Watchmen", rating:7.6, description:"In 1985 where former superheroes exist, the murder of a colleague sends active vigilante Rorschach into his own sprawling investigation, uncovering something that could completely change the course of history as we know it.", id:"Watchmen", grossRevenue:107509799}}, {_id:2226, properties:{runtimeInMinutes:122, numberOfRatingVotes:294140, name:"Lord of War", rating:7.6, description:"An arms dealer confronts the morality of his work as he is being chased by an INTERPOL Agent.", id:"Lord of War", grossRevenue:24149632}}, {_id:2227, properties:{runtimeInMinutes:103, numberOfRatingVotes:379020, name:"Saw", rating:7.6, description:"Two strangers awaken in a room with no recollection of how they got there, and soon discover they're pawns in a deadly game perpetrated by a notorious serial killer.", id:"Saw", grossRevenue:56000369}}, {_id:2228, properties:{runtimeInMinutes:124, numberOfRatingVotes:83158, name:"Synecdoche, New York", rating:7.6, description:"A theatre director struggles with his work, and the women in his life, as he creates a life-size replica of New York City inside a warehouse as part of his new play.", id:"Synecdoche, New York", grossRevenue:3081925}}, {_id:2229, properties:{runtimeInMinutes:105, numberOfRatingVotes:65939, rating:7.6, name:"Mysterious Skin", description:"A teenage hustler and a young man obsessed with alien abductions cross paths, together discovering a horrible, liberating truth.", id:"Mysterious Skin", grossRevenue:697181}}, {_id:2230, properties:{runtimeInMinutes:93, numberOfRatingVotes:67360, name:"Jeux d'enfants", rating:7.6, description:"As adults, best friends Julien and Sophie continue the odd game they started as children -- a fearless competition to outdo one another with daring and outrageous stunts. While they often act out to relieve one another's pain, their game might be a way to avoid the fact that they are truly meant for one another.", id:"Jeux d'enfants", grossRevenue:548707}}, {_id:2231, properties:{runtimeInMinutes:133, numberOfRatingVotes:70925, name:"Un long dimanche de fiançailles", rating:7.6, description:"Tells the story of a young woman's relentless search for her fiancé, who has disappeared from the trenches of the Somme during World War One.", id:"Un long dimanche de fiançailles", grossRevenue:6167817}}, {_id:2232, properties:{runtimeInMinutes:89, numberOfRatingVotes:67370, name:"The Station Agent", rating:7.6, description:"When his only friend dies, a man born with dwarfism moves to rural New Jersey to live a life of solitude, only to meet a chatty hot dog vendor and a woman dealing with her own personal loss.", id:"The Station Agent", grossRevenue:5739376}}, {_id:2233, properties:{runtimeInMinutes:124, numberOfRatingVotes:224545, name:"21 Grams", rating:7.6, description:"A freak accident brings together a critically ill mathematician, a grieving mother, and a born-again ex-con.", id:"21 Grams", grossRevenue:16290476}}, {_id:2234, properties:{runtimeInMinutes:129, numberOfRatingVotes:62659, rating:7.6, name:"Boksuneun naui geot", description:"A recently laid off factory worker kidnaps his former boss' friend's daughter, hoping to use the ransom money to pay for his sister's kidney transplant.", id:"Boksuneun naui geot", grossRevenue:45289}}, {_id:2235, properties:{runtimeInMinutes:106, numberOfRatingVotes:198677, name:"Finding Neverland", rating:7.6, description:"The story of Sir J.M. Barrie's friendship with a family who inspired him to create Peter Pan.", id:"Finding Neverland", grossRevenue:51680613}}, {_id:2236, properties:{runtimeInMinutes:135, numberOfRatingVotes:169708, name:"25th Hour", rating:7.6, description:"Cornered by the DEA, convicted New York drug dealer Montgomery Brogan reevaluates his life in the 24 remaining hours before facing a seven-year jail term.", id:"25th Hour", grossRevenue:13060843}}, {_id:2237, properties:{runtimeInMinutes:113, numberOfRatingVotes:451479, name:"The Butterfly Effect", rating:7.6, description:"Evan Treborn suffers blackouts during significant events of his life. As he grows up, he finds a way to remember these lost memories and a supernatural way to alter his life by reading his journal.", id:"The Butterfly Effect", grossRevenue:57938693}}, {_id:2238, properties:{runtimeInMinutes:113, numberOfRatingVotes:376853, name:"28 Days Later...", rating:7.6, description:"Four weeks after a mysterious, incurable virus spreads throughout the UK, a handful of survivors try to find sanctuary.", id:"28 Days Later...", grossRevenue:45064915}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2239, properties:{runtimeInMinutes:114, numberOfRatingVotes:169091, name:"Batoru rowaiaru", rating:7.6, description:"In the future, the Japanese government captures a class of ninth-grade students and forces them to kill each other under the revolutionary \"Battle Royale\" act.", id:"Batoru rowaiaru"}}, {_id:2240, properties:{runtimeInMinutes:110, numberOfRatingVotes:266842, name:"The Royal Tenenbaums", rating:7.6, description:"The eccentric members of a dysfunctional family reluctantly gather under the same roof for various reasons.", id:"The Royal Tenenbaums", grossRevenue:52364010}}, {_id:2241, properties:{runtimeInMinutes:106, numberOfRatingVotes:115827, name:"Y tu mamá también", rating:7.6, description:"In Mexico, two teenage boys and an attractive older woman embark on a road trip and learn a thing or two about life, friendship, sex, and each other.", id:"Y tu mamá también", grossRevenue:13622333}}, {_id:2242, properties:{runtimeInMinutes:152, numberOfRatingVotes:658185, name:"Harry Potter and the Sorcerer's Stone", rating:7.6, description:"An orphaned boy enrolls in a school of wizardry, where he learns the truth about himself, his family and the terrible evil that haunts the magical world.", id:"Harry Potter and the Sorcerer's Stone", grossRevenue:317575550}}, {_id:2243, properties:{runtimeInMinutes:101, numberOfRatingVotes:337651, name:"The Others", rating:7.6, description:"A woman who lives in her darkened old family house with her two photosensitive children becomes convinced that the home is haunted.", id:"The Others", grossRevenue:96522687}}, {_id:2244, properties:{runtimeInMinutes:124, numberOfRatingVotes:240714, name:"Blow", rating:7.6, description:"The story of how George Jung, along with the Medellín Cartel headed by Pablo Escobar, established the American cocaine market in the 1970s in the United States.", id:"Blow", grossRevenue:52990775}}, {_id:2245, properties:{runtimeInMinutes:131, numberOfRatingVotes:243729, name:"Enemy at the Gates", rating:7.6, description:"A Russian and a German sniper play a game of cat-and-mouse during the Battle of Stalingrad.", id:"Enemy at the Gates", grossRevenue:51401758}}, {_id:2246, properties:{runtimeInMinutes:145, numberOfRatingVotes:508417, name:"Minority Report", rating:7.6, description:"In a future where a special police unit is able to arrest murderers before they commit their crimes, an officer from that unit is himself accused of a future murder.", id:"Minority Report", grossRevenue:132072926}}, {_id:2247, properties:{runtimeInMinutes:146, numberOfRatingVotes:91557, name:"The Hurricane", rating:7.6, description:"The story of Rubin 'Hurricane' Carter, a boxer wrongly imprisoned for murder, and the people who aided in his fight to prove his innocence.", id:"The Hurricane", grossRevenue:50668906}}, {_id:2248, properties:{runtimeInMinutes:101, numberOfRatingVotes:490062, name:"American Psycho", rating:7.6, description:"A wealthy New York City investment banking executive, Patrick Bateman, hides his alternate psychopathic ego from his co-workers and friends as he delves deeper into his violent, hedonistic fantasies.", id:"American Psycho", grossRevenue:15070285}}, {_id:2249, properties:{runtimeInMinutes:81, numberOfRatingVotes:188317, name:"Lola rennt", rating:7.6, description:"After a botched money delivery, Lola has 20 minutes to come up with 100,000 Deutschmarks.", id:"Lola rennt", grossRevenue:7267585}}, {_id:2250, properties:{runtimeInMinutes:170, numberOfRatingVotes:172710, name:"The Thin Red Line", rating:7.6, description:"Adaptation of James Jones' autobiographical 1962 novel, focusing on the conflict at Guadalcanal during the second World War.", id:"The Thin Red Line", grossRevenue:36400491}}, {_id:2251, properties:{runtimeInMinutes:88, numberOfRatingVotes:256906, name:"Mulan", rating:7.6, description:"To save her father from death in the army, a young maiden secretly goes in his place and becomes one of China's greatest heroines in the process.", id:"Mulan", grossRevenue:120620254}}, {_id:2252, properties:{runtimeInMinutes:118, numberOfRatingVotes:259753, name:"Fear and Loathing in Las Vegas", rating:7.6, description:"An oddball journalist and his psychopathic lawyer travel to Las Vegas for a series of psychedelic escapades.", id:"Fear and Loathing in Las Vegas", grossRevenue:10680275}}, {_id:2253, properties:{runtimeInMinutes:108, numberOfRatingVotes:65058, name:"Funny Games", rating:7.6, description:"Two violent young men take a mother, father, and son hostage in their vacation cabin and force them to play sadistic \"games\" with one another for their own amusement.", id:"Funny Games"}}, {_id:2254, properties:{runtimeInMinutes:100, numberOfRatingVotes:187927, name:"Dark City", rating:7.6, description:"A man struggles with memories of his past, which include a wife he cannot remember and a nightmarish world no one else ever seems to wake up from.", id:"Dark City", grossRevenue:14378331}}, {_id:2255, properties:{runtimeInMinutes:147, numberOfRatingVotes:186734, name:"Sleepers", rating:7.6, description:"After a prank goes disastrously wrong, a group of boys are sent to a detention center where they are brutalized. Thirteen years later, an unexpected random encounter with a former guard gives them a chance for revenge.", id:"Sleepers", grossRevenue:49100000}}, {_id:2256, properties:{runtimeInMinutes:134, numberOfRatingVotes:131101, name:"Lost Highway", rating:7.6, description:"Anonymous videotapes presage a musician's murder conviction, and a gangster's girlfriend leads a mechanic astray.", id:"Lost Highway", grossRevenue:3796699}}, {_id:2257, properties:{runtimeInMinutes:136, numberOfRatingVotes:102598, name:"Sense and Sensibility", rating:7.6, description:"Rich Mr. Dashwood dies, leaving his second wife and her three daughters poor by the rules of inheritance. The two eldest daughters are the title opposites.", id:"Sense and Sensibility", grossRevenue:43182776}}, {_id:2258, properties:{runtimeInMinutes:128, numberOfRatingVotes:364420, name:"Die Hard: With a Vengeance", rating:7.6, description:"John McClane and a Harlem store owner are targeted by German terrorist Simon in New York City, where he plans to rob the Federal Reserve Building.", id:"Die Hard: With a Vengeance", grossRevenue:100012499}}] AS row

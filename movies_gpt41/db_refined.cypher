UNWIND [{_id:6838, properties:{runtimeInMinutes:111, numberOfRatingVotes:31568, name:"Ace in the Hole", rating:8.1, description:"A frustrated former big-city journalist now stuck working for an Albuquerque newspaper exploits a story about a man trapped in a cave to rekindle his career, but the situation quickly escalates into an out-of-control circus.", id:"Ace in the Hole", grossRevenue:3969893}}, {_id:6839, properties:{runtimeInMinutes:114, numberOfRatingVotes:29807, name:"White Heat", rating:8.1, description:"A psychopathic criminal with a mother complex makes a daring break from prison and leads his old gang in a chemical plant payroll heist.", id:"White Heat"}}, {_id:6840, properties:{runtimeInMinutes:104, numberOfRatingVotes:158731, name:"The Third Man", rating:8.1, description:"Pulp novelist Holly Martins travels to shadowy, postwar Vienna, only to find himself investigating the mysterious death of an old friend, Harry Lime.", id:"The Third Man", grossRevenue:449191}}, {_id:6841, properties:{runtimeInMinutes:135, numberOfRatingVotes:30935, name:"The Red Shoes", rating:8.1, description:"A young ballet dancer is torn between the man she loves and her pursuit to become a prima ballerina.", id:"The Red Shoes", grossRevenue:10900000}}, {_id:6842, properties:{runtimeInMinutes:99, numberOfRatingVotes:28450, name:"The Shop Around the Corner", rating:8.1, description:"Two employees at a gift shop can barely stand each other, without realizing that they are falling in love through the post as each other's anonymous pen pal.", id:"The Shop Around the Corner", grossRevenue:203300}}, {_id:6843, properties:{runtimeInMinutes:130, numberOfRatingVotes:123942, name:"Rebecca", rating:8.1, description:"A self-conscious woman juggles adjusting to her new role as an aristocrat's wife and avoiding being intimidated by his first wife's spectral presence.", id:"Rebecca", grossRevenue:4360000}}, {_id:6844, properties:{runtimeInMinutes:129, numberOfRatingVotes:107017, name:"Mr. Smith Goes to Washington", rating:8.1, description:"A naive man is appointed to fill a vacancy in the United States Senate. His plans promptly collide with political corruption, but he doesn't back down.", id:"Mr. Smith Goes to Washington", grossRevenue:9600000}}, {_id:6845, properties:{runtimeInMinutes:238, numberOfRatingVotes:290074, name:"Gone with the Wind", rating:8.1, description:"A manipulative woman and a roguish man conduct a turbulent romance during the American Civil War and Reconstruction periods.", id:"Gone with the Wind", grossRevenue:198676459}}, {_id:6846, properties:{runtimeInMinutes:113, numberOfRatingVotes:33829, rating:8.1, name:"La Grande Illusion", description:"During WWI, two French soldiers are captured and imprisoned in a German P.O.W. camp. Several escape attempts follow until they are eventually sent to a seemingly inescapable fortress.", id:"La Grande Illusion", grossRevenue:172885}}, {_id:6847, properties:{runtimeInMinutes:105, numberOfRatingVotes:94016, name:"It Happened One Night", rating:8.1, description:"A renegade reporter and a crazy young heiress meet on a bus heading for New York, and end up stuck with each other when the bus leaves them behind at one of the stops.", id:"It Happened One Night", grossRevenue:4360000}}, {_id:6848, properties:{runtimeInMinutes:110, numberOfRatingVotes:47676, name:"La passion de Jeanne d'Arc", rating:8.1, description:"In 1431, Jeanne d'Arc is placed on trial on charges of heresy. The ecclesiastical jurists attempt to force Jeanne to recant her claims of holy visions.", id:"La passion de Jeanne d'Arc", grossRevenue:21877}}, {_id:6849, properties:{runtimeInMinutes:72, numberOfRatingVotes:30205, name:"The Circus", rating:8.1, description:"The Tramp finds work and the girl of his dreams at a circus.", id:"The Circus"}}, {_id:6850, properties:{runtimeInMinutes:94, numberOfRatingVotes:46865, name:"Sunrise: A Song of Two Humans", rating:8.1, description:"An allegorical tale about a man fighting the good and evil within him. Both sides are made flesh - one a sophisticated woman he is attracted to and the other his wife.", id:"Sunrise: A Song of Two Humans", grossRevenue:539540}}, {_id:6851, properties:{runtimeInMinutes:67, numberOfRatingVotes:81156, name:"The General", rating:8.1, description:"When Union spies steal an engineer's beloved locomotive, he pursues it single-handedly and straight through enemy lines.", id:"The General", grossRevenue:1033895}}, {_id:6852, properties:{runtimeInMinutes:76, numberOfRatingVotes:57428, rating:8.1, name:"Das Cabinet des Dr. Caligari", description:"Hypnotist Dr. Caligari uses a somnambulist, Cesare, to commit murders.", id:"Das Cabinet des Dr. Caligari"}}, {_id:6853, properties:{runtimeInMinutes:124, numberOfRatingVotes:27978, name:"Badhaai ho", rating:8.0, description:"A man is embarrassed when he finds out his mother is pregnant.", id:"Badhaai ho"}}, {_id:6854, properties:{runtimeInMinutes:113, numberOfRatingVotes:37556, name:"Togo", rating:8.0, description:"The story of Togo, the sled dog who led the 1925 serum run yet was considered by most to be too small and weak to lead such an intense race.", id:"Togo"}}, {_id:6855, properties:{runtimeInMinutes:130, numberOfRatingVotes:52897, name:"Airlift", rating:8.0, description:"When Iraq invades Kuwait in August 1990, a callous Indian businessman becomes the spokesperson for more than 170,000 stranded countrymen.", id:"Airlift"}}, {_id:6856, properties:{runtimeInMinutes:163, numberOfRatingVotes:72245, name:"Bajrangi Bhaijaan", rating:8.0, description:"An Indian man with a magnanimous heart takes a young mute Pakistani girl back to her homeland to reunite her with her family.", id:"Bajrangi Bhaijaan", grossRevenue:8178001}}, {_id:6857, properties:{runtimeInMinutes:159, numberOfRatingVotes:52848, name:"Baby", rating:8.0, description:"An elite counter-intelligence unit learns of a plot, masterminded by a maniacal madman. With the clock ticking, it's up to them to track the terrorists' international tentacles and prevent them from striking at the heart of India.", id:"Baby"}}] AS row

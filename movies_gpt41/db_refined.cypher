UNWIND [{_id:6818, properties:{runtimeInMinutes:105, numberOfRatingVotes:45434, name:"Le samouraï", rating:8.1, description:"After professional hitman Jef Costello is seen by witnesses his efforts to provide himself an alibi drive him further into a corner.", id:"Le samouraï", grossRevenue:39481}}, {_id:6819, properties:{runtimeInMinutes:127, numberOfRatingVotes:161984, name:"Cool Hand Luke", rating:8.1, description:"A laid back Southern man is sentenced to two years in a rural prison, but refuses to conform.", id:"Cool Hand Luke", grossRevenue:16217773}}, {_id:6820, properties:{runtimeInMinutes:85, numberOfRatingVotes:103191, name:"Persona", rating:8.1, description:"A nurse is put in charge of a mute actress and finds that their personae are melding together.", id:"Persona"}}, {_id:6821, properties:{runtimeInMinutes:205, numberOfRatingVotes:46947, name:"Andrei Rublev", rating:8.1, description:"The life, times and afflictions of the fifteenth-century Russian iconographer St. Andrei Rublev.", id:"Andrei Rublev", grossRevenue:102021}}, {_id:6822, properties:{runtimeInMinutes:121, numberOfRatingVotes:53089, rating:8.1, name:"La battaglia di Algeri", description:"In the 1950s, fear and violence escalate as the people of Algiers fight for independence from the French government.", id:"La battaglia di Algeri", grossRevenue:55908}}, {_id:6823, properties:{runtimeInMinutes:95, numberOfRatingVotes:29682, name:"El ángel exterminador", rating:8.1, description:"The guests at an upper-class dinner party find themselves unable to leave.", id:"El ángel exterminador"}}, {_id:6824, properties:{runtimeInMinutes:134, numberOfRatingVotes:50058, name:"What Ever Happened to Baby Jane?", rating:8.1, description:"A former child star torments her paraplegic sister in their decaying Hollywood mansion.", id:"What Ever Happened to Baby Jane?", grossRevenue:4050000}}, {_id:6825, properties:{runtimeInMinutes:96, numberOfRatingVotes:33044, name:"Sanjuro", rating:8.1, description:"A crafty samurai helps a young man and his fellow clansmen save his uncle, who has been framed and imprisoned by a corrupt superintendent.", id:"Sanjuro"}}, {_id:6826, properties:{runtimeInMinutes:123, numberOfRatingVotes:68827, rating:8.1, name:"The Man Who Shot Liberty Valance", description:"A senator returns to a western town for the funeral of an old friend and tells the story of his origins.", id:"The Man Who Shot Liberty Valance"}}, {_id:6827, properties:{runtimeInMinutes:95, numberOfRatingVotes:31728, name:"Ivanovo detstvo", rating:8.1, description:"In WW2, twelve year old Soviet orphan Ivan Bondarev works for the Soviet army as a scout behind the German lines and strikes a friendship with three sympathetic Soviet officers.", id:"Ivanovo detstvo"}}, {_id:6828, properties:{runtimeInMinutes:89, numberOfRatingVotes:26697, name:"Jungfrukällan", rating:8.1, description:"An innocent yet pampered young virgin and her family's pregnant and jealous servant set out to deliver candles to church, but only one returns from events that transpire in the woods along the way.", id:"Jungfrukällan", grossRevenue:1526000}}, {_id:6829, properties:{runtimeInMinutes:128, numberOfRatingVotes:27254, name:"Inherit the Wind", rating:8.1, description:"Based on a real-life case in 1925, two great lawyers argue the case for and against a science teacher accused of the crime of teaching evolution.", id:"Inherit the Wind"}}, {_id:6830, properties:{runtimeInMinutes:99, numberOfRatingVotes:105291, name:"Les quatre cents coups", rating:8.1, description:"A young boy, left without attention, delves into a life of petty crime.", id:"Les quatre cents coups"}}, {_id:6831, properties:{runtimeInMinutes:212, numberOfRatingVotes:219466, name:"Ben-Hur", rating:8.1, description:"After a Jewish prince is betrayed and sent into slavery by a Roman friend, he regains his freedom and comes back for revenge.", id:"Ben-Hur", grossRevenue:74700000}}, {_id:6832, properties:{runtimeInMinutes:139, numberOfRatingVotes:34797, rating:8.1, name:"Kakushi-toride no san-akunin", description:"Lured by gold, two greedy peasants unknowingly escort a princess and her general across enemy lines.", id:"Kakushi-toride no san-akunin"}}, {_id:6833, properties:{runtimeInMinutes:110, numberOfRatingVotes:42940, rating:8.1, name:"Le notti di Cabiria", description:"A waifish prostitute wanders the streets of Rome looking for true love but finds only heartbreak.", id:"Le notti di Cabiria", grossRevenue:752045}}, {_id:6834, properties:{runtimeInMinutes:110, numberOfRatingVotes:46678, name:"Kumonosu-jô", rating:8.1, description:"A war-hardened general, egged on by his ambitious wife, works to fulfill a prophecy that he would become lord of Spider's Web Castle.", id:"Kumonosu-jô"}}, {_id:6835, properties:{runtimeInMinutes:161, numberOfRatingVotes:203463, name:"The Bridge on the River Kwai", rating:8.1, description:"British POWs are forced to build a railway bridge across the river Kwai for their Japanese captors, not knowing that the allied forces are planning to destroy it.", id:"The Bridge on the River Kwai", grossRevenue:44908000}}, {_id:6836, properties:{runtimeInMinutes:108, numberOfRatingVotes:142107, name:"On the Waterfront", rating:8.1, description:"An ex-prize fighter turned longshoreman struggles to stand up to his corrupt union bosses.", id:"On the Waterfront", grossRevenue:9600000}}, {_id:6837, properties:{runtimeInMinutes:131, numberOfRatingVotes:54588, name:"Le salaire de la peur", rating:8.1, description:"In a decrepit South American village, four men are hired to transport an urgent nitroglycerine shipment without the equipment that would make it safe.", id:"Le salaire de la peur"}}] AS row

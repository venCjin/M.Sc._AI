UNWIND [{_id:6978, properties:{runtimeInMinutes:122, numberOfRatingVotes:99182, name:"A Streetcar Named Desire", rating:8.0, description:"Disturbed Blanche DuBois moves in with her sister in New Orleans and is tormented by her brutish brother-in-law while her reality crumbles around her.", id:"A Streetcar Named Desire", grossRevenue:8000000}}, {_id:6979, properties:{runtimeInMinutes:94, numberOfRatingVotes:26784, name:"In a Lonely Place", rating:8.0, description:"A potentially violent screenwriter is a murder suspect until his lovely neighbor clears him. However, she soon starts to have her doubts.", id:"In a Lonely Place"}}, {_id:6980, properties:{runtimeInMinutes:106, numberOfRatingVotes:34485, name:"Kind Hearts and Coronets", rating:8.0, description:"A distant poor relative of the Duke D'Ascoyne plots to inherit the title by murdering the eight other heirs who stand ahead of him in the line of succession.", id:"Kind Hearts and Coronets"}}, {_id:6981, properties:{runtimeInMinutes:80, numberOfRatingVotes:129783, name:"Rope", rating:8.0, description:"Two men attempt to prove they committed the perfect crime by hosting a dinner party after strangling their former classmate to death.", id:"Rope"}}, {_id:6982, properties:{runtimeInMinutes:97, numberOfRatingVotes:32784, name:"Out of the Past", rating:8.0, description:"A private eye escapes his past to run a gas station in a small town, but his past catches up with him. Now he must return to the big city world of danger, corruption, double crosses and duplicitous dames.", id:"Out of the Past"}}, {_id:6983, properties:{runtimeInMinutes:86, numberOfRatingVotes:35601, name:"Brief Encounter", rating:8.0, description:"Meeting a stranger in a railway station, a woman is tempted to cheat on her husband.", id:"Brief Encounter"}}, {_id:6984, properties:{runtimeInMinutes:88, numberOfRatingVotes:42725, name:"Laura", rating:8.0, description:"A police detective falls in love with the woman whose murder he is investigating.", id:"Laura", grossRevenue:4360000}}, {_id:6985, properties:{runtimeInMinutes:170, numberOfRatingVotes:57259, name:"The Best Years of Our Lives", rating:8.0, description:"Three World War II veterans return home to small-town America to discover that they and their families have been irreparably changed.", id:"The Best Years of Our Lives", grossRevenue:23650000}}, {_id:6986, properties:{runtimeInMinutes:118, numberOfRatingVotes:65101, name:"Arsenic and Old Lace", rating:8.0, description:"A writer of books on the futility of marriage risks his reputation when he decides to get married. Things get even more complicated when he learns on his wedding day that his beloved maiden aunts are habitual murderers.", id:"Arsenic and Old Lace"}}, {_id:6987, properties:{runtimeInMinutes:100, numberOfRatingVotes:148928, name:"The Maltese Falcon", rating:8.0, description:"A private detective takes on a case that involves him with three eccentric criminals, a gorgeous liar, and their quest for a priceless statuette.", id:"The Maltese Falcon", grossRevenue:2108060}}, {_id:6988, properties:{runtimeInMinutes:129, numberOfRatingVotes:85559, rating:8.0, name:"The Grapes of Wrath", description:"A poor Midwest family is forced off their land. They travel to California, suffering the misfortunes of the homeless in the Great Depression.", id:"The Grapes of Wrath", grossRevenue:55000}}, {_id:6989, properties:{runtimeInMinutes:102, numberOfRatingVotes:371379, name:"The Wizard of Oz", rating:8.0, description:"Dorothy Gale is swept away from a farm in Kansas to a magical land of Oz in a tornado and embarks on a quest with her new friends to see the Wizard who can help her return home to Kansas and help her friends as well.", id:"The Wizard of Oz", grossRevenue:2076020}}, {_id:6990, properties:{runtimeInMinutes:110, numberOfRatingVotes:26725, name:"La règle du jeu", rating:8.0, description:"A bourgeois life in France at the onset of World War II, as the rich and their poor servants meet up at a French chateau.", id:"La règle du jeu"}}, {_id:6991, properties:{runtimeInMinutes:91, numberOfRatingVotes:26642, name:"The Thin Man", rating:8.0, description:"Former detective Nick Charles and his wealthy wife Nora investigate a murder case, mostly for the fun of it.", id:"The Thin Man"}}, {_id:6992, properties:{runtimeInMinutes:152, numberOfRatingVotes:57318, name:"All Quiet on the Western Front", rating:8.0, description:"A German youth eagerly enters World War I, but his enthusiasm wanes as he gets a firsthand view of the horror.", id:"All Quiet on the Western Front", grossRevenue:3270000}}, {_id:6993, properties:{runtimeInMinutes:75, numberOfRatingVotes:53054, rating:8.0, name:"Bronenosets Potemkin", description:"In the midst of the Russian Revolution of 1905, the crew of the battleship Potemkin mutiny against the brutal, tyrannical regime of the vessel's officers. The resulting street demonstration in Odessa brings on a police massacre.", id:"Bronenosets Potemkin", grossRevenue:50970}}, {_id:6994, properties:{runtimeInMinutes:130, numberOfRatingVotes:454203, name:"Knives Out", rating:7.9, description:"A detective investigates the death of a patriarch of an eccentric, combative family.", id:"Knives Out", grossRevenue:165359751}}, {_id:6995, properties:{runtimeInMinutes:101, numberOfRatingVotes:111478, name:"Dil Bechara", rating:7.9, description:"The emotional journey of two hopelessly in love youngsters, a young girl, Kizie, suffering from cancer, and a boy, Manny, whom she meets at a support group.", id:"Dil Bechara"}}, {_id:6996, properties:{runtimeInMinutes:121, numberOfRatingVotes:62754, name:"Manbiki kazoku", rating:7.9, description:"A family of small-time crooks take in a child they find outside in the cold.", id:"Manbiki kazoku", grossRevenue:3313513}}, {_id:6997, properties:{runtimeInMinutes:137, numberOfRatingVotes:246644, name:"Marriage Story", rating:7.9, description:"Noah Baumbach's incisive and compassionate look at a marriage breaking up and a family staying together.", id:"Marriage Story", grossRevenue:2000000}}] AS row

UNWIND [{_id:6798, properties:{runtimeInMinutes:89, numberOfRatingVotes:363401, name:"Stand by Me", rating:8.1, description:"After the death of one of his friends, a writer recounts a childhood journey with his friends to find the body of a missing boy.", id:"Stand by Me", grossRevenue:52287414}}, {_id:6799, properties:{runtimeInMinutes:120, numberOfRatingVotes:381222, name:"Platoon", rating:8.1, description:"Chris Taylor, a neophyte recruit in Vietnam, finds himself caught in a battle of wills between two sergeants, one good and the other evil. A shrewd examination of the brutality of war and the duality of man in conflict.", id:"Platoon", grossRevenue:138530565}}, {_id:6800, properties:{runtimeInMinutes:145, numberOfRatingVotes:91188, name:"Paris, Texas", rating:8.1, description:"Travis Henderson, an aimless drifter who has been missing for four years, wanders out of the desert and must reconnect with society, himself, his life, and his family.", id:"Paris, Texas", grossRevenue:2181987}}, {_id:6801, properties:{runtimeInMinutes:117, numberOfRatingVotes:150924, rating:8.1, name:"Kaze no tani no Naushika", description:"Warrior and pacifist Princess Nausicaä desperately struggles to prevent two warring nations from destroying themselves and their dying planet.", id:"Kaze no tani no Naushika", grossRevenue:495770}}, {_id:6802, properties:{runtimeInMinutes:109, numberOfRatingVotes:371271, name:"The Thing", rating:8.1, description:"A research team in Antarctica is hunted by a shape-shifting alien that assumes the appearance of its victims.", id:"The Thing", grossRevenue:13782838}}, {_id:6803, properties:{runtimeInMinutes:95, numberOfRatingVotes:76081, name:"Pink Floyd: The Wall", rating:8.1, description:"A confined but troubled rock star descends into madness in the midst of his physical and social isolation from everyone.", id:"Pink Floyd: The Wall", grossRevenue:22244207}}, {_id:6804, properties:{runtimeInMinutes:158, numberOfRatingVotes:31595, name:"Fitzcarraldo", rating:8.1, description:"The story of Brian Sweeney Fitzgerald, an extremely determined man who intends to build an opera house in the middle of a jungle.", id:"Fitzcarraldo"}}, {_id:6805, properties:{runtimeInMinutes:188, numberOfRatingVotes:57784, name:"Fanny och Alexander", rating:8.1, description:"Two young Swedish children experience the many comedies and tragedies of their family, the Ekdahls.", id:"Fanny och Alexander", grossRevenue:4971340}}, {_id:6806, properties:{runtimeInMinutes:117, numberOfRatingVotes:693827, name:"Blade Runner", rating:8.1, description:"A blade runner must pursue and terminate four replicants who stole a ship in space, and have returned to Earth to find their creator.", id:"Blade Runner", grossRevenue:32868943}}, {_id:6807, properties:{runtimeInMinutes:124, numberOfRatingVotes:220078, name:"The Elephant Man", rating:8.1, description:"A Victorian surgeon rescues a heavily disfigured man who is mistreated while scraping a living as a side-show freak. Behind his monstrous façade, there is revealed a person of kindness, intelligence and sophistication.", id:"The Elephant Man"}}, {_id:6808, properties:{runtimeInMinutes:94, numberOfRatingVotes:367250, name:"Life of Brian", rating:8.1, description:"Born on the original Christmas in the stable next door to Jesus Christ, Brian of Nazareth spends his life being mistaken for a messiah.", id:"Life of Brian", grossRevenue:20045115}}, {_id:6809, properties:{runtimeInMinutes:183, numberOfRatingVotes:311361, name:"The Deer Hunter", rating:8.1, description:"An in-depth examination of the ways in which the U.S. Vietnam War impacts and disrupts the lives of people in a small industrial town in Pennsylvania.", id:"The Deer Hunter", grossRevenue:48979328}}, {_id:6810, properties:{runtimeInMinutes:120, numberOfRatingVotes:518546, name:"Rocky", rating:8.1, description:"A small-time boxer gets a supremely rare chance to fight a heavy-weight champion in a bout in which he strives to go the distance for his self-respect.", id:"Rocky", grossRevenue:117235247}}, {_id:6811, properties:{runtimeInMinutes:121, numberOfRatingVotes:144911, name:"Network", rating:8.1, description:"A television network cynically exploits a deranged former anchor's ravings and revelations about the news media for its own profit.", id:"Network"}}, {_id:6812, properties:{runtimeInMinutes:185, numberOfRatingVotes:149843, name:"Barry Lyndon", rating:8.1, description:"An Irish rogue wins the heart of a rich widow and assumes her dead husband's aristocratic position in 18th-century England.", id:"Barry Lyndon"}}, {_id:6813, properties:{runtimeInMinutes:107, numberOfRatingVotes:40081, name:"Zerkalo", rating:8.1, description:"A dying man in his forties remembers his past. His childhood, his mother, the war, personal moments and things that tell of the recent history of all the Russian nation.", id:"Zerkalo", grossRevenue:177345}}, {_id:6814, properties:{runtimeInMinutes:130, numberOfRatingVotes:294230, name:"Chinatown", rating:8.1, description:"A private detective hired to expose an adulterer finds himself caught up in a web of deceit, corruption, and murder.", id:"Chinatown", grossRevenue:29000000}}, {_id:6815, properties:{runtimeInMinutes:102, numberOfRatingVotes:42285, name:"Paper Moon", rating:8.1, description:"During the Great Depression, a con man finds himself saddled with a young girl who may or may not be his daughter, and the two forge an unlikely partnership.", id:"Paper Moon", grossRevenue:30933743}}, {_id:6816, properties:{runtimeInMinutes:91, numberOfRatingVotes:30206, name:"Viskningar och rop", rating:8.1, description:"When a woman dying of cancer in early twentieth-century Sweden is visited by her two sisters, long-repressed feelings between the siblings rise to the surface.", id:"Viskningar och rop", grossRevenue:1742348}}, {_id:6817, properties:{runtimeInMinutes:167, numberOfRatingVotes:81021, name:"Solaris", rating:8.1, description:"A psychologist is sent to a station orbiting a distant planet in order to discover what has caused the crew to go insane.", id:"Solaris"}}] AS row

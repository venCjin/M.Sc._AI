UNWIND [{_id:6898, properties:{runtimeInMinutes:111, numberOfRatingVotes:641645, name:"Ratatouille", rating:8.0, description:"A rat who can cook makes an unusual alliance with a young kitchen worker at a famous restaurant.", id:"Ratatouille", grossRevenue:206445654}}, {_id:6899, properties:{runtimeInMinutes:144, numberOfRatingVotes:582239, name:"Casino Royale", rating:8.0, description:"After earning 00 status and a licence to kill, Secret Agent James Bond sets out on his first mission as 007. Bond must defeat a private banker funding terrorists in a high-stakes game of poker at Casino Royale, Montenegro.", id:"Casino Royale", grossRevenue:167445960}}, {_id:6900, properties:{runtimeInMinutes:137, numberOfRatingVotes:683900, name:"Kill Bill: Vol. 2", rating:8.0, description:"The Bride continues her quest of vengeance against her former boss and lover Bill, the reclusive bouncer Budd, and the treacherous, one-eyed Elle.", id:"Kill Bill: Vol. 2", grossRevenue:66208183}}, {_id:6901, properties:{runtimeInMinutes:110, numberOfRatingVotes:42399, name:"Vozvrashchenie", rating:8.0, description:"In the Russian wilderness, two brothers face a range of new, conflicting emotions when their father - a man they know only through a single photograph - resurfaces.", id:"Vozvrashchenie", grossRevenue:502028}}, {_id:6902, properties:{runtimeInMinutes:103, numberOfRatingVotes:77520, name:"Bom Yeoareum Gaeul Gyeoul Geurigo Bom", rating:8.0, description:"A boy is raised by a Buddhist monk in an isolated floating temple where the years pass like the seasons.", id:"Bom Yeoareum Gaeul Gyeoul Geurigo Bom", grossRevenue:2380788}}, {_id:6903, properties:{runtimeInMinutes:126, numberOfRatingVotes:77554, name:"Mar adentro", rating:8.0, description:"The factual story of Spaniard Ramon Sampedro, who fought a thirty-year campaign in favor of euthanasia and his own right to die.", id:"Mar adentro", grossRevenue:2086345}}, {_id:6904, properties:{runtimeInMinutes:144, numberOfRatingVotes:176151, name:"Cinderella Man", rating:8.0, description:"The story of James J. Braddock, a supposedly washed-up boxer who came back to become a champion and an inspiration in the 1930s.", id:"Cinderella Man", grossRevenue:61649911}}, {_id:6905, properties:{runtimeInMinutes:186, numberOfRatingVotes:63460, name:"Kal Ho Naa Ho", rating:8.0, description:"Naina, an introverted, perpetually depressed girl's life changes when she meets Aman. But Aman has a secret of his own which changes their lives forever. Embroiled in all this is Rohit, Naina's best friend who conceals his love for her.", id:"Kal Ho Naa Ho", grossRevenue:1787378}}, {_id:6906, properties:{runtimeInMinutes:101, numberOfRatingVotes:117857, name:"Mou gaan dou", rating:8.0, description:"A story between a mole in the police department and an undercover cop. Their objectives are the same: to find out who is the mole, and who is the cop.", id:"Mou gaan dou", grossRevenue:169659}}, {_id:6907, properties:{runtimeInMinutes:143, numberOfRatingVotes:1015122, name:"Pirates of the Caribbean: The Curse of the Black Pearl", rating:8.0, description:"Blacksmith Will Turner teams up with eccentric pirate \"Captain\" Jack Sparrow to save his love, the governor's daughter, from Jack's former pirate allies, who are now undead.", id:"Pirates of the Caribbean: The Curse of the Black Pearl", grossRevenue:305413918}}, {_id:6908, properties:{runtimeInMinutes:125, numberOfRatingVotes:415218, name:"Big Fish", rating:8.0, description:"A frustrated son tries to determine the fact from fiction in his dying father's life.", id:"Big Fish", grossRevenue:66257002}}, {_id:6909, properties:{runtimeInMinutes:115, numberOfRatingVotes:657047, name:"The Incredibles", rating:8.0, description:"A family of undercover superheroes, while trying to live the quiet suburban life, are forced into action to save the world.", id:"The Incredibles", grossRevenue:261441092}}, {_id:6910, properties:{runtimeInMinutes:137, numberOfRatingVotes:45403, name:"Yeopgijeogin geunyeo", rating:8.0, description:"A young man sees a drunk, cute woman standing too close to the tracks at a metro station in Seoul and pulls her back. She ends up getting him into trouble repeatedly after that, starting on the train.", id:"Yeopgijeogin geunyeo"}}, {_id:6911, properties:{runtimeInMinutes:178, numberOfRatingVotes:137963, name:"Dogville", rating:8.0, description:"A woman on the run from the mob is reluctantly accepted in a small Colorado community in exchange for labor, but when a search visits the town she finds out that their support has a price.", id:"Dogville", grossRevenue:1530386}}, {_id:6912, properties:{runtimeInMinutes:110, numberOfRatingVotes:33592, name:"Vizontele", rating:8.0, description:"Lives of residents in a small Anatolian village change when television is introduced to them", id:"Vizontele"}}, {_id:6913, properties:{runtimeInMinutes:113, numberOfRatingVotes:740086, name:"Donnie Darko", rating:8.0, description:"After narrowly escaping a bizarre accident, a troubled teenager is plagued by visions of a man in a large rabbit suit who manipulates him to commit a series of crimes.", id:"Donnie Darko", grossRevenue:1480006}}, {_id:6914, properties:{runtimeInMinutes:188, numberOfRatingVotes:289742, name:"Magnolia", rating:8.0, description:"An epic mosaic of interrelated characters in search of love, forgiveness, and meaning in the San Fernando Valley.", id:"Magnolia", grossRevenue:22455976}}, {_id:6915, properties:{runtimeInMinutes:140, numberOfRatingVotes:102285, name:"Dancer in the Dark", rating:8.0, description:"An East European girl travels to the United States with her young son, expecting it to be like a Hollywood film.", id:"Dancer in the Dark", grossRevenue:4184036}}, {_id:6916, properties:{runtimeInMinutes:112, numberOfRatingVotes:82002, name:"The Straight Story", rating:8.0, description:"An old man makes a long journey by lawnmower to mend his relationship with an ill brother.", id:"The Straight Story", grossRevenue:6203044}}, {_id:6917, properties:{runtimeInMinutes:81, numberOfRatingVotes:58192, rating:8.0, name:"Pâfekuto burû", description:"A pop singer gives up her career to become an actress, but she slowly goes insane when she starts being stalked by an obsessed fan and what seems to be a ghost of her past.", id:"Pâfekuto burû", grossRevenue:776665}}] AS row

UNWIND [{_id:6858, properties:{runtimeInMinutes:128, numberOfRatingVotes:505918, name:"La La Land", rating:8.0, description:"While navigating their careers in Los Angeles, a pianist and an actress fall in love while attempting to reconcile their aspirations for the future.", id:"La La Land", grossRevenue:151101803}}, {_id:6859, properties:{runtimeInMinutes:118, numberOfRatingVotes:213970, name:"Lion", rating:8.0, description:"A five-year-old Indian boy is adopted by an Australian couple after getting lost hundreds of kilometers from home. 25 years later, he sets out to find his lost family.", id:"Lion", grossRevenue:51739495}}, {_id:6860, properties:{runtimeInMinutes:144, numberOfRatingVotes:760094, name:"The Martian", rating:8.0, description:"An astronaut becomes stranded on Mars after his team assume him dead, and must rely on his ingenuity to find a way to signal to Earth that he is alive.", id:"The Martian", grossRevenue:228433663}}, {_id:6861, properties:{runtimeInMinutes:108, numberOfRatingVotes:434143, name:"Zootopia", rating:8.0, description:"In a city of anthropomorphic animals, a rookie bunny cop and a cynical con artist fox must work together to uncover a conspiracy.", id:"Zootopia", grossRevenue:341268248}}, {_id:6862, properties:{runtimeInMinutes:159, numberOfRatingVotes:102972, name:"Bãhubali: The Beginning", rating:8.0, description:"In ancient India, an adventurous and daring man becomes involved in a decades-old feud between two warring peoples.", id:"Bãhubali: The Beginning", grossRevenue:6738000}}, {_id:6863, properties:{runtimeInMinutes:137, numberOfRatingVotes:38746, name:"Kaguyahime no monogatari", rating:8.0, description:"Found inside a shining stalk of bamboo by an old bamboo cutter and his wife, a tiny girl grows rapidly into an exquisite young lady. The mysterious young princess enthralls all who encounter her, but ultimately she must confront her fate, the punishment for her crime.", id:"Kaguyahime no monogatari", grossRevenue:1506975}}, {_id:6864, properties:{runtimeInMinutes:113, numberOfRatingVotes:141923, name:"Wonder", rating:8.0, description:"Based on the New York Times bestseller, this movie tells the incredibly inspiring and heartwarming story of August Pullman, a boy with facial differences who enters the fifth grade, attending a mainstream elementary school for the first time.", id:"Wonder", grossRevenue:132422809}}, {_id:6865, properties:{runtimeInMinutes:154, numberOfRatingVotes:31886, name:"Gully Boy", rating:8.0, description:"A coming-of-age story based on the lives of street rappers in Mumbai.", id:"Gully Boy", grossRevenue:5566534}}, {_id:6866, properties:{runtimeInMinutes:144, numberOfRatingVotes:51069, name:"Special Chabbis", rating:8.0, description:"A gang of con-men rob prominent rich businessmen and politicians by posing as C.B.I and income tax officers.", id:"Special Chabbis", grossRevenue:1079369}}, {_id:6867, properties:{runtimeInMinutes:96, numberOfRatingVotes:81770, name:"Short Term 12", rating:8.0, description:"A 20-something supervising staff member of a residential treatment facility navigates the troubled waters of that world alongside her co-worker and longtime boyfriend.", id:"Short Term 12", grossRevenue:1010414}}, {_id:6868, properties:{runtimeInMinutes:150, numberOfRatingVotes:114316, name:"Serbuan maut 2: Berandal", rating:8.0, description:"Only a short time after the first raid, Rama goes undercover with the thugs of Jakarta and plans to bring down the syndicate and uncover the corruption within his police force.", id:"Serbuan maut 2: Berandal", grossRevenue:2625803}}, {_id:6869, properties:{runtimeInMinutes:114, numberOfRatingVotes:685201, name:"The Imitation Game", rating:8.0, description:"During World War II, the English mathematical genius Alan Turing tries to crack the German Enigma code with help from fellow mathematicians.", id:"The Imitation Game", grossRevenue:91125683}}, {_id:6870, properties:{runtimeInMinutes:121, numberOfRatingVotes:1043455, name:"Guardians of the Galaxy", rating:8.0, description:"A group of intergalactic criminals must pull together to stop a fanatical warrior with plans to purge the universe.", id:"Guardians of the Galaxy", grossRevenue:333176600}}, {_id:6871, properties:{runtimeInMinutes:164, numberOfRatingVotes:461823, name:"Blade Runner 2049", rating:8.0, description:"Young Blade Runner K's discovery of a long-buried secret leads him to track down former Blade Runner Rick Deckard, who's been missing for thirty years.", id:"Blade Runner 2049", grossRevenue:92054159}}, {_id:6872, properties:{runtimeInMinutes:126, numberOfRatingVotes:540772, name:"Her", rating:8.0, description:"In a near future, a lonely writer develops an unlikely relationship with an operating system designed to meet his every need.", id:"Her", grossRevenue:25568251}}, {_id:6873, properties:{runtimeInMinutes:134, numberOfRatingVotes:450349, name:"Bohemian Rhapsody", rating:8.0, description:"The story of the legendary British rock band Queen and lead singer Freddie Mercury, leading up to their famous performance at Live Aid (1985).", id:"Bohemian Rhapsody", grossRevenue:216428042}}, {_id:6874, properties:{runtimeInMinutes:156, numberOfRatingVotes:705589, name:"The Revenant", rating:8.0, description:"A frontiersman on a fur trading expedition in the 1820s fights for survival after being mauled by a bear and left for dead by members of his own hunting team.", id:"The Revenant", grossRevenue:183637894}}, {_id:6875, properties:{runtimeInMinutes:103, numberOfRatingVotes:462252, name:"The Perks of Being a Wallflower", rating:8.0, description:"An introvert freshman is taken under the wings of two seniors who welcome him to the real world", id:"The Perks of Being a Wallflower", grossRevenue:17738570}}, {_id:6876, properties:{runtimeInMinutes:115, numberOfRatingVotes:79200, name:"Tropa de Elite 2: O Inimigo Agora é Outro", rating:8.0, description:"After a prison riot, former-Captain Nascimento, now a high ranking security officer in Rio de Janeiro, is swept into a bloody political dispute that involves government officials and paramilitary groups.", id:"Tropa de Elite 2: O Inimigo Agora é Outro", grossRevenue:100119}}, {_id:6877, properties:{runtimeInMinutes:118, numberOfRatingVotes:639603, name:"The King's Speech", rating:8.0, description:"The story of King George VI, his impromptu ascension to the throne of the British Empire in 1936, and the speech therapist who helped the unsure monarch overcome his stammer.", id:"The King's Speech", grossRevenue:138797449}}] AS row

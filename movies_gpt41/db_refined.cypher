UNWIND [{_id:7038, properties:{runtimeInMinutes:120, numberOfRatingVotes:173999, name:"Ying xiong", rating:7.9, description:"A defense officer, Nameless, was summoned by the King of Qin regarding his success of terminating three warriors.", id:"Ying xiong", grossRevenue:53710019}}, {_id:7039, properties:{runtimeInMinutes:112, numberOfRatingVotes:104691, name:"Hable con ella", rating:7.9, description:"Two men share an odd friendship while they care for two women who are both in deep comas.", id:"Hable con ella", grossRevenue:9284265}}, {_id:7040, properties:{runtimeInMinutes:98, numberOfRatingVotes:44618, name:"No Man's Land", rating:7.9, description:"Bosnia and Herzegovina during 1993 at the time of the heaviest fighting between the two warring sides. Two soldiers from opposing sides in the conflict, Nino and Ciki, become trapped in no man's land, whilst a third soldier becomes a living booby trap.", id:"No Man's Land", grossRevenue:1059830}}, {_id:7041, properties:{runtimeInMinutes:115, numberOfRatingVotes:42897, name:"Cowboy Bebop: Tengoku no tobira", rating:7.9, description:"A terrorist explosion releases a deadly virus on the masses, and it's up the bounty-hunting Bebop crew to catch the cold-blooded culprit.", id:"Cowboy Bebop: Tengoku no tobira", grossRevenue:1000045}}, {_id:7042, properties:{runtimeInMinutes:119, numberOfRatingVotes:508771, name:"The Bourne Identity", rating:7.9, description:"A man is picked up by a fishing boat, bullet-riddled and suffering from amnesia, before racing to elude assassins and attempting to regain his memory.", id:"The Bourne Identity", grossRevenue:121661683}}, {_id:7043, properties:{runtimeInMinutes:114, numberOfRatingVotes:49721, name:"Nueve reinas", rating:7.9, description:"Two con artists try to swindle a stamp collector by selling him a sheet of counterfeit rare stamps (the \"nine queens\").", id:"Nueve reinas", grossRevenue:1221261}}, {_id:7044, properties:{runtimeInMinutes:109, numberOfRatingVotes:465113, name:"Children of Men", rating:7.9, description:"In 2027, in a chaotic world in which women have become somehow infertile, a former activist agrees to help transport a miraculously pregnant woman to a sanctuary at sea.", id:"Children of Men", grossRevenue:35552383}}, {_id:7045, properties:{runtimeInMinutes:122, numberOfRatingVotes:252586, name:"Almost Famous", rating:7.9, description:"A high-school boy is given the chance to write a story for Rolling Stone Magazine about an up-and-coming rock band as he accompanies them on their concert tour.", id:"Almost Famous", grossRevenue:32534850}}, {_id:7046, properties:{runtimeInMinutes:147, numberOfRatingVotes:322031, name:"Mulholland Dr.", rating:7.9, description:"After a car wreck on the winding Mulholland Drive renders a woman amnesiac, she and a perky Hollywood-hopeful search for clues and answers across Los Angeles in a twisting venture beyond dreams and reality.", id:"Mulholland Dr.", grossRevenue:7220243}}, {_id:7047, properties:{runtimeInMinutes:92, numberOfRatingVotes:527512, name:"Toy Story 2", rating:7.9, description:"When Woody is stolen by a toy collector, Buzz and his friends set out on a rescue mission to save Woody before he becomes a museum toy property with his roundup gang Jessie, Prospector, and Bullseye.", id:"Toy Story 2", grossRevenue:245852179}}, {_id:7048, properties:{runtimeInMinutes:155, numberOfRatingVotes:239473, name:"Boogie Nights", rating:7.9, description:"Back when sex was safe, pleasure was a business and business was booming, an idealistic porn producer aspires to elevate his craft to an art when he discovers a hot young talent.", id:"Boogie Nights", grossRevenue:26400640}}, {_id:7049, properties:{runtimeInMinutes:111, numberOfRatingVotes:51943, name:"Mimi wo sumaseba", rating:7.9, description:"A love story between a girl who loves reading books, and a boy who has previously checked out all of the library books she chooses.", id:"Mimi wo sumaseba"}}, {_id:7050, properties:{runtimeInMinutes:102, numberOfRatingVotes:31590, name:"Once Were Warriors", rating:7.9, description:"A family descended from Maori warriors is bedeviled by a violent father and the societal problems of being treated as outcasts.", id:"Once Were Warriors", grossRevenue:2201126}}, {_id:7051, properties:{runtimeInMinutes:119, numberOfRatingVotes:206918, name:"True Romance", rating:7.9, description:"In Detroit, a lonely pop culture geek marries a call girl, steals cocaine from her pimp, and tries to sell it in Hollywood. Meanwhile, the owners of the cocaine, the Mob, track them down in an attempt to reclaim it.", id:"True Romance", grossRevenue:12281500}}, {_id:7052, properties:{runtimeInMinutes:94, numberOfRatingVotes:89836, name:"Trois couleurs: Bleu", rating:7.9, description:"A woman struggles to find a way to live her life after the death of her husband and child.", id:"Trois couleurs: Bleu", grossRevenue:1324974}}, {_id:7053, properties:{runtimeInMinutes:94, numberOfRatingVotes:34529, name:"Jûbê ninpûchô", rating:7.9, description:"A vagabond swordsman is aided by a beautiful ninja girl and a crafty spy in confronting a demonic clan of killers - with a ghost from his past as their leader - who are bent on overthrowing the Tokugawa Shogunate.", id:"Jûbê ninpûchô"}}, {_id:7054, properties:{runtimeInMinutes:144, numberOfRatingVotes:201000, name:"Carlito's Way", rating:7.9, description:"A Puerto Rican former convict, just released from prison, pledges to stay away from drugs and violence despite the pressure around him and lead on to a better life outside of N.Y.C.", id:"Carlito's Way", grossRevenue:36948322}}, {_id:7055, properties:{runtimeInMinutes:105, numberOfRatingVotes:447368, name:"Edward Scissorhands", rating:7.9, description:"An artificial man, who was incompletely constructed and has scissors for hands, leads a solitary life. Then one day, a suburban lady meets him and introduces him to her world.", id:"Edward Scissorhands", grossRevenue:56362352}}, {_id:7056, properties:{runtimeInMinutes:103, numberOfRatingVotes:68076, name:"My Left Foot: The Story of Christy Brown", rating:7.9, description:"Christy Brown, born with cerebral palsy, learns to paint and write with his only controllable limb - his left foot.", id:"My Left Foot: The Story of Christy Brown", grossRevenue:14743391}}, {_id:7057, properties:{runtimeInMinutes:104, numberOfRatingVotes:54670, name:"Crimes and Misdemeanors", rating:7.9, description:"An ophthalmologist's mistress threatens to reveal their affair to his wife while a married documentary filmmaker is infatuated with another woman.", id:"Crimes and Misdemeanors", grossRevenue:18254702}}] AS row

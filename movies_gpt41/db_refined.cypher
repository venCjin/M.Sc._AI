UNWIND [{_id:7058, properties:{runtimeInMinutes:119, numberOfRatingVotes:281842, name:"The Untouchables", rating:7.9, description:"During the era of Prohibition in the United States, Federal Agent Eliot Ness sets out to stop ruthless Chicago gangster Al Capone and, because of rampant corruption, assembles a small, hand-picked team to help him.", id:"The Untouchables", grossRevenue:76270454}}, {_id:7059, properties:{runtimeInMinutes:107, numberOfRatingVotes:67176, name:"Hannah and Her Sisters", rating:7.9, description:"Between two Thanksgivings two years apart, Hannah's husband falls in love with her sister Lee, while her hypochondriac ex-husband rekindles his relationship with her sister Holly.", id:"Hannah and Her Sisters", grossRevenue:40084041}}, {_id:7060, properties:{runtimeInMinutes:132, numberOfRatingVotes:187567, name:"Brazil", rating:7.9, description:"A bureaucrat in a dystopic society becomes an enemy of the state as he pursues the woman of his dreams.", id:"Brazil", grossRevenue:9929135}}, {_id:7061, properties:{runtimeInMinutes:82, numberOfRatingVotes:128812, rating:7.9, name:"This Is Spinal Tap", description:"Spinal Tap, one of England's loudest bands, is chronicled by film director Marty DiBergi on what proves to be a fateful tour.", id:"This Is Spinal Tap", grossRevenue:188751}}, {_id:7062, properties:{runtimeInMinutes:93, numberOfRatingVotes:132947, name:"A Christmas Story", rating:7.9, description:"In the 1940s, a young boy named Ralphie attempts to convince his parents, his teacher and Santa that a Red Ryder BB gun really is the perfect Christmas gift.", id:"A Christmas Story", grossRevenue:20605209}}, {_id:7063, properties:{runtimeInMinutes:133, numberOfRatingVotes:183182, name:"The Blues Brothers", rating:7.9, description:"Jake Blues, just released from prison, puts together his old band to save the Catholic home where he and his brother Elwood were raised.", id:"The Blues Brothers", grossRevenue:57229890}}, {_id:7064, properties:{runtimeInMinutes:96, numberOfRatingVotes:131436, name:"Manhattan", rating:7.9, description:"The life of a divorced television writer dating a teenage girl is further complicated when he falls in love with his best friend's mistress.", id:"Manhattan", grossRevenue:45700000}}, {_id:7065, properties:{runtimeInMinutes:123, numberOfRatingVotes:28223, name:"All That Jazz", rating:7.9, description:"Director/choreographer Bob Fosse tells his own life story as he details the sordid career of Joe Gideon, a womanizing, drug-using dancer.", id:"All That Jazz", grossRevenue:37823676}}, {_id:7066, properties:{runtimeInMinutes:127, numberOfRatingVotes:111512, name:"Dawn of the Dead", rating:7.9, description:"Following an ever-growing epidemic of zombies that have risen from the dead, two Philadelphia S.W.A.T. team members, a traffic reporter, and his television executive girlfriend seek refuge in a secluded shopping mall.", id:"Dawn of the Dead", grossRevenue:5100000}}, {_id:7067, properties:{runtimeInMinutes:138, numberOfRatingVotes:103031, name:"All the President's Men", rating:7.9, description:"\"The Washington Post\" reporters Bob Woodward and Carl Bernstein uncover the details of the Watergate scandal that leads to President Richard Nixon's resignation.", id:"All the President's Men", grossRevenue:70600000}}, {_id:7068, properties:{runtimeInMinutes:114, numberOfRatingVotes:37183, rating:7.9, name:"La montaña sagrada", description:"In a corrupt, greed-fueled world, a powerful alchemist leads a messianic character and seven materialistic figures to the Holy Mountain, where they hope to achieve enlightenment.", id:"La montaña sagrada", grossRevenue:61001}}, {_id:7069, properties:{runtimeInMinutes:123, numberOfRatingVotes:39897, name:"Amarcord", rating:7.9, description:"A series of comedic and nostalgic vignettes set in a 1930s Italian coastal town.", id:"Amarcord"}}, {_id:7070, properties:{runtimeInMinutes:102, numberOfRatingVotes:38737, name:"Le charme discret de la bourgeoisie", rating:7.9, description:"A surreal, virtually plotless series of dreams centered around six middle-class people and their consistently interrupted attempts to have a meal together.", id:"Le charme discret de la bourgeoisie", grossRevenue:198809}}, {_id:7071, properties:{runtimeInMinutes:95, numberOfRatingVotes:52397, name:"Aguirre, der Zorn Gottes", rating:7.9, description:"In the 16th century, the ruthless and insane Don Lope de Aguirre leads a Spanish expedition in search of El Dorado.", id:"Aguirre, der Zorn Gottes"}}, {_id:7072, properties:{runtimeInMinutes:91, numberOfRatingVotes:70826, name:"Harold and Maude", rating:7.9, description:"Young, rich, and obsessed with death, Harold finds himself changed forever when he meets lively septuagenarian Maude at a funeral.", id:"Harold and Maude"}}, {_id:7073, properties:{runtimeInMinutes:172, numberOfRatingVotes:93741, name:"Patton", rating:7.9, description:"The World War II phase of the career of controversial American general George S. Patton.", id:"Patton", grossRevenue:61700000}}, {_id:7074, properties:{runtimeInMinutes:145, numberOfRatingVotes:77401, name:"The Wild Bunch", rating:7.9, description:"An aging group of outlaws look for one last big score as the \"traditional\" American West is disappearing around them.", id:"The Wild Bunch", grossRevenue:12064472}}, {_id:7075, properties:{runtimeInMinutes:96, numberOfRatingVotes:116557, rating:7.9, name:"Night of the Living Dead", description:"A ragtag group of Pennsylvanians barricade themselves in an old farmhouse to remain safe from a horde of flesh-eating ghouls that are ravaging the East Coast of the United States.", id:"Night of the Living Dead", grossRevenue:89029}}, {_id:7076, properties:{runtimeInMinutes:134, numberOfRatingVotes:29003, name:"The Lion in Winter", rating:7.9, description:"1183 A.D.: King Henry II's three sons all want to inherit the throne, but he won't commit to a choice. They and his wife variously plot to force him.", id:"The Lion in Winter", grossRevenue:22276975}}, {_id:7077, properties:{runtimeInMinutes:110, numberOfRatingVotes:67804, name:"In the Heat of the Night", rating:7.9, description:"A black police detective is asked to investigate a murder in a racially hostile southern town.", id:"In the Heat of the Night", grossRevenue:24379978}}] AS row

UNWIND [{_id:7238, properties:{runtimeInMinutes:100, numberOfRatingVotes:27007, name:"The Innocents", rating:7.8, description:"A young governess for two children becomes convinced that the house and grounds are haunted.", id:"The Innocents", grossRevenue:2616000}}, {_id:7239, properties:{runtimeInMinutes:90, numberOfRatingVotes:73251, rating:7.8, name:"À bout de souffle", description:"A small-time thief steals a car and impulsively murders a motorcycle policeman. Wanted by the authorities, he reunites with a hip American journalism student and attempts to persuade her to run away with him to Italy.", id:"À bout de souffle", grossRevenue:336705}}, {_id:7240, properties:{runtimeInMinutes:133, numberOfRatingVotes:28167, name:"Red River", rating:7.8, description:"Dunson leads a cattle drive, the culmination of over 14 years of work, to its destination in Missouri. But his tyrannical behavior along the way causes a mutiny, led by his adopted son.", id:"Red River"}}, {_id:7241, properties:{runtimeInMinutes:100, numberOfRatingVotes:36995, name:"Key Largo", rating:7.8, description:"A man visits his war buddy's family hotel and finds a gangster running things. As a hurricane approaches, the two end up confronting each other.", id:"Key Largo"}}, {_id:7242, properties:{runtimeInMinutes:100, numberOfRatingVotes:31053, name:"To Have and Have Not", rating:7.8, description:"During World War II, American expatriate Harry Morgan helps transport a French Resistance leader and his beautiful wife to Martinique while romancing a sensuous lounge singer.", id:"To Have and Have Not"}}, {_id:7243, properties:{runtimeInMinutes:108, numberOfRatingVotes:59556, name:"Shadow of a Doubt", rating:7.8, description:"A young girl, overjoyed when her favorite uncle comes to visit the family, slowly begins to suspect that he is in fact the \"Merry Widow\" killer sought by the authorities.", id:"Shadow of a Doubt"}}, {_id:7244, properties:{runtimeInMinutes:96, numberOfRatingVotes:43621, name:"Stagecoach", rating:7.8, description:"A group of people traveling on a stagecoach find their journey complicated by the threat of Geronimo and learn something about each other in the process.", id:"Stagecoach"}}, {_id:7245, properties:{runtimeInMinutes:96, numberOfRatingVotes:47400, name:"The Lady Vanishes", rating:7.8, description:"While travelling in continental Europe, a rich young playgirl realizes that an elderly lady seems to have disappeared from the train.", id:"The Lady Vanishes"}}, {_id:7246, properties:{runtimeInMinutes:102, numberOfRatingVotes:55163, name:"Bringing Up Baby", rating:7.8, description:"While trying to secure a $1 million donation for his museum, a befuddled paleontologist is pursued by a flighty and often irritating heiress and her pet leopard, Baby.", id:"Bringing Up Baby"}}, {_id:7247, properties:{runtimeInMinutes:75, numberOfRatingVotes:43542, name:"Bride of Frankenstein", rating:7.8, description:"Mary Shelley reveals the main characters of her novel survived: Dr. Frankenstein, goaded by an even madder scientist, builds his monster a mate.", id:"Bride of Frankenstein", grossRevenue:4360000}}, {_id:7248, properties:{runtimeInMinutes:69, numberOfRatingVotes:55581, name:"Duck Soup", rating:7.8, description:"Rufus T. Firefly is named president/dictator of bankrupt Freedonia and declares war on neighboring Sylvania over the love of wealthy Mrs. Teasdale.", id:"Duck Soup"}}, {_id:7249, properties:{runtimeInMinutes:93, numberOfRatingVotes:25312, rating:7.8, name:"Scarface: The Shame of the Nation", description:"An ambitious and nearly insane violent gangster climbs the ladder of success in the mob, but his weaknesses prove to be his downfall.", id:"Scarface: The Shame of the Nation"}}, {_id:7250, properties:{runtimeInMinutes:70, numberOfRatingVotes:65341, name:"Frankenstein", rating:7.8, description:"Dr. Frankenstein dares to tamper with life and death by creating a human monster out of lifeless body parts.", id:"Frankenstein"}}, {_id:7251, properties:{runtimeInMinutes:135, numberOfRatingVotes:140375, name:"Roma", rating:7.7, description:"A year in the life of a middle-class family's maid in Mexico City in the early 1970s.", id:"Roma"}}, {_id:7252, properties:{runtimeInMinutes:104, numberOfRatingVotes:25198, rating:7.7, name:"God's Own Country", description:"Spring. Yorkshire. Young farmer Johnny Saxby numbs his daily frustrations with binge drinking and casual sex, until the arrival of a Romanian migrant worker for lambing season ignites an intense relationship that sets Johnny on a new path.", id:"God's Own Country", grossRevenue:335609}}, {_id:7253, properties:{runtimeInMinutes:119, numberOfRatingVotes:478586, name:"Deadpool 2", rating:7.7, description:"Foul-mouthed mutant mercenary Wade Wilson (a.k.a. Deadpool), brings together a team of fellow mutant rogues to protect a young boy with supernatural abilities from the brutal, time-traveling cyborg Cable.", id:"Deadpool 2", grossRevenue:324591735}}, {_id:7254, properties:{runtimeInMinutes:107, numberOfRatingVotes:205444, name:"Wind River", rating:7.7, description:"A veteran hunter helps an FBI agent investigate the murder of a young woman on a Wyoming Native American reservation.", id:"Wind River", grossRevenue:33800859}}, {_id:7255, properties:{runtimeInMinutes:104, numberOfRatingVotes:492851, name:"Get Out", rating:7.7, description:"A young African-American visits his white girlfriend's parents for the weekend, where his simmering uneasiness about their reception of him eventually reaches a boiling point.", id:"Get Out", grossRevenue:176040665}}, {_id:7256, properties:{runtimeInMinutes:147, numberOfRatingVotes:291257, name:"Mission: Impossible - Fallout", rating:7.7, description:"Ethan Hunt and his IMF team, along with some familiar allies, race against time after a mission gone wrong.", id:"Mission: Impossible - Fallout", grossRevenue:220159104}}, {_id:7257, properties:{runtimeInMinutes:116, numberOfRatingVotes:47444, name:"En man som heter Ove", rating:7.7, description:"Ove, an ill-tempered, isolated retiree who spends his days enforcing block association rules and visiting his wife's grave, has finally given up on life just as an unlikely friendship develops with his boisterous new neighbors.", id:"En man som heter Ove", grossRevenue:3358518}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:7258, properties:{runtimeInMinutes:86, numberOfRatingVotes:157498, name:"What We Do in the Shadows", rating:7.7, description:"Viago, Deacon and Vladislav are vampires who are finding that modern life has them struggling with the mundane - like paying rent, keeping up with the chore wheel, trying to get into nightclubs and overcoming flatmate conflicts.", id:"What We Do in the Shadows", grossRevenue:3333000}}, {_id:7259, properties:{runtimeInMinutes:103, numberOfRatingVotes:32798, rating:7.7, name:"Omoide no Mânî", description:"Due to 12 y.o. Anna's asthma, she's sent to stay with relatives of her guardian in the Japanese countryside. She likes to be alone, sketching. She befriends Marnie. Who is the mysterious, blonde Marnie.", id:"Omoide no Mânî", grossRevenue:765127}}, {_id:7260, properties:{runtimeInMinutes:123, numberOfRatingVotes:404182, name:"The Theory of Everything", rating:7.7, description:"A look at the relationship between the famous physicist Stephen Hawking and his wife.", id:"The Theory of Everything", grossRevenue:35893537}}, {_id:7261, properties:{runtimeInMinutes:129, numberOfRatingVotes:590440, name:"Kingsman: The Secret Service", rating:7.7, description:"A spy organisation recruits a promising street kid into the agency's training program, while a global threat emerges from a twisted tech genius.", id:"Kingsman: The Secret Service", grossRevenue:128261724}}, {_id:7262, properties:{runtimeInMinutes:126, numberOfRatingVotes:344312, name:"The Fault in Our Stars", rating:7.7, description:"Two teenage cancer patients begin a life-affirming journey to visit a reclusive author in Amsterdam.", id:"The Fault in Our Stars", grossRevenue:124872350}}, {_id:7263, properties:{runtimeInMinutes:105, numberOfRatingVotes:123210, name:"Me and Earl and the Dying Girl", rating:7.7, description:"High schooler Greg, who spends most of his time making parodies of classic movies with his co-worker Earl, finds his outlook forever altered after befriending a classmate who has just been diagnosed with cancer.", id:"Me and Earl and the Dying Girl", grossRevenue:6743776}}, {_id:7264, properties:{runtimeInMinutes:119, numberOfRatingVotes:580291, name:"Birdman or (The Unexpected Virtue of Ignorance)", rating:7.7, description:"A washed-up superhero actor attempts to revive his fading career by writing, directing, and starring in a Broadway production.", id:"Birdman or (The Unexpected Virtue of Ignorance)", grossRevenue:42340598}}, {_id:7265, properties:{runtimeInMinutes:180, numberOfRatingVotes:138741, name:"La vie d'Adèle", rating:7.7, description:"Adèle's life is changed when she meets Emma, a young woman with blue hair, who will allow her to discover desire and to assert herself as a woman and as an adult. In front of others, Adèle grows, seeks herself, loses herself, and ultimately finds herself through love and loss.", id:"La vie d'Adèle", grossRevenue:2199675}}, {_id:7266, properties:{runtimeInMinutes:130, numberOfRatingVotes:32628, name:"Kai po che!", rating:7.7, description:"Three friends growing up in India at the turn of the millennium set out to open a training academy to produce the country's next cricket stars.", id:"Kai po che!", grossRevenue:1122527}}, {_id:7267, properties:{runtimeInMinutes:111, numberOfRatingVotes:39379, name:"The Broken Circle Breakdown", rating:7.7, description:"Elise and Didier fall in love at first sight, in spite of their differences. He talks, she listens. He's a romantic atheist, she's a religious realist. When their daughter becomes seriously ill, their love is put on trial.", id:"The Broken Circle Breakdown", grossRevenue:175058}}, {_id:7268, properties:{runtimeInMinutes:136, numberOfRatingVotes:736182, name:"Captain America: The Winter Soldier", rating:7.7, description:"As Steve Rogers struggles to embrace his role in the modern world, he teams up with a fellow Avenger and S.H.I.E.L.D agent, Black Widow, to battle a new threat from history: an assassin known as the Winter Soldier.", id:"Captain America: The Winter Soldier", grossRevenue:259766572}}, {_id:7269, properties:{runtimeInMinutes:159, numberOfRatingVotes:39501, name:"Rockstar", rating:7.7, description:"Janardhan Jakhar chases his dreams of becoming a big Rock star, during which he falls in love with Heer.", id:"Rockstar", grossRevenue:985912}}, {_id:7270, properties:{runtimeInMinutes:115, numberOfRatingVotes:112298, name:"Nebraska", rating:7.7, description:"An aging, booze-addled father makes the trip from Montana to Nebraska with his estranged son in order to claim a million-dollar Mega Sweepstakes Marketing prize.", id:"Nebraska", grossRevenue:17654912}}, {_id:7271, properties:{runtimeInMinutes:101, numberOfRatingVotes:380195, name:"Wreck-It Ralph", rating:7.7, description:"A video game villain wants to be a hero and sets out to fulfill his dream, but his quest brings havoc to the whole arcade where he lives.", id:"Wreck-It Ralph", grossRevenue:189422889}}, {_id:7272, properties:{runtimeInMinutes:108, numberOfRatingVotes:56720, name:"Le Petit Prince", rating:7.7, description:"A little girl lives in a very grown-up world with her mother, who tries to prepare her for it. Her neighbor, the Aviator, introduces the girl to an extraordinary world where anything is possible, the world of the Little Prince.", id:"Le Petit Prince", grossRevenue:1339152}}, {_id:7273, properties:{runtimeInMinutes:98, numberOfRatingVotes:77071, name:"Detachment", rating:7.7, description:"A substitute teacher who drifts from classroom to classroom finds a connection to the students and teachers during his latest assignment.", id:"Detachment", grossRevenue:71177}}, {_id:7274, properties:{runtimeInMinutes:96, numberOfRatingVotes:388089, name:"Midnight in Paris", rating:7.7, description:"While on a trip to Paris with his fiancée's family, a nostalgic screenwriter finds himself mysteriously going back to the 1920s every day at midnight.", id:"Midnight in Paris", grossRevenue:56816662}}, {_id:7275, properties:{runtimeInMinutes:100, numberOfRatingVotes:323982, name:"The Lego Movie", rating:7.7, description:"An ordinary LEGO construction worker, thought to be the prophesied as \"special\", is recruited to join a quest to stop an evil tyrant from gluing the LEGO universe into eternal stasis.", id:"The Lego Movie", grossRevenue:257760692}}, {_id:7276, properties:{runtimeInMinutes:91, numberOfRatingVotes:769145, name:"Gravity", rating:7.7, description:"Two astronauts work together to survive after an accident leaves them stranded in space.", id:"Gravity", grossRevenue:274092705}}, {_id:7277, properties:{runtimeInMinutes:132, numberOfRatingVotes:463188, name:"Star Trek Into Darkness", rating:7.7, description:"After the crew of the Enterprise find an unstoppable force of terror from within their own organization, Captain Kirk leads a manhunt to a war-zone world to capture a one-man weapon of mass destruction.", id:"Star Trek Into Darkness", grossRevenue:228778661}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:7278, properties:{runtimeInMinutes:137, numberOfRatingVotes:73964, rating:7.7, name:"Beasts of No Nation", description:"A drama based on the experiences of Agu, a child soldier fighting in the civil war of an unnamed African country.", id:"Beasts of No Nation", grossRevenue:83861}}, {_id:7279, properties:{runtimeInMinutes:120, numberOfRatingVotes:624982, name:"The Social Network", rating:7.7, description:"As Harvard student Mark Zuckerberg creates the social networking site that would become known as Facebook, he is sued by the twins who claimed he stole their idea, and by the co-founder who was later squeezed out of the business.", id:"The Social Network", grossRevenue:96962694}}, {_id:7280, properties:{runtimeInMinutes:131, numberOfRatingVotes:645512, name:"X: First Class", rating:7.7, description:"In the 1960s, superpowered humans Charles Xavier and Erik Lensherr work together to find others like them, but Erik's vengeful pursuit of an ambitious mutant who ruined his life causes a schism to divide them.", id:"X: First Class", grossRevenue:146408305}}, {_id:7281, properties:{runtimeInMinutes:100, numberOfRatingVotes:717559, name:"The Hangover", rating:7.7, description:"Three buddies wake up from a bachelor party in Las Vegas, with no memory of the previous night and the bachelor missing. They make their way around the city in order to find their friend before his wedding.", id:"The Hangover", grossRevenue:277322503}}, {_id:7282, properties:{runtimeInMinutes:143, numberOfRatingVotes:630614, name:"Skyfall", rating:7.7, description:"James Bond's loyalty to M is tested when her past comes back to haunt her. When MI6 comes under attack, 007 must track down and destroy the threat, no matter how personal the cost.", id:"Skyfall", grossRevenue:304360277}}, {_id:7283, properties:{runtimeInMinutes:122, numberOfRatingVotes:661871, name:"Silver Linings Playbook", rating:7.7, description:"After a stint in a mental institution, former teacher Pat Solitano moves back in with his parents and tries to reconcile with his ex-wife. Things get more challenging when Pat meets Tiffany, a mysterious girl with problems of her own.", id:"Silver Linings Playbook", grossRevenue:132092958}}, {_id:7284, properties:{runtimeInMinutes:120, numberOfRatingVotes:572581, name:"Argo", rating:7.7, description:"Acting under the cover of a Hollywood producer scouting a location for a science fiction film, a CIA agent launches a dangerous operation to rescue six Americans in Tehran during the U.S. hostage crisis in Iran in 1979.", id:"Argo", grossRevenue:136025503}}, {_id:7285, properties:{runtimeInMinutes:95, numberOfRatingVotes:472242, name:"(500) Days of Summer", rating:7.7, description:"An offbeat romantic comedy about a woman who doesn't believe true love exists, and the young man who falls for her.", id:"(500) Days of Summer", grossRevenue:32391374}}, {_id:7286, properties:{runtimeInMinutes:146, numberOfRatingVotes:479120, name:"Harry Potter and the Deathly Hallows: Part 1", rating:7.7, description:"As Harry, Ron, and Hermione race against time and evil to destroy the Horcruxes, they uncover the existence of the three most powerful objects in the wizarding world: the Deathly Hallows.", id:"Harry Potter and the Deathly Hallows: Part 1", grossRevenue:295983305}}, {_id:7287, properties:{runtimeInMinutes:101, numberOfRatingVotes:125317, name:"Gake no ue no Ponyo", rating:7.7, description:"A five-year-old boy develops a relationship with Ponyo, a young goldfish princess who longs to become a human after falling in love with him.", id:"Gake no ue no Ponyo", grossRevenue:15090400}}, {_id:7288, properties:{runtimeInMinutes:122, numberOfRatingVotes:103330, name:"Frost/Nixon", rating:7.7, description:"A dramatic retelling of the post-Watergate television interviews between British talk-show host David Frost and former president Richard Nixon.", id:"Frost/Nixon", grossRevenue:18593156}}, {_id:7289, properties:{runtimeInMinutes:90, numberOfRatingVotes:71379, name:"Papurika", rating:7.7, description:"When a machine that allows therapists to enter their patients' dreams is stolen, all Hell breaks loose. Only a young female therapist, Paprika, can stop it.", id:"Papurika", grossRevenue:881302}}, {_id:7290, properties:{runtimeInMinutes:141, numberOfRatingVotes:239203, name:"Changeling", rating:7.7, description:"Grief-stricken mother Christine Collins (Angelina Jolie) takes on the L.A.P.D. to her own detriment when it tries to pass off an obvious impostor as her missing child.", id:"Changeling", grossRevenue:35739802}}, {_id:7291, properties:{runtimeInMinutes:90, numberOfRatingVotes:81446, name:"Flipped", rating:7.7, description:"Two eighth-graders start to have feelings for each other despite being total opposites.", id:"Flipped", grossRevenue:1752214}}, {_id:7292, properties:{runtimeInMinutes:98, numberOfRatingVotes:60368, name:"Toki o kakeru shôjo", rating:7.7, description:"A high-school girl named Makoto acquires the power to travel back in time, and decides to use it for her own personal benefits. Little does she know that she is affecting the lives of others just as much as she is her own.", id:"Toki o kakeru shôjo"}}, {_id:7293, properties:{runtimeInMinutes:126, numberOfRatingVotes:28630, rating:7.7, name:"Death Note: Desu nôto", description:"A battle between the world's two greatest minds begins when Light Yagami finds the Death Note, a notebook with the power to kill, and decides to rid the world of criminals.", id:"Death Note: Desu nôto"}}, {_id:7294, properties:{runtimeInMinutes:101, numberOfRatingVotes:115576, rating:7.7, name:"This Is England", description:"A young boy becomes friends with a gang of skinheads. Friends soon become like family, and relationships will be pushed to the very limit.", id:"This Is England", grossRevenue:327919}}, {_id:7295, properties:{runtimeInMinutes:108, numberOfRatingVotes:474141, name:"Ex Machina", rating:7.7, description:"A young programmer is selected to participate in a ground-breaking experiment in synthetic intelligence by evaluating the human qualities of a highly advanced humanoid A.I.", id:"Ex Machina", grossRevenue:25442958}}, {_id:7296, properties:{runtimeInMinutes:120, numberOfRatingVotes:32001, rating:7.7, name:"Efter brylluppet", description:"A manager of an orphanage in India is sent to Copenhagen, Denmark, where he discovers a life-altering family secret.", id:"Efter brylluppet", grossRevenue:412544}}, {_id:7297, properties:{runtimeInMinutes:123, numberOfRatingVotes:175355, name:"The Last King of Scotland", rating:7.7, description:"Based on the events of the brutal Ugandan dictator Idi Amin's regime as seen by his personal physician during the 1970s.", id:"The Last King of Scotland", grossRevenue:17605861}}] AS row

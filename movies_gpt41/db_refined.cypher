UNWIND [{_id:7138, properties:{runtimeInMinutes:129, numberOfRatingVotes:52758, name:"Madeo", rating:7.8, description:"A mother desperately searches for the killer who framed her son for a girl's horrific murder.", id:"Madeo", grossRevenue:547292}}, {_id:7139, properties:{runtimeInMinutes:125, numberOfRatingVotes:58468, name:"Chugyeokja", rating:7.8, description:"A disgraced ex-policeman who runs a small ring of prostitutes finds himself in a race against time when one of his women goes missing.", id:"Chugyeokja"}}, {_id:7140, properties:{runtimeInMinutes:161, numberOfRatingVotes:601408, name:"The Hobbit: The Desolation of Smaug", rating:7.8, description:"The dwarves, along with Bilbo Baggins and Gandalf the Grey, continue their quest to reclaim Erebor, their homeland, from Smaug. Bilbo Baggins is in possession of a mysterious and magical ring.", id:"The Hobbit: The Desolation of Smaug", grossRevenue:258366855}}, {_id:7141, properties:{runtimeInMinutes:144, numberOfRatingVotes:68715, name:"Das weiße Band - Eine deutsche Kindergeschichte", rating:7.8, description:"Strange events happen in a small village in the north of Germany during the years before World War I, which seem to be ritual punishment. Who is responsible?", id:"Das weiße Band - Eine deutsche Kindergeschichte", grossRevenue:2222647}}, {_id:7142, properties:{runtimeInMinutes:152, numberOfRatingVotes:208994, name:"Män som hatar kvinnor", rating:7.8, description:"A journalist is aided by a young female hacker in his search for the killer of a woman who has been dead for forty years.", id:"Män som hatar kvinnor", grossRevenue:10095170}}, {_id:7143, properties:{runtimeInMinutes:129, numberOfRatingVotes:89896, rating:7.8, name:"The Trial of the Chicago 7", description:"The story of 7 people on trial stemming from various charges surrounding the uprising at the 1968 Democratic National Convention in Chicago, Illinois.", id:"The Trial of the Chicago 7"}}, {_id:7144, properties:{runtimeInMinutes:117, numberOfRatingVotes:33931, name:"Druk", rating:7.8, description:"Four friends, all high school teachers, test a theory that they will improve their lives by maintaining a constant level of alcohol in their blood.", id:"Druk"}}, {_id:7145, properties:{runtimeInMinutes:116, numberOfRatingVotes:340584, name:"The Fighter", rating:7.8, description:"Based on the story of Micky Ward, a fledgling boxer who tries to escape the shadow of his more famous but troubled older boxing brother and get his own shot at greatness.", id:"The Fighter", grossRevenue:93617009}}, {_id:7146, properties:{runtimeInMinutes:90, numberOfRatingVotes:564791, name:"Taken", rating:7.8, description:"A retired CIA agent travels across Europe and relies on his old skills to save his estranged daughter, who has been kidnapped while on a trip to Paris.", id:"Taken", grossRevenue:145000989}}, {_id:7147, properties:{runtimeInMinutes:94, numberOfRatingVotes:190748, name:"The Boy in the Striped Pyjamas", rating:7.8, description:"Through the innocent eyes of Bruno, the eight-year-old son of the commandant at a German concentration camp, a forbidden friendship with a Jewish boy on the other side of the camp fence has startling and unexpected consequences.", id:"The Boy in the Striped Pyjamas", grossRevenue:9030581}}, {_id:7148, properties:{runtimeInMinutes:86, numberOfRatingVotes:110656, name:"Once", rating:7.8, description:"A modern-day musical about a busker and an immigrant and their eventful week in Dublin, as they write, rehearse and record songs that tell their love story.", id:"Once", grossRevenue:9439923}}, {_id:7149, properties:{runtimeInMinutes:169, numberOfRatingVotes:757377, name:"The Hobbit: An Unexpected Journey", rating:7.8, description:"A reluctant Hobbit, Bilbo Baggins, sets out to the Lonely Mountain with a spirited group of dwarves to reclaim their mountain home, and the gold within it from the dragon Smaug.", id:"The Hobbit: An Unexpected Journey", grossRevenue:303003568}}, {_id:7150, properties:{runtimeInMinutes:122, numberOfRatingVotes:30827, rating:7.8, name:"Auf der anderen Seite", description:"A Turkish man travels to Istanbul to find the daughter of his father's former girlfriend.", id:"Auf der anderen Seite", grossRevenue:741283}}, {_id:7151, properties:{runtimeInMinutes:123, numberOfRatingVotes:251370, name:"Atonement", rating:7.8, description:"Thirteen-year-old fledgling writer Briony Tallis irrevocably changes the course of several lives when she accuses her older sister's lover of a crime he did not commit.", id:"Atonement", grossRevenue:50927067}}, {_id:7152, properties:{runtimeInMinutes:100, numberOfRatingVotes:571571, name:"Drive", rating:7.8, description:"A mysterious Hollywood stuntman and mechanic moonlights as a getaway driver and finds himself in trouble when he helps out his neighbor.", id:"Drive", grossRevenue:35061555}}, {_id:7153, properties:{runtimeInMinutes:157, numberOfRatingVotes:392449, name:"American Gangster", rating:7.8, description:"An outcast New York City cop is charged with bringing down Harlem drug lord Frank Lucas, whose real life inspired this partly biographical film.", id:"American Gangster", grossRevenue:130164645}}, {_id:7154, properties:{runtimeInMinutes:162, numberOfRatingVotes:1118998, name:"Avatar", rating:7.8, description:"A paraplegic Marine dispatched to the moon Pandora on a unique mission becomes torn between following his orders and protecting the world he feels is his home.", id:"Avatar", grossRevenue:760507625}}, {_id:7155, properties:{runtimeInMinutes:141, numberOfRatingVotes:216421, name:"Mr. Nobody", rating:7.8, description:"A boy stands on a station platform as a train is about to leave. Should he go with his mother or stay with his father? Infinite possibilities arise from this decision. As long as he doesn't choose, anything is possible.", id:"Mr. Nobody", grossRevenue:3600}}, {_id:7156, properties:{runtimeInMinutes:139, numberOfRatingVotes:291018, name:"Apocalypto", rating:7.8, description:"As the Mayan kingdom faces its decline, a young man is taken on a perilous journey to a world ruled by fear and oppression.", id:"Apocalypto", grossRevenue:50866635}}, {_id:7157, properties:{runtimeInMinutes:101, numberOfRatingVotes:439856, name:"Little Miss Sunshine", rating:7.8, description:"A family determined to get their young daughter into the finals of a beauty pageant take a cross-country trip in their VW bus.", id:"Little Miss Sunshine", grossRevenue:59891098}}] AS row

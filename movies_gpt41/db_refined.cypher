UNWIND [{_id:6938, properties:{runtimeInMinutes:128, numberOfRatingVotes:64722, name:"Der Himmel über Berlin", rating:8.0, description:"An angel tires of overseeing human activity and wishes to become human when he falls in love with a mortal.", id:"Der Himmel über Berlin", grossRevenue:3333969}}, {_id:6939, properties:{runtimeInMinutes:104, numberOfRatingVotes:31163, name:"Au revoir les enfants", rating:8.0, description:"A French boarding school run by priests seems to be a haven from World War II until a new student arrives. He becomes the roommate of the top student in his class. Rivals at first, the roommates form a bond and share a secret.", id:"Au revoir les enfants", grossRevenue:4542825}}, {_id:6940, properties:{runtimeInMinutes:125, numberOfRatingVotes:150140, rating:8.0, name:"Tenkû no shiro Rapyuta", description:"A young boy and a girl with a magic crystal must race against pirates and foreign agents in a search for a legendary floating castle.", id:"Tenkû no shiro Rapyuta"}}, {_id:6941, properties:{runtimeInMinutes:107, numberOfRatingVotes:799795, name:"The Terminator", rating:8.0, description:"A human soldier is sent from 2029 to 1984 to stop an almost indestructible cyborg killing machine, sent from the same year, which has been programmed to execute a young woman whose unborn son is the key to humanity's future salvation.", id:"The Terminator", grossRevenue:38400000}}, {_id:6942, properties:{runtimeInMinutes:191, numberOfRatingVotes:217664, name:"Gandhi", rating:8.0, description:"The life of the lawyer who became the famed leader of the Indian revolts against the British rule through his philosophy of nonviolent protest.", id:"Gandhi", grossRevenue:52767889}}, {_id:6943, properties:{runtimeInMinutes:180, numberOfRatingVotes:32195, name:"Kagemusha", rating:8.0, description:"A petty thief with an utter resemblance to a samurai warlord is hired as the lord's double. When the warlord later dies the thief is forced to take up arms in his place.", id:"Kagemusha"}}, {_id:6944, properties:{runtimeInMinutes:130, numberOfRatingVotes:65625, name:"Being There", rating:8.0, description:"A simpleminded, sheltered gardener becomes an unlikely trusted advisor to a powerful businessman and an insider in Washington politics.", id:"Being There", grossRevenue:30177511}}, {_id:6945, properties:{runtimeInMinutes:93, numberOfRatingVotes:251823, name:"Annie Hall", rating:8.0, description:"Neurotic New York comedian Alvy Singer falls in love with the ditzy Annie Hall.", id:"Annie Hall", grossRevenue:39200000}}, {_id:6946, properties:{runtimeInMinutes:124, numberOfRatingVotes:543388, name:"Jaws", rating:8.0, description:"When a killer shark unleashes chaos on a beach community, it's up to a local sheriff, a marine biologist, and an old seafarer to hunt the beast down.", id:"Jaws", grossRevenue:260000000}}, {_id:6947, properties:{runtimeInMinutes:125, numberOfRatingVotes:235652, name:"Dog Day Afternoon", rating:8.0, description:"Three amateur bank robbers plan to hold up a bank. A nice simple robbery: Walk in, take the money, and run. Unfortunately, the supposedly uncomplicated heist suddenly becomes a bizarre nightmare as everything that could go wrong does.", id:"Dog Day Afternoon", grossRevenue:50000000}}, {_id:6948, properties:{runtimeInMinutes:106, numberOfRatingVotes:143359, name:"Young Frankenstein", rating:8.0, description:"An American grandson of the infamous scientist, struggling to prove that his grandfather was not as insane as people believe, is invited to Transylvania, where he discovers the process that reanimates a dead body.", id:"Young Frankenstein", grossRevenue:86300000}}, {_id:6949, properties:{runtimeInMinutes:151, numberOfRatingVotes:121627, name:"Papillon", rating:8.0, description:"A man befriends a fellow criminal as the two of them begin serving their sentence on a dreadful prison island, which inspires the man to plot his escape.", id:"Papillon", grossRevenue:53267000}}, {_id:6950, properties:{runtimeInMinutes:122, numberOfRatingVotes:362393, name:"The Exorcist", rating:8.0, description:"When a 12-year-old girl is possessed by a mysterious entity, her mother seeks the help of two priests to save her.", id:"The Exorcist", grossRevenue:232906145}}, {_id:6951, properties:{runtimeInMinutes:138, numberOfRatingVotes:44748, name:"Sleuth", rating:8.0, description:"A man who loves games and theater invites his wife's lover to meet him, setting up a battle of wits with potentially deadly results.", id:"Sleuth", grossRevenue:4081254}}, {_id:6952, properties:{runtimeInMinutes:118, numberOfRatingVotes:42456, name:"The Last Picture Show", rating:8.0, description:"In 1951, a group of high schoolers come of age in a bleak, isolated, atrophied North Texas town that is slowly dying, both culturally and economically.", id:"The Last Picture Show", grossRevenue:29133000}}, {_id:6953, properties:{runtimeInMinutes:181, numberOfRatingVotes:39491, name:"Fiddler on the Roof", rating:8.0, description:"In prerevolutionary Russia, a Jewish peasant contends with marrying off three of his daughters while growing anti-Semitic sentiment threatens his village.", id:"Fiddler on the Roof", grossRevenue:80500000}}, {_id:6954, properties:{runtimeInMinutes:113, numberOfRatingVotes:27067, name:"Il conformista", rating:8.0, description:"A weak-willed Italian man becomes a fascist flunky who goes abroad to arrange the assassination of his old teacher, now a political dissident.", id:"Il conformista", grossRevenue:541940}}, {_id:6955, properties:{runtimeInMinutes:110, numberOfRatingVotes:201888, name:"Butch Cassidy and the Sundance Kid", rating:8.0, description:"Wyoming, early 1900s. Butch Cassidy and The Sundance Kid are the leaders of a band of outlaws. After a train robbery goes wrong they find themselves on the run with a posse hard on their heels. Their solution - escape to Bolivia.", id:"Butch Cassidy and the Sundance Kid", grossRevenue:102308889}}, {_id:6956, properties:{runtimeInMinutes:137, numberOfRatingVotes:193674, name:"Rosemary's Baby", rating:8.0, description:"A young couple trying for a baby move into a fancy apartment surrounded by peculiar neighbors.", id:"Rosemary's Baby"}}, {_id:6957, properties:{runtimeInMinutes:112, numberOfRatingVotes:165167, name:"Planet of the Apes", rating:8.0, description:"An astronaut crew crash-lands on a planet in the distant future where intelligent talking apes are the dominant species, and humans are the oppressed and enslaved.", id:"Planet of the Apes", grossRevenue:33395426}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6958, properties:{runtimeInMinutes:106, numberOfRatingVotes:253676, name:"The Graduate", rating:8.0, description:"A disillusioned college graduate finds himself torn between his older lover and her daughter.", id:"The Graduate", grossRevenue:104945305}}, {_id:6959, properties:{runtimeInMinutes:131, numberOfRatingVotes:68926, name:"Who's Afraid of Virginia Woolf?", rating:8.0, description:"A bitter, aging couple, with the help of alcohol, use their young houseguests to fuel anguish and emotional pain towards each other over the course of a distressing night.", id:"Who's Afraid of Virginia Woolf?"}}, {_id:6960, properties:{runtimeInMinutes:172, numberOfRatingVotes:205425, name:"The Sound of Music", rating:8.0, description:"A woman leaves an Austrian convent to become a governess to the children of a Naval officer widower.", id:"The Sound of Music", grossRevenue:163214286}}, {_id:6961, properties:{runtimeInMinutes:197, numberOfRatingVotes:69903, name:"Doctor Zhivago", rating:8.0, description:"The life of a Russian physician and poet who, although married to another, falls in love with a political activist's wife and experiences hardship during World War I and then the October Revolution.", id:"Doctor Zhivago", grossRevenue:111722000}}, {_id:6962, properties:{runtimeInMinutes:99, numberOfRatingVotes:198219, name:"Per un pugno di dollari", rating:8.0, description:"A wandering gunfighter plays two rival families against each other in a town torn apart by greed, pride, and revenge.", id:"Per un pugno di dollari", grossRevenue:14500000}}, {_id:6963, properties:{runtimeInMinutes:138, numberOfRatingVotes:108844, name:"8½", rating:8.0, description:"A harried movie director retreats into his memories and fantasies.", id:"8½", grossRevenue:50690}}, {_id:6964, properties:{runtimeInMinutes:80, numberOfRatingVotes:28057, rating:8.0, name:"Vivre sa vie: Film en douze tableaux", description:"Twelve episodic tales in the life of a Parisian woman and her slow descent into prostitution.", id:"Vivre sa vie: Film en douze tableaux"}}, {_id:6965, properties:{runtimeInMinutes:134, numberOfRatingVotes:75067, name:"The Hustler", rating:8.0, description:"An up-and-coming pool player plays a long-time champion in a single high-stakes match.", id:"The Hustler", grossRevenue:8284000}}, {_id:6966, properties:{runtimeInMinutes:174, numberOfRatingVotes:66621, name:"La dolce vita", rating:8.0, description:"A series of stories following a week in the life of a philandering paparazzo journalist living in Rome.", id:"La dolce vita", grossRevenue:19516000}}, {_id:6967, properties:{runtimeInMinutes:141, numberOfRatingVotes:56305, name:"Rio Bravo", rating:8.0, description:"A small-town sheriff in the American West enlists the help of a cripple, a drunk, and a young gunfighter in his efforts to hold in jail the brother of the local bad guy.", id:"Rio Bravo", grossRevenue:12535000}}, {_id:6968, properties:{runtimeInMinutes:161, numberOfRatingVotes:59847, name:"Anatomy of a Murder", rating:8.0, description:"In a murder trial, the defendant says he suffered temporary insanity after the victim raped his wife. What is the truth, and will he win his case?", id:"Anatomy of a Murder", grossRevenue:11900000}}, {_id:6969, properties:{runtimeInMinutes:95, numberOfRatingVotes:98431, name:"Touch of Evil", rating:8.0, description:"A stark, perverse story of murder, kidnapping, and police corruption in a Mexican border town.", id:"Touch of Evil", grossRevenue:2237659}}, {_id:6970, properties:{runtimeInMinutes:108, numberOfRatingVotes:45062, name:"Cat on a Hot Tin Roof", rating:8.0, description:"Brick is an alcoholic ex-football player who drinks his days away and resists the affections of his wife. A reunion with his terminal father jogs a host of memories and revelations for both father and son.", id:"Cat on a Hot Tin Roof", grossRevenue:17570324}}, {_id:6971, properties:{runtimeInMinutes:96, numberOfRatingVotes:28137, name:"Sweet Smell of Success", rating:8.0, description:"Powerful but unethical Broadway columnist J.J. Hunsecker coerces unscrupulous press agent Sidney Falco into breaking up his sister's romance with a jazz musician.", id:"Sweet Smell of Success"}}, {_id:6972, properties:{runtimeInMinutes:84, numberOfRatingVotes:81702, name:"The Killing", rating:8.0, description:"Crook Johnny Clay assembles a five man team to plan and execute a daring race-track robbery.", id:"The Killing"}}, {_id:6973, properties:{runtimeInMinutes:92, numberOfRatingVotes:81980, rating:8.0, name:"The Night of the Hunter", description:"A religious fanatic marries a gullible widow whose young children are reluctant to tell him where their real daddy hid the $10,000 he'd stolen in a robbery.", id:"The Night of the Hunter", grossRevenue:654000}}, {_id:6974, properties:{runtimeInMinutes:108, numberOfRatingVotes:58314, name:"La Strada", rating:8.0, description:"A care-free girl is sold to a traveling entertainer, consequently enduring physical and emotional pain along the way.", id:"La Strada"}}, {_id:6975, properties:{runtimeInMinutes:117, numberOfRatingVotes:61503, name:"Les diaboliques", rating:8.0, description:"The wife and mistress of a loathed school principal plan to murder him with what they believe is the perfect alibi.", id:"Les diaboliques"}}, {_id:6976, properties:{runtimeInMinutes:120, numberOfRatingVotes:51046, name:"Stalag 17", rating:8.0, description:"When two escaping American World War II prisoners are killed, the German P.O.W. camp barracks black marketeer, J.J. Sefton, is suspected of being an informer.", id:"Stalag 17"}}, {_id:6977, properties:{runtimeInMinutes:118, numberOfRatingVotes:127256, name:"Roman Holiday", rating:8.0, description:"A bored and sheltered princess escapes her guardians and falls in love with an American newsman in Rome.", id:"Roman Holiday"}}] AS row

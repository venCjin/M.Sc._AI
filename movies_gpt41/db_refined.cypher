UNWIND [{_id:2259, properties:{runtimeInMinutes:121, numberOfRatingVotes:90442, name:"Dead Man", rating:7.6, description:"On the run after murdering a man, accountant William Blake encounters a strange aboriginal American man named Nobody who prepares him for his journey into the spiritual world.", id:"Dead Man", grossRevenue:1037847}}, {_id:2260, properties:{runtimeInMinutes:135, numberOfRatingVotes:73172, name:"The Bridges of Madison County", rating:7.6, description:"Photographer Robert Kincaid wanders into the life of housewife Francesca Johnson for four days in the 1960s.", id:"The Bridges of Madison County", grossRevenue:71516617}}, {_id:2261, properties:{runtimeInMinutes:140, numberOfRatingVotes:269197, name:"Apollo 13", rating:7.6, description:"NASA must devise a strategy to return Apollo 13 to Earth safely after the spacecraft undergoes massive internal damage putting the lives of the three astronauts on board in jeopardy.", id:"Apollo 13", grossRevenue:173837933}}, {_id:2262, properties:{runtimeInMinutes:92, numberOfRatingVotes:64390, name:"Trois couleurs: Blanc", rating:7.6, description:"After his wife divorces him, a Polish immigrant plots to get even with her.", id:"Trois couleurs: Blanc", grossRevenue:1464625}}, {_id:2263, properties:{runtimeInMinutes:113, numberOfRatingVotes:171640, name:"Falling Down", rating:7.6, description:"An ordinary man frustrated with the various flaws he sees in society begins to psychotically and violently lash out against them.", id:"Falling Down", grossRevenue:40903593}}, {_id:2264, properties:{runtimeInMinutes:102, numberOfRatingVotes:165465, name:"Dazed and Confused", rating:7.6, description:"The adventures of high school and junior high students on the last day of school in May 1976.", id:"Dazed and Confused", grossRevenue:7993039}}, {_id:2265, properties:{runtimeInMinutes:120, numberOfRatingVotes:107325, name:"My Cousin Vinny", rating:7.6, description:"Two New Yorkers accused of murder in rural Alabama while on their way back to college call in the help of one of their cousins, a loudmouth lawyer with no trial experience.", id:"My Cousin Vinny", grossRevenue:52929168}}, {_id:2266, properties:{runtimeInMinutes:118, numberOfRatingVotes:27071, rating:7.6, name:"Omohide poro poro", description:"A twenty-seven-year-old office worker travels to the countryside while reminiscing about her childhood in Tokyo.", id:"Omohide poro poro", grossRevenue:453243}}, {_id:2267, properties:{runtimeInMinutes:99, numberOfRatingVotes:80487, name:"Delicatessen", rating:7.6, description:"Post-apocalyptic surrealist black comedy about the landlord of an apartment building who occasionally prepares a delicacy for his odd tenants.", id:"Delicatessen", grossRevenue:1794187}}, {_id:2268, properties:{runtimeInMinutes:103, numberOfRatingVotes:488817, name:"Home Alone", rating:7.6, description:"An eight-year-old troublemaker must protect his house from a pair of burglars when he is accidentally left home alone by his family during Christmas vacation.", id:"Home Alone", grossRevenue:285761243}}, {_id:2269, properties:{runtimeInMinutes:162, numberOfRatingVotes:359809, name:"The Godfather: Part III", rating:7.6, description:"Follows Michael Corleone, now in his 60s, as he seeks to free his family from crime and find a suitable successor to his empire.", id:"The Godfather: Part III", grossRevenue:66666062}}, {_id:2270, properties:{runtimeInMinutes:95, numberOfRatingVotes:195663, name:"When Harry Met Sally...", rating:7.6, description:"Harry and Sally have known each other for years, and are very good friends, but they fear sex would ruin the friendship.", id:"When Harry Met Sally...", grossRevenue:92823600}}, {_id:2271, properties:{runtimeInMinutes:83, numberOfRatingVotes:237696, name:"The Little Mermaid", rating:7.6, description:"A mermaid princess makes a Faustian bargain in an attempt to become human and win a prince's love.", id:"The Little Mermaid", grossRevenue:111543479}}, {_id:2272, properties:{runtimeInMinutes:85, numberOfRatingVotes:152871, name:"The Naked Gun: From the Files of Police Squad!", rating:7.6, description:"Incompetent police Detective Frank Drebin must foil an attempt to assassinate Queen Elizabeth II.", id:"The Naked Gun: From the Files of Police Squad!", grossRevenue:78756177}}, {_id:2273, properties:{runtimeInMinutes:93, numberOfRatingVotes:124773, name:"Planes, Trains & Automobiles", rating:7.6, description:"A man must struggle to travel home for Thanksgiving with a lovable oaf of a shower curtain ring salesman as his only companion.", id:"Planes, Trains & Automobiles", grossRevenue:49530280}}, {_id:2274, properties:{runtimeInMinutes:109, numberOfRatingVotes:236894, name:"Lethal Weapon", rating:7.6, description:"Two newly paired cops who are complete opposites must put aside their differences in order to catch a gang of drug smugglers.", id:"Lethal Weapon", grossRevenue:65207127}}, {_id:2275, properties:{runtimeInMinutes:99, numberOfRatingVotes:87745, name:"Blood Simple", rating:7.6, description:"The owner of a seedy small-town Texas bar discovers that one of his employees is having an affair with his wife. A chaotic chain of misunderstandings, lies and mischief ensues after he devises a plot to have them murdered.", id:"Blood Simple", grossRevenue:2150000}}, {_id:2276, properties:{runtimeInMinutes:109, numberOfRatingVotes:27650, name:"On Golden Pond", rating:7.6, description:"Norman is a curmudgeon with an estranged relationship with his daughter Chelsea. At Golden Pond, he and his wife nevertheless agree to care for Billy, the son of Chelsea's new boyfriend, and a most unexpected relationship blooms.", id:"On Golden Pond", grossRevenue:119285432}}, {_id:2277, properties:{runtimeInMinutes:96, numberOfRatingVotes:166588, name:"Mad Max 2", rating:7.6, description:"In the post-apocalyptic Australian wasteland, a cynical drifter agrees to help a small, gasoline-rich community escape a horde of bandits.", id:"Mad Max 2", grossRevenue:12465371}}, {_id:2278, properties:{runtimeInMinutes:92, numberOfRatingVotes:93878, name:"The Warriors", rating:7.6, description:"In the near future, a charismatic leader summons the street gangs of New York City in a bid to take it over. When he is killed, The Warriors are falsely blamed and now must fight their way home while every other gang is hunting them down.", id:"The Warriors", grossRevenue:22490039}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:2279, properties:{runtimeInMinutes:95, numberOfRatingVotes:32802, name:"The Muppet Movie", rating:7.6, description:"Kermit and his newfound friends trek across America to find success in Hollywood, but a frog legs merchant is after Kermit.", id:"The Muppet Movie", grossRevenue:76657000}}, {_id:2280, properties:{runtimeInMinutes:112, numberOfRatingVotes:121731, name:"Escape from Alcatraz", rating:7.6, description:"Alcatraz is the most secure prison of its time. It is believed that no one can ever escape from it, until three daring men make a possible successful attempt at escaping from one of the most infamous prisons in the world.", id:"Escape from Alcatraz", grossRevenue:43000000}}, {_id:2281, properties:{runtimeInMinutes:91, numberOfRatingVotes:33656, name:"Watership Down", rating:7.6, description:"Hoping to escape destruction by human developers and save their community, a colony of rabbits, led by Hazel and Fiver, seek out a safe place to set up a new warren.", id:"Watership Down"}}, {_id:2282, properties:{runtimeInMinutes:121, numberOfRatingVotes:73662, name:"Midnight Express", rating:7.6, description:"Billy Hayes, an American college student, is caught smuggling drugs out of Turkey and thrown into prison.", id:"Midnight Express", grossRevenue:35000000}}, {_id:2283, properties:{runtimeInMinutes:138, numberOfRatingVotes:184966, name:"Close Encounters of the Third Kind", rating:7.6, description:"Roy Neary, an electric lineman, watches how his quiet and ordinary daily life turns upside down after a close encounter with a UFO.", id:"Close Encounters of the Third Kind", grossRevenue:132088635}}, {_id:2284, properties:{runtimeInMinutes:112, numberOfRatingVotes:26337, rating:7.6, name:"The Long Goodbye", description:"Private investigator Philip Marlowe helps a friend out of a jam, but in doing so gets implicated in his wife's murder.", id:"The Long Goodbye", grossRevenue:959000}}, {_id:2285, properties:{runtimeInMinutes:157, numberOfRatingVotes:30144, name:"Giù la testa", rating:7.6, description:"A low-life bandit and an I.R.A. explosives expert rebel against the government and become heroes of the Mexican Revolution.", id:"Giù la testa", grossRevenue:696690}}, {_id:2286, properties:{runtimeInMinutes:144, numberOfRatingVotes:45338, name:"Kelly's Heroes", rating:7.6, description:"A group of U.S. soldiers sneaks across enemy lines to get their hands on a secret stash of Nazi treasure.", id:"Kelly's Heroes", grossRevenue:1378435}}, {_id:2287, properties:{runtimeInMinutes:78, numberOfRatingVotes:166409, name:"The Jungle Book", rating:7.6, description:"Bagheera the Panther and Baloo the Bear have a difficult time trying to convince a boy to leave the jungle for human civilization.", id:"The Jungle Book", grossRevenue:141843612}}, {_id:2288, properties:{runtimeInMinutes:111, numberOfRatingVotes:56513, name:"Blowup", rating:7.6, description:"A fashion photographer unknowingly captures a death on film after following two lovers in a park.", id:"Blowup"}}, {_id:2289, properties:{runtimeInMinutes:87, numberOfRatingVotes:40351, name:"A Hard Day's Night", rating:7.6, description:"Over two \"typical\" days in the life of The Beatles, the boys struggle to keep themselves and Sir Paul McCartney's mischievous grandfather in check while preparing for a live television performance.", id:"A Hard Day's Night", grossRevenue:13780024}}, {_id:2290, properties:{runtimeInMinutes:115, numberOfRatingVotes:166544, name:"Breakfast at Tiffany's", rating:7.6, description:"A young New York socialite becomes interested in a young man who has moved into her apartment building, but her past threatens to get in the way.", id:"Breakfast at Tiffany's"}}, {_id:2291, properties:{runtimeInMinutes:201, numberOfRatingVotes:34075, name:"Giant", rating:7.6, description:"Sprawling epic covering the life of a Texas cattle rancher and his family and associates.", id:"Giant"}}, {_id:2292, properties:{runtimeInMinutes:118, numberOfRatingVotes:43374, name:"From Here to Eternity", rating:7.6, description:"In Hawaii in 1941, a private is cruelly punished for not boxing on his unit's team, while his captain's wife and second-in-command are falling in love.", id:"From Here to Eternity", grossRevenue:30500000}}, {_id:2293, properties:{runtimeInMinutes:97, numberOfRatingVotes:26471, name:"Lifeboat", rating:7.6, description:"Several survivors of a torpedoed merchant ship in World War II find themselves in the same lifeboat with one of the crew members of the U-boat that sank their ship.", id:"Lifeboat"}}, {_id:2294, properties:{runtimeInMinutes:86, numberOfRatingVotes:51853, name:"The 39 Steps", rating:7.6, description:"A man in London tries to help a counter-espionage Agent. But when the Agent is killed, and the man stands accused, he must go on the run to save himself and stop a spy ring which is trying to steal top secret information.", id:"The 39 Steps"}}, {_id:6534, properties:{runtimeInMinutes:152, numberOfRatingVotes:2303232, name:"The Dark Knight", rating:9.0, description:"When the menace known as the Joker wreaks havoc and chaos on the people of Gotham, Batman must accept one of the greatest psychological and physical tests of his ability to fight injustice.", id:"The Dark Knight", grossRevenue:534858444}}, {_id:6535, properties:{runtimeInMinutes:202, numberOfRatingVotes:1129952, name:"The Godfather: Part II", rating:9.0, description:"The early life and career of Vito Corleone in 1920s New York City is portrayed, while his son, Michael, expands and tightens his grip on the family crime syndicate.", id:"The Godfather: Part II", grossRevenue:57300000}}, {_id:6536, properties:{runtimeInMinutes:96, numberOfRatingVotes:689845, name:"12 Angry Men", rating:9.0, description:"A jury holdout attempts to prevent a miscarriage of justice by forcing his colleagues to reconsider the evidence.", id:"12 Angry Men", grossRevenue:4360000}}, {_id:6537, properties:{runtimeInMinutes:201, numberOfRatingVotes:1642758, name:"The Lord of the Rings: The Return of the King", rating:8.9, description:"Gandalf and Aragorn lead the World of Men against Sauron's army to draw his gaze from Frodo and Sam as they approach Mount Doom with the One Ring.", id:"The Lord of the Rings: The Return of the King", grossRevenue:377845905}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6538, properties:{runtimeInMinutes:154, numberOfRatingVotes:1826188, name:"Pulp Fiction", rating:8.9, description:"The lives of two mob hitmen, a boxer, a gangster and his wife, and a pair of diner bandits intertwine in four tales of violence and redemption.", id:"Pulp Fiction", grossRevenue:107928762}}, {_id:6539, properties:{runtimeInMinutes:195, numberOfRatingVotes:1213505, name:"Schindler's List", rating:8.9, description:"In German-occupied Poland during World War II, industrialist Oskar Schindler gradually becomes concerned for his Jewish workforce after witnessing their persecution by the Nazis.", id:"Schindler's List", grossRevenue:96898818}}, {_id:6540, properties:{runtimeInMinutes:148, numberOfRatingVotes:2067042, name:"Inception", rating:8.8, description:"A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O.", id:"Inception", grossRevenue:292576195}}, {_id:6541, properties:{runtimeInMinutes:139, numberOfRatingVotes:1854740, name:"Fight Club", rating:8.8, description:"An insomniac office worker and a devil-may-care soapmaker form an underground fight club that evolves into something much, much more.", id:"Fight Club", grossRevenue:37030102}}, {_id:6542, properties:{runtimeInMinutes:178, numberOfRatingVotes:1661481, name:"The Lord of the Rings: The Fellowship of the Ring", rating:8.8, description:"A meek Hobbit from the Shire and eight companions set out on a journey to destroy the powerful One Ring and save Middle-earth from the Dark Lord Sauron.", id:"The Lord of the Rings: The Fellowship of the Ring", grossRevenue:315544750}}, {_id:6543, properties:{runtimeInMinutes:142, numberOfRatingVotes:1809221, name:"Forrest Gump", rating:8.8, description:"The presidencies of Kennedy and Johnson, the events of Vietnam, Watergate and other historical events unfold through the perspective of an Alabama man with an IQ of 75, whose only desire is to be reunited with his childhood sweetheart.", id:"Forrest Gump", grossRevenue:330252182}}, {_id:6544, properties:{runtimeInMinutes:161, numberOfRatingVotes:688390, name:"Il buono, il brutto, il cattivo", rating:8.8, description:"A bounty hunting scam joins two men in an uneasy alliance against a third in a race to find a fortune in gold buried in a remote cemetery.", id:"Il buono, il brutto, il cattivo", grossRevenue:6100000}}, {_id:6545, properties:{runtimeInMinutes:179, numberOfRatingVotes:1485555, name:"The Lord of the Rings: The Two Towers", rating:8.7, description:"While Frodo and Sam edge closer to Mordor with the help of the shifty Gollum, the divided fellowship makes a stand against Sauron's new ally, Saruman, and his hordes of Isengard.", id:"The Lord of the Rings: The Two Towers", grossRevenue:342551365}}, {_id:6546, properties:{runtimeInMinutes:136, numberOfRatingVotes:1676426, name:"The Matrix", rating:8.7, description:"When a beautiful stranger leads computer hacker Neo to a forbidding underworld, he discovers the shocking truth--the life he knows is the elaborate deception of an evil cyber-intelligence.", id:"The Matrix", grossRevenue:171479930}}, {_id:6547, properties:{runtimeInMinutes:146, numberOfRatingVotes:1020727, name:"Goodfellas", rating:8.7, description:"The story of Henry Hill and his life in the mob, covering his relationship with his wife Karen Hill and his mob partners Jimmy Conway and Tommy DeVito in the Italian-American crime syndicate.", id:"Goodfellas", grossRevenue:46836394}}, {_id:6548, properties:{runtimeInMinutes:124, numberOfRatingVotes:1159315, name:"Star Wars: Episode V - The Empire Strikes Back", rating:8.7, description:"After the Rebels are brutally overpowered by the Empire on the ice planet Hoth, Luke Skywalker begins Jedi training with Yoda, while his friends are pursued by Darth Vader and a bounty hunter named Boba Fett all over the galaxy.", id:"Star Wars: Episode V - The Empire Strikes Back", grossRevenue:290475067}}, {_id:6549, properties:{runtimeInMinutes:133, numberOfRatingVotes:918088, name:"One Flew Over the Cuckoo's Nest", rating:8.7, description:"A criminal pleads insanity and is admitted to a mental institution, where he rebels against the oppressive nurse and rallies up the scared patients.", id:"One Flew Over the Cuckoo's Nest", grossRevenue:112000000}}, {_id:6550, properties:{runtimeInMinutes:160, numberOfRatingVotes:55291, name:"Hamilton", rating:8.6, description:"The real life of one of America's foremost founding fathers and first Secretary of the Treasury, Alexander Hamilton. Captured live on Broadway from the Richard Rodgers Theater with the original Broadway cast.", id:"Hamilton"}}, {_id:6551, properties:{runtimeInMinutes:132, numberOfRatingVotes:552778, name:"Gisaengchung", rating:8.6, description:"Greed and class discrimination threaten the newly formed symbiotic relationship between the wealthy Park family and the destitute Kim clan.", id:"Gisaengchung", grossRevenue:53367844}}, {_id:6552, properties:{runtimeInMinutes:153, numberOfRatingVotes:54995, name:"Soorarai Pottru", rating:8.6, description:"Nedumaaran Rajangam \"Maara\" sets out to make the common man fly and in the process takes on the world's most capital intensive industry and several enemies who stand in his way.", id:"Soorarai Pottru"}}, {_id:6553, properties:{runtimeInMinutes:169, numberOfRatingVotes:1512360, name:"Interstellar", rating:8.6, description:"A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.", id:"Interstellar", grossRevenue:188020017}}, {_id:6554, properties:{runtimeInMinutes:130, numberOfRatingVotes:699256, name:"Cidade de Deus", rating:8.6, description:"In the slums of Rio, two kids' paths diverge as one struggles to become a photographer and the other a kingpin.", id:"Cidade de Deus", grossRevenue:7563397}}, {_id:6555, properties:{runtimeInMinutes:125, numberOfRatingVotes:651376, name:"Sen to Chihiro no kamikakushi", rating:8.6, description:"During her family's move to the suburbs, a sullen 10-year-old girl wanders into a world ruled by gods, witches, and spirits, and where humans are changed into beasts.", id:"Sen to Chihiro no kamikakushi", grossRevenue:10055859}}, {_id:6556, properties:{runtimeInMinutes:169, numberOfRatingVotes:1235804, name:"Saving Private Ryan", rating:8.6, description:"Following the Normandy Landings, a group of U.S. soldiers go behind enemy lines to retrieve a paratrooper whose brothers have been killed in action.", id:"Saving Private Ryan", grossRevenue:216540909}}, {_id:6557, properties:{runtimeInMinutes:189, numberOfRatingVotes:1147794, name:"The Green Mile", rating:8.6, description:"The lives of guards on Death Row are affected by one of their charges: a black man accused of child murder and rape, yet who has a mysterious gift.", id:"The Green Mile", grossRevenue:136801374}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6558, properties:{runtimeInMinutes:116, numberOfRatingVotes:623629, name:"La vita è bella", rating:8.6, description:"When an open-minded Jewish librarian and his son become victims of the Holocaust, he uses a perfect mixture of will, humor, and imagination to protect his son from the dangers around their camp.", id:"La vita è bella", grossRevenue:57598247}}, {_id:6559, properties:{runtimeInMinutes:127, numberOfRatingVotes:1445096, name:"Se7en", rating:8.6, description:"Two detectives, a rookie and a veteran, hunt a serial killer who uses the seven deadly sins as his motives.", id:"Se7en", grossRevenue:100125643}}, {_id:6560, properties:{runtimeInMinutes:118, numberOfRatingVotes:1270197, name:"The Silence of the Lambs", rating:8.6, description:"A young F.B.I. cadet must receive the help of an incarcerated and manipulative cannibal killer to help catch another serial killer, a madman who skins his victims.", id:"The Silence of the Lambs", grossRevenue:130742922}}, {_id:6561, properties:{runtimeInMinutes:121, numberOfRatingVotes:1231473, name:"Star Wars", rating:8.6, description:"Luke Skywalker joins forces with a Jedi Knight, a cocky pilot, a Wookiee and two droids to save the galaxy from the Empire's world-destroying battle station, while also attempting to rescue Princess Leia from the mysterious Darth Vader.", id:"Star Wars", grossRevenue:322740140}}, {_id:6562, properties:{runtimeInMinutes:133, numberOfRatingVotes:42004, name:"Seppuku", rating:8.6, description:"When a ronin requesting seppuku at a feudal lord's palace is told of the brutal suicide of another ronin who previously visited, he reveals how their pasts are intertwined - and in doing so challenges the clan's integrity.", id:"Seppuku"}}, {_id:6563, properties:{runtimeInMinutes:207, numberOfRatingVotes:315744, rating:8.6, name:"Shichinin no samurai", description:"A poor village under attack by bandits recruits seven unemployed samurai to help them defend themselves.", id:"Shichinin no samurai", grossRevenue:269061}}, {_id:6564, properties:{runtimeInMinutes:130, numberOfRatingVotes:405801, name:"It's a Wonderful Life", rating:8.6, description:"An angel is sent from Heaven to help a desperately frustrated businessman by showing him what life would have been like if he had never existed.", id:"It's a Wonderful Life"}}, {_id:6565, properties:{runtimeInMinutes:122, numberOfRatingVotes:939252, name:"Joker", rating:8.5, description:"In Gotham City, mentally troubled comedian Arthur Fleck is disregarded and mistreated by society. He then embarks on a downward spiral of revolution and bloody crime. This path brings him face-to-face with his alter-ego: the Joker.", id:"Joker", grossRevenue:335451311}}, {_id:6566, properties:{runtimeInMinutes:106, numberOfRatingVotes:717585, name:"Whiplash", rating:8.5, description:"A promising young drummer enrolls at a cut-throat music conservatory where his dreams of greatness are mentored by an instructor who will stop at nothing to realize a student's potential.", id:"Whiplash", grossRevenue:13092000}}, {_id:6567, properties:{runtimeInMinutes:112, numberOfRatingVotes:760360, name:"The Intouchables", rating:8.5, description:"After he becomes a quadriplegic from a paragliding accident, an aristocrat hires a young man from the projects to be his caregiver.", id:"The Intouchables", grossRevenue:13182281}}, {_id:6568, properties:{runtimeInMinutes:130, numberOfRatingVotes:1190259, name:"The Prestige", rating:8.5, description:"After a tragic accident, two stage magicians engage in a battle to create the ultimate illusion while sacrificing everything they have to outwit each other.", id:"The Prestige", grossRevenue:53089891}}, {_id:6569, properties:{runtimeInMinutes:151, numberOfRatingVotes:1189773, name:"The Departed", rating:8.5, description:"An undercover cop and a mole in the police attempt to identify each other while infiltrating an Irish gang in South Boston.", id:"The Departed", grossRevenue:132384315}}, {_id:6570, properties:{runtimeInMinutes:150, numberOfRatingVotes:729603, name:"The Pianist", rating:8.5, description:"A Polish Jewish musician struggles to survive the destruction of the Warsaw ghetto of World War II.", id:"The Pianist", grossRevenue:32572577}}, {_id:6571, properties:{runtimeInMinutes:155, numberOfRatingVotes:1341460, name:"Gladiator", rating:8.5, description:"A former Roman General sets out to exact vengeance against the corrupt emperor who murdered his family and sent him into slavery.", id:"Gladiator", grossRevenue:187705427}}, {_id:6572, properties:{runtimeInMinutes:119, numberOfRatingVotes:1034705, name:"American History X", rating:8.5, description:"A former neo-nazi skinhead tries to prevent his younger brother from going down the same wrong path that he did.", id:"American History X", grossRevenue:6719864}}, {_id:6573, properties:{runtimeInMinutes:106, numberOfRatingVotes:991208, name:"The Usual Suspects", rating:8.5, description:"A sole survivor tells of the twisty events leading up to a horrific gun battle on a boat, which began when five criminals met at a seemingly random police lineup.", id:"The Usual Suspects", grossRevenue:23341568}}, {_id:6574, properties:{runtimeInMinutes:110, numberOfRatingVotes:1035236, name:"Léon", rating:8.5, description:"Mathilda, a 12-year-old girl, is reluctantly taken in by Léon, a professional assassin, after her family is murdered. An unusual relationship forms as she becomes his protégée and learns the assassin's trade.", id:"Léon", grossRevenue:19501238}}, {_id:6575, properties:{runtimeInMinutes:88, numberOfRatingVotes:942045, name:"The Lion King", rating:8.5, description:"Lion prince Simba and his father are targeted by his bitter uncle, who wants to ascend the throne himself.", id:"The Lion King", grossRevenue:422783777}}, {_id:6576, properties:{runtimeInMinutes:137, numberOfRatingVotes:995506, name:"Terminator 2: Judgment Day", rating:8.5, description:"A cyborg, identical to the one who failed to kill Sarah Connor, must now protect her teenage son, John Connor, from a more advanced and powerful cyborg.", id:"Terminator 2: Judgment Day", grossRevenue:204843350}}, {_id:6577, properties:{runtimeInMinutes:155, numberOfRatingVotes:230763, name:"Nuovo Cinema Paradiso", rating:8.5, description:"A filmmaker recalls his childhood when falling in love with the pictures at the cinema of his home village and forms a deep friendship with the cinema's projectionist.", id:"Nuovo Cinema Paradiso", grossRevenue:11990401}}] AS row

UNWIND [{_id:7298, properties:{runtimeInMinutes:157, numberOfRatingVotes:466080, name:"Zodiac", rating:7.7, description:"In the late 1960s/early 1970s, a San Francisco cartoonist becomes an amateur detective obsessed with tracking down the Zodiac Killer, an unidentified individual who terrorizes Northern California with a killing spree.", id:"Zodiac", grossRevenue:33080084}}, {_id:7299, properties:{runtimeInMinutes:110, numberOfRatingVotes:299524, name:"Lucky Number Slevin", rating:7.7, description:"A case of mistaken identity lands Slevin into the middle of a war being plotted by two of the city's most rival crime bosses. Under constant surveillance by Detective Brikowski and assassin Goodkat, he must get them before they get him.", id:"Lucky Number Slevin", grossRevenue:22494487}}, {_id:7300, properties:{runtimeInMinutes:116, numberOfRatingVotes:28003, name:"Joyeux Noël", rating:7.7, description:"In December 1914, an unofficial Christmas truce on the Western Front allows soldiers from opposing sides of the First World War to gain insight into each other's way of life.", id:"Joyeux Noël", grossRevenue:1054361}}, {_id:7301, properties:{runtimeInMinutes:122, numberOfRatingVotes:61609, name:"Control", rating:7.7, description:"A profile of Ian Curtis, the enigmatic singer of Joy Division whose personal, professional, and romantic troubles led him to commit suicide at the age of 23.", id:"Control", grossRevenue:871577}}, {_id:7302, properties:{runtimeInMinutes:100, numberOfRatingVotes:405922, name:"Tangled", rating:7.7, description:"The magically long-haired Rapunzel has spent her entire life in a tower, but now that a runaway thief has stumbled upon her, she is about to discover the world for the first time, and who she really is.", id:"Tangled", grossRevenue:200821936}}, {_id:7303, properties:{runtimeInMinutes:145, numberOfRatingVotes:72643, name:"Zwartboek", rating:7.7, description:"In the Nazi-occupied Netherlands during World War II, a Jewish singer infiltrates the regional Gestapo headquarters for the Dutch resistance.", id:"Zwartboek", grossRevenue:4398392}}, {_id:7304, properties:{runtimeInMinutes:134, numberOfRatingVotes:323103, name:"Brokeback Mountain", rating:7.7, description:"The story of a forbidden and secretive relationship between two cowboys, and their lives over the years.", id:"Brokeback Mountain", grossRevenue:83043761}}, {_id:7305, properties:{runtimeInMinutes:122, numberOfRatingVotes:288797, name:"3:10 to Yuma", rating:7.7, description:"A small-time rancher agrees to hold a captured outlaw who's awaiting a train to go to court in Yuma. A battle of wills ensues as the outlaw tries to psych out the rancher.", id:"3:10 to Yuma", grossRevenue:53606916}}, {_id:7306, properties:{runtimeInMinutes:112, numberOfRatingVotes:419483, name:"Crash", rating:7.7, description:"Los Angeles citizens with vastly separate lives collide in interweaving stories of race, loss and redemption.", id:"Crash", grossRevenue:54580300}}, {_id:7307, properties:{runtimeInMinutes:99, numberOfRatingVotes:127250, name:"Kung fu", rating:7.7, description:"In Shanghai, China in the 1940s, a wannabe gangster aspires to join the notorious \"Axe Gang\" while residents of a housing complex exhibit extraordinary powers in defending their turf.", id:"Kung fu", grossRevenue:17108591}}, {_id:7308, properties:{runtimeInMinutes:108, numberOfRatingVotes:434841, name:"The Bourne Supremacy", rating:7.7, description:"When Jason Bourne is framed for a CIA operation gone awry, he is forced to resume his former life as a trained assassin to survive.", id:"The Bourne Supremacy", grossRevenue:176241941}}, {_id:7309, properties:{runtimeInMinutes:101, numberOfRatingVotes:358432, name:"The Machinist", rating:7.7, description:"An industrial worker who hasn't slept in a year begins to doubt his own sanity.", id:"The Machinist", grossRevenue:1082715}}, {_id:7310, properties:{runtimeInMinutes:152, numberOfRatingVotes:138356, name:"Ray", rating:7.7, description:"The story of the life and career of the legendary rhythm and blues musician Ray Charles, from his humble beginnings in the South, where he went blind at age seven, to his meteoric rise to stardom during the 1950s and 1960s.", id:"Ray", grossRevenue:75331600}}, {_id:7311, properties:{runtimeInMinutes:102, numberOfRatingVotes:415074, name:"Lost in Translation", rating:7.7, description:"A faded movie star and a neglected young woman form an unlikely bond after crossing paths in Tokyo.", id:"Lost in Translation", grossRevenue:44585453}}, {_id:7312, properties:{runtimeInMinutes:157, numberOfRatingVotes:548619, name:"Harry Potter and the Goblet of Fire", rating:7.7, description:"Harry Potter finds himself competing in a hazardous tournament between rival schools of magic, but he is distracted by recurring nightmares.", id:"Harry Potter and the Goblet of Fire", grossRevenue:290013036}}, {_id:7313, properties:{runtimeInMinutes:146, numberOfRatingVotes:329592, name:"Man on Fire", rating:7.7, description:"In Mexico City, a former CIA operative swears vengeance on those who committed an unspeakable act against the family he was hired to protect.", id:"Man on Fire", grossRevenue:77911774}}, {_id:7314, properties:{runtimeInMinutes:100, numberOfRatingVotes:197761, name:"Coraline", rating:7.7, description:"An adventurous 11-year-old girl finds another world that is a strangely idealized version of her frustrating home, but it has sinister secrets.", id:"Coraline", grossRevenue:75286229}}, {_id:7315, properties:{runtimeInMinutes:154, numberOfRatingVotes:400049, name:"The Last Samurai", rating:7.7, description:"An American military advisor embraces the Samurai culture he was hired to destroy after he is captured in battle.", id:"The Last Samurai", grossRevenue:111110575}}, {_id:7316, properties:{runtimeInMinutes:114, numberOfRatingVotes:25938, name:"The Magdalene Sisters", rating:7.7, description:"Three young Irish women struggle to maintain their spirits while they endure dehumanizing abuse as inmates of a Magdalene Sisters Asylum.", id:"The Magdalene Sisters", grossRevenue:4890878}}, {_id:7317, properties:{runtimeInMinutes:121, numberOfRatingVotes:137981, name:"Good Bye Lenin!", rating:7.7, description:"In 1990, to protect his fragile mother from a fatal shock after a long coma, a young man must keep her from learning that her beloved nation of East Germany as she knew it has disappeared.", id:"Good Bye Lenin!", grossRevenue:4064200}}] AS row

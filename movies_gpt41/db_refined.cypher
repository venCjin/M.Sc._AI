UNWIND [{_id:7098, properties:{runtimeInMinutes:64, numberOfRatingVotes:42117, name:"Freaks", rating:7.9, description:"A circus' beautiful trapeze artist agrees to marry the leader of side-show performers, but his deformed friends discover she is only marrying him for his inheritance.", id:"Freaks"}}, {_id:7099, properties:{runtimeInMinutes:94, numberOfRatingVotes:88794, name:"Nosferatu", rating:7.9, description:"Vampire Count Orlok expresses interest in a new residence and real estate agent Hutter's wife.", id:"Nosferatu"}}, {_id:7100, properties:{runtimeInMinutes:113, numberOfRatingVotes:237392, name:"The Gentlemen", rating:7.8, description:"An American expat tries to sell off his highly profitable marijuana empire in London, triggering plots, schemes, bribery and blackmail in an attempt to steal his domain out from under him.", id:"The Gentlemen"}}, {_id:7101, properties:{runtimeInMinutes:138, numberOfRatingVotes:25344, name:"Raazi", rating:7.8, description:"A Kashmiri woman agrees to marry a Pakistani army officer in order to spy on Pakistan during the Indo-Pakistan War of 1971.", id:"Raazi"}}, {_id:7102, properties:{runtimeInMinutes:120, numberOfRatingVotes:27187, name:"Sound of Metal", rating:7.8, description:"A heavy-metal drummer's life is thrown into freefall when he begins to lose his hearing.", id:"Sound of Metal"}}, {_id:7103, properties:{runtimeInMinutes:124, numberOfRatingVotes:51240, name:"Forushande", rating:7.8, description:"While both participating in a production of \"Death of a Salesman,\" a teacher's wife is assaulted in her new home, which leaves him determined to find the perpetrator over his wife's traumatized objections.", id:"Forushande", grossRevenue:2402067}}, {_id:7104, properties:{runtimeInMinutes:106, numberOfRatingVotes:555092, name:"Dunkirk", rating:7.8, description:"Allied soldiers from Belgium, the British Empire, and France are surrounded by the German Army and evacuated during a fierce battle in World War II.", id:"Dunkirk", grossRevenue:188373161}}, {_id:7105, properties:{runtimeInMinutes:96, numberOfRatingVotes:57168, name:"Perfetti sconosciuti", rating:7.8, description:"Seven long-time friends get together for a dinner. When they decide to share with each other the content of every text message, email and phone call they receive, many secrets start to unveil and the equilibrium trembles.", id:"Perfetti sconosciuti"}}, {_id:7106, properties:{runtimeInMinutes:127, numberOfRatingVotes:200876, name:"Hidden Figures", rating:7.8, description:"The story of a team of female African-American mathematicians who served a vital role in NASA during the early years of the U.S. space program.", id:"Hidden Figures", grossRevenue:169607287}}, {_id:7107, properties:{runtimeInMinutes:103, numberOfRatingVotes:61594, name:"Paddington 2", rating:7.8, description:"Paddington (Ben Whishaw), now happily settled with the Brown family and a popular member of the local community, picks up a series of odd jobs to buy the perfect present for his Aunt Lucy's (Imelda Staunton's) 100th birthday, only for the gift to be stolen.", id:"Paddington 2", grossRevenue:40442052}}, {_id:7108, properties:{runtimeInMinutes:148, numberOfRatingVotes:27175, name:"Udta Punjab", rating:7.8, description:"A story that revolves around drug abuse in the affluent north Indian State of Punjab and how the youth there have succumbed to it en-masse resulting in a socio-economic decline.", id:"Udta Punjab"}}, {_id:7109, properties:{runtimeInMinutes:101, numberOfRatingVotes:118035, name:"Kubo and the Two Strings", rating:7.8, description:"A young boy named Kubo must locate a magical suit of armour worn by his late father in order to defeat a vengeful spirit from the past.", id:"Kubo and the Two Strings", grossRevenue:48023088}}, {_id:7110, properties:{runtimeInMinutes:184, numberOfRatingVotes:40416, name:"M.S. Dhoni: The Untold Story", rating:7.8, description:"The untold story of Mahendra Singh Dhoni's journey from ticket collector to trophy collector - the world-cup-winning captain of the Indian Cricket Team.", id:"M.S. Dhoni: The Untold Story", grossRevenue:1782795}}, {_id:7111, properties:{runtimeInMinutes:137, numberOfRatingVotes:246963, name:"Manchester by the Sea", rating:7.8, description:"A depressed uncle is asked to take care of his teenage nephew after the boy's father dies.", id:"Manchester by the Sea", grossRevenue:47695120}}, {_id:7112, properties:{runtimeInMinutes:100, numberOfRatingVotes:35539, name:"Under sandet", rating:7.8, description:"In post-World War II Denmark, a group of young German POWs are forced to clear a beach of thousands of land mines under the watch of a Danish Sergeant who slowly learns to appreciate their plight.", id:"Under sandet", grossRevenue:435266}}, {_id:7113, properties:{runtimeInMinutes:133, numberOfRatingVotes:556608, name:"Rogue One", rating:7.8, description:"The daughter of an Imperial scientist joins the Rebel Alliance in a risky move to steal the plans for the Death Star.", id:"Rogue One", grossRevenue:532177324}}, {_id:7114, properties:{runtimeInMinutes:147, numberOfRatingVotes:663649, name:"Captain America: Civil War", rating:7.8, description:"Political involvement in the Avengers' affairs causes a rift between Captain America and Iron Man.", id:"Captain America: Civil War", grossRevenue:408084349}}, {_id:7115, properties:{runtimeInMinutes:168, numberOfRatingVotes:517059, name:"The Hateful Eight", rating:7.8, description:"In the dead of a Wyoming winter, a bounty hunter and his prisoner find shelter in a cabin currently inhabited by a collection of nefarious characters.", id:"The Hateful Eight", grossRevenue:54117416}}, {_id:7116, properties:{runtimeInMinutes:135, numberOfRatingVotes:143250, name:"Little Women", rating:7.8, description:"Jo March reflects back and forth on her life, telling the beloved story of the March sisters - four young women, each determined to live life on her own terms.", id:"Little Women", grossRevenue:108101214}}, {_id:7117, properties:{runtimeInMinutes:94, numberOfRatingVotes:50778, name:"Loving Vincent", rating:7.8, description:"In a story depicted in oil painted animation, a young man comes to the last hometown of painter Vincent van Gogh (Robert Gulaczyk) to deliver the troubled artist's final letter and ends up investigating his final days there.", id:"Loving Vincent", grossRevenue:6735118}}] AS row

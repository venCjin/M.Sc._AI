UNWIND [{_id:7318, properties:{runtimeInMinutes:105, numberOfRatingVotes:40403, name:"In America", rating:7.7, description:"A family of Irish immigrants adjust to life on the mean streets of Hell's Kitchen while also grieving the death of a child.", id:"In America", grossRevenue:15539266}}, {_id:7319, properties:{runtimeInMinutes:132, numberOfRatingVotes:142863, name:"I Am Sam", rating:7.7, description:"A mentally handicapped man fights for custody of his 7-year-old daughter and in the process teaches his cold-hearted lawyer the value of love and family.", id:"I Am Sam", grossRevenue:40311852}}, {_id:7320, properties:{runtimeInMinutes:115, numberOfRatingVotes:178565, name:"Adaptation.", rating:7.7, description:"A lovelorn screenwriter becomes desperate as he tries and fails to adapt 'The Orchid Thief' by Susan Orlean for the screen.", id:"Adaptation.", grossRevenue:22245861}}, {_id:7321, properties:{runtimeInMinutes:144, numberOfRatingVotes:364254, name:"Black Hawk Down", rating:7.7, description:"160 elite U.S. soldiers drop into Somalia to capture two top lieutenants of a renegade warlord and find themselves in a desperate battle with a large force of heavily-armed Somalis.", id:"Black Hawk Down", grossRevenue:108638745}}, {_id:7322, properties:{runtimeInMinutes:117, numberOfRatingVotes:246840, name:"Road to Perdition", rating:7.7, description:"A mob enforcer's son witnesses a murder, forcing him and his father to take to the road, and his father down a path of redemption and revenge.", id:"Road to Perdition", grossRevenue:104454762}}, {_id:7323, properties:{runtimeInMinutes:120, numberOfRatingVotes:90842, name:"Das Experiment", rating:7.7, description:"For two weeks, 20 male participants are hired to play prisoners and guards in a prison. The \"prisoners\" have to follow seemingly mild rules, and the \"guards\" are told to retain order without using physical violence.", id:"Das Experiment", grossRevenue:141072}}, {_id:7324, properties:{runtimeInMinutes:110, numberOfRatingVotes:126770, name:"Billy Elliot", rating:7.7, description:"A talented young boy becomes torn between his unexpected love of dance and the disintegration of his family.", id:"Billy Elliot", grossRevenue:21995263}}, {_id:7325, properties:{runtimeInMinutes:95, numberOfRatingVotes:31957, name:"Hedwig and the Angry Inch", rating:7.7, description:"A gender-queer punk-rock singer from East Berlin tours the U.S. with her band as she tells her life story and follows the former lover/band-mate who stole her songs.", id:"Hedwig and the Angry Inch", grossRevenue:3029081}}, {_id:7326, properties:{runtimeInMinutes:116, numberOfRatingVotes:516372, name:"Ocean's Eleven", rating:7.7, description:"Danny Ocean and his ten accomplices plan to rob three Las Vegas casinos simultaneously.", id:"Ocean's Eleven", grossRevenue:183417150}}, {_id:7327, properties:{runtimeInMinutes:103, numberOfRatingVotes:29210, name:"Vampire Hunter D: Bloodlust", rating:7.7, description:"When a girl is abducted by a vampire, a legendary bounty hunter is hired to bring her back.", id:"Vampire Hunter D: Bloodlust", grossRevenue:151086}}, {_id:7328, properties:{runtimeInMinutes:107, numberOfRatingVotes:286742, name:"O Brother, Where Art Thou?", rating:7.7, description:"In the deep south during the 1930s, three escaped convicts search for hidden treasure while a relentless lawman pursues them.", id:"O Brother, Where Art Thou?", grossRevenue:45512588}}, {_id:7329, properties:{runtimeInMinutes:116, numberOfRatingVotes:29999, name:"Interstate 60: Episodes of the Road", rating:7.7, description:"Neal Oliver, a very confused young man and an artist, takes a journey of a lifetime on a highway I60 that doesn't exist on any of the maps, going to the places he never even heard of, searching for an answer and his dreamgirl.", id:"Interstate 60: Episodes of the Road"}}, {_id:7330, properties:{runtimeInMinutes:81, numberOfRatingVotes:192112, name:"South Park: Bigger, Longer & Uncut", rating:7.7, description:"When Stan Marsh and his friends go see an R-rated movie, they start cursing and their parents think that Canada is to blame.", id:"South Park: Bigger, Longer & Uncut", grossRevenue:52037603}}, {_id:7331, properties:{runtimeInMinutes:89, numberOfRatingVotes:241575, name:"Office Space", rating:7.7, description:"Three company workers who hate their jobs decide to rebel against their greedy boss.", id:"Office Space", grossRevenue:10824921}}, {_id:7332, properties:{runtimeInMinutes:134, numberOfRatingVotes:66408, name:"Happiness", rating:7.7, description:"The lives of several individuals intertwine as they go about their lives in their own unique ways, engaging in acts society as a whole might find disturbing in a desperate search for human connection.", id:"Happiness", grossRevenue:2807390}}, {_id:7333, properties:{runtimeInMinutes:122, numberOfRatingVotes:390247, name:"Training Day", rating:7.7, description:"A rookie cop spends his first day as a Los Angeles narcotics officer with a rogue detective who isn't what he appears to be.", id:"Training Day", grossRevenue:76631907}}, {_id:7334, properties:{runtimeInMinutes:93, numberOfRatingVotes:169229, name:"Rushmore", rating:7.7, description:"The extracurricular king of Rushmore Preparatory School is put on academic probation.", id:"Rushmore", grossRevenue:17105219}}, {_id:7335, properties:{runtimeInMinutes:119, numberOfRatingVotes:64082, name:"Abre los ojos", rating:7.7, description:"A very handsome man finds the love of his life, but he suffers an accident and needs to have his face rebuilt by surgery after it is severely disfigured.", id:"Abre los ojos", grossRevenue:368234}}, {_id:7336, properties:{runtimeInMinutes:113, numberOfRatingVotes:312542, name:"Being John Malkovich", rating:7.7, description:"A puppeteer discovers a portal that leads literally into the head of movie star John Malkovich.", id:"Being John Malkovich", grossRevenue:22858926}}, {_id:7337, properties:{runtimeInMinutes:139, numberOfRatingVotes:275755, name:"As Good as It Gets", rating:7.7, description:"A single mother and waitress, a misanthropic author, and a gay artist form an unlikely friendship after the artist is assaulted in a robbery.", id:"As Good as It Gets", grossRevenue:148478011}}] AS row

UNWIND [{_id:6678, properties:{runtimeInMinutes:180, numberOfRatingVotes:1187498, name:"The Wolf of Wall Street", rating:8.2, description:"Based on the true story of Jordan Belfort, from his rise to a wealthy stock-broker living the high life to his fall involving crime, corruption and the federal government.", id:"The Wolf of Wall Street", grossRevenue:116900694}}, {_id:6679, properties:{runtimeInMinutes:153, numberOfRatingVotes:74129, name:"Chak De! India", rating:8.2, description:"Kabir Khan is the coach of the Indian Women's National Hockey Team and his dream is to make his all girls team emerge victorious against all odds.", id:"Chak De! India", grossRevenue:1113541}}, {_id:6680, properties:{runtimeInMinutes:158, numberOfRatingVotes:517359, name:"There Will Be Blood", rating:8.2, description:"A story of family, religion, hatred, oil and madness, focusing on a turn-of-the-century prospector in the early days of the business.", id:"There Will Be Blood", grossRevenue:40222514}}, {_id:6681, properties:{runtimeInMinutes:118, numberOfRatingVotes:618623, name:"Pan's Labyrinth", rating:8.2, description:"In the Falangist Spain of 1944, the bookish young stepdaughter of a sadistic army officer escapes into an eerie but captivating fantasy world.", id:"Pan's Labyrinth", grossRevenue:37634615}}, {_id:6682, properties:{runtimeInMinutes:103, numberOfRatingVotes:757032, name:"Toy Story 3", rating:8.2, description:"The toys are mistakenly delivered to a day-care center instead of the attic right before Andy leaves for college, and it's up to Woody to convince the other toys that they weren't abandoned and to return home.", id:"Toy Story 3", grossRevenue:415004880}}, {_id:6683, properties:{runtimeInMinutes:132, numberOfRatingVotes:1032749, name:"V for Vendetta", rating:8.2, description:"In a future British tyranny, a shadowy freedom fighter, known only by the alias of \"V\", plots to overthrow it with the help of a young woman.", id:"V for Vendetta", grossRevenue:70511035}}, {_id:6684, properties:{runtimeInMinutes:167, numberOfRatingVotes:111937, name:"Rang De Basanti", rating:8.2, description:"The story of six young Indians who assist an English woman to film a documentary on the freedom fighters from their past, and the events that lead them to relive the long-forgotten saga of freedom.", id:"Rang De Basanti", grossRevenue:2197331}}, {_id:6685, properties:{runtimeInMinutes:122, numberOfRatingVotes:33354, name:"Black", rating:8.2, description:"The cathartic tale of a young woman who can't see, hear or talk and the teacher who brings a ray of light into her dark world.", id:"Black", grossRevenue:733094}}, {_id:6686, properties:{runtimeInMinutes:140, numberOfRatingVotes:1308302, name:"Batman Begins", rating:8.2, description:"After training with his mentor, Batman begins his fight to free crime-ridden Gotham City from corruption.", id:"Batman Begins", grossRevenue:206852432}}, {_id:6687, properties:{runtimeInMinutes:210, numberOfRatingVotes:83005, name:"Swades: We, the People", rating:8.2, description:"A successful Indian scientist returns to an Indian village to take his nanny to America with him and in the process rediscovers his roots.", id:"Swades: We, the People", grossRevenue:1223240}}, {_id:6688, properties:{runtimeInMinutes:156, numberOfRatingVotes:331308, name:"Der Untergang", rating:8.2, description:"Traudl Junge, the final secretary for Adolf Hitler, tells of the Nazi dictator's final days in his Berlin bunker at the end of WWII.", id:"Der Untergang", grossRevenue:5509040}}, {_id:6689, properties:{runtimeInMinutes:119, numberOfRatingVotes:333915, name:"Hauru no ugoku shiro", rating:8.2, description:"When an unconfident young woman is cursed with an old body by a spiteful witch, her only chance of breaking the spell lies with a self-indulgent yet insecure young wizard and his companions in his legged, walking castle.", id:"Hauru no ugoku shiro", grossRevenue:4711096}}, {_id:6690, properties:{runtimeInMinutes:135, numberOfRatingVotes:848920, name:"A Beautiful Mind", rating:8.2, description:"After John Nash, a brilliant but asocial mathematician, accepts secret work in cryptography, his life takes a turn for the nightmarish.", id:"A Beautiful Mind", grossRevenue:170742341}}, {_id:6691, properties:{runtimeInMinutes:156, numberOfRatingVotes:57057, name:"Hera Pheri", rating:8.2, description:"Three unemployed men look for answers to all their money problems - but when their opportunity arrives, will they know what to do with it?", id:"Hera Pheri"}}, {_id:6692, properties:{runtimeInMinutes:107, numberOfRatingVotes:535216, name:"Lock, Stock and Two Smoking Barrels", rating:8.2, description:"A botched card game in London triggers four friends, thugs, weed-growers, hard gangsters, loan sharks and debt collectors to collide with each other in a series of unexpected events, all for the sake of weed, cash and two antique shotguns.", id:"Lock, Stock and Two Smoking Barrels", grossRevenue:3897569}}, {_id:6693, properties:{runtimeInMinutes:138, numberOfRatingVotes:531967, name:"L.A. Confidential", rating:8.2, description:"As corruption grows in 1950s Los Angeles, three policemen - one strait-laced, one brutal, and one sleazy - investigate a series of murders with their own brand of justice.", id:"L.A. Confidential", grossRevenue:64616940}}, {_id:6694, properties:{runtimeInMinutes:128, numberOfRatingVotes:64118, name:"Eskiya", rating:8.2, description:"Baran the Bandit, released from prison after 35 years, searches for vengeance and his lover.", id:"Eskiya"}}, {_id:6695, properties:{runtimeInMinutes:170, numberOfRatingVotes:577113, name:"Heat", rating:8.2, description:"A group of professional bank robbers start to feel the heat from police when they unknowingly leave a clue at their latest heist.", id:"Heat", grossRevenue:67436818}}, {_id:6696, properties:{runtimeInMinutes:178, numberOfRatingVotes:466276, name:"Casino", rating:8.2, description:"A tale of greed, deception, money, power, and murder occur between two best friends: a mafia enforcer and a casino executive compete against each other over a gambling empire, and over a fast-living and fast-loving socialite.", id:"Casino", grossRevenue:42438300}}, {_id:6697, properties:{runtimeInMinutes:160, numberOfRatingVotes:49300, name:"Andaz Apna Apna", rating:8.2, description:"Two slackers competing for the affections of an heiress inadvertently become her protectors from an evil criminal.", id:"Andaz Apna Apna"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6698, properties:{runtimeInMinutes:130, numberOfRatingVotes:375935, name:"Unforgiven", rating:8.2, description:"Retired Old West gunslinger William Munny reluctantly takes on one last job, with the help of his old partner Ned Logan and a young man, The \"Schofield Kid.\"", id:"Unforgiven", grossRevenue:101157447}}, {_id:6699, properties:{runtimeInMinutes:127, numberOfRatingVotes:692366, name:"Indiana Jones and the Last Crusade", rating:8.2, description:"In 1938, after his father Professor Henry Jones, Sr. goes missing while pursuing the Holy Grail, Professor Henry \"Indiana\" Jones, Jr. finds himself up against Adolf Hitler's Nazis again to stop them from obtaining its powers.", id:"Indiana Jones and the Last Crusade", grossRevenue:197171806}}, {_id:6700, properties:{runtimeInMinutes:142, numberOfRatingVotes:26402, name:"Dom za vesanje", rating:8.2, description:"In this luminous tale set in the area around Sarajevo and in Italy, Perhan, an engaging young Romany (gypsy) with telekinetic powers, is seduced by the quick-cash world of petty crime, which threatens to destroy him and those he loves.", id:"Dom za vesanje", grossRevenue:280015}}, {_id:6701, properties:{runtimeInMinutes:86, numberOfRatingVotes:291180, name:"Tonari no Totoro", rating:8.2, description:"When two girls move to the country to be near their ailing mother, they have adventures with the wondrous forest spirits who live nearby.", id:"Tonari no Totoro", grossRevenue:1105564}}, {_id:6702, properties:{runtimeInMinutes:132, numberOfRatingVotes:793164, name:"Die Hard", rating:8.2, description:"An NYPD officer tries to save his wife and several others taken hostage by German terrorists during a Christmas party at the Nakatomi Plaza in Los Angeles.", id:"Die Hard", grossRevenue:83008852}}, {_id:6703, properties:{runtimeInMinutes:162, numberOfRatingVotes:112505, name:"Ran", rating:8.2, description:"In Medieval Japan, an elderly warlord retires, handing over his empire to his three sons. However, he vastly underestimates how the new-found power will corrupt them and cause them to turn on each other...and him.", id:"Ran", grossRevenue:4135750}}, {_id:6704, properties:{runtimeInMinutes:129, numberOfRatingVotes:321860, name:"Raging Bull", rating:8.2, description:"The life of boxer Jake LaMotta, whose violence and temper that led him to the top in the ring destroyed his life outside of it.", id:"Raging Bull", grossRevenue:23383987}}, {_id:6705, properties:{runtimeInMinutes:162, numberOfRatingVotes:116945, name:"Stalker", rating:8.2, description:"A guide leads two men through an area known as the Zone to find a room that grants wishes.", id:"Stalker", grossRevenue:234723}}, {_id:6706, properties:{runtimeInMinutes:99, numberOfRatingVotes:26875, name:"Höstsonaten", rating:8.2, description:"A married daughter who longs for her mother's love is visited by the latter, a successful concert pianist.", id:"Höstsonaten"}}, {_id:6707, properties:{runtimeInMinutes:177, numberOfRatingVotes:43885, name:"The Message", rating:8.2, description:"This epic historical drama chronicles the life and times of Prophet Muhammad and serves as an introduction to early Islamic history.", id:"The Message"}}, {_id:6708, properties:{runtimeInMinutes:204, numberOfRatingVotes:51284, name:"Sholay", rating:8.2, description:"After his family is murdered by a notorious and ruthless bandit, a former police officer enlists the services of two outlaws to capture the bandit.", id:"Sholay"}}, {_id:6709, properties:{runtimeInMinutes:91, numberOfRatingVotes:500875, name:"Monty Python and the Holy Grail", rating:8.2, description:"King Arthur and his Knights of the Round Table embark on a surreal, low-budget search for the Holy Grail, encountering many, very silly obstacles.", id:"Monty Python and the Holy Grail", grossRevenue:1229197}}, {_id:6710, properties:{runtimeInMinutes:172, numberOfRatingVotes:224730, name:"The Great Escape", rating:8.2, description:"Allied prisoners of war plan for several hundred of their number to escape from a German camp during World War II.", id:"The Great Escape", grossRevenue:12100000}}, {_id:6711, properties:{runtimeInMinutes:129, numberOfRatingVotes:293811, name:"To Kill a Mockingbird", rating:8.2, description:"Atticus Finch, a lawyer in the Depression-era South, defends a black man against an undeserved rape charge, and his children against prejudice.", id:"To Kill a Mockingbird"}}, {_id:6712, properties:{runtimeInMinutes:110, numberOfRatingVotes:111244, name:"Yôjinbô", rating:8.2, description:"A crafty ronin comes to a town divided by two criminal gangs and decides to play them against each other to free the town.", id:"Yôjinbô"}}, {_id:6713, properties:{runtimeInMinutes:179, numberOfRatingVotes:69458, name:"Judgment at Nuremberg", rating:8.2, description:"In 1948, an American court in occupied Germany tries four Nazis judged for war crimes.", id:"Judgment at Nuremberg"}}, {_id:6714, properties:{runtimeInMinutes:121, numberOfRatingVotes:243943, name:"Some Like It Hot", rating:8.2, description:"After two male musicians witness a mob hit, they flee the state in an all-female band disguised as women, but further complications set in.", id:"Some Like It Hot", grossRevenue:25000000}}, {_id:6715, properties:{runtimeInMinutes:91, numberOfRatingVotes:96381, name:"Smultronstället", rating:8.2, description:"After living a life marked by coldness, an aging professor is forced to confront the emptiness of his existence.", id:"Smultronstället"}}, {_id:6716, properties:{runtimeInMinutes:96, numberOfRatingVotes:164939, name:"Det sjunde inseglet", rating:8.2, description:"A man seeks answers about life, death, and the existence of God as he plays chess against the Grim Reaper during the Black Plague.", id:"Det sjunde inseglet"}}, {_id:6717, properties:{runtimeInMinutes:118, numberOfRatingVotes:28810, rating:8.2, name:"Du rififi chez les hommes", description:"Four men plan a technically perfect crime, but the human element intervenes...", id:"Du rififi chez les hommes", grossRevenue:57226}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6718, properties:{runtimeInMinutes:105, numberOfRatingVotes:158335, rating:8.2, name:"Dial M for Murder", description:"A former tennis player tries to arrange his wife's murder after learning of her affair.", id:"Dial M for Murder", grossRevenue:12562}}, {_id:6719, properties:{runtimeInMinutes:136, numberOfRatingVotes:53153, name:"Tôkyô monogatari", rating:8.2, description:"An old couple visit their children and grandchildren in the city, but receive little attention.", id:"Tôkyô monogatari"}}, {_id:6720, properties:{runtimeInMinutes:88, numberOfRatingVotes:152572, name:"Rashômon", rating:8.2, description:"The rape of a bride and the murder of her samurai husband are recalled from the perspectives of a bandit, the bride, the samurai's ghost and a woodcutter.", id:"Rashômon", grossRevenue:96568}}, {_id:6721, properties:{runtimeInMinutes:138, numberOfRatingVotes:120539, name:"All About Eve", rating:8.2, description:"A seemingly timid but secretly ruthless ingénue insinuates herself into the lives of an aging Broadway star and her circle of theater friends.", id:"All About Eve", grossRevenue:10177}}, {_id:6722, properties:{runtimeInMinutes:126, numberOfRatingVotes:114304, name:"The Treasure of the Sierra Madre", rating:8.2, description:"Two Americans searching for work in Mexico convince an old prospector to help them mine for gold in the Sierra Madre Mountains.", id:"The Treasure of the Sierra Madre", grossRevenue:5014000}}, {_id:6723, properties:{runtimeInMinutes:99, numberOfRatingVotes:29915, name:"To Be or Not to Be", rating:8.2, description:"During the Nazi occupation of Poland, an acting troupe becomes embroiled in a Polish soldier's efforts to track down a German spy.", id:"To Be or Not to Be"}}, {_id:6724, properties:{runtimeInMinutes:95, numberOfRatingVotes:101053, name:"The Gold Rush", rating:8.2, description:"A prospector goes to the Klondike in search of gold and finds it and more.", id:"The Gold Rush", grossRevenue:5450000}}, {_id:6725, properties:{runtimeInMinutes:45, numberOfRatingVotes:41985, name:"Sherlock Jr.", rating:8.2, description:"A film projectionist longs to be a detective, and puts his meagre skills to work when he is framed by a rival for stealing his girlfriend's father's pocketwatch.", id:"Sherlock Jr.", grossRevenue:977375}}, {_id:6726, properties:{runtimeInMinutes:122, numberOfRatingVotes:63134, name:"Portrait de la jeune fille en feu", rating:8.1, description:"On an isolated island in Brittany at the end of the eighteenth century, a female painter is obliged to paint a wedding portrait of a young woman.", id:"Portrait de la jeune fille en feu", grossRevenue:3759854}}, {_id:6727, properties:{runtimeInMinutes:136, numberOfRatingVotes:39216, name:"Pink", rating:8.1, description:"When three young women are implicated in a crime, a retired lawyer steps forward to help them clear their names.", id:"Pink", grossRevenue:1241223}}, {_id:6728, properties:{runtimeInMinutes:130, numberOfRatingVotes:47708, name:"Koe no katachi", rating:8.1, description:"A young man is ostracized by his classmates after he bullies a deaf girl to the point where she moves away. Years later, he sets off on a path for redemption.", id:"Koe no katachi"}}, {_id:6729, properties:{runtimeInMinutes:106, numberOfRatingVotes:141516, name:"Contratiempo", rating:8.1, description:"A successful entrepreneur accused of murder and a witness preparation expert have less than three hours to come up with an impregnable defense.", id:"Contratiempo"}}, {_id:6730, properties:{runtimeInMinutes:145, numberOfRatingVotes:113649, name:"Ah-ga-ssi", rating:8.1, description:"A woman is hired as a handmaiden to a Japanese heiress, but secretly she is involved in a plot to defraud her.", id:"Ah-ga-ssi", grossRevenue:2006788}}, {_id:6731, properties:{runtimeInMinutes:139, numberOfRatingVotes:50700, name:"Mommy", rating:8.1, description:"A widowed single mother, raising her violent son alone, finds new hope when a mysterious neighbor inserts herself into their household.", id:"Mommy", grossRevenue:3492754}}, {_id:6732, properties:{runtimeInMinutes:160, numberOfRatingVotes:50445, name:"Haider", rating:8.1, description:"A young man returns to Kashmir after his father's disappearance to confront his uncle, whom he suspects of playing a role in his father's fate.", id:"Haider", grossRevenue:901610}}, {_id:6733, properties:{runtimeInMinutes:137, numberOfRatingVotes:647884, name:"Logan", rating:8.1, description:"In a future where mutants are nearly extinct, an elderly and weary Logan leads a quiet life. But when Laura, a mutant child pursued by scientists, comes to him for help, he must get her to safety.", id:"Logan", grossRevenue:226277068}}, {_id:6734, properties:{runtimeInMinutes:118, numberOfRatingVotes:371538, name:"Room", rating:8.1, description:"Held captive for 7 years in an enclosed space, a woman and her young son finally gain their freedom, allowing the boy to experience the outside world for the first time.", id:"Room", grossRevenue:14677674}}, {_id:6735, properties:{runtimeInMinutes:122, numberOfRatingVotes:177059, name:"Relatos salvajes", rating:8.1, description:"Six short stories that explore the extremities of human behavior involving people in distress.", id:"Relatos salvajes", grossRevenue:3107072}}, {_id:6736, properties:{runtimeInMinutes:100, numberOfRatingVotes:159171, name:"Soul", rating:8.1, description:"After landing the gig of a lifetime, a New York jazz pianist suddenly finds himself trapped in a strange land between Earth and the afterlife.", id:"Soul"}}, {_id:6737, properties:{runtimeInMinutes:196, numberOfRatingVotes:46547, name:"Kis Uykusu", rating:8.1, description:"A hotel owner and landlord in a remote Turkish village deals with conflicts within his family and a tenant behind on his rent.", id:"Kis Uykusu", grossRevenue:165520}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6738, properties:{runtimeInMinutes:153, numberOfRatingVotes:163061, name:"PK", rating:8.1, description:"An alien on Earth loses the only device he can use to communicate with his spaceship. His innocent nature and child-like questions force the country to evaluate the impact of religion on its people.", id:"PK", grossRevenue:10616104}}, {_id:6739, properties:{runtimeInMinutes:125, numberOfRatingVotes:51739, rating:8.1, name:"OMG: Oh My God!", description:"A shopkeeper takes God to court when his shop is destroyed by an earthquake.", id:"OMG: Oh My God!", grossRevenue:923221}}, {_id:6740, properties:{runtimeInMinutes:99, numberOfRatingVotes:707630, name:"The Grand Budapest Hotel", rating:8.1, description:"A writer encounters the owner of an aging high-class hotel, who tells him of his early years serving as a lobby boy in the hotel's glorious years under an exceptional concierge.", id:"The Grand Budapest Hotel", grossRevenue:59100318}}, {_id:6741, properties:{runtimeInMinutes:149, numberOfRatingVotes:859695, name:"Gone Girl", rating:8.1, description:"With his wife's disappearance having become the focus of an intense media circus, a man sees the spotlight turned on him when it's suspected that he may not be innocent.", id:"Gone Girl", grossRevenue:167767189}}, {_id:6742, properties:{runtimeInMinutes:117, numberOfRatingVotes:38803, rating:8.1, name:"Ôkami kodomo no Ame to Yuki", description:"After her werewolf lover unexpectedly dies in an accident while hunting for food for their children, a young woman must find ways to raise the werewolf son and daughter that she had with him while keeping their trait hidden from society.", id:"Ôkami kodomo no Ame to Yuki"}}, {_id:6743, properties:{runtimeInMinutes:139, numberOfRatingVotes:435928, name:"Hacksaw Ridge", rating:8.1, description:"World War II American Army Medic Desmond T. Doss, who served during the Battle of Okinawa, refuses to kill people, and becomes the first man in American history to receive the Medal of Honor without firing a shot.", id:"Hacksaw Ridge", grossRevenue:67209615}}, {_id:6744, properties:{runtimeInMinutes:95, numberOfRatingVotes:616228, name:"Inside Out", rating:8.1, description:"After young Riley is uprooted from her Midwest life and moved to San Francisco, her emotions - Joy, Fear, Anger, Disgust and Sadness - conflict on how best to navigate a new city, house, and school.", id:"Inside Out", grossRevenue:356461711}}, {_id:6745, properties:{runtimeInMinutes:151, numberOfRatingVotes:75721, name:"Barfi!", rating:8.1, description:"Three young people learn that love can neither be defined nor contained by society's definition of normal and abnormal.", id:"Barfi!", grossRevenue:2804874}}, {_id:6746, properties:{runtimeInMinutes:134, numberOfRatingVotes:640533, name:"12 Years a Slave", rating:8.1, description:"In the antebellum United States, Solomon Northup, a free black man from upstate New York, is abducted and sold into slavery.", id:"12 Years a Slave", grossRevenue:56671993}}, {_id:6747, properties:{runtimeInMinutes:123, numberOfRatingVotes:432811, name:"Rush", rating:8.1, description:"The merciless 1970s rivalry between Formula One rivals James Hunt and Niki Lauda.", id:"Rush", grossRevenue:26947624}}, {_id:6748, properties:{runtimeInMinutes:152, numberOfRatingVotes:291289, name:"Ford v Ferrari", rating:8.1, description:"American car designer Carroll Shelby and driver Ken Miles battle corporate interference and the laws of physics to build a revolutionary race car for Ford in order to defeat Ferrari at the 24 Hours of Le Mans in 1966.", id:"Ford v Ferrari", grossRevenue:117624028}}, {_id:6749, properties:{runtimeInMinutes:129, numberOfRatingVotes:420316, name:"Spotlight", rating:8.1, description:"The true story of how the Boston Globe uncovered the massive scandal of child molestation and cover-up within the local Catholic Archdiocese, shaking the entire Catholic Church to its core.", id:"Spotlight", grossRevenue:45055776}}, {_id:6750, properties:{runtimeInMinutes:93, numberOfRatingVotes:51679, rating:8.1, name:"Song of the Sea", description:"Ben, a young Irish boy, and his little sister Saoirse, a girl who can turn into a seal, go on an adventure to free the fairies and save the spirit world.", id:"Song of the Sea", grossRevenue:857524}}, {_id:6751, properties:{runtimeInMinutes:122, numberOfRatingVotes:57806, name:"Kahaani", rating:8.1, description:"A pregnant woman's search for her missing husband takes her from London to Kolkata, but everyone she questions denies having ever met him.", id:"Kahaani", grossRevenue:1035953}}, {_id:6752, properties:{runtimeInMinutes:155, numberOfRatingVotes:67927, name:"Zindagi Na Milegi Dobara", rating:8.1, description:"Three friends decide to turn their fantasy vacation into reality after one of their friends gets engaged.", id:"Zindagi Na Milegi Dobara", grossRevenue:3108485}}, {_id:6753, properties:{runtimeInMinutes:153, numberOfRatingVotes:601149, name:"Prisoners", rating:8.1, description:"When Keller Dover's daughter and her friend go missing, he takes matters into his own hands as the police pursue multiple leads and the pressure mounts.", id:"Prisoners", grossRevenue:61002302}}, {_id:6754, properties:{runtimeInMinutes:120, numberOfRatingVotes:882316, name:"Mad Max: Fury Road", rating:8.1, description:"In a post-apocalyptic wasteland, a woman rebels against a tyrannical ruler in search for her homeland with the aid of a group of female prisoners, a psychotic worshiper, and a drifter named Max.", id:"Mad Max: Fury Road", grossRevenue:154058340}}, {_id:6755, properties:{runtimeInMinutes:104, numberOfRatingVotes:73891, name:"A Wednesday", rating:8.1, description:"A retiring police officer reminisces about the most astounding day of his career. About a case that was never filed but continues to haunt him in his memories - the case of a man and a Wednesday.", id:"A Wednesday"}}, {_id:6756, properties:{runtimeInMinutes:116, numberOfRatingVotes:720450, name:"Gran Torino", rating:8.1, description:"Disgruntled Korean War veteran Walt Kowalski sets out to reform his neighbor, Thao Lor, a Hmong teenager who tried to steal Kowalski's prized possession: a 1972 Gran Torino.", id:"Gran Torino", grossRevenue:148095302}}, {_id:6757, properties:{runtimeInMinutes:130, numberOfRatingVotes:764493, name:"Harry Potter and the Deathly Hallows: Part 2", rating:8.1, description:"Harry, Ron, and Hermione search for Voldemort's remaining Horcruxes in their effort to destroy the Dark Lord as the final battle rages on at Hogwarts.", id:"Harry Potter and the Deathly Hallows: Part 2", grossRevenue:381011219}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6758, properties:{runtimeInMinutes:130, numberOfRatingVotes:48582, name:"Okuribito", rating:8.1, description:"A newly unemployed cellist takes a job preparing the dead for funerals.", id:"Okuribito", grossRevenue:1498210}}, {_id:6759, properties:{runtimeInMinutes:93, numberOfRatingVotes:253575, name:"Hachi: A Dog's Tale", rating:8.1, description:"A college professor bonds with an abandoned dog he takes into his home.", id:"Hachi: A Dog's Tale"}}, {_id:6760, properties:{runtimeInMinutes:92, numberOfRatingVotes:164462, name:"Mary and Max", rating:8.1, description:"A tale of friendship between two unlikely pen pals: Mary, a lonely, eight-year-old girl living in the suburbs of Melbourne, and Max, a forty-four-year old, severely obese man living in New York.", id:"Mary and Max"}}, {_id:6761, properties:{runtimeInMinutes:98, numberOfRatingVotes:666773, name:"How to Train Your Dragon", rating:8.1, description:"A hapless young Viking who aspires to hunt dragons becomes the unlikely friend of a young dragon himself, and learns there may be more to the creatures than he assumed.", id:"How to Train Your Dragon", grossRevenue:217581231}}, {_id:6762, properties:{runtimeInMinutes:148, numberOfRatingVotes:572921, name:"Into the Wild", rating:8.1, description:"After graduating from Emory University, top student and athlete Christopher McCandless abandons his possessions, gives his entire $24,000 savings account to charity and hitchhikes to Alaska to live in the wilderness. Along the way, Christopher encounters a series of characters that shape his life.", id:"Into the Wild", grossRevenue:18354356}}, {_id:6763, properties:{runtimeInMinutes:122, numberOfRatingVotes:856916, name:"No Country for Old Men", rating:8.1, description:"Violence and mayhem ensue after a hunter stumbles upon a drug deal gone wrong and more than two million dollars in cash near the Rio Grande.", id:"No Country for Old Men", grossRevenue:74283625}}, {_id:6764, properties:{runtimeInMinutes:144, numberOfRatingVotes:43137, name:"Lage Raho Munna Bhai", rating:8.1, description:"Munna Bhai embarks on a journey with Mahatma Gandhi in order to fight against a corrupt property dealer.", id:"Lage Raho Munna Bhai", grossRevenue:2217561}}, {_id:6765, properties:{runtimeInMinutes:132, numberOfRatingVotes:635975, name:"Million Dollar Baby", rating:8.1, description:"A determined woman works with a hardened boxing trainer to become a professional.", id:"Million Dollar Baby", grossRevenue:100492203}}, {_id:6766, properties:{runtimeInMinutes:121, numberOfRatingVotes:334320, name:"Hotel Rwanda", rating:8.1, description:"Paul Rusesabagina, a hotel manager, houses over a thousand Tutsi refugees during their struggle against the Hutu militia in Rwanda, Africa.", id:"Hotel Rwanda", grossRevenue:23530892}}, {_id:6767, properties:{runtimeInMinutes:140, numberOfRatingVotes:37820, name:"Taegukgi hwinalrimyeo", rating:8.1, description:"When two brothers are forced to fight in the Korean War, the elder decides to take the riskiest missions if it will help shield the younger from battle.", id:"Taegukgi hwinalrimyeo", grossRevenue:1111061}}, {_id:6768, properties:{runtimeInMinutes:80, numberOfRatingVotes:236311, name:"Before Sunset", rating:8.1, description:"Nine years after Jesse and Celine first met, they encounter each other again on the French leg of Jesse's book tour.", id:"Before Sunset", grossRevenue:5820649}}, {_id:6769, properties:{runtimeInMinutes:156, numberOfRatingVotes:73992, name:"Munna Bhai M.B.B.S.", rating:8.1, description:"A gangster sets out to fulfill his father's dream of becoming a doctor.", id:"Munna Bhai M.B.B.S."}}, {_id:6770, properties:{runtimeInMinutes:131, numberOfRatingVotes:139558, name:"Salinui chueok", rating:8.1, description:"In a small Korean province in 1986, two detectives struggle with the case of multiple young women being found raped and murdered by an unknown culprit.", id:"Salinui chueok", grossRevenue:14131}}, {_id:6771, properties:{runtimeInMinutes:183, numberOfRatingVotes:66803, name:"Dil Chahta Hai", rating:8.1, description:"Three inseparable childhood friends are just out of college. Nothing comes between them - until they each fall in love, and their wildly different approaches to relationships creates tension.", id:"Dil Chahta Hai", grossRevenue:300000}}, {_id:6772, properties:{runtimeInMinutes:111, numberOfRatingVotes:1000639, name:"Kill Bill: Vol. 1", rating:8.1, description:"After awakening from a four-year coma, a former assassin wreaks vengeance on the team of assassins who betrayed her.", id:"Kill Bill: Vol. 1", grossRevenue:70099045}}, {_id:6773, properties:{runtimeInMinutes:100, numberOfRatingVotes:949565, name:"Finding Nemo", rating:8.1, description:"After his son is captured in the Great Barrier Reef and taken to Sydney, a timid clownfish sets out on a journey to bring him home.", id:"Finding Nemo", grossRevenue:380843261}}, {_id:6774, properties:{runtimeInMinutes:141, numberOfRatingVotes:832846, name:"Catch Me If You Can", rating:8.1, description:"Barely 21 yet, Frank is a skilled forger who has passed as a doctor, lawyer and pilot. FBI agent Carl becomes obsessed with tracking down the con man, who only revels in the pursuit.", id:"Catch Me If You Can", grossRevenue:164615351}}, {_id:6775, properties:{runtimeInMinutes:154, numberOfRatingVotes:223741, name:"Amores perros", rating:8.1, description:"A horrific car accident connects three stories, each involving characters dealing with loss, regret, and life's harsh realities, all in the name of love.", id:"Amores perros", grossRevenue:5383834}}, {_id:6776, properties:{runtimeInMinutes:92, numberOfRatingVotes:815505, name:"Monsters, Inc.", rating:8.1, description:"In order to power the city, monsters have to scare children so that they scream. However, the children are toxic to the monsters, and after a child gets through, 2 monsters realize things may not be what they think.", id:"Monsters, Inc.", grossRevenue:289916256}}, {_id:6777, properties:{runtimeInMinutes:87, numberOfRatingVotes:38847, name:"Shin seiki Evangelion Gekijô-ban: Air/Magokoro wo, kimi ni", rating:8.1, description:"Concurrent theatrical ending of the TV series Shin seiki evangerion (1995).", id:"Shin seiki Evangelion Gekijô-ban: Air/Magokoro wo, kimi ni"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:6778, properties:{runtimeInMinutes:224, numberOfRatingVotes:105036, name:"Lagaan: Once Upon a Time in India", rating:8.1, description:"The people of a small village in Victorian India stake their future on a game of cricket against their ruthless British rulers.", id:"Lagaan: Once Upon a Time in India", grossRevenue:70147}}, {_id:6779, properties:{runtimeInMinutes:107, numberOfRatingVotes:911573, name:"The Sixth Sense", rating:8.1, description:"A boy who communicates with spirits seeks the help of a disheartened child psychologist.", id:"The Sixth Sense", grossRevenue:293506292}}, {_id:6780, properties:{runtimeInMinutes:169, numberOfRatingVotes:59020, name:"La leggenda del pianista sull'oceano", rating:8.1, description:"A baby boy, discovered in 1900 on an ocean liner, grows into a musical prodigy, never setting foot on land.", id:"La leggenda del pianista sull'oceano", grossRevenue:259127}}, {_id:6781, properties:{runtimeInMinutes:103, numberOfRatingVotes:939631, name:"The Truman Show", rating:8.1, description:"An insurance salesman discovers his whole life is actually a reality TV show.", id:"The Truman Show", grossRevenue:125618201}}, {_id:6782, properties:{runtimeInMinutes:127, numberOfRatingVotes:50862, rating:8.1, name:"Crna macka, beli macor", description:"Matko and his son Zare live on the banks of the Danube river and get by through hustling and basically doing anything to make a living. In order to pay off a business debt Matko agrees to marry off Zare to the sister of a local gangster.", id:"Crna macka, beli macor", grossRevenue:348660}}, {_id:6783, properties:{runtimeInMinutes:117, numberOfRatingVotes:732620, name:"The Big Lebowski", rating:8.1, description:"Jeff \"The Dude\" Lebowski, mistaken for a millionaire of the same name, seeks restitution for his ruined rug and enlists his bowling buddies to help get it.", id:"The Big Lebowski", grossRevenue:17498804}}, {_id:6784, properties:{runtimeInMinutes:98, numberOfRatingVotes:124383, name:"Fa yeung nin wah", rating:8.1, description:"Two neighbors, a woman and a man, form a strong bond after both suspect extramarital activities of their spouses. However, they agree to keep their bond platonic so as not to commit similar wrongs.", id:"Fa yeung nin wah", grossRevenue:2734044}}, {_id:6785, properties:{runtimeInMinutes:93, numberOfRatingVotes:634716, name:"Trainspotting", rating:8.1, description:"Renton, deeply immersed in the Edinburgh drug scene, tries to clean up and get out, despite the allure of the drugs and influence of friends.", id:"Trainspotting", grossRevenue:16501785}}, {_id:6786, properties:{runtimeInMinutes:98, numberOfRatingVotes:617444, name:"Fargo", rating:8.1, description:"Jerry Lundegaard's inept crime falls apart due to his and his henchmen's bungling and the persistent police work of the quite pregnant Marge Gunderson.", id:"Fargo", grossRevenue:24611975}}, {_id:6787, properties:{runtimeInMinutes:170, numberOfRatingVotes:55220, name:"Underground", rating:8.1, description:"A group of Serbian socialists prepares for the war in a surreal underground filled by parties, tragedies, love and hate.", id:"Underground", grossRevenue:171082}}, {_id:6788, properties:{runtimeInMinutes:98, numberOfRatingVotes:150345, name:"La haine", rating:8.1, description:"24 hours in the lives of three young men in the French suburbs the day after a violent riot.", id:"La haine", grossRevenue:309811}}, {_id:6789, properties:{runtimeInMinutes:189, numberOfRatingVotes:63516, rating:8.1, name:"Dilwale Dulhania Le Jayenge", description:"When Raj meets Simran in Europe, it isn't love at first sight but when Simran moves to India for an arranged marriage, love makes its presence felt.", id:"Dilwale Dulhania Le Jayenge"}}, {_id:6790, properties:{runtimeInMinutes:101, numberOfRatingVotes:272291, name:"Before Sunrise", rating:8.1, description:"A young man and woman meet on a train in Europe, and wind up spending one evening together in Vienna. Unfortunately, both know that this will probably be their only night together.", id:"Before Sunrise", grossRevenue:5535405}}, {_id:6791, properties:{runtimeInMinutes:99, numberOfRatingVotes:90729, name:"Trois couleurs: Rouge", rating:8.1, description:"A model discovers a retired judge is keen on invading people's privacy.", id:"Trois couleurs: Rouge", grossRevenue:4043686}}, {_id:6792, properties:{runtimeInMinutes:102, numberOfRatingVotes:63122, rating:8.1, name:"Chung Hing sam lam", description:"Two melancholy Hong Kong policemen fall in love: one with a mysterious female underworld figure, the other with a beautiful and ethereal server at a late-night restaurant he frequents.", id:"Chung Hing sam lam", grossRevenue:600200}}, {_id:6793, properties:{runtimeInMinutes:127, numberOfRatingVotes:867615, name:"Jurassic Park", rating:8.1, description:"A pragmatic paleontologist visiting an almost complete theme park is tasked with protecting a couple of kids after a power failure causes the park's cloned dinosaurs to run loose.", id:"Jurassic Park", grossRevenue:402453882}}, {_id:6794, properties:{runtimeInMinutes:133, numberOfRatingVotes:156842, name:"In the Name of the Father", rating:8.1, description:"A man's coerced confession to an I.R.A. bombing he did not commit results in the imprisonment of his father as well. An English lawyer fights to free them.", id:"In the Name of the Father", grossRevenue:25010410}}, {_id:6795, properties:{runtimeInMinutes:171, numberOfRatingVotes:25088, name:"Ba wang bie ji", rating:8.1, description:"Two boys meet at an opera training school in Peking in 1924. Their resulting friendship will span nearly 70 years and will endure some of the most troublesome times in China's history.", id:"Ba wang bie ji", grossRevenue:5216888}}, {_id:6796, properties:{runtimeInMinutes:125, numberOfRatingVotes:29662, name:"Dà hóng denglong gaogao guà", rating:8.1, description:"A young woman becomes the fourth wife of a wealthy lord, and must learn to live with the strict rules and tensions within the household.", id:"Dà hóng denglong gaogao guà", grossRevenue:2603061}}, {_id:6797, properties:{runtimeInMinutes:128, numberOfRatingVotes:425457, name:"Dead Poets Society", rating:8.1, description:"Maverick teacher John Keating uses poetry to embolden his boarding school students to new heights of self-expression.", id:"Dead Poets Society", grossRevenue:95860116}}] AS row

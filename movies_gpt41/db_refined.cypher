UNWIND [{_id:6998, properties:{runtimeInMinutes:132, numberOfRatingVotes:212651, name:"Call Me by Your Name", rating:7.9, description:"In 1980s Italy, romance blossoms between a seventeen-year-old student and the older man hired as his father's research assistant.", id:"Call Me by Your Name", grossRevenue:18095701}}, {_id:6999, properties:{runtimeInMinutes:100, numberOfRatingVotes:53818, rating:7.9, name:"I, Daniel Blake", description:"After having suffered a heart-attack, a 59-year-old carpenter must fight the bureaucratic forces of the system in order to receive Employment and Support Allowance.", id:"I, Daniel Blake", grossRevenue:258168}}, {_id:7000, properties:{runtimeInMinutes:101, numberOfRatingVotes:139114, name:"Isle of Dogs", rating:7.9, description:"Set in Japan, Isle of Dogs follows a boy's odyssey in search of his lost dog.", id:"Isle of Dogs", grossRevenue:32015231}}, {_id:7001, properties:{runtimeInMinutes:101, numberOfRatingVotes:111483, name:"Hunt for the Wilderpeople", rating:7.9, description:"A national manhunt is ordered for a rebellious kid and his foster uncle who go missing in the wild New Zealand bush.", id:"Hunt for the Wilderpeople", grossRevenue:5202582}}, {_id:7002, properties:{runtimeInMinutes:118, numberOfRatingVotes:189400, name:"Captain Fantastic", rating:7.9, description:"In the forests of the Pacific Northwest, a father devoted to raising his six kids with a rigorous physical and intellectual education is forced to leave his paradise and enter the world, challenging his idea of what it means to be a parent.", id:"Captain Fantastic", grossRevenue:5875006}}, {_id:7003, properties:{runtimeInMinutes:106, numberOfRatingVotes:85109, name:"Sing Street", rating:7.9, description:"A boy growing up in Dublin during the 1980s escapes his strained family life by starting a band to impress the mysterious girl he likes.", id:"Sing Street", grossRevenue:3237118}}, {_id:7004, properties:{runtimeInMinutes:130, numberOfRatingVotes:587775, name:"Thor: Ragnarok", rating:7.9, description:"Imprisoned on the planet Sakaar, Thor must race against time to return to Asgard and stop Ragnarök, the destruction of his world, at the hands of the powerful and ruthless villain Hela.", id:"Thor: Ragnarok", grossRevenue:315058289}}, {_id:7005, properties:{runtimeInMinutes:117, numberOfRatingVotes:466134, name:"Nightcrawler", rating:7.9, description:"When Louis Bloom, a con man desperate for work, muscles into the world of L.A. crime journalism, he blurs the line between observer and participant to become the star of his own story.", id:"Nightcrawler", grossRevenue:32381218}}, {_id:7006, properties:{runtimeInMinutes:108, numberOfRatingVotes:297918, name:"Jojo Rabbit", rating:7.9, description:"A young boy in Hitler's army finds out his mother is hiding a Jewish girl in their home.", id:"Jojo Rabbit", grossRevenue:349555}}, {_id:7007, properties:{runtimeInMinutes:116, numberOfRatingVotes:594181, name:"Arrival", rating:7.9, description:"A linguist works with the military to communicate with alien lifeforms after twelve mysterious spacecrafts appear around the world.", id:"Arrival", grossRevenue:100546139}}, {_id:7008, properties:{runtimeInMinutes:138, numberOfRatingVotes:860823, name:"Star Wars: Episode VII - The Force Awakens", rating:7.9, description:"As a new threat to the galaxy rises, Rey, a desert scavenger, and Finn, an ex-stormtrooper, must join Han Solo and Chewbacca to search for the one hope of restoring peace.", id:"Star Wars: Episode VII - The Force Awakens", grossRevenue:936662225}}, {_id:7009, properties:{runtimeInMinutes:109, numberOfRatingVotes:141457, name:"Before Midnight", rating:7.9, description:"We meet Jesse and Celine nine years on in Greece. Almost two decades have passed since their first meeting on that train bound for Vienna.", id:"Before Midnight", grossRevenue:8114627}}, {_id:7010, properties:{runtimeInMinutes:132, numberOfRatingVotes:659763, name:"X-Men: Days of Future Past", rating:7.9, description:"The X-Men send Wolverine to the past in a desperate effort to change history and prevent an event that results in doom for both humans and mutants.", id:"X-Men: Days of Future Past", grossRevenue:233921534}}, {_id:7011, properties:{runtimeInMinutes:157, numberOfRatingVotes:41995, rating:7.9, name:"Bir Zamanlar Anadolu'da", description:"A group of men set out in search of a dead body in the Anatolian steppes.", id:"Bir Zamanlar Anadolu'da", grossRevenue:138730}}, {_id:7012, properties:{runtimeInMinutes:100, numberOfRatingVotes:230624, name:"The Artist", rating:7.9, description:"An egomaniacal film star develops a relationship with a young dancer against the backdrop of Hollywood's silent era.", id:"The Artist", grossRevenue:44671682}}, {_id:7013, properties:{runtimeInMinutes:113, numberOfRatingVotes:600004, name:"Edge of Tomorrow", rating:7.9, description:"A soldier fighting aliens gets to relive the same day over and over again, the day restarting every time he dies.", id:"Edge of Tomorrow", grossRevenue:100206256}}, {_id:7014, properties:{runtimeInMinutes:127, numberOfRatingVotes:93090, name:"Amour", rating:7.9, description:"Georges and Anne are an octogenarian couple. They are cultivated, retired music teachers. Their daughter, also a musician, lives in Britain with her family. One day, Anne has a stroke, and the couple's bond of love is severely tested.", id:"Amour", grossRevenue:6739492}}, {_id:7015, properties:{runtimeInMinutes:209, numberOfRatingVotes:324720, name:"The Irishman", rating:7.9, description:"An old man recalls his time painting houses for his friend, Jimmy Hoffa, through the 1950-70s.", id:"The Irishman", grossRevenue:7000000}}, {_id:7016, properties:{runtimeInMinutes:155, numberOfRatingVotes:93560, name:"Un prophète", rating:7.9, description:"A young Arab man is sent to a French prison.", id:"Un prophète", grossRevenue:2084637}}, {_id:7017, properties:{runtimeInMinutes:97, numberOfRatingVotes:335152, name:"Moon", rating:7.9, description:"Astronaut Sam Bell has a quintessentially personal encounter toward the end of his three-year stint on the Moon, where he, working alongside his computer, GERTY, sends back to Earth parcels of a resource that has helped diminish our planet's power problems.", id:"Moon", grossRevenue:5009677}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Movie;
UNWIND [{_id:7018, properties:{runtimeInMinutes:114, numberOfRatingVotes:205609, name:"Låt den rätte komma in", rating:7.9, description:"Oskar, an overlooked and bullied boy, finds love and revenge through Eli, a beautiful but peculiar girl.", id:"Låt den rätte komma in", grossRevenue:2122065}}, {_id:7019, properties:{runtimeInMinutes:112, numberOfRatingVotes:638202, name:"District 9", rating:7.9, description:"Violence ensues after an extraterrestrial race forced to live in slum-like conditions on Earth finds a kindred spirit in a government agent exposed to their biotechnology.", id:"District 9", grossRevenue:115646235}}, {_id:7020, properties:{runtimeInMinutes:109, numberOfRatingVotes:289415, name:"The Wrestler", rating:7.9, description:"A faded professional wrestler must retire, but finds his quest for a new life outside the ring a dispiriting struggle.", id:"The Wrestler", grossRevenue:26236603}}, {_id:7021, properties:{runtimeInMinutes:138, numberOfRatingVotes:47720, name:"Jab We Met", rating:7.9, description:"A depressed wealthy businessman finds his life changing after he meets a spunky and care-free young woman.", id:"Jab We Met", grossRevenue:410800}}, {_id:7022, properties:{runtimeInMinutes:165, numberOfRatingVotes:335533, name:"Boyhood", rating:7.9, description:"The life of Mason, from early childhood to his arrival at college.", id:"Boyhood", grossRevenue:25379975}}, {_id:7023, properties:{runtimeInMinutes:113, numberOfRatingVotes:56625, name:"4 luni, 3 saptamâni si 2 zile", rating:7.9, description:"A woman assists her friend in arranging an illegal abortion in 1980s Romania.", id:"4 luni, 3 saptamâni si 2 zile", grossRevenue:1185783}}, {_id:7024, properties:{runtimeInMinutes:127, numberOfRatingVotes:577336, name:"Star Trek", rating:7.9, description:"The brash James T. Kirk tries to live up to his father's legacy with Mr. Spock keeping him in check as a vengeful Romulan from the future creates black holes to destroy the Federation one planet at a time.", id:"Star Trek", grossRevenue:257730019}}, {_id:7025, properties:{runtimeInMinutes:107, numberOfRatingVotes:390334, name:"In Bruges", rating:7.9, description:"Guilt-stricken after a job gone wrong, hitman Ray and his partner await orders from their ruthless boss in Bruges, Belgium, the last place in the world Ray wants to be.", id:"In Bruges", grossRevenue:7757130}}, {_id:7026, properties:{runtimeInMinutes:87, numberOfRatingVotes:174125, name:"The Man from Earth", rating:7.9, description:"An impromptu goodbye party for Professor John Oldman becomes a mysterious interrogation after the retiring scholar reveals to his colleagues he has a longer and stranger past than they can imagine.", id:"The Man from Earth"}}, {_id:7027, properties:{runtimeInMinutes:141, numberOfRatingVotes:154011, name:"Letters from Iwo Jima", rating:7.9, description:"The story of the battle of Iwo Jima between the United States and Imperial Japan during World War II, as told from the perspective of the Japanese who fought it.", id:"Letters from Iwo Jima", grossRevenue:13756082}}, {_id:7028, properties:{runtimeInMinutes:117, numberOfRatingVotes:107290, name:"The Fall", rating:7.9, description:"In a hospital on the outskirts of 1920s Los Angeles, an injured stuntman begins to tell a fellow patient, a little girl with a broken arm, a fantastic story of five mythical heroes. Thanks to his fractured state of mind and her vivid imagination, the line between fiction and reality blurs as the tale advances.", id:"The Fall", grossRevenue:2280348}}, {_id:7029, properties:{runtimeInMinutes:127, numberOfRatingVotes:580708, name:"Life of Pi", rating:7.9, description:"A young man who survives a disaster at sea is hurtled into an epic journey of adventure and discovery. While cast away, he forms an unexpected connection with another survivor: a fearsome Bengal tiger.", id:"Life of Pi", grossRevenue:124987023}}, {_id:7030, properties:{runtimeInMinutes:87, numberOfRatingVotes:199696, name:"Fantastic Mr. Fox", rating:7.9, description:"An urbane fox cannot resist returning to his farm raiding ways and then must help his community survive the farmers' retaliation.", id:"Fantastic Mr. Fox", grossRevenue:21002919}}, {_id:7031, properties:{runtimeInMinutes:129, numberOfRatingVotes:31476, name:"C.R.A.Z.Y.", rating:7.9, description:"A young French-Canadian, growing up in the 1960s and 1970s, struggles to reconcile his emerging homosexuality with his father's conservative values and his own Catholic beliefs.", id:"C.R.A.Z.Y."}}, {_id:7032, properties:{runtimeInMinutes:97, numberOfRatingVotes:57430, name:"Les choristes", rating:7.9, description:"The new teacher at a severely administered boys' boarding school works to positively affect the students' lives through music.", id:"Les choristes", grossRevenue:3635164}}, {_id:7033, properties:{runtimeInMinutes:126, numberOfRatingVotes:939644, name:"Iron Man", rating:7.9, description:"After being held captive in an Afghan cave, billionaire engineer Tony Stark creates a unique weaponized suit of armor to fight evil.", id:"Iron Man", grossRevenue:318412101}}, {_id:7034, properties:{runtimeInMinutes:99, numberOfRatingVotes:512249, name:"Shaun of the Dead", rating:7.9, description:"A man's uneventful life is disrupted by the zombie apocalypse.", id:"Shaun of the Dead", grossRevenue:13542874}}, {_id:7035, properties:{runtimeInMinutes:121, numberOfRatingVotes:51325, name:"Gegen die Wand", rating:7.9, description:"With the intention to break free from the strict familial restrictions, a suicidal young woman sets up a marriage of convenience with a forty-year-old addict, an act that will lead to an outburst of envious love.", id:"Gegen die Wand"}}, {_id:7036, properties:{runtimeInMinutes:138, numberOfRatingVotes:419420, name:"Mystic River", rating:7.9, description:"The lives of three men who were childhood friends are shattered when one of them has a family tragedy.", id:"Mystic River", grossRevenue:90135191}}, {_id:7037, properties:{runtimeInMinutes:142, numberOfRatingVotes:552493, name:"Harry Potter and the Prisoner of Azkaban", rating:7.9, description:"Harry Potter, Ron and Hermione return to Hogwarts School of Witchcraft and Wizardry for their third year of study, where they delve into the mystery surrounding an escaped prisoner who poses a dangerous threat to the young wizard.", id:"Harry Potter and the Prisoner of Azkaban", grossRevenue:249358727}}] AS row

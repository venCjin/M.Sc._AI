UNWIND [{_id:6578, properties:{runtimeInMinutes:89, numberOfRatingVotes:235231, name:"Hotaru no haka", rating:8.5, description:"A young boy and his little sister struggle to survive in Japan during World War II.", id:"Hotaru no haka"}}, {_id:6579, properties:{runtimeInMinutes:116, numberOfRatingVotes:1058081, name:"Back to the Future", rating:8.5, description:"Marty McFly, a 17-year-old high school student, is accidentally sent thirty years into the past in a time-traveling DeLorean invented by his close friend, the eccentric scientist Doc Brown.", id:"Back to the Future", grossRevenue:210609762}}, {_id:6580, properties:{runtimeInMinutes:165, numberOfRatingVotes:302844, name:"Once Upon a Time in the West", rating:8.5, description:"A mysterious stranger with a harmonica joins forces with a notorious desperado to protect a beautiful widow from a ruthless assassin working for the railroad.", id:"Once Upon a Time in the West", grossRevenue:5321508}}, {_id:6581, properties:{runtimeInMinutes:109, numberOfRatingVotes:604211, name:"Psycho", rating:8.5, description:"A Phoenix secretary embezzles $40,000 from her employer's client, goes on the run, and checks into a remote motel run by a young man under the domination of his mother.", id:"Psycho", grossRevenue:32000000}}, {_id:6582, properties:{runtimeInMinutes:102, numberOfRatingVotes:522093, name:"Casablanca", rating:8.5, description:"A cynical expatriate American cafe owner struggles to decide whether or not to help his former lover and her fugitive husband escape the Nazis in French Morocco.", id:"Casablanca", grossRevenue:1024560}}, {_id:6583, properties:{runtimeInMinutes:87, numberOfRatingVotes:217881, name:"Modern Times", rating:8.5, description:"The Tramp struggles to live in modern industrial society with the help of a young homeless woman.", id:"Modern Times", grossRevenue:163245}}, {_id:6584, properties:{runtimeInMinutes:87, numberOfRatingVotes:167839, name:"City Lights", rating:8.5, description:"With the aid of a wealthy erratic tippler, a dewy-eyed tramp who has fallen in love with a sightless flower girl accumulates money to be able to help her medically.", id:"City Lights", grossRevenue:19181}}, {_id:6585, properties:{runtimeInMinutes:126, numberOfRatingVotes:62635, name:"Capharnaüm", rating:8.4, description:"While serving a five-year sentence for a violent crime, a 12-year-old boy sues his parents for neglect.", id:"Capharnaüm", grossRevenue:1661096}}, {_id:6586, properties:{runtimeInMinutes:125, numberOfRatingVotes:34112, name:"Ayla: The Daughter of War", rating:8.4, description:"In 1950, amid-st the ravages of the Korean War, Sergeant Süleyman stumbles upon a half-frozen little girl, with no parents and no help in sight. Frantic, scared and on the verge of death, ...                See full summary »", id:"Ayla: The Daughter of War"}}, {_id:6587, properties:{runtimeInMinutes:147, numberOfRatingVotes:28401, name:"Vikram Vedha", rating:8.4, description:"Vikram, a no-nonsense police officer, accompanied by Simon, his partner, is on the hunt to capture Vedha, a smuggler and a murderer. Vedha tries to change Vikram's life, which leads to a conflict.", id:"Vikram Vedha"}}, {_id:6588, properties:{runtimeInMinutes:106, numberOfRatingVotes:194838, name:"Kimi no na wa.", rating:8.4, description:"Two strangers find themselves linked in a bizarre way. When a connection forms, will distance be the only thing to keep them apart?", id:"Kimi no na wa.", grossRevenue:5017246}}, {_id:6589, properties:{runtimeInMinutes:161, numberOfRatingVotes:156479, name:"Dangal", rating:8.4, description:"Former wrestler Mahavir Singh Phogat and his two wrestler daughters struggle towards glory at the Commonwealth Games in the face of societal oppression.", id:"Dangal", grossRevenue:12391761}}, {_id:6590, properties:{runtimeInMinutes:117, numberOfRatingVotes:375110, name:"Spider-Man: Into the Spider-Verse", rating:8.4, description:"Teen Miles Morales becomes the Spider-Man of his universe, and must join with five spider-powered individuals from other dimensions to stop a threat for all realities.", id:"Spider-Man: Into the Spider-Verse", grossRevenue:190241310}}, {_id:6591, properties:{runtimeInMinutes:181, numberOfRatingVotes:809955, name:"Avengers: Endgame", rating:8.4, description:"After the devastating events of Avengers: Infinity War (2018), the universe is in ruins. With the help of remaining allies, the Avengers assemble once more in order to reverse Thanos' actions and restore balance to the universe.", id:"Avengers: Endgame", grossRevenue:858373000}}, {_id:6592, properties:{runtimeInMinutes:149, numberOfRatingVotes:834477, name:"Avengers: Infinity War", rating:8.4, description:"The Avengers and their allies must be willing to sacrifice all in an attempt to defeat the powerful Thanos before his blitz of devastation and ruin puts an end to the universe.", id:"Avengers: Infinity War", grossRevenue:678815482}}, {_id:6593, properties:{runtimeInMinutes:105, numberOfRatingVotes:384171, name:"Coco", rating:8.4, description:"Aspiring musician Miguel, confronted with his family's ancestral ban on music, enters the Land of the Dead to find his great-great-grandfather, a legendary singer.", id:"Coco", grossRevenue:209726015}}, {_id:6594, properties:{runtimeInMinutes:165, numberOfRatingVotes:1357682, name:"Django Unchained", rating:8.4, description:"With the help of a German bounty hunter, a freed slave sets out to rescue his wife from a brutal Mississippi plantation owner.", id:"Django Unchained", grossRevenue:162805434}}, {_id:6595, properties:{runtimeInMinutes:164, numberOfRatingVotes:1516346, name:"The Dark Knight Rises", rating:8.4, description:"Eight years after the Joker's reign of anarchy, Batman, with the help of the enigmatic Catwoman, is forced from his exile to save Gotham City from the brutal guerrilla terrorist Bane.", id:"The Dark Knight Rises", grossRevenue:448139099}}, {_id:6596, properties:{runtimeInMinutes:170, numberOfRatingVotes:344445, name:"3 Idiots", rating:8.4, description:"Two friends are searching for their long lost companion. They revisit their college days and recall the memories of their friend who inspired them to think differently, even as the rest of the world called them \"idiots\".", id:"3 Idiots", grossRevenue:6532908}}, {_id:6597, properties:{runtimeInMinutes:165, numberOfRatingVotes:168895, name:"Taare Zameen Par", rating:8.4, description:"An eight-year-old boy is thought to be a lazy trouble-maker, until the new art teacher has the patience and compassion to discover the real problem behind his struggles in school.", id:"Taare Zameen Par", grossRevenue:1223869}}] AS row
